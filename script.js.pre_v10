                makeStage('2 dígitos + 1 dígito sem reagrupamento', 10, () => { const [a,b]=randAdditionNoCarry(10,89,1,9); return qAddition(a,b,'2 dígitos + 1 dígito sem reagrupamento'); }),
                makeStage('2 dígitos + 1 dígito com reagrupamento', 10, () => { const [a,b]=randAdditionWithCarry(10,89,1,9); return qAddition(a,b,'2 dígitos + 1 dígito com reagrupamento'); }),
                makeStage('2 dígitos + 2 dígitos sem reagrupamento', 10, () => { const [a,b]=randAdditionNoCarry(12,59,11,39); return qAddition(a,b,'2 dígitos + 2 dígitos sem reagrupamento'); }),
                makeStage('2 dígitos + 2 dígitos com reagrupamento', 10, () => { const [a,b]=randAdditionWithCarry(12,59,11,39); return qAddition(a,b,'2 dígitos + 2 dígitos com reagrupamento'); }),
