/** Exibe uma tela e oculta as outras */
function exibirTela(id) {
    screens.forEach(screen => {
        screen.classList.remove('active');
    });
    const targetScreen = document.getElementById(id);
    if (targetScreen) {
        targetScreen.classList.add('active');
        gameState.currentScreen = id;
    }

    // Esconde o badge de progresso fora da tela de jogo
    if (id !== 'game-screen') {
        try { hideCycleProgressBadge(); } catch (_) {}
    }
    // Sempre que voltarmos para a home ou resultados, atualiza o botão de treino
    if (id === 'home-screen' || id === 'result-screen') {
        updateErrorTrainingButton();
    }
    try { if (id === 'home-screen' || id === 'result-screen') refreshPetProgressMini(); } catch (_) {}

    // Mentor só aparece na tela de questões
    try { updateMentorVisibility(id); } catch (_) {}
}

/** Reproduz o som de alerta */
function playAlertSound() {
    if (document.body.classList.contains('calm-mode')) return;
    if (alertSound) {
        alertSound.currentTime = 0;
        alertSound.play().catch(e => console.error("Erro ao tocar áudio:", e));
    }
}

/** Função de Text-to-Speech (Leitura de Voz) */
function speak(text) {
    if (!gameState.isVoiceReadActive || !synth) return;

    // Evita cortar falas de forma agressiva (alguns navegadores podem “engolir” a primeira fala)
    try {
        if (synth.speaking || synth.pending) synth.cancel();
    } catch (_) {}

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'pt-BR';
    utterance.rate = 1.0; 
    
    synth.speak(utterance);
}


/** Fala uma sequência de mensagens (pergunta → alternativas) de forma confiável. */
let __voiceQueueToken = 0;
function speakSequence(texts) {
    if (!gameState.isVoiceReadActive || !synth) return;
    if (!Array.isArray(texts) || texts.length === 0) return;

    // Token para evitar que uma sequência antiga continue após iniciar uma nova
    const token = ++__voiceQueueToken;

    // Interrompe qualquer leitura anterior
    try { synth.cancel(); } catch (_) {}

    let i = 0;

    const speakNext = () => {
        if (token !== __voiceQueueToken) return;
        if (!gameState.isVoiceReadActive || !synth) return;
        if (i >= texts.length) return;

        const utterance = new SpeechSynthesisUtterance(String(texts[i]));
        utterance.lang = 'pt-BR';
        utterance.rate = 1.0;

        utterance.onend = () => { i++; speakNext(); };
        utterance.onerror = () => { i++; speakNext(); };

        try { synth.speak(utterance); } catch (_) {}
    };

    // Pequeno delay após cancel() (melhora compatibilidade: em alguns navegadores a 1ª fala pode ser "comida")
    setTimeout(speakNext, 80);
}

/** Monta textos para leitura de voz: 1) pergunta 2) alternativas (1–4). */

// === Feedback pedagógico inteligente (explicativo) ===
function fmtNum(n){ return (typeof n==='number' && Number.isFinite(n)) ? n : Number(n); }



function explainAnswer(operation, num1, num2, correct, userAnswer) {
    const a = Number(num1), b = Number(num2);

    switch (operation) {

        // ✅ BASE (mantida): completar para a próxima dezena
        case 'addition': {
            const falta = (10 - (a % 10)) % 10;
            if (falta > 0 && falta < 10) {
                const a2 = a + falta;
                return `Jeito fácil: complete ${a} até ${a2} (faltam ${falta}). Faça ${a2} + ${b} e depois tire ${falta}.`;
            }
            return `Some devagar: ${a} + ${b}. Comece pelo mais fácil e depois complete.`;
        }

        // ➖ Subtração: ir até uma dezena “redonda” e depois voltar
        case 'subtraction': {
            // Ex.: 42 - 17 -> 42 - 2 = 40, depois 40 - 15
            const faltaParaBaixo = a % 10; // quanto falta para descer até a dezena
            if (faltaParaBaixo > 0 && b > faltaParaBaixo) {
                const a2 = a - faltaParaBaixo;
                const b2 = b - faltaParaBaixo;
                return `Jeito fácil: leve ${a} até ${a2} (tire ${faltaParaBaixo}). Depois faça ${a2} − ${b2}.`;
            }
            // Se b é pequeno, tira direto
            return `Jeito fácil: tire em partes. Ex.: tire ${b%10} e depois tire as dezenas.`;
        }

        // ✖️ Multiplicação: quebrar o número e somar parcelas iguais
        case 'multiplication': {
            // Ex.: 6×7 = 6×5 + 6×2
            if (b > 5) {
                const parte = 5;
                const resto = b - parte;
                return `Jeito fácil: quebre ${b}. Faça ${a}×${parte} e depois ${a}×${resto}. Depois some as duas partes.`;
            }
            return `Jeito fácil: repita a soma. Ex.: ${a}×${b} é somar ${a} (${b} vezes).`;
        }

        // ➗ Divisão: “testa a tabuada” até chegar perto sem passar
        case 'division': {
            return `Dividir é REPARTIR em partes iguais. Pergunta: “se eu tenho ${a} e vou repartir em ${b} partes, quanto fica em cada parte?”`;
        }

        // ^ Potenciação: “vezes ele mesmo” (b vezes) e começar pequeno
        case 'potenciacao': {
            if (b <= 2) {
                return `Jeito fácil: ${a}^${b} é ${a}×${a} (se for 2).`;
            }
            return `Jeito fácil: é ${a} vezes ele mesmo ${b} vezes. Comece: ${a}×${a} e vá multiplicando de novo até completar.`;
        }

        // √ / ∛ Radiciação: procurar a potência que gera o valor
        case 'radiciacao': {
            if (b === 3) {
                const chute = Math.round(Math.cbrt(a));
                const p = chute * chute * chute;
                if (p === a) {
                    return `Jeito fácil: pense “qual número vezes ele mesmo 3 vezes dá ${a}?”`;
                }
                return `Jeito fácil: teste cubos conhecidos: 2×2×2=8, 3×3×3=27, 4×4×4=64… até chegar em ${a}.`;
            }
            const chute = Math.round(Math.sqrt(a));
            const p = chute * chute;
            if (p === a) {
                return `Jeito fácil: pense “qual número vezes ele mesmo dá ${a}?”`;
            }
            return `Jeito fácil: teste: 5×5=25, 6×6=36, 7×7=49… até chegar em ${a}.`;
        }

        default:
            return `Tente de novo com calma.`;
    }
}

// === Modo Estudo: explicação passo a passo (tipo professor) ===
function explainSteps(operation, num1, num2) {
    const a = Number(num1), b = Number(num2);
    const join = (arr) => arr.filter(Boolean).join('  |  ');

    switch (operation) {
        case 'addition': {
            const falta = (10 - (a % 10)) % 10;
            if (falta > 0 && falta < 10) {
                const a2 = a + falta;
                return join([
                    `Passo 1: complete ${a} até ${a2} (faltam ${falta})`,
                    `Passo 2: faça ${a2} + ${b}`,
                    `Passo 3: tire ${falta}`,
                    `Pronto`
                ]);
            }
            return join([`Passo 1: some partes fáceis`, `Passo 2: complete`, `Pronto`]);
        }
        case 'subtraction': {
            const faltaParaBaixo = a % 10;
            if (faltaParaBaixo > 0 && b > faltaParaBaixo) {
                const a2 = a - faltaParaBaixo;
                const b2 = b - faltaParaBaixo;
                return join([
                    `Passo 1: leve ${a} até ${a2} (tire ${faltaParaBaixo})`,
                    `Passo 2: faça ${a2} − ${b2}`,
                    `Pronto`
                ]);
            }
            return join([`Passo 1: tire unidades`, `Passo 2: tire dezenas`, `Pronto`]);
        }
        case 'multiplication': {
            if (b > 5) {
                const parte = 5, resto = b - 5;
                return join([`Passo 1: quebre ${b} em 5 + ${resto}`, `Passo 2: ${a}×5`, `Passo 3: ${a}×${resto}`, `Passo 4: some`, `Pronto`]);
            }
            return join([`Passo 1: soma repetida`, `Passo 2: some ${a} (${b} vezes)`, `Pronto`]);
        }
        case 'division': {
            return join([
                `Passo 1: dividir é REPARTIR em partes iguais.`,
                `Passo 2: imagine ${a} itens para ${b} pessoas (ou caixas).`,
                `Passo 3: vá distribuindo 1 para cada pessoa, repetindo as voltas.`,
                `Passo 4: quando acabar, veja quantos cada um recebeu.`,
                `Passo 5: se sobrar algum item, isso é o RESTO.`
            ]);
        }
        case 'potenciacao': {
            return join([`Passo 1: é multiplicar ${a} por ele mesmo`, `Passo 2: faça isso ${b} vezes`, `Pronto`]);
        }
        case 'radiciacao': {
            if (b === 3) {
                return join([`Passo 1: teste 1×1×1, 2×2×2, 3×3×3...`, `Passo 2: quando der ${a}, achou a raiz cúbica`, `Pronto`]);
            }
            return join([`Passo 1: teste 1×1, 2×2, 3×3...`, `Passo 2: quando der ${a}, achou`, `Pronto`]);
        }
        default:
            return `Passo 1: tente de novo com calma.`;
    }
}






function showPedagogicalFeedback(isCorrect, operation, q, selectedValue) {
    // Regras:
    // - Modo Rápido: 15s ou até acabar o tempo ou acertar/seguir para a próxima.
    // - Modo Estudo: fica visível até o usuário responder novamente.
    const isRapid = !!gameState.isRapidMode;
    const DURATION_RAPID = 15000;

    if (isCorrect) {
        showFeedbackControlled('✅ Correto! Boa! Continue.', 'success', 2500);
        return;
    }

    const diagnosis = getDistractorDiagnosis(q, selectedValue) || null;
    const typicalError = diagnosis?.label || classifyTypicalError(q, selectedValue);
    const targetedHint = String(diagnosis?.feedback || '').trim();
    const genericRapid = explainAnswer(operation, q?.num1, q?.num2, q?.answer, selectedValue);
    const genericStudy = explainSteps(operation, q?.num1, q?.num2);
    const targeted = typicalError && typicalError !== 'Erro de cálculo ou atenção nesta habilidade.'
        ? typicalError
        : '';
    const baseHint = isRapid ? genericRapid : genericStudy;
    const hint = targetedHint || baseHint;
    const msg = targeted
        ? `${targeted} ${hint}`.trim()
        : hint;

    if (isRapid) {
        showFeedbackControlled('💡 Dica rápida: ' + msg, 'incentive', DURATION_RAPID);
    } else {
        showFeedbackControlled('👩‍🏫 Passo a passo: ' + msg, 'incentive', 600000);
        window.__keepFeedbackUntilNextAnswer = true;
    }
}


function buildVoiceTextsForQuestion(questionObj) {
    if (!questionObj) return [];

    const qCore = (questionObj.voiceQuestion || questionObj.question || '').toString().replace(/\s+/g, ' ').trim();
    const opts = (questionObj.voiceOptions || questionObj.options || []).map(v => String(v));

    // Pergunta primeiro (sempre)
    const qText = qCore
        ? `Questão ${gameState.questionNumber}. Quanto é ${qCore}?`
        : `Questão ${gameState.questionNumber}.`;

    // Alternativas depois, uma por vez (mais claro e mais estável no TTS)
    const optionTexts = (opts.length === 4)
        ? [
            `Opção 1: ${opts[0]}.`,
            `Opção 2: ${opts[1]}.`,
            `Opção 3: ${opts[2]}.`,
            `Opção 4: ${opts[3]}.`
        ]
        : [];

    return [qText, ...optionTexts].filter(Boolean);
}

/** Lê novamente a questão atual (atalho: tecla R). */
function announceCurrentQuestion() {
    if (!gameState.currentQuestion) return;
    speakSequence(buildVoiceTextsForQuestion(gameState.currentQuestion));
}


/** Exibe mensagens de feedback */

// --- ARIA Live global (Leitor de tela) ---
let __petLiveRegion = null;
function ensureGlobalLiveRegion() {
    try {
        if (__petLiveRegion) return __petLiveRegion;
        let el = document.getElementById('pet-sr-live');
        if (!el) {
            el = document.createElement('div');
            el.id = 'pet-sr-live';
            el.className = 'sr-only';
            el.setAttribute('aria-live', 'polite');
            el.setAttribute('aria-atomic', 'true');
            document.body.appendChild(el);
        }
        __petLiveRegion = el;
        return el;
    } catch (_) {
        return null;
    }
}
function announceSR(text, politeness = 'polite') {
    try {
        const el = ensureGlobalLiveRegion();
        if (!el) return;
        el.setAttribute('aria-live', politeness);
        // Limpa e escreve (força anúncio)
        el.textContent = '';
        setTimeout(() => { el.textContent = String(text || ''); }, 20);
    } catch (_) {}
}

// --- Vibração (opcional) ---
function maybeVibrate(pattern) {
    try {
        if (!document.body.classList.contains('vibrate-mode')) return;
        if (typeof navigator === 'undefined' || typeof navigator.vibrate !== 'function') return;
        navigator.vibrate(pattern);
    } catch (_) {}
}

// --- Toggle extras (Dislexia / Calmo / Tempo+ / Vibração) ---
function toggleDyslexia(force) {
    const enabled = (typeof force === 'boolean') ? force : !document.body.classList.contains('dyslexia-mode');
    document.body.classList.toggle('dyslexia-mode', enabled);
    try { localStorage.setItem(UI_DYSLEXIA_KEY, enabled ? '1' : '0'); } catch (_) {}
    updateAccessibilityOnClass();
    // Atualiza tempo no rápido (se aplicável)
    try { recomputeRapidTimeWithAccessibility(); } catch (_) {}
    return enabled;
}
function toggleCalm(force) {
    const enabled = (typeof force === 'boolean') ? force : !document.body.classList.contains('calm-mode');
    document.body.classList.toggle('calm-mode', enabled);
    try { localStorage.setItem(UI_CALM_KEY, enabled ? '1' : '0'); } catch (_) {}
    updateAccessibilityOnClass();
    return enabled;
}
function toggleExtraTime(force) {
    const enabled = (typeof force === 'boolean') ? force : !document.body.classList.contains('extra-time-mode');
    document.body.classList.toggle('extra-time-mode', enabled);
    try { localStorage.setItem(UI_EXTRA_TIME_KEY, enabled ? '1' : '0'); } catch (_) {}
    updateAccessibilityOnClass();
    try { recomputeRapidTimeWithAccessibility(); } catch (_) {}
    return enabled;
}
function toggleVibrate(force) {
    const enabled = (typeof force === 'boolean') ? force : !document.body.classList.contains('vibrate-mode');
    document.body.classList.toggle('vibrate-mode', enabled);
    try { localStorage.setItem(UI_VIBRATE_KEY, enabled ? '1' : '0'); } catch (_) {}
    updateAccessibilityOnClass();
    return enabled;
}

function showFeedbackMessage(message, type, duration = 3000) {
    try { announceSR(message); } catch (_) {}
    const feedbackTextElement = document.getElementById('feedback-text');

    if (!feedbackMessageElement) return;

    feedbackMessageElement.className = 'feedback-message hidden';
    feedbackMessageElement.classList.add(type);
    if (feedbackTextElement) { feedbackTextElement.textContent = message; } else { feedbackMessageElement.textContent = message; }

    setTimeout(() => {
        feedbackMessageElement.classList.remove('hidden');
        feedbackMessageElement.classList.add('show');
    }, 50);

    setTimeout(() => {
        feedbackMessageElement.classList.remove('show');
        setTimeout(() => feedbackMessageElement.classList.add('hidden'), 300);
    }, duration);
}


// --- LÓGICA DE PERSISTÊNCIA (Local Storage) ---
// --- PERFIL DO ESTUDANTE (opcional) ---
const PROFILE_STORAGE_KEY = 'matemagica_profile_v1';

// --- VERSÃO DO STORAGE + SESSÃO EM ANDAMENTO (Prioridade 1) ---
// Mantém o “andamento do jogo” no dispositivo para continuar depois.
const PET_STORAGE_VERSION = 5;
const PET_STORAGE_VERSION_KEY = 'pet_storage_version_v1';
const PET_SESSION_KEY = 'pet_session_v1';

// --- Prioridade 2: Onboarding (primeiro acesso) + resumo pós-sessão ---
const PET_ONBOARD_KEY = 'pet_onboarded_v1';
const PET_LAST_SUMMARY_KEY = 'pet_last_summary_v1';

// --- Prioridade 3: Sequência (streak) + Conquistas (medalhas) ---
const PET_PROGRESS_KEY = 'pet_progress_v1';

// --- Prioridade 6: Histórico de sessões + Exportar CSV (Relatório) ---
const PET_SESSION_HISTORY_KEY = 'pet_session_history_v1';
const PET_SESSION_HISTORY_MAX = 500; // limite de sessões guardadas (neste dispositivo)

// --- Configuração (Prioridade 4+): Bônus de XP por marcos de sequência ---
// ✅ Para mudar os valores do bônus, altere SOMENTE aqui.
// Ex.: { days: 3, xp: 15 } -> dá +15 XP quando bater 3 dias seguidos.
const PET_STREAK_REWARD_RULES = [
    { days: 3, xp: 10 },
    { days: 7, xp: 25 },
    { days: 14, xp: 50 }
];

function getPetStreakRewardForStreak(streakDays) {
    try {
        const s = Math.round(Number(streakDays || 0));
        const rules = Array.isArray(PET_STREAK_REWARD_RULES) ? PET_STREAK_REWARD_RULES : [];
        const rule = rules.find(r => Math.round(Number(r.days || 0)) === s);
        if (!rule) return { xp: 0, label: '' };
        const xp = Math.round(Number(rule.xp || 0));
        if (!xp) return { xp: 0, label: '' };
        const label = rule.label ? String(rule.label) : `${s} dias seguidos`;
        return { xp, label };
    } catch (_) {
        return { xp: 0, label: '' };
    }
}



function ensurePetStorageVersion() {
    try {
        const cur = Number(localStorage.getItem(PET_STORAGE_VERSION_KEY));
        if (!Number.isFinite(cur) || cur <= 0) {
            localStorage.setItem(PET_STORAGE_VERSION_KEY, String(PET_STORAGE_VERSION));
            return PET_STORAGE_VERSION;
        }
        if (cur !== PET_STORAGE_VERSION) {
            // Em caso de mudança de versão: evita restaurar sessão incompatível.
            try { profileStorageRemove(PET_SESSION_KEY); } catch (_) {}
            localStorage.setItem(PET_STORAGE_VERSION_KEY, String(PET_STORAGE_VERSION));
            return PET_STORAGE_VERSION;
        }
        return cur;
    } catch (_) {
        return PET_STORAGE_VERSION;
    }
}

function safeJsonParse(raw, fallback) {
    try {
        const obj = raw ? JSON.parse(raw) : fallback;
        return (obj == null) ? fallback : obj;
    } catch (_) {
        return fallback;
    }
}

function loadSavedPetSession() {
    try {
        const raw = profileStorageGetRaw(PET_SESSION_KEY);
        const snap = safeJsonParse(raw, null);
        if (!snap || typeof snap !== 'object') return null;
        if (Number(snap.version) !== PET_STORAGE_VERSION) return null;
        if (!snap.isGameActive) return null;
        if (!snap.operation || !snap.level) return null;
        if (!snap.currentQuestion || !Array.isArray(snap.currentQuestion.options)) return null;
        return snap;
    } catch (_) {
        return null;
    }
}

function clearSavedPetSession() {
    try { profileStorageRemove(PET_SESSION_KEY); } catch (_) {}
}

function buildPetSessionSnapshot() {
    const q = gameState.currentQuestion;
    const snap = {
        version: PET_STORAGE_VERSION,
        savedAt: Date.now(),
        isGameActive: !!gameState.isGameActive,
        currentScreen: gameState.currentScreen || 'home-screen',
        operation: gameState.currentOperation || '',
        level: gameState.currentLevel || '',
        isRapidMode: !!gameState.isRapidMode,
        score: Number(gameState.score || 0),
        questionNumber: Number(gameState.questionNumber || 0),
        totalQuestions: (Number.isFinite(gameState.totalQuestions) ? Number(gameState.totalQuestions) : null),
        acertos: Number(gameState.acertos || 0),
        erros: Number(gameState.erros || 0),
        timeLeft: Number.isFinite(gameState.timeLeft) ? Number(gameState.timeLeft) : null,
        maxTime: Number.isFinite(gameState.maxTime) ? Number(gameState.maxTime) : null,
        sessionDiagnostics: (gameState.sessionDiagnostics && typeof gameState.sessionDiagnostics === 'object')
            ? JSON.parse(JSON.stringify(gameState.sessionDiagnostics))
            : null,
        currentQuestion: q ? {
            question: q.question,
            voiceQuestion: q.voiceQuestion,
            answer: q.answer,
            options: Array.isArray(q.options) ? q.options.slice(0, 4) : [],
            operacao: q.operacao,
            num1: (q.num1 ?? null),
            num2: (q.num2 ?? null),
            stageLabel: (q.stageLabel || ''),
            stageIndex: (q.stageIndex ?? null),
            absoluteTrailIndex: (q.absoluteTrailIndex ?? null),
            bankSize: (q.bankSize ?? null),
            isReview: !!q.isReview,
            sourceStageIndex: (q.sourceStageIndex ?? null),
            sourceStageLabel: (q.sourceStageLabel || ''),
            masteryStageIndex: (q.masteryStageIndex ?? null),
            masteryStageLabel: (q.masteryStageLabel || ''),
            learningType: (q.learningType || ''),
            learningTypeLabel: (q.learningTypeLabel || ''),
            isConsolidation: !!q.isConsolidation,
            consolidationStageIndex: (q.consolidationStageIndex ?? null),
            consolidationStageLabel: (q.consolidationStageLabel || '')
        } : null,
        opTrail: (gameState.operationTrail && (gameState.currentOperation !== 'multiplication' || isMultiplicationMasteryTrailSession())) ? {
            operation: gameState.operationTrail.operation,
            level: gameState.operationTrail.level,
            key: gameState.operationTrail.key,
            startIndex: gameState.operationTrail.startIndex,
            bankSize: gameState.operationTrail.bankSize,
            totalStages: gameState.operationTrail.totalStages,
            masteryMode: !!gameState.operationTrail.masteryMode,
            currentStageIndex: Number(gameState.operationTrail.currentStageIndex || 0),
            currentStageAsked: Number(gameState.operationTrail.currentStageAsked || 0),
            currentStageCorrect: Number(gameState.operationTrail.currentStageCorrect || 0),
            stageTarget: Number(gameState.operationTrail.stageTarget || 0),
            targetAccuracy: Number(gameState.operationTrail.targetAccuracy || 0),
            reviewEvery: Number(gameState.operationTrail.reviewEvery || 0),
            reviewAsked: Number(gameState.operationTrail.reviewAsked || 0),
            lastQuestionWasReview: !!gameState.operationTrail.lastQuestionWasReview,
            currentStageLabel: (gameState.operationTrail.currentStageLabel || ''),
            supportMode: String(gameState.operationTrail.supportMode || 'normal'),
            supportEscalations: Number(gameState.operationTrail.supportEscalations || 0),
            supportHint: String(gameState.operationTrail.supportHint || ''),
            consolidationMode: !!gameState.operationTrail.consolidationMode,
            consolidation: gameState.operationTrail.consolidation ? JSON.parse(JSON.stringify(gameState.operationTrail.consolidation)) : null,
            stageType: String(gameState.operationTrail.stageType || 'fluency')
        } : null,
        mult: (gameState.currentOperation === 'multiplication' && gameState.multiplication) ? {
            mode: gameState.multiplication.mode,
            tabuada: gameState.multiplication.tabuada,
            trailMin: gameState.multiplication.trailMin,
            trailMax: gameState.multiplication.trailMax,
            multMin: gameState.multiplication.multMin,
            multMax: gameState.multiplication.multMax,
            trailRangeKey: gameState.multiplication.trailRangeKey,
            trailPairIndex: gameState.multiplication.trailPairIndex
        } : null
    };
    return snap;
}

function savePetSessionSnapshotNow() {
    try {
        // Só salva se houver jogo ativo e uma questão carregada
        if (!gameState.isGameActive || !gameState.currentQuestion) return;
        const snap = buildPetSessionSnapshot();
        profileStorageSetJson(PET_SESSION_KEY, snap);
    } catch (_) {}
}

let __petSessionSaveTimer = null;
function savePetSessionSoon() {
    try {
        if (__petSessionSaveTimer) clearTimeout(__petSessionSaveTimer);
        __petSessionSaveTimer = setTimeout(() => {
            __petSessionSaveTimer = null;
            savePetSessionSnapshotNow();
        }, 200);
    } catch (_) {}
}

function formatOperationLabel(op) {
    const map = {
        addition: 'Adição',
        subtraction: 'Subtração',
        multiplication: 'Multiplicação',
        division: 'Divisão',
        potenciacao: 'Potenciação',
        radiciacao: 'Radiciação'
    };
    return map[op] || String(op || '').toUpperCase();
}


function getResultPerformanceExplanation() {
    const total = Math.max(0, Number(gameState.acertos || 0) + Number(gameState.erros || 0));
    const hits = Math.max(0, Number(gameState.acertos || 0));
    const misses = Math.max(0, Number(gameState.erros || 0));
    const accuracy = total > 0 ? Math.round((hits / total) * 100) : 0;
    const opLabel = formatOperationLabel(gameState.currentOperation).toLowerCase();
    const levelLabel = petLevelLabel(gameState.currentLevel).toLowerCase();
    const modeLabel = gameState.isRapidMode ? 'modo rápido' : 'modo estudo';

    if (total === 0) {
        return 'Esta rodada terminou sem respostas registradas. Volte à Home e tente novamente com calma.';
    }

    if (accuracy >= 90) {
        return `Excelente desempenho: você acertou ${hits} de ${total} questões (${accuracy}%) em ${opLabel}, no nível ${levelLabel}, e mostrou domínio bem consistente.`;
    }
    if (accuracy >= 75) {
        return `Bom desempenho: você acertou ${hits} de ${total} questões (${accuracy}%). Já existe base sólida em ${opLabel}; vale repetir mais uma rodada para ganhar segurança.`;
    }
    if (accuracy >= 50) {
        return `Desempenho mediano: foram ${hits} acertos e ${misses} erros (${accuracy}%). O melhor próximo passo é revisar esta habilidade no ${modeLabel} para reduzir os erros antes de acelerar.`;
    }
    return `Esta rodada mostrou que ${opLabel} ainda precisa de reforço: foram ${hits} acertos e ${misses} erros (${accuracy}%). O mais indicado agora é voltar para a Home e retomar com apoio mais guiado.`;
}

function updateResultPerformanceExplanation() {
    const el = document.getElementById('result-performance-explanation');
    if (!el) return;
    const base = getResultPerformanceExplanation();
    const pedag = getPriority3RoundSummary();
    el.textContent = [base, pedag].filter(Boolean).join(' ');
}


function setPriority3ComprehensionExpanded(expanded) {
    const panel = document.getElementById('priority3-comprehension-panel');
    if (!panel) return;
    const toggle = panel.querySelector('#priority3-comprehension-toggle');
    const body = panel.querySelector('#priority3-comprehension-body');
    const isExpanded = !!expanded;

    panel.dataset.expanded = isExpanded ? 'true' : 'false';

    if (toggle) {
        toggle.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        toggle.classList.toggle('hidden', isExpanded);
        toggle.hidden = isExpanded;
    }

    if (body) {
        body.classList.toggle('hidden', !isExpanded);
        body.hidden = !isExpanded;
        body.setAttribute('aria-hidden', !isExpanded ? 'true' : 'false');
    }
}

function ensurePriority3ComprehensionPanel() {
    let panel = document.getElementById('priority3-comprehension-panel');
    if (panel) return panel;
    const gameScreen = document.getElementById('game-screen');
    const optionsGrid = document.querySelector('#game-screen .options-grid.answers-grid');
    if (!gameScreen || !optionsGrid || !optionsGrid.parentElement) return null;

    panel = document.createElement('div');
    panel.id = 'priority3-comprehension-panel';
    panel.className = 'priority3-comprehension-panel hidden';
    panel.setAttribute('aria-live', 'polite');
    panel.dataset.expanded = 'false';
    panel.innerHTML = `
      <button type="button" class="priority3-comprehension-toggle" id="priority3-comprehension-toggle" aria-expanded="false">
        Compreender a Questão
      </button>
      <div class="info-card priority3-comprehension-card hidden" id="priority3-comprehension-body" hidden aria-hidden="true">
        <div class="priority3-comprehension-header">
          <strong>🧠 Compreender a questão</strong>
          <button type="button" class="priority3-comprehension-close" id="priority3-comprehension-close" aria-label="Fechar compreensão da questão">×</button>
        </div>
        <div class="priority3-comprehension-badge" id="priority3-comprehension-badge">Antes de responder</div>
        <div class="priority3-comprehension-grid">
          <div class="priority3-comprehension-item">
            <span class="priority3-comprehension-label">Como pensar</span>
            <p id="priority3-how-think"></p>
          </div>
          <div class="priority3-comprehension-item">
            <span class="priority3-comprehension-label">Estratégia sugerida</span>
            <p id="priority3-strategy"></p>
          </div>
          <div class="priority3-comprehension-item">
            <span class="priority3-comprehension-label">Erro ou ponto-chave</span>
            <p id="priority3-error-focus"></p>
          </div>
          <div class="priority3-comprehension-item">
            <span class="priority3-comprehension-label">Tente por outro caminho</span>
            <p id="priority3-other-path"></p>
          </div>
        </div>
        <p class="priority3-comprehension-reflect">Pergunte-se: como eu pensei, que estratégia usei e como posso conferir por outro caminho?</p>
      </div>
    `;
    optionsGrid.insertAdjacentElement('afterend', panel);

    const toggle = panel.querySelector('#priority3-comprehension-toggle');
    const closeBtn = panel.querySelector('#priority3-comprehension-close');
    toggle?.addEventListener('click', (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        setPriority3ComprehensionExpanded(true);
    });
    closeBtn?.addEventListener('click', (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        setPriority3ComprehensionExpanded(false);
    });
    return panel;
}

function shouldShowPriority3ComprehensionPanel(q) {
    if (!q) return false;
    if (gameState.isRapidMode) return false;
    if (gameState.isTrainingErrors) return true;
    return true;
}

function getPriority3StageLabel(q) {
    return String(
        q?.masteryStageLabel ||
        q?.consolidationStageLabel ||
        q?.sourceStageLabel ||
        q?.stageLabel || ''
    ).trim();
}

function getPriority3ThinkingText(q) {
    const operation = String(q?.operacao || gameState.currentOperation || '');
    const label = getPriority3StageLabel(q);
    const micro = getSkillMicroExplanation(operation, label);
    if (micro) return micro;
    if (q?.strategyFamily === 'missing-term') return 'Antes de olhar as alternativas, descubra qual valor está faltando na conta.';
    if (q?.strategyFamily === 'inverse-relation') return 'Use a operação inversa para entender a relação entre os números.';
    if (q?.strategyFamily === 'missing-factor') return 'Pense em qual fator multiplicado pelo outro produz o total.';
    if (q?.strategyFamily === 'missing-dividend' || q?.strategyFamily === 'missing-divisor') return 'Pergunte qual número está faltando para a divisão fazer sentido.';
    if (q?.strategyFamily === 'inverse-power' || q?.strategyFamily === 'inverse-root') return 'Conecte a operação à sua inversa antes de responder.';
    return 'Leia a conta com calma, separe o que cada número representa e só então compare as alternativas.';
}

function getPriority3StrategyText(q) {
    const operation = String(q?.operacao || gameState.currentOperation || '');
    const label = getPriority3StageLabel(q).toLowerCase();
    if (q?.strategyFamily === 'missing-term') return 'Use a operação inversa para encontrar o termo faltante antes de testar as opções.';
    if (q?.strategyFamily === 'inverse-relation') return 'Relacione as operações inversas: somar ↔ subtrair, multiplicar ↔ dividir, potência ↔ raiz.';
    if (q?.strategyFamily === 'missing-factor') return 'Use fatos da tabuada para descobrir qual fator completa o produto.';
    if (q?.strategyFamily === 'missing-dividend') return 'Multiplique quociente pelo divisor e ajuste pelo resto, quando houver.';
    if (q?.strategyFamily === 'missing-divisor') return 'Compare quantos grupos completos o total consegue formar.';
    if (q?.strategyFamily === 'inverse-power') return 'Reescreva a potência como multiplicação repetida e veja qual valor fecha o padrão.';
    if (q?.strategyFamily === 'inverse-root') return 'Teste mentalmente quadrados ou cubos conhecidos para localizar a raiz correta.';

    if (operation === 'addition') return label.includes('reagrupamento') ? 'Separe dezenas e unidades e faça a troca apenas quando a soma passar de 9.' : 'Some por partes e confira se o total faz sentido.';
    if (operation === 'subtraction') return label.includes('reserva') ? 'Compare as ordens e, se faltar unidade, empreste 1 dezena antes de subtrair.' : 'Use a diferença ou complete do menor para o maior.';
    if (operation === 'multiplication') return isMultiplicationApprenticeLevel(gameState.currentLevel) ? 'Modele grupos iguais ou saltos antes de pensar na tabuada decorada.' : 'Apoie-se em grupos iguais, padrões das tabuadas e fatos já conhecidos.';
    if (operation === 'division') return label.includes('resto') ? 'Pense em quantos grupos completos cabem e observe o que sobra.' : 'Use a multiplicação de volta para conferir o quociente.';
    if (operation === 'potenciacao') return 'Transforme a potência em multiplicação repetida e compare com potências conhecidas.';
    if (operation === 'radiciacao') return label.includes('cúbica') ? 'Procure um número que, ao cubo, gere o radicando.' : 'Procure o número que, ao quadrado, gera o radicando.';
    return 'Resolva primeiro pelo raciocínio principal e só depois use as alternativas para confirmar.';
}

function getPriority3AlternativePathText(q) {
    const operation = String(q?.operacao || gameState.currentOperation || '');
    if (operation === 'addition') return 'Outro caminho: decomponha em centenas, dezenas e unidades ou confira pela operação inversa quando houver termo faltante.';
    if (operation === 'subtraction') return 'Outro caminho: complete do menor para o maior ou confira somando a diferença ao subtraendo.';
    if (operation === 'multiplication') return 'Outro caminho: represente em grupos iguais, soma repetida ou use dobros/metades para conferir.';
    if (operation === 'division') return 'Outro caminho: multiplique quociente × divisor e veja se volta ao total, observando o resto.';
    if (operation === 'potenciacao') return 'Outro caminho: escreva a potência como produto repetido e compare com quadrados ou cubos conhecidos.';
    if (operation === 'radiciacao') return 'Outro caminho: eleve a possível resposta ao quadrado ou ao cubo para conferir se retorna ao radicando.';
    return 'Outro caminho: resolva por uma estratégia diferente e compare os dois resultados.';
}

function getPriority3ErrorFocusText(q, selectedValue, isCorrect) {
    if (isCorrect) {
        const learningType = String(q?.learningType || inferStageLearningType(q?.operacao || gameState.currentOperation || '', getPriority3StageLabel(q))).toLowerCase();
        const focus = learningType === 'comprehension'
            ? 'Você acertou entendendo a relação matemática da questão.'
            : 'Você acertou com boa fluência nesta habilidade.';
        return `${focus} Vale conferir qual pista ou estratégia te levou ao acerto.`;
    }
    const diagnosis = getDistractorDiagnosis(q, selectedValue) || null;
    const label = String(diagnosis?.label || classifyTypicalError(q, selectedValue) || '');
    const feedback = String(diagnosis?.feedback || '').trim();
    if (label && feedback) return `${label} ${feedback}`.trim();
    if (label) return label;
    return 'O erro desta questão pede voltar ao passo-chave da habilidade antes de acelerar.';
}

function renderPriority3ComprehensionPanel(q, opts = {}) {
    const panel = ensurePriority3ComprehensionPanel();
    if (!panel) return;
    if (!shouldShowPriority3ComprehensionPanel(q)) {
        panel.classList.add('hidden');
        panel.hidden = true;
        setPriority3ComprehensionExpanded(false);
        return;
    }

    const badge = panel.querySelector('#priority3-comprehension-badge');
    const howEl = panel.querySelector('#priority3-how-think');
    const stratEl = panel.querySelector('#priority3-strategy');
    const errorEl = panel.querySelector('#priority3-error-focus');
    const otherEl = panel.querySelector('#priority3-other-path');
    const phase = String(opts?.phase || 'before');
    const isCorrect = opts?.isCorrect;
    const selectedValue = opts?.selectedValue;

    if (badge) {
        badge.textContent = phase === 'after' ? (isCorrect ? 'Questão resolvida' : 'Revise o raciocínio') : 'Antes de responder';
    }
    if (howEl) howEl.textContent = getPriority3ThinkingText(q);
    if (stratEl) stratEl.textContent = getPriority3StrategyText(q);
    if (errorEl) {
        errorEl.textContent = phase === 'after'
            ? getPriority3ErrorFocusText(q, selectedValue, !!isCorrect)
            : 'Responda para o app apontar o erro mais provável ou o ponto-chave desta habilidade.';
    }
    if (otherEl) otherEl.textContent = getPriority3AlternativePathText(q);

    panel.classList.remove('hidden');
    panel.hidden = false;
    setPriority3ComprehensionExpanded(false);
}

function resetPriority3RoundPedagogy() {
    gameState.roundPedagogy = {
        fluency: { answered: 0, correct: 0 },
        comprehension: { answered: 0, correct: 0 },
        strategyHistogram: {},
        errorHistogram: {},
        lastError: '',
        lastStrategy: ''
    };
}


function resetSessionDiagnostics() {
    gameState.sessionDiagnostics = {
        distractorCodeHistogram: {},
        distractorLabelHistogram: {},
        distractorLabelMap: {},
        typicalErrorHistogram: {},
        errorDimensionHistogram: {},
        lastDistractorCode: '',
        lastDistractorLabel: '',
        lastTypicalError: '',
        lastErrorDimension: ''
    };
}

function ensureSessionDiagnostics() {
    if (!gameState.sessionDiagnostics || typeof gameState.sessionDiagnostics !== 'object') {
        resetSessionDiagnostics();
    }
    return gameState.sessionDiagnostics;
}

function incrementHistogramCounter(mapObj, key) {
    const safe = String(key || '').trim();
    if (!safe || !mapObj || typeof mapObj !== 'object') return;
    mapObj[safe] = Math.max(0, Number(mapObj[safe]) || 0) + 1;
}

function getTopHistogramEntry(mapObj) {
    try {
        const entries = Object.entries(mapObj || {}).sort((a, b) => {
            const diff = (Number(b[1]) || 0) - (Number(a[1]) || 0);
            if (diff !== 0) return diff;
            return String(a[0] || '').localeCompare(String(b[0] || ''), 'pt-BR');
        });
        if (!entries.length) return { key: '', count: 0 };
        return { key: String(entries[0][0] || ''), count: Math.max(0, Number(entries[0][1]) || 0) };
    } catch (_) {
        return { key: '', count: 0 };
    }
}

function formatHistogramSummary(mapObj, limit = 3) {
    try {
        return Object.entries(mapObj || {})
            .sort((a, b) => (Number(b[1]) || 0) - (Number(a[1]) || 0))
            .slice(0, Math.max(1, Number(limit) || 3))
            .map(([key, count]) => `${String(key || '').trim()} (${Math.max(0, Number(count) || 0)})`)
            .filter(Boolean)
            .join(' • ');
    } catch (_) {
        return '';
    }
}

function recordSessionErrorDiagnostic(meta = {}) {
    try {
        const store = ensureSessionDiagnostics();
        const code = String(meta.selectedDistractorCode || '').trim();
        const label = String(meta.selectedDistractorLabel || meta.typicalError || '').trim();
        const typical = String(meta.typicalError || '').trim();
        const dimension = String(meta.errorDimension || '').trim();
        if (code) {
            incrementHistogramCounter(store.distractorCodeHistogram, code);
            store.lastDistractorCode = code;
            if (label) store.distractorLabelMap[code] = label;
        }
        if (label) {
            incrementHistogramCounter(store.distractorLabelHistogram, label);
            store.lastDistractorLabel = label;
        }
        if (typical) {
            incrementHistogramCounter(store.typicalErrorHistogram, typical);
            store.lastTypicalError = typical;
        }
        if (dimension) {
            incrementHistogramCounter(store.errorDimensionHistogram, dimension);
            store.lastErrorDimension = dimension;
        }
    } catch (_) {}
}

function buildSessionDiagnosticsSummary(sessionDiagnostics) {
    try {
        const sd = (sessionDiagnostics && typeof sessionDiagnostics === 'object') ? sessionDiagnostics : {};
        const topCode = getTopHistogramEntry(sd.distractorCodeHistogram || {});
        const topTypical = getTopHistogramEntry(sd.typicalErrorHistogram || {});
        const topDimension = getTopHistogramEntry(sd.errorDimensionHistogram || {});
        const labelMap = (sd.distractorLabelMap && typeof sd.distractorLabelMap === 'object') ? sd.distractorLabelMap : {};
        const topLabel = topCode.key ? String(labelMap[topCode.key] || sd.lastDistractorLabel || '').trim() : '';
        return {
            topDistractorCode: topCode.key,
            topDistractorLabel: topLabel,
            topDistractorCount: topCode.count,
            topTypicalError: topTypical.key,
            topTypicalErrorCount: topTypical.count,
            topErrorDimension: topDimension.key,
            topErrorDimensionCount: topDimension.count,
            distractorCodeSummary: formatHistogramSummary(sd.distractorCodeHistogram || {}),
            typicalErrorSummary: formatHistogramSummary(sd.typicalErrorHistogram || {}),
            errorDimensionSummary: formatHistogramSummary(sd.errorDimensionHistogram || {})
        };
    } catch (_) {
        return {
            topDistractorCode: '',
            topDistractorLabel: '',
            topDistractorCount: 0,
            topTypicalError: '',
            topTypicalErrorCount: 0,
            topErrorDimension: '',
            topErrorDimensionCount: 0,
            distractorCodeSummary: '',
            typicalErrorSummary: '',
            errorDimensionSummary: ''
        };
    }
}

function formatDistractorCodeReportLabel(code, label = '') {
    const safeCode = String(code || '').trim();
    const safeLabel = String(label || '').trim();
    if (safeCode && safeLabel) return `${safeCode} — ${safeLabel}`;
    if (safeCode) return safeCode;
    if (safeLabel) return safeLabel;
    return '';
}

function getMostCommonDistractorInfo(record) {
    try {
        const stats = (record && typeof record.distractorCodes === 'object') ? record.distractorCodes : {};
        const ranked = Object.entries(stats).sort((a, b) => (Number(b[1]) || 0) - (Number(a[1]) || 0));
        if (!ranked.length) return { code: '', label: '', count: 0, formatted: '' };
        const code = String(ranked[0][0] || '').trim();
        const count = Math.max(0, Number(ranked[0][1]) || 0);
        const labelMap = (record && typeof record.distractorLabelMap === 'object') ? record.distractorLabelMap : {};
        const label = String(labelMap[code] || record?.lastDistractorLabel || '').trim();
        return { code, label, count, formatted: formatDistractorCodeReportLabel(code, label) };
    } catch (_) {
        return { code: '', label: '', count: 0, formatted: '' };
    }
}

function getPriority3RoundBucket(q) {
    const raw = String(q?.learningType || inferStageLearningType(q?.operacao || gameState.currentOperation || '', getPriority3StageLabel(q)) || 'fluency').toLowerCase();
    return raw === 'comprehension' ? 'comprehension' : 'fluency';
}

function getPriority3StrategyKey(q) {
    if (q?.strategyFamily) return String(q.strategyFamily);
    const label = getPriority3StageLabel(q);
    return label ? normalizeSkillStageLabel(label).toLowerCase() : String(q?.operacao || gameState.currentOperation || 'questão');
}

function recordPriority3RoundOutcome(q, wasCorrect, selectedValue) {
    try {
        if (!gameState.roundPedagogy) resetPriority3RoundPedagogy();
        const bucket = getPriority3RoundBucket(q);
        const ref = gameState.roundPedagogy[bucket] || { answered: 0, correct: 0 };
        ref.answered = Math.max(0, Number(ref.answered) || 0) + 1;
        ref.correct = Math.max(0, Number(ref.correct) || 0) + (wasCorrect ? 1 : 0);
        gameState.roundPedagogy[bucket] = ref;

        const strategyKey = getPriority3StrategyKey(q);
        if (strategyKey) {
            const current = gameState.roundPedagogy.strategyHistogram[strategyKey] || 0;
            gameState.roundPedagogy.strategyHistogram[strategyKey] = current + 1;
            gameState.roundPedagogy.lastStrategy = strategyKey;
        }

        if (!wasCorrect) {
            const diagnosis = getDistractorDiagnosis(q, selectedValue) || null;
            const err = String(diagnosis?.label || classifyTypicalError(q, selectedValue) || 'Erro de cálculo ou atenção nesta habilidade.').trim();
            gameState.roundPedagogy.errorHistogram[err] = Math.max(0, Number(gameState.roundPedagogy.errorHistogram[err]) || 0) + 1;
            gameState.roundPedagogy.lastError = err;
        }
    } catch (_) {}
}

function getPriority3HistogramTopEntry(mapObj) {
    const entries = Object.entries(mapObj || {}).sort((a, b) => (Number(b[1]) || 0) - (Number(a[1]) || 0));
    return entries.length ? entries[0][0] : '';
}

function prettyPriority3StrategyLabel(key) {
    const map = {
        'missing-term': 'encontrar termo faltante',
        'inverse-relation': 'usar operação inversa',
        'missing-factor': 'encontrar fator faltante',
        'missing-dividend': 'descobrir o dividendo',
        'missing-divisor': 'descobrir o divisor',
        'inverse-power': 'ligar potência à forma expandida',
        'inverse-root': 'ligar raiz à potência inversa'
    };
    return map[key] || String(key || '').replace(/_/g, ' ');
}

function getPriority3RoundSummary() {
    try {
        const p = gameState.roundPedagogy;
        if (!p) return '';
        const flu = p.fluency || { answered: 0, correct: 0 };
        const comp = p.comprehension || { answered: 0, correct: 0 };
        const fluAcc = flu.answered > 0 ? Math.round((flu.correct / flu.answered) * 100) : null;
        const compAcc = comp.answered > 0 ? Math.round((comp.correct / comp.answered) * 100) : null;
        const worst = (fluAcc == null && compAcc == null) ? '' : (compAcc != null && (fluAcc == null || compAcc < fluAcc) ? 'compreensão' : 'fluência');
        const topErr = getPriority3HistogramTopEntry(p.errorHistogram);
        const topStrategy = prettyPriority3StrategyLabel(getPriority3HistogramTopEntry(p.strategyHistogram));
        const parts = [];
        if (topStrategy) parts.push(`Estratégia mais presente na rodada: ${topStrategy}.`);
        if (worst === 'compreensão' && compAcc != null) parts.push(`Seu ponto mais frágil nesta sessão foi compreensão (${compAcc}%). Vale explicar a conta em voz alta ou usar a operação inversa antes de responder.`);
        else if (worst === 'fluência' && fluAcc != null) parts.push(`Seu ponto mais frágil nesta sessão foi fluência (${fluAcc}%). Vale repetir a habilidade com mais calma até automatizar o cálculo.`);
        if (topErr) parts.push(`Erro mais recorrente da rodada: ${topErr}.`);
        return parts.join(' ');
    } catch (_) {
        return '';
    }
}

// --- Prioridade 2: Onboarding (primeiro acesso) ---
function petLevelLabel(level) {
    const map = { apprentice: 'Aprendiz', easy: 'Fácil', medium: 'Médio', advanced: 'Avançado' };
    return map[level] || String(level || '').toUpperCase();
}

function isPetOnboarded() {
    try { return localStorage.getItem(PET_ONBOARD_KEY) === '1'; } catch (_) { return true; }
}

function setPetOnboarded() {
    try { localStorage.setItem(PET_ONBOARD_KEY, '1'); } catch (_) {}
}

function maybeShowOnboardingWizard() {
    try {
        if (isPetOnboarded()) return;

        // Se houver sessão salva (continuar), não interrompe com onboarding agora.
        try {
            const snap = loadSavedPetSession();
            if (snap) return;
        } catch (_) {}

        if (!window.PET_LEVEL1_UI || !PET_LEVEL1_UI.openModal) return;

        const steps = [
            {
                title: 'Bem-vindo(a) ao PET — Tabuada',
                html: `
                  <div class="pet-pill">Em 20 segundos</div>
                  <p>Você vai praticar com foco e acompanhar sua evolução.</p>
                  <ul>
                    <li><strong>Modo Estudo</strong>: ideal para aprender com calma.</li>
                    <li><strong>Modo Rápido</strong>: treina velocidade e consistência.</li>
                    <li>Seu progresso fica salvo neste dispositivo.</li>
                  </ul>
                  <p class="pet-muted">Dica: comece pelo <strong>Modo Estudo</strong> e passe para o Rápido quando estiver consistente.</p>
                `,
                primaryText: 'Próximo',
                secondaryText: ''
            },
            {
                title: 'Como funciona',
                html: `
                  <div class="pet-pill">Regras simples</div>
                  <ul>
                    <li>Você responde questões e acumula <strong>pontos</strong> e <strong>XP</strong>.</li>
                    <li>Errou? Você tem nova tentativa (quando permitido) e aprende com o feedback.</li>
                    <li>No <strong>Modo Rápido</strong>, a velocidade influencia o XP.</li>
                  </ul>
                `,
                primaryText: 'Próximo',
                secondaryText: 'Voltar'
            },
            {
                title: 'Pronto(a) para começar?',
                html: `
                  <div class="pet-pill">Você está no controle</div>
                  <ul>
                    <li>Você pode <strong>continuar</strong> de onde parou (quando houver sessão salva).</li>
                    <li>Você pode <strong>reiniciar</strong> quando quiser (com confirmação).</li>
                  </ul>
                  <p class="pet-muted">Quando terminar uma sessão, você verá um <strong>resumo</strong> para saber exatamente como foi.</p>
                `,
                primaryText: 'Começar',
                secondaryText: 'Voltar'
            }
        ];

        const openStep = (i) => {
            const step = steps[i];
            PET_LEVEL1_UI.openModal({
                title: step.title,
                html: step.html,
                primaryText: step.primaryText,
                secondaryText: step.secondaryText,
                onPrimary: () => {
                    if (i < steps.length - 1) {
                        setTimeout(() => openStep(i + 1), 0);
                    } else {
                        setPetOnboarded();
                        try { PET_LEVEL1_UI.showToast('Tudo certo. Bons estudos!'); } catch (_) {}
                    }
                },
                onSecondary: () => {
                    if (i > 0) setTimeout(() => openStep(i - 1), 0);
                }
            });
        };

        openStep(0);
    } catch (_) {}
}

// --- Prioridade 2: Resumo pós-sessão (modal) ---
function maybeShowSessionSummary(xpGained) {
    try {
        if (gameState.__summaryShown) return;
        if (!window.PET_LEVEL1_UI || !PET_LEVEL1_UI.openModal) return;

        // Evita resumo em modos que não são sessão principal
        if (gameState.isTrainingErrors) return;

        const operationLabel = formatOperationLabel(gameState.currentOperation);
        const levelLabel = petLevelLabel(gameState.currentLevel);
        const modeLabel = gameState.isRapidMode ? 'Modo Rápido' : 'Modo Estudo';

        const hits = Number(gameState.acertos || 0);
        const misses = Number(gameState.erros || 0);
        const attempts = hits + misses;

        const answered = Number(gameState.questionsAnswered || 0) || Number(gameState.questionNumber || 0) || 0;
        const accuracy = attempts > 0 ? Math.round((hits / attempts) * 100) : 0;

        const totalMs = Number(gameState.totalAnswerTimeMs || 0);
        const avgSec = (answered > 0 && totalMs > 0) ? (totalMs / answered / 1000) : null;

        let suggestion = 'Continue praticando para ganhar consistência.';
        if (accuracy < 70 || (misses > hits / 2)) suggestion = 'Sugestão: volte ao <strong>Modo Estudo</strong> para reforçar este conteúdo.';
        if (accuracy >= 85 && answered >= 10) suggestion = 'Sugestão: excelente! Você pode testar o <strong>Modo Rápido</strong> para aumentar a velocidade.';

        // Persiste um resumo simples (futuro: histórico)
        try {
            const payload = {
                at: Date.now(),
                operation: gameState.currentOperation,
                level: gameState.currentLevel,
                mode: gameState.isRapidMode ? 'rapid' : 'study',
                answered,
                hits,
                misses,
                accuracy,
                avgSec: avgSec ? Math.round(avgSec * 10) / 10 : null,
                score: Number(gameState.score || 0),
                xpGained: Number(xpGained || 0)
            };
            profileStorageSetJson(PET_LAST_SUMMARY_KEY, payload);
        } catch (_) {}

        gameState.__summaryShown = true;

        const html = `
          <div class="pet-pill">Resumo da sessão</div>
          <div class="pet-modal-kv"><span>Conteúdo</span><strong>${operationLabel} • ${levelLabel}</strong></div>
          <div class="pet-modal-kv"><span>Modo</span><strong>${modeLabel}</strong></div>
          <div class="pet-modal-kv"><span>Questões</span><strong>${answered}</strong></div>
          <div class="pet-modal-kv"><span>Acertos</span><strong>${hits}</strong></div>
          <div class="pet-modal-kv"><span>Tentativas erradas</span><strong>${misses}</strong></div>
          <div class="pet-modal-kv"><span>Precisão</span><strong>${accuracy}%</strong></div>
          ${avgSec != null ? `<div class="pet-modal-kv"><span>Tempo médio (1ª tentativa)</span><strong>${Math.round(avgSec * 10) / 10}s</strong></div>` : ``}
          
          ${(() => {
              try {
                  const p = loadPetProgress();
                  const s = Number(p.streak || 0);
                  const best = Number(p.bestStreak || 0);
                  return `<div class="pet-summary-streak">🔥 Sequência: <strong>${s}</strong> dia(s) • Recorde: <strong>${best}</strong></div>`;
              } catch (_) { return ''; }
          })()}
          <p class="pet-muted">${suggestion}</p>
        `;

        PET_LEVEL1_UI.openModal({
            title: 'Sua evolução',
            html,
            primaryText: 'Jogar novamente',
            secondaryText: 'Voltar ao início',
            onPrimary: () => {
                try {
                    // Mantém o modo atual (Rápido/Estudo)
                    startGame(gameState.currentOperation, gameState.currentLevel);
                } catch (_) {}
            },
            onSecondary: () => {
                try { exibirTela('home-screen'); } catch (_) {}
            }
        });
    } catch (_) {}
}

// --- Prioridade 3: Sequência + Conquistas ---
function petDateKeyLocal(d = new Date()) {
    try {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    } catch (_) {
        return '1970-01-01';
    }
}

function petAddDaysToKey(key, deltaDays) {
    try {
        const m = String(key || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
        if (!m) return petDateKeyLocal();
        const y = Number(m[1]), mo = Number(m[2]) - 1, da = Number(m[3]);
        const d = new Date(y, mo, da);
        d.setDate(d.getDate() + Number(deltaDays || 0));
        return petDateKeyLocal(d);
    } catch (_) {
        return petDateKeyLocal();
    }
}

function formatDateBR(key) {
    try {
        const m = String(key || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
        if (!m) return '';
        return `${m[3]}/${m[2]}/${m[1]}`;
    } catch (_) { return ''; }
}

function getPetBadgeCatalog() {
    return [
        { id: 'first_session', title: 'Primeira sessão', desc: 'Concluiu sua primeira sessão.' },
        { id: 'streak_3', title: '3 dias seguidos', desc: 'Estudou 3 dias consecutivos.' },
        { id: 'streak_7', title: '7 dias seguidos', desc: 'Manteve uma sequência de 7 dias.' },
        { id: 'streak_14', title: '14 dias seguidos', desc: 'Manteve uma sequência de 14 dias.' },
        { id: 'accuracy_90', title: 'Precisão 90%', desc: 'Concluiu uma sessão com 90%+ de precisão (10+ questões).' },
        { id: 'rapid_90', title: 'Rápido 90%', desc: 'Concluiu no Modo Rápido com 90%+ de precisão (10+ questões).' },
        { id: 'answered_100', title: '100 questões', desc: 'Respondeu 100 questões no total (somando sessões).' },
        { id: 'answered_500', title: '500 questões', desc: 'Respondeu 500 questões no total (somando sessões).' }
    ];
}

function loadPetProgress() {
    const def = {
        version: 1,
        lastStudyDate: null,
        streak: 0,
        bestStreak: 0,
        totalSessions: 0,
        totalAnswered: 0,
        badges: {}
    };
    try {
        const raw = profileStorageGetRaw(PET_PROGRESS_KEY);
        const obj = safeJsonParse(raw, def);
        if (!obj || typeof obj !== 'object') return def;
        const badges = (obj.badges && typeof obj.badges === 'object') ? obj.badges : {};
        return {
            ...def,
            ...obj,
            streak: Number(obj.streak || 0),
            bestStreak: Number(obj.bestStreak || 0),
            totalSessions: Number(obj.totalSessions || 0),
            totalAnswered: Number(obj.totalAnswered || 0),
            badges
        };
    } catch (_) {
        return def;
    }
}

function savePetProgress(p) {
    try {
        profileStorageSetJson(PET_PROGRESS_KEY, { ...p, updatedAt: Date.now() });
    } catch (_) {}
}

function awardPetBadge(p, id) {
    try {
        if (!p.badges) p.badges = {};
        if (p.badges[id]) return false;
        p.badges[id] = Date.now();
        return true;
    } catch (_) {
        return false;
    }
}

// --- Prioridade 6: Histórico de sessões (para relatório CSV) ---
function loadPetSessionHistory() {
    const def = [];
    try {
        const raw = profileStorageGetRaw(PET_SESSION_HISTORY_KEY);
        const arr = safeJsonParse(raw, def);
        return Array.isArray(arr) ? arr : def;
    } catch (_) {
        return def;
    }
}

function savePetSessionHistory(arr) {
    try {
        profileStorageSetJson(PET_SESSION_HISTORY_KEY, Array.isArray(arr) ? arr : []);
    } catch (_) {}
}

function appendPetSessionHistory(entry) {
    try {
        if (!entry || typeof entry !== 'object') return;
        const arr = loadPetSessionHistory();

        // Dedup simples (evita duplicar se o endGame rodar 2x por algum motivo)
        const last = arr && arr.length ? arr[0] : null;
        if (last) {
            const dt = Math.abs(Number(last.endedAt || 0) - Number(entry.endedAt || 0));
            if (dt < 2000 &&
                String(last.operation || '') === String(entry.operation || '') &&
                String(last.level || '') === String(entry.level || '') &&
                String(last.mode || '') === String(entry.mode || '') &&
                Number(last.score || 0) === Number(entry.score || 0)
            ) {
                return;
            }
        }

        arr.unshift(entry);
        if (arr.length > PET_SESSION_HISTORY_MAX) arr.length = PET_SESSION_HISTORY_MAX;
        savePetSessionHistory(arr);
    } catch (_) {}
}

function formatTimeBR(ts) {
    try {
        const d = new Date(Number(ts || 0));
        const hh = String(d.getHours()).padStart(2, '0');
        const mm = String(d.getMinutes()).padStart(2, '0');
        return `${hh}:${mm}`;
    } catch (_) {
        return '';
    }
}

function formatDateBRFromTs(ts) {
    try {
        const d = new Date(Number(ts || 0));
        return formatDateBR(petDateKeyLocal(d));
    } catch (_) {
        return '';
    }
}

function numBR(v, decimals = 1) {
    try {
        if (v == null || v === '') return '';
        const n = Number(v);
        if (!Number.isFinite(n)) return String(v);
        const fixed = (typeof decimals === 'number') ? n.toFixed(decimals) : String(n);
        // troca ponto por vírgula para Excel pt-BR
        return fixed.replace('.', ',');
    } catch (_) {
        return String(v ?? '');
    }
}

function csvEscape(val) {
    const s = (val == null) ? '' : String(val);
    if (/[;"\n\r]/.test(s)) {
        return '"' + s.replace(/"/g, '""') + '"';
    }
    return s;
}

function exportPetSessionHistoryCSVUsingItems(itemsDesc, { filename = null, silent = false } = {}) {
    try {
        if (!itemsDesc || !itemsDesc.length) {
            if (!silent) {
                try { PET_LEVEL1_UI.showToast('Ainda não há sessões registradas para exportar.', { type: 'error', timeout: 3000 }); } catch (_) {}
            }
            return false;
        }

        // Exporta em ordem cronológica (mais antigo -> mais novo)
        const items = itemsDesc.slice().reverse();

        const headers = [
            'data', 'hora', 'tipo',
            'operacao', 'nivel', 'modo', 'submodo', 'etapa', 'habilidade',
            'questoes', 'acertos', 'erros',
            'precisao_pct', 'tempo_medio_s',
            'score', 'xp_ganho', 'xp_bonus',
            'sequencia_dias', 'conquistas',
            'distrator_codigo_topo', 'distrator_rotulo_topo', 'distrator_codigo_topo_qtd',
            'erro_tipico_topo', 'erro_tipico_topo_qtd',
            'dimensao_erro_topo', 'dimensao_erro_topo_qtd',
            'resumo_codigos_distratores', 'resumo_erros_tipicos', 'resumo_dimensoes_erro',
            'turma', 'aluno',
            'perfil_nome', 'perfil_turma', 'perfil_escola',
            'versao_app'
        ];

        const lines = [];
        lines.push(headers.join(';'));

        items.forEach((it) => {
            const row = {
                data: formatDateBRFromTs(it.endedAt),
                hora: formatTimeBR(it.endedAt),
                tipo: it.sessionType || '',
                operacao: it.operationLabel || it.operation || '',
                nivel: it.levelLabel || it.level || '',
                modo: it.modeLabel || it.mode || '',
                submodo: it.submode || '',
                etapa: (it.stageNo ?? ''),
                habilidade: it.stageLabel || '',
                questoes: it.answered ?? '',
                acertos: it.hits ?? '',
                erros: it.misses ?? '',
                precisao_pct: numBR(it.accuracy, 1),
                tempo_medio_s: (it.avgSec == null) ? '' : numBR(it.avgSec, 1),
                score: it.score ?? '',
                xp_ganho: it.xpEarned ?? '',
                xp_bonus: it.xpBonus ?? '',
                sequencia_dias: it.streak ?? '',
                conquistas: it.unlockedTitles || '',
                distrator_codigo_topo: it.topDistractorCode || '',
                distrator_rotulo_topo: it.topDistractorLabel || '',
                distrator_codigo_topo_qtd: it.topDistractorCount ?? '',
                erro_tipico_topo: it.topTypicalError || '',
                erro_tipico_topo_qtd: it.topTypicalErrorCount ?? '',
                dimensao_erro_topo: it.topErrorDimension || '',
                dimensao_erro_topo_qtd: it.topErrorDimensionCount ?? '',
                resumo_codigos_distratores: it.distractorCodeSummary || '',
                resumo_erros_tipicos: it.typicalErrorSummary || '',
                resumo_dimensoes_erro: it.errorDimensionSummary || '',
                turma: (it.className || it.profileTurma || ''),
                aluno: (it.studentName || it.profileName || ''),
                perfil_nome: (it.profileName || ''),
                perfil_turma: (it.profileTurma || ''),
                perfil_escola: (it.profileEscola || ''),
                versao_app: it.appVersion || ''
            };

            const line = headers.map(h => csvEscape(row[h])).join(';');
            lines.push(line);
        });

        // BOM ajuda o Excel a reconhecer UTF-8 (acentos)
        const csv = '\ufeff' + lines.join('\r\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        const today = petDateKeyLocal();
        a.download = filename || `PET_relatorio_sessoes_${today}.csv`;
        document.body.appendChild(a);
        a.click();

        setTimeout(() => {
            try { URL.revokeObjectURL(url); } catch (_) {}
            try { a.remove(); } catch (_) {}
        }, 300);

        if (!silent) {
            try { PET_LEVEL1_UI.showToast('Relatório CSV gerado.', { type: 'success', timeout: 2500 }); } catch (_) {}
        }
        return true;
    } catch (e) {
        if (!silent) {
            try { PET_LEVEL1_UI.showToast('Não foi possível exportar o relatório.', { type: 'error', timeout: 3000 }); } catch (_) {}
        }
        return false;
    }
}

function exportPetSessionHistoryCSV() {
    const itemsDesc = loadAllPetSessionHistory();
    return exportPetSessionHistoryCSVUsingItems(itemsDesc);
}

// --- Área do Professor (Relatório CSV com filtros) ---
function petParseDateInputToStartTs(dateStr) {
    try {
        if (!dateStr) return null;
        const parts = String(dateStr).split('-').map(n => Number(n));
        if (parts.length !== 3) return null;
        const [y, m, d] = parts;
        if (!y || !m || !d) return null;
        return new Date(y, m - 1, d, 0, 0, 0, 0).getTime();
    } catch (_) {
        return null;
    }
}

function petParseDateInputToEndTs(dateStr) {
    try {
        if (!dateStr) return null;
        const parts = String(dateStr).split('-').map(n => Number(n));
        if (parts.length !== 3) return null;
        const [y, m, d] = parts;
        if (!y || !m || !d) return null;
        return new Date(y, m - 1, d, 23, 59, 59, 999).getTime();
    } catch (_) {
        return null;
    }
}

function filterPetSessionHistory(itemsDesc, { operation = 'all', level = 'all', classKey = 'all', studentKey = 'all', startDate = '', endDate = '' } = {}) {
    try {
        const startTs = petParseDateInputToStartTs(startDate);
        const endTs = petParseDateInputToEndTs(endDate);
        const op = String(operation || 'all');
        const lv = String(level || 'all');
        const arr = Array.isArray(itemsDesc) ? itemsDesc : [];

        return arr.filter((it) => {
            const ts = Number(it.endedAt || 0);
            if (startTs != null && ts < startTs) return false;
            if (endTs != null && ts > endTs) return false;
            if (op !== 'all' && String(it.operation || '') !== op) return false;
            if (lv !== 'all' && String(it.level || '') !== lv) return false;

            // Filtros opcionais por Turma/Aluno (offline)
            const ck = String(classKey || 'all');
            const sk = String(studentKey || 'all');

            const itClassName = String(it.className || it.profileTurma || '').trim();
            const itStudentName = String(it.studentName || it.profileName || '').trim();

            if (ck !== 'all') {
                if (ck.startsWith('n:')) {
                    const name = ck.slice(2);
                    if (itClassName !== name) return false;
                } else {
                    // fallback: compara por texto também
                    if (itClassName !== ck) return false;
                }
            }

            if (sk !== 'all') {
                if (sk.startsWith('n:')) {
                    const name = sk.slice(2);
                    if (itStudentName !== name) return false;
                } else {
                    if (itStudentName !== sk) return false;
                }
            }

            return true;
        });
    } catch (_) {
        return Array.isArray(itemsDesc) ? itemsDesc : [];
    }
}


function summarizePetSessions(itemsDesc) {
    const arr = Array.isArray(itemsDesc) ? itemsDesc : [];
    const sum = {
        sessions: arr.length,
        totalAnswered: 0,
        totalHits: 0,
        totalMisses: 0,
        avgAccuracy: null,
        avgSec: null,
        firstTs: null,
        lastTs: null
    };
    if (!arr.length) return sum;

    let accSum = 0;
    let accCount = 0;
    let secSum = 0;
    let secCount = 0;
    let first = null;
    let last = null;

    arr.forEach((it) => {
        const answered = Number(it.answered || 0);
        const hits = Number(it.hits || 0);
        const misses = Number(it.misses || 0);
        const ts = Number(it.endedAt || 0);
        if (Number.isFinite(answered)) sum.totalAnswered += answered;
        if (Number.isFinite(hits)) sum.totalHits += hits;
        if (Number.isFinite(misses)) sum.totalMisses += misses;

        const acc = Number(it.accuracy);
        if (Number.isFinite(acc)) { accSum += acc; accCount += 1; }

        const sec = Number(it.avgSec);
        if (Number.isFinite(sec) && sec > 0) { secSum += sec; secCount += 1; }

        if (Number.isFinite(ts) && ts > 0) {
            if (first == null || ts < first) first = ts;
            if (last == null || ts > last) last = ts;
        }
    });

    sum.avgAccuracy = accCount ? (accSum / accCount) : null;
    sum.avgSec = secCount ? (secSum / secCount) : null;
    sum.firstTs = first;
    sum.lastTs = last;
    return sum;
}

function teacherSkillEntryLabel(it) {
    try {
        const op = String(it.operationLabel || formatOperationLabel(it.operation) || '').trim();
        const lv = String(it.levelLabel || petLevelLabel(it.level) || '').trim();
        const stageNo = Number(it.stageNo || 0);
        const skill = String(it.stageLabel || '').trim() || 'Habilidade sem nome';
        const parts = [];
        if (op) parts.push(op);
        if (lv) parts.push(`Nível ${lv}`);
        if (stageNo > 0) parts.push(`Etapa ${stageNo}`);
        return `${parts.join(' • ')}${parts.length ? ' — ' : ''}${skill}`;
    } catch (_) {
        return String(it?.stageLabel || 'Habilidade sem nome');
    }
}

function getTeacherStudentName(it) {
    const raw = String(it?.studentName || it?.profileName || '').trim();
    return raw;
}

function buildTeacherSkillReport(itemsDesc, { masteryThreshold = 80 } = {}) {
    const arr = Array.isArray(itemsDesc) ? itemsDesc : [];
    const relevant = arr.filter((it) => String(it?.sessionType || '') !== 'treino_erros' && String(it?.stageLabel || '').trim());
    const report = {
        currentSkill: '—',
        lastMastered: '—',
        highestError: '—',
        stabilitySummary: '—',
        skillRows: [],
        stuckGroups: [],
        interventions: [],
        dominantDistractorSummary: '—',
        errorPatternSummary: '—',
        note: 'Baseado nas rodadas da trilha registradas neste dispositivo.'
    };

    if (!relevant.length) {
        report.note = 'Ainda não há sessões de trilha com habilidade registrada neste filtro.';
        return report;
    }

    const sorted = relevant.slice().sort((a, b) => Number(b.endedAt || 0) - Number(a.endedAt || 0));
    const latest = sorted[0];
    report.currentSkill = teacherSkillEntryLabel(latest);

    const latestRecord = getOperationSkillReviewRecord(String(latest.operation || ''), String(latest.level || ''), Math.max(0, Number(latest.stageNo || 1) - 1));
    const latestTraffic = getPedagogicalTrafficLight(latestRecord);
    const latestStability = getSkillStabilityMeta(latestRecord);
    report.currentSkill = `${report.currentSkill} • ${latestTraffic.label}`;
    report.stabilitySummary = latestStability.label;

    const mastered = sorted.find((it) => Number(it.accuracy || 0) >= masteryThreshold);
    if (mastered) {
        report.lastMastered = `${teacherSkillEntryLabel(mastered)} • ${numBR(mastered.accuracy, 1)}%`;
    }

    const skillMap = new Map();
    sorted.forEach((it) => {
        const label = teacherSkillEntryLabel(it);
        const op = String(it.operation || '');
        const lv = String(it.level || '');
        const stageIndex = Math.max(0, Number(it.stageNo || 1) - 1);
        const key = `${op}::${lv}::${stageIndex}::${label}`;
        if (!skillMap.has(key)) {
            skillMap.set(key, {
                key,
                label,
                operation: op,
                level: lv,
                stageIndex,
                sessions: 0,
                answered: 0,
                hits: 0,
                misses: 0,
                students: new Set(),
                lastTs: 0
            });
        }
        const row = skillMap.get(key);
        row.sessions += 1;
        row.answered += Math.max(0, Number(it.answered || 0));
        row.hits += Math.max(0, Number(it.hits || 0));
        row.misses += Math.max(0, Number(it.misses || 0));
        row.lastTs = Math.max(row.lastTs, Number(it.endedAt || 0));
        const student = getTeacherStudentName(it);
        if (student) row.students.add(student);
    });

    const aggregatedTypicalErrors = {};
    const aggregatedDistractorCodes = {};
    const aggregatedDistractorLabelMap = {};

    const rows = Array.from(skillMap.values()).map((row) => {
        const accuracy = row.answered > 0 ? (row.hits / row.answered) * 100 : 0;
        const reviewRecord = getOperationSkillReviewRecord(row.operation, row.level, row.stageIndex);
        const traffic = getPedagogicalTrafficLight(reviewRecord);
        const stability = getSkillStabilityMeta(reviewRecord);
        const commonError = getMostCommonTypicalError(reviewRecord) || 'Sem erro típico dominante';
        const commonDistractor = getMostCommonDistractorInfo(reviewRecord);
        const prerequisite = getSkillPrerequisiteInfo(row.operation, row.label).label;
        const bridgeStats = reviewRecord?.bridgeStats || { asked: 0, correct: 0 };
        if (reviewRecord && reviewRecord.typicalErrors && typeof reviewRecord.typicalErrors === 'object') {
            Object.entries(reviewRecord.typicalErrors).forEach(([errLabel, count]) => {
                const safeLabel = String(errLabel || '').trim();
                if (!safeLabel) return;
                aggregatedTypicalErrors[safeLabel] = Math.max(0, Number(aggregatedTypicalErrors[safeLabel]) || 0) + Math.max(0, Number(count) || 0);
            });
        }
        if (reviewRecord && reviewRecord.distractorCodes && typeof reviewRecord.distractorCodes === 'object') {
            const labelMap = (reviewRecord.distractorLabelMap && typeof reviewRecord.distractorLabelMap === 'object') ? reviewRecord.distractorLabelMap : {};
            Object.entries(reviewRecord.distractorCodes).forEach(([code, count]) => {
                const safeCode = String(code || '').trim();
                if (!safeCode) return;
                aggregatedDistractorCodes[safeCode] = Math.max(0, Number(aggregatedDistractorCodes[safeCode]) || 0) + Math.max(0, Number(count) || 0);
                if (labelMap[safeCode]) aggregatedDistractorLabelMap[safeCode] = String(labelMap[safeCode] || '').trim();
            });
        }
        return {
            label: row.label,
            operation: row.operation,
            level: row.level,
            stageIndex: row.stageIndex,
            sessions: row.sessions,
            accuracy,
            misses: row.misses,
            studentCount: row.students.size,
            lastTs: row.lastTs,
            trafficLabel: traffic.label,
            trafficCode: traffic.code,
            stabilityLabel: stability.label,
            stabilityCode: stability.code,
            commonError,
            commonDistractor: commonDistractor.formatted || 'Sem distrator dominante',
            commonDistractorCode: commonDistractor.code || '',
            prerequisite,
            bridgeAccuracy: Number(bridgeStats.asked || 0) > 0 ? (Number(bridgeStats.correct || 0) / Math.max(1, Number(bridgeStats.asked || 0))) * 100 : null,
            intervention: buildTeacherInterventionPlan({ operation: row.operation, level: row.level, stageIndex: row.stageIndex, stageLabel: row.label, record: reviewRecord, studentNames: Array.from(row.students.values()).sort((a, b) => a.localeCompare(b, 'pt-BR')).slice(0, 3) })
        };
    });

    rows.sort((a, b) => {
        const priority = { red: 0, yellow: 1, green: 2 };
        const pa = priority[a.trafficCode] ?? 9;
        const pb = priority[b.trafficCode] ?? 9;
        if (pa !== pb) return pa - pb;
        if (b.misses !== a.misses) return b.misses - a.misses;
        if (a.accuracy !== b.accuracy) return a.accuracy - b.accuracy;
        return b.lastTs - a.lastTs;
    });

    report.skillRows = rows.slice(0, 8);
    const rankedPatterns = Object.entries(aggregatedTypicalErrors).sort((a, b) => Number(b[1] || 0) - Number(a[1] || 0));
    if (rankedPatterns.length) {
        report.errorPatternSummary = rankedPatterns.slice(0, 3).map(([label, count]) => `${label} (${count})`).join(' • ');
        report.note = `Baseado nas rodadas da trilha registradas neste dispositivo. Padrões de erro mais frequentes no filtro: ${report.errorPatternSummary}.`;
    }
    const rankedDistractors = Object.entries(aggregatedDistractorCodes).sort((a, b) => Number(b[1] || 0) - Number(a[1] || 0));
    if (rankedDistractors.length) {
        const [topCode, topCount] = rankedDistractors[0];
        const topLabel = String(aggregatedDistractorLabelMap[topCode] || '').trim();
        report.dominantDistractorSummary = `${formatDistractorCodeReportLabel(topCode, topLabel)} (${Math.max(0, Number(topCount) || 0)})`;
        report.note = `${report.note} Distrator dominante no filtro: ${report.dominantDistractorSummary}.`.trim();
    }
    if (rows.length) {
        const weak = rows[0];
        report.highestError = `${weak.label} • ${weak.trafficLabel} • ${weak.misses} erro(s) • ${numBR(weak.accuracy, 1)}% • ${weak.commonDistractor}`;
        report.interventions = rows.filter((row) => row.trafficCode !== 'green').slice(0, 4).map((row) => ({
            label: row.label,
            trafficLabel: row.trafficLabel,
            stabilityLabel: row.stabilityLabel,
            prerequisite: row.prerequisite,
            commonError: row.commonError,
            commonDistractor: row.commonDistractor,
            planText: row.intervention?.planText || ''
        }));
    }

    const latestByStudent = new Map();
    sorted.forEach((it) => {
        const name = getTeacherStudentName(it);
        if (!name) return;
        if (!latestByStudent.has(name)) latestByStudent.set(name, it);
    });

    const stuckMap = new Map();
    latestByStudent.forEach((it, name) => {
        const acc = Number(it.accuracy || 0);
        const op = String(it.operation || '');
        const lv = String(it.level || '');
        const stageIndex = Math.max(0, Number(it.stageNo || 1) - 1);
        const reviewRecord = getOperationSkillReviewRecord(op, lv, stageIndex);
        const traffic = getPedagogicalTrafficLight(reviewRecord);
        if (acc >= masteryThreshold && traffic.code === 'green') return;
        const key = `${op}::${lv}::${stageIndex}::${teacherSkillEntryLabel(it)}`;
        if (!stuckMap.has(key)) {
            stuckMap.set(key, {
                label: teacherSkillEntryLabel(it),
                operation: op,
                level: lv,
                stageIndex,
                students: [],
                accuracySum: 0,
                count: 0,
                record: reviewRecord
            });
        }
        const g = stuckMap.get(key);
        g.students.push(name);
        g.accuracySum += Math.max(0, acc);
        g.count += 1;
    });

    report.stuckGroups = Array.from(stuckMap.values()).map((g) => {
        const intervention = buildTeacherInterventionPlan({ operation: g.operation, level: g.level, stageIndex: g.stageIndex, stageLabel: g.label, record: g.record, studentNames: g.students });
        const traffic = getPedagogicalTrafficLight(g.record);
        const stability = getSkillStabilityMeta(g.record);
        return {
            label: g.label,
            students: g.students.sort((a, b) => a.localeCompare(b, 'pt-BR')),
            avgAccuracy: g.count ? (g.accuracySum / g.count) : 0,
            count: g.count,
            trafficLabel: traffic.label,
            stabilityLabel: stability.label,
            prerequisite: intervention.prerequisite,
            commonError: intervention.commonError,
            commonDistractor: getMostCommonDistractorInfo(g.record).formatted || 'Sem distrator dominante',
            planText: intervention.planText
        };
    }).sort((a, b) => {
        if (b.count !== a.count) return b.count - a.count;
        return a.avgAccuracy - b.avgAccuracy;
    }).slice(0, 6);

    if (!report.stuckGroups.length) {
        report.note = 'Nenhum aluno identificado ficou travado abaixo de 80% neste filtro. Se os nomes estiverem vazios, preencha o Perfil do Estudante para enxergar quem travou.';
    }

    return report;
}


function buildPetSubmodeLabel() {
    try {
        if (gameState.currentOperation === 'multiplication' && gameState.multiplication) {
            const m = gameState.multiplication;
            const mMin = Number.isInteger(m.multMin) ? m.multMin : 0;
            const mMax = Number.isInteger(m.multMax) ? m.multMax : 20;

            if (m.mode === 'trail') {
                const tMin = Number.isInteger(m.trailMin) ? m.trailMin : 0;
                const tMax = Number.isInteger(m.trailMax) ? m.trailMax : 20;
                return `Trilha ${tMin}–${tMax} (×${mMin}–${mMax})`;
            }
            if (m.mode === 'direct') {
                const tab = Number.isInteger(m.tabuada) ? m.tabuada : 0;
                return `Direto Tabuada ${tab} (×${mMin}–${mMax})`;
            }
            return '';
        }

        if (gameState.operationTrail && gameState.operationTrail.masteryMode) {
            const t = gameState.operationTrail;
            const stageNo = Number(t.currentStageIndex || 0) + 1;
            const totalStages = Number(t.totalStages || 10) || 10;
            const label = String(t.currentStageLabel || gameState.currentQuestion?.masteryStageLabel || gameState.currentQuestion?.stageLabel || '').trim();
            return label ? `Etapa ${stageNo}/${totalStages} — ${label}` : `Etapa ${stageNo}/${totalStages}`;
        }
        return '';
    } catch (_) {
        return '';
    }
}


function recordPetCompletedSession({ sessionType = 'sessao', upd = null, bonusApplied = 0 } = {}) {
    try {
        const endedAt = Date.now();

        const operation = gameState.currentOperation || '';
        const level = gameState.currentLevel || '';
        const mode = gameState.isRapidMode ? 'rapid' : 'study';

        const hits = Number(gameState.acertos || 0);
        const misses = Number(gameState.erros || 0);
        const attempts = Math.max(1, hits + misses);
        const accuracy = (hits / attempts) * 100;

        const answered = (Number.isFinite(gameState.totalQuestions) && gameState.totalQuestions !== Infinity)
            ? Number(gameState.totalQuestions)
            : Number(gameState.questionNumber || 0);

        const totalMs = Number(gameState.totalAnswerTimeMs || 0);
        const answeredForTime = Number(gameState.questionsAnswered || 0);
        const avgSec = (answeredForTime > 0 && totalMs > 0) ? (totalMs / answeredForTime / 1000) : null;

        // XP: como o bônus entra em xpGainedRound, separamos aqui
        const xpRoundTotal = Math.round(Number(gameState.xpGainedRound || 0));
        const xpBonus = Math.round(Number(bonusApplied || 0));
        const xpEarned = Math.max(0, xpRoundTotal - xpBonus);

        let streak = 0;
        let unlockedTitles = '';
        try {
            const p = (upd && upd.progress) ? upd.progress : loadPetProgress();
            streak = Number(p.streak || 0);
        } catch (_) {}

        try {
            const ids = (upd && Array.isArray(upd.newlyUnlocked)) ? upd.newlyUnlocked : [];
            if (ids.length) {
                const cat = getPetBadgeCatalog();
                unlockedTitles = ids
                    .map(id => (cat.find(b => b.id === id)?.title) || id)
                    .join(' | ');
            }
        } catch (_) {}

        const activeSkillLabel = String(
            gameState.operationTrail?.currentStageLabel ||
            gameState.currentQuestion?.masteryStageLabel ||
            gameState.currentQuestion?.stageLabel || ''
        ).trim();
        const activeSkillStage = (gameState.operationTrail && gameState.operationTrail.masteryMode)
            ? (Number(gameState.operationTrail.currentStageIndex || 0) + 1)
            : null;

        const diagSummary = buildSessionDiagnosticsSummary(gameState.sessionDiagnostics);

        const entry = {
            id: `${endedAt}-${Math.random().toString(16).slice(2)}`,
            endedAt,
            dateKey: petDateKeyLocal(new Date(endedAt)),
            sessionType: String(sessionType || 'sessao'),
            operation,
            operationLabel: formatOperationLabel(operation),
            level,
            levelLabel: petLevelLabel(level),
            mode,
            modeLabel: gameState.isRapidMode ? 'Modo Rápido' : 'Modo Estudo',
            submode: buildPetSubmodeLabel(),
            stageNo: activeSkillStage,
            stageLabel: activeSkillLabel,
            answered,
            hits,
            misses,
            accuracy: Math.round(accuracy * 10) / 10,
            avgSec: (avgSec == null) ? null : (Math.round(avgSec * 10) / 10),
            score: Math.round(Number(gameState.score || 0)),
            xpEarned,
            xpBonus,
            streak,
            unlockedTitles,
            topDistractorCode: diagSummary.topDistractorCode || '',
            topDistractorLabel: diagSummary.topDistractorLabel || '',
            topDistractorCount: Math.max(0, Number(diagSummary.topDistractorCount) || 0),
            topTypicalError: diagSummary.topTypicalError || '',
            topTypicalErrorCount: Math.max(0, Number(diagSummary.topTypicalErrorCount) || 0),
            topErrorDimension: diagSummary.topErrorDimension || '',
            topErrorDimensionCount: Math.max(0, Number(diagSummary.topErrorDimensionCount) || 0),
            distractorCodeSummary: diagSummary.distractorCodeSummary || '',
            typicalErrorSummary: diagSummary.typicalErrorSummary || '',
            errorDimensionSummary: diagSummary.errorDimensionSummary || '',
            profileName: (getStudentProfile()?.name || ''),
            profileTurma: (getStudentProfile()?.turma || ''),
            profileEscola: (getStudentProfile()?.escola || ''),
            appVersion: (document.body.getAttribute('data-version') || '')
        };

        appendPetSessionHistory(entry);
    } catch (_) {}
}

function updatePetProgressOnSessionEnd({ answered = 0, accuracy = 0, mode = 'study' } = {}) {
    const p = loadPetProgress();
    const today = petDateKeyLocal();
    const yesterday = petAddDaysToKey(today, -1);

    const last = p.lastStudyDate;
    let streakChanged = false;

    if (last === today) {
        // mesma data: não mexe no streak
    } else if (last === yesterday) {
        p.streak = Math.max(1, Number(p.streak || 0) + 1);
        streakChanged = true;
    } else {
        p.streak = 1;
        streakChanged = true;
    }

    p.lastStudyDate = today;
    p.bestStreak = Math.max(Number(p.bestStreak || 0), Number(p.streak || 0));
    p.totalSessions = Number(p.totalSessions || 0) + 1;
    p.totalAnswered = Number(p.totalAnswered || 0) + Math.max(0, Number(answered || 0));

    const newlyUnlocked = [];

    // Conquistas
    if (awardPetBadge(p, 'first_session')) newlyUnlocked.push('first_session');
    if (p.streak >= 3 && awardPetBadge(p, 'streak_3')) newlyUnlocked.push('streak_3');
    if (p.streak >= 7 && awardPetBadge(p, 'streak_7')) newlyUnlocked.push('streak_7');
    if (p.streak >= 14 && awardPetBadge(p, 'streak_14')) newlyUnlocked.push('streak_14');

    if (Number(accuracy) >= 90 && Number(answered) >= 10 && awardPetBadge(p, 'accuracy_90')) newlyUnlocked.push('accuracy_90');
    if (String(mode) === 'rapid' && Number(accuracy) >= 90 && Number(answered) >= 10 && awardPetBadge(p, 'rapid_90')) newlyUnlocked.push('rapid_90');

    if (p.totalAnswered >= 100 && awardPetBadge(p, 'answered_100')) newlyUnlocked.push('answered_100');
    if (p.totalAnswered >= 500 && awardPetBadge(p, 'answered_500')) newlyUnlocked.push('answered_500');

    // Recompensa de sequência (XP bônus em marcos: 3/7/14 dias)
    let streakReward = { xp: 0, label: '' };
    try {
        if (streakChanged) {
            // Bônus configurável (mude os valores em PET_STREAK_REWARD_RULES)
            streakReward = getPetStreakRewardForStreak(p.streak);
        }
    } catch (_) {}

    savePetProgress(p);

    // Atualiza UI (Home) se existir
    try { refreshPetProgressMini(); } catch (_) {}

    return { progress: p, newlyUnlocked, streakChanged, streakReward };
}



// --- Prioridade 3+: Recompensa de sequência (XP) + Medalhas na tela de Resultado ---
function refreshResultScreenXPSummary() {
    try {
        const gained = Number(gameState.xpGainedRound) || 0;
        const elG = document.getElementById('xp-gained');
        const elT = document.getElementById('xp-total');
        if (elG) elG.textContent = `+${gained}`;
        if (elT) elT.textContent = String(gameState.xp ?? 0);
    } catch (_) {}
}

function grantPetBonusXP(amount) {
    const a = Math.round(Number(amount) || 0);
    if (!a) return 0;

    try {
        // Atualiza XP total (salva no localStorage) usando a função existente
        atualizarXP(a);
    } catch (_) {
        // Fallback: mantém o app funcionando mesmo se atualizarXP falhar
        try {
            gameState.xp = (Number(gameState.xp) || 0) + a;
            profileStorageSetText('matemagica_xp', String(gameState.xp));
        } catch (__) {}
    }

    // Atualiza o “XP ganho na rodada” mesmo se o jogo já tiver sido finalizado
    try {
        gameState.xpGainedRound = (Number(gameState.xpGainedRound) || 0) + a;
    } catch (_) {}

    // Reflete na UI de resultado (se já estiver no DOM)
    try { refreshResultScreenXPSummary(); } catch (_) {}

    return a;
}

function applyPetStreakRewardIfAny(upd) {
    try {
        if (!upd || typeof upd !== 'object') return 0;
        if (gameState.__petStreakRewardApplied) return 0;

        const rewardXP = Number(upd.streakReward?.xp || 0);
        if (!rewardXP) return 0;

        gameState.__petStreakRewardApplied = true;
        return grantPetBonusXP(rewardXP);
    } catch (_) {
        return 0;
    }
}

function ensurePetSessionRewardsContainer() {
    try {
        const resultScreen = document.getElementById('result-screen');
        if (!resultScreen) return null;

        if (document.getElementById('pet-session-rewards')) {
            return document.getElementById('pet-session-rewards');
        }

        const summaryCard = resultScreen.querySelector('.info-card.result-summary') || resultScreen.querySelector('.result-summary') || resultScreen;
        if (!summaryCard) return null;

        const wrap = document.createElement('div');
        wrap.id = 'pet-session-rewards';
        wrap.className = 'pet-session-rewards hidden';
        wrap.setAttribute('aria-live', 'polite');

        const xpSummary = summaryCard.querySelector('.xp-summary');
        if (xpSummary) xpSummary.insertAdjacentElement('afterend', wrap);
        else summaryCard.appendChild(wrap);

        return wrap;
    } catch (_) {
        return null;
    }
}

function renderPetSessionRewardsOnResultScreen() {
    try {
        const wrap = ensurePetSessionRewardsContainer();
        if (!wrap) return;

        const upd = gameState.__petProgressUpdate;
        if (!upd || typeof upd !== 'object') {
            wrap.classList.add('hidden');
            return;
        }

        const rewardXP = Number(upd.streakReward?.xp || 0);
        const streakNow = Number(upd.progress?.streak || 0);
        const unlocked = Array.isArray(upd.newlyUnlocked) ? upd.newlyUnlocked.slice() : [];

        if (!rewardXP && unlocked.length === 0) {
            wrap.classList.add('hidden');
            return;
        }

        const catalog = getPetBadgeCatalog();
        const chips = unlocked.slice(0, 4).map((id) => {
            const title = (catalog.find(b => b.id === id)?.title) || id;
            return `<span class="pet-badge-chip pet-badge-chip-new">🎖 ${diagEscapeHtml(title)}</span>`;
        }).join('');

        const extra = unlocked.length > 4
            ? `<span class="pet-badge-chip">+${unlocked.length - 4}</span>`
            : '';

        wrap.innerHTML = `
          <div class="pet-session-rewards-title">Nesta sessão</div>
          <div class="pet-reward-row">
            <span class="pet-pill-chip">🔥 Sequência: ${streakNow} dia${streakNow === 1 ? '' : 's'}</span>
            ${rewardXP ? `<span class="pet-pill-chip">🎁 Bônus: +${rewardXP} XP</span>` : ``}
          </div>
          ${unlocked.length ? `
            <div class="pet-session-rewards-subtitle">Conquistas</div>
            <div class="pet-unlocked-now"><span class="pet-unlocked-now-tag">✅ Desbloqueado agora</span></div>
            <div class="pet-badge-chips">
              ${chips}${extra}
            </div>
            <div class="pet-session-muted">Veja tudo em “Conquistas” na Home.</div>
          ` : ``}
        `;

        wrap.classList.remove('hidden');
    } catch (_) {}
}


// UI (Home): chip de sequência + botão de conquistas
let __petAchievementsLastOpenAt = 0;
function openPetAchievementsModalSafe(ev = null) {
    const now = Date.now();
    if (now - __petAchievementsLastOpenAt < 600) {
        if (ev) { try { ev.preventDefault(); } catch (_) {} try { ev.stopPropagation(); } catch (_) {} }
        return false;
    }
    __petAchievementsLastOpenAt = now;
    if (ev) { try { ev.preventDefault(); } catch (_) {} try { ev.stopPropagation(); } catch (_) {} }
    try {
        openPetAchievementsFallbackModal();
    } catch (_) {
        try { openPetAchievementsModal(); } catch (_) {
            try { alert('Conquistas indisponíveis no momento.'); } catch (_) {}
        }
    }
    return false;
}

function ensurePetProgressMini() {
    const home = document.getElementById('home-screen');
    if (!home) return;

    let wrap = document.getElementById('pet-progress-mini');
    let chip = document.getElementById('pet-streak-chip');
    let btn = document.getElementById('btn-pet-achievements');

    if (!wrap) {
        const rankingBtn = document.getElementById('btn-show-ranking');
        if (!rankingBtn) return;

        wrap = document.createElement('div');
        wrap.className = 'pet-progress-mini';
        wrap.id = 'pet-progress-mini';

        chip = document.createElement('div');
        chip.className = 'pet-streak-chip';
        chip.id = 'pet-streak-chip';
        chip.setAttribute('role', 'status');
        chip.textContent = '🔥 Sequência: 0 dias';

        btn = document.createElement('button');
        btn.type = 'button';
        btn.id = 'btn-pet-achievements';
        btn.className = 'btn-secondary main-btn';
        btn.setAttribute('aria-label', 'Abrir conquistas');
        btn.textContent = '🎖 Conquistas';

        wrap.appendChild(chip);
        wrap.appendChild(btn);
        const newGameBtn = document.getElementById('btn-new-game');
        if (newGameBtn) newGameBtn.insertAdjacentElement('afterend', wrap);
        else rankingBtn.insertAdjacentElement('afterend', wrap);
    }

    if (btn) {
        btn.type = 'button';
        btn.disabled = false;
        btn.setAttribute('aria-disabled', 'false');
        btn.setAttribute('tabindex', '0');
        try { btn.style.setProperty('pointer-events', 'auto', 'important'); } catch (_) {}
        try { btn.style.setProperty('cursor', 'pointer'); } catch (_) {}
        try { btn.style.setProperty('z-index', '80', 'important'); } catch (_) {}
        try { btn.style.setProperty('touch-action', 'manipulation'); } catch (_) {}
    }

    bindReliableHomeButtons();
    refreshPetProgressMini();
}

function refreshPetProgressMini() {
    const chip = document.getElementById('pet-streak-chip');
    if (!chip) return;

    const p = loadPetProgress();
    const s = Number(p.streak || 0);

    chip.textContent = `🔥 Sequência: ${s} dia${s === 1 ? '' : 's'}`;
    chip.title = `Recorde: ${Number(p.bestStreak || 0)} dia(s) • Sessões: ${Number(p.totalSessions || 0)} • Questões: ${Number(p.totalAnswered || 0)}`;
}

// Home global capture desativado para evitar cliques duplicados.
try { window.openPetAchievementsModal = openPetAchievementsModalSafe; } catch (_) {}

function openPetAchievementsFallbackModal() {
    try {
        const p = loadPetProgress();
        const catalog = getPetBadgeCatalog();
        const root = document.getElementById('modal-root');
        if (!root) {
            try { alert('Conquistas indisponíveis no momento.'); } catch (_) {}
            return;
        }
        const badgesHtml = catalog.map((b) => {
            const unlocked = !!(p.badges && p.badges[b.id]);
            const when = unlocked ? formatDateBR(petDateKeyLocal(new Date(Number(p.badges[b.id])))) : '';
            return `
              <div class="pet-badge-card ${unlocked ? 'is-unlocked' : 'is-locked'}">
                <div class="pet-badge-emoji">${b.icon}</div>
                <div class="pet-badge-title">${b.title}</div>
                <div class="pet-badge-desc">${b.desc}</div>
                <div class="pet-badge-status">${unlocked ? `Desbloqueada em ${when}` : 'Ainda bloqueada'}</div>
              </div>`;
        }).join('');
        root.innerHTML = `
          <div class="modal" role="dialog" aria-modal="true" aria-label="Conquistas">
            <h2>🎖 Conquistas</h2>
            <div class="modal-scroll-tip">↕ Role a tela para subir ou descer dentro deste painel.</div>
            <p>Sequência atual: <strong>${Number(p.streak || 0)}</strong> dia(s) • Melhor sequência: <strong>${Number(p.bestStreak || 0)}</strong></p>
            <div class="pet-badge-grid">${badgesHtml}</div>
            <div class="modal-actions">
              <button type="button" class="btn-primary" id="btn-close-achievements-fallback">Fechar</button>
            </div>
          </div>`;
        root.classList.remove('hidden');
        root.setAttribute('aria-hidden', 'false');
        const close = () => {
            try { root.classList.add('hidden'); } catch (_) {}
            try { root.setAttribute('aria-hidden', 'true'); } catch (_) {}
            try { root.innerHTML = ''; } catch (_) {}
        };
        root.addEventListener('click', (ev) => {
            const closeBtn = ev.target && ev.target.closest ? ev.target.closest('#btn-close-achievements-fallback') : null;
            if (closeBtn || ev.target === root) close();
        }, { once: true });
    } catch (_) {
        try { alert('Conquistas indisponíveis no momento.'); } catch (_) {}
    }
}

function openPetAchievementsModal() {
    if (!window.PET_LEVEL1_UI || !PET_LEVEL1_UI.openModal) {
        openPetAchievementsFallbackModal();
        return;
    }

    const p = loadPetProgress();
    const catalog = getPetBadgeCatalog();

    const badgesHtml = catalog.map(b => {
        const unlocked = !!(p.badges && p.badges[b.id]);
        const when = unlocked ? formatDateBR(petDateKeyLocal(new Date(Number(p.badges[b.id])))) : '';
        return `
          <div class="pet-badge ${unlocked ? 'unlocked' : 'locked'}">
            <div class="pet-badge-title">${unlocked ? '✅' : '🔒'} ${b.title}</div>
            <div class="pet-badge-desc">${b.desc}${unlocked && when ? ` <span class="pet-badge-when">(desde ${when})</span>` : ''}</div>
          </div>
        `;
    }).join('');

    const html = `
      <div class="modal-scroll-tip">↕ Role a tela para subir ou descer dentro deste painel.</div>
      <div class="pet-pill">Progresso</div>
      <div class="pet-modal-kv"><span>Sequência atual</span><strong>${Number(p.streak || 0)} dia(s)</strong></div>
      <div class="pet-modal-kv"><span>Recorde</span><strong>${Number(p.bestStreak || 0)} dia(s)</strong></div>
      <div class="pet-modal-kv"><span>Sessões concluídas</span><strong>${Number(p.totalSessions || 0)}</strong></div>
      <div class="pet-modal-kv"><span>Questões respondidas</span><strong>${Number(p.totalAnswered || 0)}</strong></div>
      <div class="pet-modal-kv"><span>Último estudo</span><strong>${p.lastStudyDate ? formatDateBR(p.lastStudyDate) : '—'}</strong></div>

      <div class="pet-divider"></div>
      <div class="pet-pill">Conquistas</div>
      <div class="pet-badge-grid">
        ${badgesHtml}
      </div>
      <p class="pet-muted">As conquistas ficam salvas neste dispositivo.</p>
    `;

    PET_LEVEL1_UI.openModal({
        title: 'Sequência & Conquistas',
        html,
        primaryText: 'Fechar',
        secondaryText: '📄 Exportar CSV',
        onPrimary: () => {},
        onSecondary: () => {
            try { exportPetSessionHistoryCSV(); } catch (_) {}
        }
    });
}


function formatLevelLabel(level) {
    const map = { apprentice: 'Aprendiz', easy: 'Fácil', medium: 'Médio', advanced: 'Difícil' };
    return map[level] || String(level || '').toUpperCase();
}

function applyGameModeUIForResume() {
    const timeContainer = timeBar && timeBar.parentElement;
    if (!timeContainer) return;

    if (!gameState.isRapidMode) {
        timeContainer.style.display = 'none';
        if (btnExtendTime) btnExtendTime.style.display = 'none';
        if (btnShowAnswer) btnShowAnswer.style.display = 'block';
    } else {
        timeContainer.style.display = 'block';
        if (btnExtendTime) btnExtendTime.style.display = 'block';
        if (btnShowAnswer) btnShowAnswer.style.display = 'block';
        try {
            const pct = (Number(gameState.timeLeft) / Number(gameState.maxTime)) * 100;
            timeBar.style.width = `${Math.max(0, Math.min(100, pct))}%`;
        } catch (_) {}
    }
}

function resumePetSessionFromSnapshot(snap) {
    if (!snap) return false;

    // Estado base
    gameState.currentOperation = snap.operation;
    gameState.currentLevel = snap.level;
    gameState.isRapidMode = !!snap.isRapidMode;
    gameState.isGameActive = true;
    gameState.score = Number(snap.score || 0);
    gameState.questionNumber = Math.max(1, Number(snap.questionNumber || 1));
    gameState.totalQuestions = Number.isFinite(snap.totalQuestions) ? Number(snap.totalQuestions) : (gameState.isRapidMode ? 20 : Infinity);
    gameState.acertos = Number(snap.acertos || 0);
    gameState.erros = Number(snap.erros || 0);
    gameState.maxTime = Number.isFinite(snap.maxTime) ? Number(snap.maxTime) : gameState.maxTime;
    gameState.timeLeft = Number.isFinite(snap.timeLeft) ? Number(snap.timeLeft) : gameState.maxTime;
    gameState.lowTimeAlerted = false;
    gameState.sessionDiagnostics = (snap.sessionDiagnostics && typeof snap.sessionDiagnostics === 'object')
        ? JSON.parse(JSON.stringify(snap.sessionDiagnostics))
        : null;
    ensureSessionDiagnostics();

    // Multiplicação: reaplica configuração básica (o progresso detalhado já é persistido em outras chaves)
    if (snap.mult && gameState.multiplication) {
        try {
            gameState.multiplication.mode = snap.mult.mode || gameState.multiplication.mode;
            gameState.multiplication.tabuada = Number.isInteger(snap.mult.tabuada) ? snap.mult.tabuada : gameState.multiplication.tabuada;
            gameState.multiplication.trailMin = Number.isInteger(snap.mult.trailMin) ? snap.mult.trailMin : gameState.multiplication.trailMin;
            gameState.multiplication.trailMax = Number.isInteger(snap.mult.trailMax) ? snap.mult.trailMax : gameState.multiplication.trailMax;
            gameState.multiplication.multMin = Number.isInteger(snap.mult.multMin) ? snap.mult.multMin : gameState.multiplication.multMin;
            gameState.multiplication.multMax = Number.isInteger(snap.mult.multMax) ? snap.mult.multMax : gameState.multiplication.multMax;
            if (typeof snap.mult.trailRangeKey === 'string') gameState.multiplication.trailRangeKey = snap.mult.trailRangeKey;
            if (Number.isInteger(snap.mult.trailPairIndex)) gameState.multiplication.trailPairIndex = snap.mult.trailPairIndex;
            saveMultiplicationConfig();
        } catch (_) {}
    }

    // UI: modo
    try {
        if (modeRapidoBtn && modeEstudoBtn) {
            modeRapidoBtn.classList.toggle('active', !!gameState.isRapidMode);
            modeEstudoBtn.classList.toggle('active', !gameState.isRapidMode);
        }
    } catch (_) {}

    applyGameModeUIForResume();

    // Questão atual
    if (snap.opTrail && (gameState.currentOperation !== 'multiplication' || !!(snap.opTrail && snap.opTrail.masteryMode))) {
        gameState.operationTrail = {
            operation: snap.opTrail.operation || gameState.currentOperation,
            level: snap.opTrail.level || gameState.currentLevel,
            key: snap.opTrail.key || getOperationTrailKey(gameState.currentOperation, gameState.currentLevel),
            startIndex: Number(snap.opTrail.startIndex || 0),
            bankSize: Number(snap.opTrail.bankSize || 0),
            totalStages: Number(snap.opTrail.totalStages || 10),
            masteryMode: !!snap.opTrail.masteryMode,
            currentStageIndex: Number(snap.opTrail.currentStageIndex || 0),
            currentStageAsked: Number(snap.opTrail.currentStageAsked || 0),
            currentStageCorrect: Number(snap.opTrail.currentStageCorrect || 0),
            stageTarget: Number(snap.opTrail.stageTarget || 0),
            targetAccuracy: Number(snap.opTrail.targetAccuracy || 0),
            reviewEvery: Number(snap.opTrail.reviewEvery || 0),
            reviewAsked: Number(snap.opTrail.reviewAsked || 0),
            lastQuestionWasReview: !!snap.opTrail.lastQuestionWasReview,
            currentStageLabel: String(snap.opTrail.currentStageLabel || ''),
            supportMode: String(snap.opTrail.supportMode || 'normal'),
            supportEscalations: Number(snap.opTrail.supportEscalations || 0),
            supportHint: String(snap.opTrail.supportHint || ''),
            consolidationMode: !!snap.opTrail.consolidationMode,
            consolidation: snap.opTrail.consolidation ? JSON.parse(JSON.stringify(snap.opTrail.consolidation)) : null,
            stageType: String(snap.opTrail.stageType || 'fluency')
        };
    }

    const q = snap.currentQuestion;
    gameState.currentQuestion = {
        question: String(q.question || ''),
        voiceQuestion: String(q.voiceQuestion || q.question || ''),
        answer: Number(q.answer || 0),
        options: Array.isArray(q.options) ? q.options.slice(0, 4) : [],
        operacao: q.operacao || gameState.currentOperation,
        num1: (q.num1 ?? null),
        num2: (q.num2 ?? null),
        stageLabel: String(q.stageLabel || ''),
        stageIndex: (q.stageIndex ?? null),
        absoluteTrailIndex: (q.absoluteTrailIndex ?? null),
        bankSize: (q.bankSize ?? null),
        isReview: !!q.isReview,
        sourceStageIndex: (q.sourceStageIndex ?? null),
        sourceStageLabel: String(q.sourceStageLabel || ''),
        masteryStageIndex: (q.masteryStageIndex ?? null),
        masteryStageLabel: String(q.masteryStageLabel || '')
    };

    // Cabeçalho do jogo
    if (playerScoreElement) playerScoreElement.textContent = `${gameState.score} Pontos`;

    // Contador
    const isTabuadaRound = (gameState.currentOperation === 'multiplication' && gameState.multiplication && (gameState.multiplication.mode === 'direct' || gameState.multiplication.mode === 'trail'));
    const isStructuredTrailRound = !!(gameState.operationTrail && gameState.operationTrail.bankSize > 0);
    const totalDisplay = (gameState.isRapidMode || isTabuadaRound || isStructuredTrailRound) ? gameState.totalQuestions : '∞';
    if (questionCounter) questionCounter.textContent = buildQuestionCounterLabel();
    if (questionText) questionText.textContent = gameState.currentQuestion.question;
    updateAdaptiveSupportPanel();
    try {
        // Anúncio curto para leitor de tela (as opções ficam nos botões)
        announceSR(`Questão ${gameState.questionNumber} de ${totalDisplay}. ${gameState.currentQuestion.question}`);
    } catch (_) {}

    // Opções
    answerOptions.forEach((btn, index) => {
        let idxSpan = btn.querySelector('.answer-index');
        const txtSpan = btn.querySelector('.answer-text');
        if (!idxSpan) {
            idxSpan = document.createElement('span');
            idxSpan.className = 'answer-index';
            btn.insertBefore(idxSpan, txtSpan);
        }
        idxSpan.textContent = `${index + 1})`;
        const optVal = String(gameState.currentQuestion.options[index] ?? '');
        if (txtSpan) txtSpan.textContent = optVal;
        try { btn.setAttribute('aria-label', `Opção ${index + 1}: ${optVal}`); } catch (_) {}
        btn.classList.remove('correct', 'wrong');
        btn.disabled = false;
    });
    clearAnswerFocus();

    // Entra no jogo
    exibirTela('game-screen');
    gameState.lastSkillMicroExplanationKey = '';
    try { scheduleSkillMicroExplanation(true); } catch (_) {}
    try { updateCycleProgressUI(); } catch (_) {}
    try { updateMentorForCurrentQuestion(); } catch (_) {}
    try { announceCurrentQuestion(); } catch (_) {}

    if (gameState.isRapidMode) {
        stopTimer();
        startTimer();
    } else {
        stopTimer();
    }

    // Persiste imediatamente
    savePetSessionSnapshotNow();
    return true;
}


function clearAllPetGameData({ preserveSettings = true } = {}) {
    try {
        clearScopedProfileData(gameState.activeProfileId, PROFILE_RESETTABLE_KEYS);
        if (!preserveSettings) {
            [
                PET_ONBOARD_KEY,
                PET_STORAGE_VERSION_KEY,
                'pet_theme',
                'pet_layout',
                UI_SCALE_KEY,
                UI_CONTRAST_KEY,
                UI_DYSLEXIA_KEY,
                UI_CALM_KEY,
                UI_EXTRA_TIME_KEY,
                UI_VIBRATE_KEY
            ].forEach((key) => {
                try { localStorage.removeItem(key); } catch (_) {}
            });
        }
    } catch (_) {}
}


function ensureContinueSessionButton() {
    const home = document.getElementById('home-screen');
    if (!home) return;

    const anchor = document.getElementById('btn-show-ranking');
    if (!anchor) return;

    let continueBtn = document.getElementById('btn-continue-session');
    if (!continueBtn) {
        continueBtn = document.createElement('button');
        continueBtn.type = 'button';
        continueBtn.id = 'btn-continue-session';
        continueBtn.className = 'main-btn';
        continueBtn.textContent = '▶ Continuar';
        anchor.insertAdjacentElement('afterend', continueBtn);
    }

    let newGameBtn = document.getElementById('btn-new-game');
    if (!newGameBtn) {
        newGameBtn = document.createElement('button');
        newGameBtn.type = 'button';
        newGameBtn.id = 'btn-new-game';
        newGameBtn.className = 'main-btn';
        newGameBtn.textContent = '🆕 Novo Jogo';
        continueBtn.insertAdjacentElement('afterend', newGameBtn);
    }

    const continueNow = () => {
        const snap = loadSavedPetSession();
        if (!snap) {
            refreshContinueSessionButtonVisibility();
            try { PET_LEVEL1_UI.showToast('Nenhum andamento salvo no perfil atual.', { type: 'info', timeout: 2600 }); } catch (_) {}
            return;
        }
        resumePetSessionFromSnapshot(snap);
    };

    const confirmNewGame = () => {
        const runReset = () => {
            try { stopTimer(); } catch (_) {}
            try { gameState.isGameActive = false; } catch (_) {}
            try { clearSavedPetSession(); } catch (_) {}
            clearAllPetGameData({ preserveSettings: true });
            try { refreshContinueSessionButtonVisibility(); } catch (_) {}
            try { refreshPetProgressMini(); } catch (_) {}
            try { showFeedbackMessage('Novo jogo iniciado. Dados do progresso foram apagados do perfil atual.', 'info', 2400); } catch (_) {}
            setTimeout(() => {
                try { window.location.reload(); } catch (_) { exibirTela('home-screen'); }
            }, 350);
        };

        if (window.PET_LEVEL1_UI && PET_LEVEL1_UI.openModal) {
            PET_LEVEL1_UI.openModal({
                title: 'Novo jogo',
                html: `<p>Isso vai apagar o andamento salvo, XP, conquistas, histórico, ranking e progresso do perfil atual.</p><p style="margin-top:8px;"><strong>Deseja começar do zero?</strong></p>`,
                primaryText: 'Apagar e começar',
                secondaryText: 'Cancelar',
                onPrimary: runReset
            });
            return;
        }

        if (confirm('Isso vai apagar os dados salvos do perfil atual e começar do zero. Continuar?')) runReset();
    };

    continueBtn.disabled = false;
    continueBtn.setAttribute('aria-disabled', 'false');
    newGameBtn.disabled = false;
    newGameBtn.setAttribute('aria-disabled', 'false');
    bindReliableHomeButtons();
}

function refreshContinueSessionButtonVisibility() {
    const btn = document.getElementById('btn-continue-session');
    if (!btn) return;
    const snap = loadSavedPetSession();
    btn.style.display = 'block';
    btn.disabled = false;
    btn.textContent = '▶ Continuar';
    btn.title = snap ? 'Retomar o andamento salvo do perfil atual.' : 'Nenhum andamento salvo no perfil atual. Toque para verificar.';
    btn.setAttribute('aria-disabled', 'false');
    try { btn.style.setProperty('pointer-events', 'auto', 'important'); } catch (_) {}
    try { btn.style.setProperty('cursor', 'pointer'); } catch (_) {}
}

function petContinueNow(ev = null) {
    try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
    const snap = loadSavedPetSession();
    if (!snap) {
        const now = Date.now();
        if (!window.__petNoSaveToastAt || (now - window.__petNoSaveToastAt) > 1200) {
            window.__petNoSaveToastAt = now;
            try { PET_LEVEL1_UI.showToast('Nenhum andamento salvo no perfil atual.', { type: 'info', timeout: 2200 }); } catch (_) {
                try { alert('Nenhum andamento salvo no perfil atual.'); } catch (_) {}
            }
        }
        try { refreshContinueSessionButtonVisibility(); } catch (_) {}
        return false;
    }
    try { resumePetSessionFromSnapshot(snap); } catch (_) {
        try { alert('Não foi possível retomar o andamento salvo agora.'); } catch (_) {}
    }
    return false;
}

function petConfirmNewGame(ev = null) {
    try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
    const runReset = () => {
        try { stopTimer(); } catch (_) {}
        try { gameState.isGameActive = false; } catch (_) {}
        try { clearSavedPetSession(); } catch (_) {}
        clearAllPetGameData({ preserveSettings: true });
        try { refreshContinueSessionButtonVisibility(); } catch (_) {}
        try { refreshPetProgressMini(); } catch (_) {}
        try { showFeedbackMessage('Novo jogo iniciado. Dados do progresso foram apagados do perfil atual.', 'info', 2400); } catch (_) {}
        setTimeout(() => {
            try { window.location.reload(); } catch (_) { exibirTela('home-screen'); }
        }, 250);
    };

    if (window.PET_LEVEL1_UI && PET_LEVEL1_UI.openModal) {
        PET_LEVEL1_UI.openModal({
            title: 'Novo jogo',
            html: `<p>Isso vai apagar o andamento salvo, XP, conquistas, histórico, ranking e progresso do perfil atual.</p><p style="margin-top:8px;"><strong>Deseja começar do zero?</strong></p>`,
            primaryText: 'Apagar e começar',
            secondaryText: 'Cancelar',
            onPrimary: runReset
        });
        return false;
    }

    if (confirm('Isso vai apagar os dados salvos do perfil atual e começar do zero. Continuar?')) runReset();
    return false;
}

function bindReliableHomeButton(button, actionName) {
    if (!button) return;
    button.type = 'button';
    button.disabled = false;
    button.setAttribute('aria-disabled', 'false');
    try { button.style.setProperty('pointer-events', 'auto', 'important'); } catch (_) {}
    try { button.style.setProperty('touch-action', 'manipulation'); } catch (_) {}
    try { button.style.setProperty('cursor', 'pointer'); } catch (_) {}
    const handler = (ev) => {
        try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
        const now = Date.now();
        if (__petHomeActionLock.action === actionName && (now - __petHomeActionLock.at) < 650) return false;
        __petHomeActionLock.action = actionName;
        __petHomeActionLock.at = now;
        if (actionName === 'achievements') return openPetAchievementsModalSafe(ev || null);
        if (actionName === 'continue') return petContinueNow(ev || null);
        if (actionName === 'new-game') return petConfirmNewGame(ev || null);
        return false;
    };
    button.onclick = handler;
    if (!button.dataset.petBoundClick) {
        button.addEventListener('click', handler);
        button.dataset.petBoundClick = '1';
    }
    try { ensureTouchClick(button); } catch (_) {}
}

function bindReliableHomeButtons() {
    bindReliableHomeButton(document.getElementById('btn-pet-achievements'), 'achievements');
    bindReliableHomeButton(document.getElementById('btn-continue-session'), 'continue');
    bindReliableHomeButton(document.getElementById('btn-new-game'), 'new-game');
}

window.__petHomeDirectAction = function(actionName, ev = null) {
    try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
    if (actionName === 'achievements') {
        openPetAchievementsModalSafe(ev || null);
        return false;
    }
    if (actionName === 'continue') return petContinueNow(ev || null);
    if (actionName === 'new-game') return petConfirmNewGame(ev || null);
    return false;
};

function initPetSessionPersistence() {
    ensurePetStorageVersion();
    ensureContinueSessionButton();
    refreshContinueSessionButtonVisibility();

    // Salva quando o app perde foco
    try {
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) savePetSessionSnapshotNow();
        });
        window.addEventListener('beforeunload', () => {
            savePetSessionSnapshotNow();
        });
    } catch (_) {}

    // Auto-save leve (captura timeLeft no rápido)
    try {
        setInterval(() => {
            if (gameState.isGameActive && gameState.currentQuestion) {
                savePetSessionSnapshotNow();
                refreshContinueSessionButtonVisibility();
            }
        }, 2000);
    } catch (_) {}

    // Mantém o botão Continuar disponível na Home, sem abrir a sessão automaticamente.
    try { refreshContinueSessionButtonVisibility(); } catch (_) {}
}


function bindHomePrimaryActions() {
    if (window.__petHomePrimaryActionsBound) return;
    window.__petHomePrimaryActionsBound = true;
}



function loadStudentProfile() {
    try {
        const obj = profileStorageGetJson(PROFILE_STORAGE_KEY, { name: '', turma: '', escola: '' });
        gameState.studentProfile = {
            name: String(obj?.name || '').trim(),
            turma: String(obj?.turma || '').trim(),
            escola: String(obj?.escola || '').trim()
        };
    } catch (e) {
        gameState.studentProfile = { name: '', turma: '', escola: '' };
    }
    syncProfileButtonLabel();
    return gameState.studentProfile;
}

function saveStudentProfile(profile) {
    const safe = sanitizeStudentProfile(profile);
    profileStorageSetJson(PROFILE_STORAGE_KEY, safe);
    gameState.studentProfile = safe;
    if (!isGuestProfileActive()) {
        updateStoredProfileMeta(gameState.activeProfileId, safe);
    }
    syncProfileButtonLabel();
    return safe;
}

function getStudentProfile() {
    return gameState.studentProfile || loadStudentProfile();
}

const PROFILE_INDEX_KEY = 'pet_profiles_index_v1';
const PROFILE_ACTIVE_KEY = 'pet_active_profile_id_v1';
const PROFILE_GUEST_ID = '__guest__';
const PROFILE_SCOPE_PREFIX = 'pet_profile';
const PROFILE_GUEST_PREFIX = 'pet_guest';
const PROFILE_MAX_COUNT = 60;
const PROFILE_BOOT_TOKEN_KEY = 'pet_profile_boot_token_v1';
const PROFILE_SCOPED_KEYS = [
    PROFILE_STORAGE_KEY,
    PET_SESSION_KEY,
    PET_PROGRESS_KEY,
    PET_SESSION_HISTORY_KEY,
    PET_LAST_SUMMARY_KEY,
    'matemagica_xp',
    'matemagica_errors',
    'matemagica_mult_cfg',
    'matemagica_mult_progress_map_v1',
    'matemagica_path_progress_v1',
    'matemagica_high_scores_v1',
    'pet_operation_trail_index_v2',
    'pet_operation_stage_unlock_v1',
    'pet_operation_skill_review_v1',
    'pet_multiplication_apprentice_completed_v1',
    'pet_initial_diagnostic_v1'
];
const PROFILE_RESETTABLE_KEYS = PROFILE_SCOPED_KEYS.filter((key) => key !== PROFILE_STORAGE_KEY);

let __profileOverlay = null;
let __profileBtn = null;
let __profileForceLock = false;
let __profileGateResolver = null;
let __profileSelectedId = null;
let __profileCreateMode = false;

function sanitizeStudentProfile(profile) {
    return {
        name: String(profile?.name || '').trim().slice(0, 50),
        turma: String(profile?.turma || '').trim().slice(0, 30),
        escola: String(profile?.escola || '').trim().slice(0, 60)
    };
}

function escapeHtml(value) {
    return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function normalizePin(pin) {
    return String(pin || '').replace(/\D+/g, '').slice(0, 6);
}

function isValidProfilePin(pin) {
    return /^\d{4,6}$/.test(normalizePin(pin));
}

function hashProfilePin(pin) {
    const src = normalizePin(pin);
    let h1 = 5381;
    let h2 = 52711;
    for (let i = 0; i < src.length; i++) {
        const code = src.charCodeAt(i);
        h1 = (((h1 << 5) + h1) ^ code) >>> 0;
        h2 = (((h2 << 5) + h2) + code) >>> 0;
    }
    return `${h1.toString(16)}${h2.toString(16)}`;
}

function generateProfileId() {
    return `p_${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`;
}

function normalizeStoredProfile(record) {
    const safeMeta = sanitizeStudentProfile(record || {});
    return {
        id: String(record?.id || generateProfileId()),
        name: safeMeta.name || 'Aluno',
        turma: safeMeta.turma || '',
        escola: safeMeta.escola || '',
        pinHash: String(record?.pinHash || ''),
        mustSetPin: !!record?.mustSetPin || !String(record?.pinHash || ''),
        createdAt: Number(record?.createdAt || Date.now()),
        lastUsedAt: Number(record?.lastUsedAt || 0)
    };
}

function loadProfilesIndex() {
    const def = { version: 1, profiles: [] };
    try {
        const raw = localStorage.getItem(PROFILE_INDEX_KEY);
        const obj = raw ? JSON.parse(raw) : def;
        const profiles = Array.isArray(obj?.profiles) ? obj.profiles.map(normalizeStoredProfile).slice(0, PROFILE_MAX_COUNT) : [];
        return { version: 1, profiles };
    } catch (_) {
        return def;
    }
}

function saveProfilesIndex(index) {
    const safe = {
        version: 1,
        profiles: Array.isArray(index?.profiles) ? index.profiles.map(normalizeStoredProfile).slice(0, PROFILE_MAX_COUNT) : []
    };
    try { localStorage.setItem(PROFILE_INDEX_KEY, JSON.stringify(safe)); } catch (_) {}
    return safe;
}

function getStoredProfiles() {
    return loadProfilesIndex().profiles;
}

function getStoredProfile(profileId) {
    return getStoredProfiles().find((p) => p.id === String(profileId || '')) || null;
}

function saveProfileRaw(baseKey, rawValue, profileId = null) {
    const id = profileId || gameState.activeProfileId || PROFILE_GUEST_ID;
    const driver = id === PROFILE_GUEST_ID ? sessionStorage : localStorage;
    const scopedKey = id === PROFILE_GUEST_ID ? `${PROFILE_GUEST_PREFIX}::${baseKey}` : `${PROFILE_SCOPE_PREFIX}::${id}::${baseKey}`;
    try { driver.setItem(scopedKey, rawValue); } catch (_) {}
}

function isGuestProfileActive(profileId = null) {
    const id = profileId || gameState.activeProfileId;
    return id === PROFILE_GUEST_ID || !!gameState.isGuestProfile;
}

function getScopedStorageKey(baseKey, profileId = null) {
    const id = profileId || gameState.activeProfileId;
    if (!id) return baseKey;
    return id === PROFILE_GUEST_ID ? `${PROFILE_GUEST_PREFIX}::${baseKey}` : `${PROFILE_SCOPE_PREFIX}::${id}::${baseKey}`;
}

function getScopedStorageDriver(profileId = null) {
    const id = profileId || gameState.activeProfileId;
    return id === PROFILE_GUEST_ID ? sessionStorage : localStorage;
}

function profileStorageGetRaw(baseKey, profileId = null) {
    try {
        const driver = getScopedStorageDriver(profileId);
        const scoped = driver.getItem(getScopedStorageKey(baseKey, profileId));
        if (scoped != null) return scoped;
    } catch (_) {}
    if (!profileId && !gameState.activeProfileId && !isGuestProfileActive()) {
        try { return localStorage.getItem(baseKey); } catch (_) {}
    }
    return null;
}

function profileStorageGetJson(baseKey, fallback, profileId = null) {
    const raw = profileStorageGetRaw(baseKey, profileId);
    return safeJsonParse(raw, fallback);
}

function profileStorageSetJson(baseKey, value, profileId = null) {
    saveProfileRaw(baseKey, JSON.stringify(value), profileId || gameState.activeProfileId || PROFILE_GUEST_ID);
}

function profileStorageSetText(baseKey, value, profileId = null) {
    saveProfileRaw(baseKey, String(value), profileId || gameState.activeProfileId || PROFILE_GUEST_ID);
}

function profileStorageRemove(baseKey, profileId = null) {
    const id = profileId || gameState.activeProfileId;
    if (!id) return;
    try {
        getScopedStorageDriver(id).removeItem(getScopedStorageKey(baseKey, id));
    } catch (_) {}
}

function clearScopedProfileData(profileId = null, keys = PROFILE_RESETTABLE_KEYS) {
    const id = profileId || gameState.activeProfileId;
    if (!id) return;
    (Array.isArray(keys) ? keys : PROFILE_RESETTABLE_KEYS).forEach((key) => profileStorageRemove(key, id));
}

function clearGuestSessionData() {
    clearScopedProfileData(PROFILE_GUEST_ID, PROFILE_SCOPED_KEYS);
}

function createStoredProfile(meta, pin, options = {}) {
    const safeMeta = sanitizeStudentProfile(meta);
    const idx = loadProfilesIndex();
    const rec = normalizeStoredProfile({
        id: options.id || generateProfileId(),
        ...safeMeta,
        pinHash: isValidProfilePin(pin) ? hashProfilePin(pin) : '',
        mustSetPin: !!options.mustSetPin || !isValidProfilePin(pin),
        createdAt: Date.now(),
        lastUsedAt: 0
    });
    idx.profiles.unshift(rec);
    saveProfilesIndex(idx);
    profileStorageSetJson(PROFILE_STORAGE_KEY, safeMeta, rec.id);
    return rec;
}

function updateStoredProfileMeta(profileId, meta) {
    if (!profileId || profileId === PROFILE_GUEST_ID) return null;
    const safeMeta = sanitizeStudentProfile(meta);
    const idx = loadProfilesIndex();
    idx.profiles = idx.profiles.map((p) => p.id === profileId ? normalizeStoredProfile({ ...p, ...safeMeta }) : p);
    saveProfilesIndex(idx);
    profileStorageSetJson(PROFILE_STORAGE_KEY, safeMeta, profileId);
    return getStoredProfile(profileId);
}

function updateStoredProfilePin(profileId, pin) {
    if (!profileId || profileId === PROFILE_GUEST_ID || !isValidProfilePin(pin)) return null;
    const idx = loadProfilesIndex();
    idx.profiles = idx.profiles.map((p) => p.id === profileId ? normalizeStoredProfile({ ...p, pinHash: hashProfilePin(pin), mustSetPin: false }) : p);
    saveProfilesIndex(idx);
    return getStoredProfile(profileId);
}

function touchStoredProfile(profileId) {
    if (!profileId || profileId === PROFILE_GUEST_ID) return;
    const idx = loadProfilesIndex();
    idx.profiles = idx.profiles.map((p) => p.id === profileId ? normalizeStoredProfile({ ...p, lastUsedAt: Date.now() }) : p);
    saveProfilesIndex(idx);
    try { localStorage.setItem(PROFILE_ACTIVE_KEY, profileId); } catch (_) {}
}

function verifyStoredProfilePin(profileId, pin) {
    const profile = getStoredProfile(profileId);
    if (!profile) return false;
    if (profile.mustSetPin || !profile.pinHash) return false;
    return profile.pinHash === hashProfilePin(pin);
}

function hasLegacyProfileData() {
    return PROFILE_SCOPED_KEYS.some((key) => {
        try { return localStorage.getItem(key) != null; } catch (_) { return false; }
    });
}

function migrateLegacyProfileDataIfNeeded() {
    const idx = loadProfilesIndex();
    if (idx.profiles.length) return idx;
    if (!hasLegacyProfileData()) return idx;

    const legacyMeta = safeJsonParse(localStorage.getItem(PROFILE_STORAGE_KEY), {});
    const profile = createStoredProfile({
        name: String(legacyMeta?.name || '').trim() || 'Aluno local',
        turma: String(legacyMeta?.turma || '').trim(),
        escola: String(legacyMeta?.escola || '').trim()
    }, '', { mustSetPin: true });

    PROFILE_SCOPED_KEYS.forEach((baseKey) => {
        try {
            const raw = localStorage.getItem(baseKey);
            if (raw != null) saveProfileRaw(baseKey, raw, profile.id);
        } catch (_) {}
    });

    PROFILE_SCOPED_KEYS.forEach((baseKey) => {
        try { localStorage.removeItem(baseKey); } catch (_) {}
    });
    try { localStorage.removeItem(PROFILE_ACTIVE_KEY); } catch (_) {}
    return loadProfilesIndex();
}

function syncProfileButtonLabel() {
    if (!__profileBtn) return;
    const label = isGuestProfileActive()
        ? 'Perfil'
        : (String(gameState.studentProfile?.name || '').trim() || 'Perfil');
    const shortLabel = label.length > 14 ? `${label.slice(0, 14)}…` : label;
    __profileBtn.innerHTML = `<span class="icon">👤</span> ${shortLabel}`;
    __profileBtn.title = isGuestProfileActive()
        ? 'Abrir perfis neste dispositivo'
        : (label === 'Perfil' ? 'Perfis neste dispositivo' : `Perfil ativo: ${label}`);
}

function activateStoredProfileContext(profileId) {
    const profile = getStoredProfile(profileId);
    if (!profile) return null;
    gameState.activeProfileId = profile.id;
    gameState.isGuestProfile = false;
    touchStoredProfile(profile.id);
    loadStudentProfile();
    syncProfileButtonLabel();
    return profile;
}

function activateGuestProfileContext() {
    clearGuestSessionData();
    gameState.activeProfileId = PROFILE_GUEST_ID;
    gameState.isGuestProfile = true;
    gameState.studentProfile = { name: 'Visitante', turma: '', escola: '' };
    profileStorageSetJson(PROFILE_STORAGE_KEY, gameState.studentProfile, PROFILE_GUEST_ID);
    try { localStorage.removeItem(PROFILE_ACTIVE_KEY); } catch (_) {}
    syncProfileButtonLabel();
}

function getPreferredProfileId() {
    try {
        const saved = String(localStorage.getItem(PROFILE_ACTIVE_KEY) || '');
        if (saved && getStoredProfile(saved)) return saved;
    } catch (_) {}
    const list = getStoredProfiles();
    return list.length ? list[0].id : null;
}

function setProfileBootToken(profileId) {
    try { sessionStorage.setItem(PROFILE_BOOT_TOKEN_KEY, String(profileId || '')); } catch (_) {}
}

function consumeProfileBootToken() {
    try {
        const token = String(sessionStorage.getItem(PROFILE_BOOT_TOKEN_KEY) || '');
        sessionStorage.removeItem(PROFILE_BOOT_TOKEN_KEY);
        return token || '';
    } catch (_) {
        return '';
    }
}

function loadProfileBoundState() {
    loadStudentProfile();
    carregarXP();
    carregarErros();
    carregarRanking();
    loadMultiplicationConfig();
    loadMultProgressMap();
}

function getProfileHistoryFor(profileId) {
    const raw = profileStorageGetRaw(PET_SESSION_HISTORY_KEY, profileId);
    const arr = safeJsonParse(raw, []);
    return Array.isArray(arr) ? arr : [];
}

function loadAllPetSessionHistory() {
    const out = [];
    getStoredProfiles().forEach((profile) => {
        getProfileHistoryFor(profile.id).forEach((item) => out.push(item));
    });
    if (isGuestProfileActive()) {
        getProfileHistoryFor(PROFILE_GUEST_ID).forEach((item) => out.push(item));
    }
    return out.sort((a, b) => Number(b?.endedAt || 0) - Number(a?.endedAt || 0));
}

function openProfileOverlay(options = {}) {
    ensureProfileUI();
    if (!__profileOverlay) return Promise.resolve(null);
    __profileForceLock = !!options.locked;
    document.body.classList.toggle('profile-lock-active', __profileForceLock);
    const closeBtn = __profileOverlay.querySelector('#profile-close');
    if (closeBtn) closeBtn.style.display = __profileForceLock ? 'none' : 'inline-flex';
    __profileOverlay.classList.remove('hidden');

    const profiles = getStoredProfiles();
    if (!__profileSelectedId || !getStoredProfile(__profileSelectedId)) {
        __profileSelectedId = getPreferredProfileId();
    }
    if (!profiles.length) __profileCreateMode = true;
    refreshProfileOverlay();

    if (!__profileForceLock) return Promise.resolve(true);
    return new Promise((resolve) => {
        __profileGateResolver = resolve;
    });
}

function closeProfileOverlay(force = false) {
    if (!__profileOverlay) return;
    if (__profileForceLock && !force) return;
    __profileOverlay.classList.add('hidden');
    document.body.classList.remove('profile-lock-active');
    __profileForceLock = false;
}

function resolveProfileGate(result = true) {
    if (typeof __profileGateResolver === 'function') {
        const fn = __profileGateResolver;
        __profileGateResolver = null;
        fn(result);
    }
}

function refreshProfileOverlay() {
    if (!__profileOverlay) return;
    const profiles = getStoredProfiles();
    const selected = __profileSelectedId ? getStoredProfile(__profileSelectedId) : null;
    const listEl = __profileOverlay.querySelector('#profile-list');
    const stateEl = __profileOverlay.querySelector('#profile-selected-state');
    const loginHintEl = __profileOverlay.querySelector('#profile-login-hint');
    const loginPinEl = __profileOverlay.querySelector('#profile-login-pin');
    const enterBtn = __profileOverlay.querySelector('#profile-enter');
    const createBtn = __profileOverlay.querySelector('#profile-create');
    const createShortcutBtn = __profileOverlay.querySelector('#profile-create-shortcut');
    const saveBtn = __profileOverlay.querySelector('#profile-save-current');
    const guestBtn = __profileOverlay.querySelector('#profile-guest');
    const lockBtn = __profileOverlay.querySelector('#profile-lock');
    const nameEl = __profileOverlay.querySelector('#profile-name');
    const turmaEl = __profileOverlay.querySelector('#profile-turma');
    const escolaEl = __profileOverlay.querySelector('#profile-escola');
    const pinEl = __profileOverlay.querySelector('#profile-pin');
    const pin2El = __profileOverlay.querySelector('#profile-pin-confirm');
    const formTitleEl = __profileOverlay.querySelector('#profile-form-title');
    const formHintEl = __profileOverlay.querySelector('#profile-form-hint');
    const modeBadgeEl = __profileOverlay.querySelector('#profile-mode-badge');

    if (listEl) {
        listEl.innerHTML = profiles.map((profile) => {
            const active = profile.id === __profileSelectedId;
            const pinState = profile.mustSetPin ? 'Definir PIN' : 'PIN ativo';
            const lastUsed = profile.lastUsedAt ? formatTimeBR(profile.lastUsedAt) : 'Nunca usado';
            return `
              <button class="profile-card ${active ? 'selected' : ''}" type="button" data-profile-id="${profile.id}">
                <span class="profile-card-name">${escapeHtml(profile.name || 'Aluno')}</span>
                <span class="profile-card-meta">${escapeHtml(profile.turma || 'Sem turma')} • ${escapeHtml(pinState)}</span>
                <span class="profile-card-last">${escapeHtml(lastUsed)}</span>
              </button>
            `;
        }).join('');
        listEl.querySelectorAll('[data-profile-id]').forEach((btn) => {
            btn.addEventListener('click', () => {
                __profileSelectedId = btn.getAttribute('data-profile-id');
                __profileCreateMode = false;
                refreshProfileOverlay();
            });
        });
    }

    if (modeBadgeEl) {
        if (__profileCreateMode) modeBadgeEl.textContent = 'Novo perfil';
        else if (selected) modeBadgeEl.textContent = selected.mustSetPin ? 'PIN pendente' : 'Perfil selecionado';
        else modeBadgeEl.textContent = profiles.length ? 'Selecione um perfil' : 'Sem perfis';
    }

    if (selected && !__profileCreateMode) {
        if (nameEl) nameEl.value = selected.name || '';
        if (turmaEl) turmaEl.value = selected.turma || '';
        if (escolaEl) escolaEl.value = selected.escola || '';
        if (formTitleEl) formTitleEl.textContent = selected.mustSetPin ? 'Complete e defina o PIN' : 'Editar perfil selecionado';
        if (formHintEl) formHintEl.textContent = selected.mustSetPin
            ? 'Esse perfil veio da versão antiga. Defina um PIN para continuar usando no computador compartilhado.'
            : 'Você pode corrigir nome, turma, escola e trocar o PIN deste perfil.';
    } else {
        if (nameEl) nameEl.value = '';
        if (turmaEl) turmaEl.value = '';
        if (escolaEl) escolaEl.value = '';
        if (formTitleEl) formTitleEl.textContent = 'Criar novo perfil';
        if (formHintEl) formHintEl.textContent = 'Use PIN de 4 a 6 dígitos. Este perfil ficará salvo apenas neste computador.';
    }
    if (pinEl) pinEl.value = '';
    if (pin2El) pin2El.value = '';
    if (loginPinEl) loginPinEl.value = '';

    if (stateEl) {
        stateEl.textContent = selected
            ? `${selected.name || 'Aluno'}${selected.turma ? ` • ${selected.turma}` : ''}`
            : (profiles.length ? 'Selecione um perfil acima.' : 'Nenhum perfil criado ainda.');
    }
    if (loginHintEl) {
        loginHintEl.textContent = selected
            ? (selected.mustSetPin ? 'Esse perfil precisa definir um PIN antes do primeiro acesso.' : 'Digite o PIN do perfil selecionado para entrar.')
            : 'Selecione um perfil acima ou clique em "Criar novo perfil + PIN".';
    }
    if (enterBtn) enterBtn.disabled = !(selected && !selected.mustSetPin && !!selected.pinHash);
    if (saveBtn) saveBtn.textContent = (__profileCreateMode || !selected) ? 'Criar perfil e PIN' : (selected.mustSetPin ? 'Salvar perfil e PIN' : 'Salvar alterações');
    if (createBtn) createBtn.textContent = 'Novo perfil';
    if (createShortcutBtn) createShortcutBtn.textContent = 'Criar novo perfil + PIN';
    if (guestBtn) guestBtn.textContent = 'Entrar como visitante';
    if (lockBtn) lockBtn.style.display = __profileForceLock ? 'none' : 'inline-flex';
}

function ensureProfileUI() {
    if (__profileBtn && __profileOverlay) return;

    const bar = document.querySelector('.settings-bar');
    if (!bar) return;

    if (!__profileBtn) {
        __profileBtn = document.createElement('button');
        __profileBtn.id = 'btn-student-profile';
        __profileBtn.className = 'setting-btn';
        __profileBtn.type = 'button';
        __profileBtn.innerHTML = '<span class="icon">👤</span> Perfil';
        bar.appendChild(__profileBtn);
        __profileBtn.addEventListener('click', () => openProfileOverlay({ locked: false }));
    }

    if (!__profileOverlay) {
        const overlay = document.createElement('div');
        overlay.id = 'profile-overlay';
        overlay.className = 'teacher-overlay hidden';
        overlay.innerHTML = `
          <div class="teacher-panel profile-panel profile-device-panel" role="dialog" aria-modal="true" aria-label="Perfis neste dispositivo">
            <div class="teacher-panel-header">
              <div>
                <div id="profile-mode-badge" class="profile-mode-badge">Perfis</div>
                <h3>Perfis neste dispositivo</h3>
              </div>
              <button id="profile-close" class="teacher-close" type="button" aria-label="Fechar">✕</button>
            </div>

            <p class="teacher-help">
              Computador compartilhado exige <strong>PIN</strong>. Cada aluno entra no próprio perfil. <strong>Visitante</strong> não salva dados após fechar a sessão.
            </p>
            <div class="profile-scroll-tip">↕ Role a tela para subir ou descer até o campo de PIN.</div>

            <div class="teacher-panel-section">
              <div class="profile-section-title">Perfis salvos</div>
              <div id="profile-list" class="profile-list"></div>
            </div>

            <div class="teacher-panel-section">
              <div class="profile-section-title">Entrar no perfil</div>
              <div id="profile-selected-state" class="profile-inline-note">Selecione um perfil acima.</div>
              <div id="profile-login-hint" class="teacher-help" style="margin-top:8px;"></div>
              <label class="tp-label">PIN</label>
              <input id="profile-login-pin" class="tp-input" type="password" inputmode="numeric" maxlength="6" placeholder="4 a 6 dígitos">
              <div class="teacher-row" style="margin-top: 12px; gap: 8px; flex-wrap: wrap;">
                <button id="profile-enter" class="btn-action" type="button">Entrar</button>
                <button id="profile-create-shortcut" class="btn-action btn-secondary" type="button">Criar novo perfil + PIN</button>
                <button id="profile-guest" class="btn-action btn-secondary" type="button">Entrar como visitante</button>
                <button id="profile-lock" class="btn-action btn-secondary" type="button">Bloquear acesso</button>
              </div>
            </div>

            <div class="teacher-panel-section">
              <div class="profile-section-title" id="profile-form-title">Criar novo perfil</div>
              <p id="profile-form-hint" class="teacher-help">Use PIN de 4 a 6 dígitos.</p>
              <label class="tp-label">Nome do aluno</label>
              <input id="profile-name" class="tp-input" type="text" maxlength="50" placeholder="Ex.: Ana, João, Aluno 12">
              <label class="tp-label">Turma</label>
              <input id="profile-turma" class="tp-input" type="text" maxlength="30" placeholder="Ex.: 701, 8ºA">
              <label class="tp-label">Escola</label>
              <input id="profile-escola" class="tp-input" type="text" maxlength="60" placeholder="Ex.: E.M. ...">
              <label class="tp-label">PIN</label>
              <input id="profile-pin" class="tp-input" type="password" inputmode="numeric" maxlength="6" placeholder="4 a 6 dígitos">
              <label class="tp-label">Confirmar PIN</label>
              <input id="profile-pin-confirm" class="tp-input" type="password" inputmode="numeric" maxlength="6" placeholder="Repita o PIN">
              <div class="teacher-row" style="margin-top: 12px; gap: 8px; flex-wrap: wrap;">
                <button id="profile-save-current" class="btn-action" type="button">Criar perfil</button>
                <button id="profile-create" class="btn-action btn-secondary" type="button">Novo perfil</button>
              </div>
            </div>
          </div>
        `;
        document.body.appendChild(overlay);
        __profileOverlay = overlay;

        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeProfileOverlay(); });
        overlay.querySelector('#profile-close').addEventListener('click', () => closeProfileOverlay());
        const openCreateProfileMode = () => {
            __profileCreateMode = true;
            __profileSelectedId = null;
            refreshProfileOverlay();
            setTimeout(() => {
                try { overlay.querySelector('#profile-name')?.focus(); } catch (_) {}
            }, 20);
        };
        overlay.querySelector('#profile-create').addEventListener('click', openCreateProfileMode);
        overlay.querySelector('#profile-create-shortcut').addEventListener('click', openCreateProfileMode);
        overlay.querySelector('#profile-lock').addEventListener('click', () => {
            closeProfileOverlay(true);
            setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
        });
        overlay.querySelector('#profile-guest').addEventListener('click', () => {
            activateGuestProfileContext();
            closeProfileOverlay(true);
            if (__profileForceLock) resolveProfileGate(true);
            else {
                setProfileBootToken(PROFILE_GUEST_ID);
                setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
            }
        });
        overlay.querySelector('#profile-enter').addEventListener('click', () => {
            const selected = __profileSelectedId ? getStoredProfile(__profileSelectedId) : null;
            const pin = normalizePin(overlay.querySelector('#profile-login-pin').value);
            if (!selected) {
                showFeedbackMessage('Selecione um perfil primeiro.', 'error', 1800);
                return;
            }
            if (!verifyStoredProfilePin(selected.id, pin)) {
                showFeedbackMessage('PIN inválido.', 'error', 1800);
                return;
            }
            activateStoredProfileContext(selected.id);
            closeProfileOverlay(true);
            if (__profileGateResolver) resolveProfileGate(true);
            else {
                setProfileBootToken(selected.id);
                setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
            }
        });
        overlay.querySelector('#profile-save-current').addEventListener('click', () => {
            const meta = {
                name: overlay.querySelector('#profile-name').value,
                turma: overlay.querySelector('#profile-turma').value,
                escola: overlay.querySelector('#profile-escola').value
            };
            const safeMeta = sanitizeStudentProfile(meta);
            const pin = normalizePin(overlay.querySelector('#profile-pin').value);
            const pin2 = normalizePin(overlay.querySelector('#profile-pin-confirm').value);
            if (!safeMeta.name) {
                showFeedbackMessage('Nome do aluno é obrigatório.', 'error', 1800);
                return;
            }
            const selected = __profileCreateMode ? null : (__profileSelectedId ? getStoredProfile(__profileSelectedId) : null);
            const needsPin = !selected || !!selected.mustSetPin || pin || pin2;
            if (needsPin) {
                if (!isValidProfilePin(pin)) {
                    showFeedbackMessage('Use PIN de 4 a 6 dígitos.', 'error', 1800);
                    return;
                }
                if (pin !== pin2) {
                    showFeedbackMessage('PIN e confirmação não conferem.', 'error', 1800);
                    return;
                }
            }

            if (!selected) {
                const created = createStoredProfile(safeMeta, pin);
                __profileSelectedId = created.id;
                __profileCreateMode = false;
                activateStoredProfileContext(created.id);
                closeProfileOverlay(true);
                if (__profileGateResolver) resolveProfileGate(true);
                else {
                    setProfileBootToken(created.id);
                    setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
                }
                return;
            }

            updateStoredProfileMeta(selected.id, safeMeta);
            if (needsPin && isValidProfilePin(pin)) updateStoredProfilePin(selected.id, pin);
            if (gameState.activeProfileId === selected.id && !gameState.isGuestProfile) {
                saveStudentProfile(safeMeta);
            }
            showFeedbackMessage('Perfil salvo neste dispositivo.', 'success', 1600);
            refreshProfileOverlay();
            if (__profileForceLock) {
                activateStoredProfileContext(selected.id);
                closeProfileOverlay(true);
                resolveProfileGate(true);
            }
        });
    }

    syncProfileButtonLabel();
}

async function bootstrapProfileAccess() {
    migrateLegacyProfileDataIfNeeded();
    ensureProfileUI();

    const bootToken = consumeProfileBootToken();
    if (bootToken === PROFILE_GUEST_ID) {
        activateGuestProfileContext();
        return;
    }
    if (bootToken && getStoredProfile(bootToken) && !getStoredProfile(bootToken).mustSetPin) {
        activateStoredProfileContext(bootToken);
        return;
    }

    __profileCreateMode = !getStoredProfiles().length;
    __profileSelectedId = null;
    activateGuestProfileContext();
}


// --- PROGRESSO POR TRILHA DA TABUADA (salva por faixa/nível) ---
const MULT_PROGRESS_KEY = 'matemagica_mult_progress_map_v1';

function loadMultProgressMap() {
    try {
        const map = profileStorageGetJson(MULT_PROGRESS_KEY, {});
        gameState.multiplication.progressByKey = (map && typeof map === 'object') ? map : {};
    } catch (e) {
        gameState.multiplication.progressByKey = {};
    }
    return gameState.multiplication.progressByKey;
}

function saveMultProgressMap() {
    try {
        profileStorageSetJson(MULT_PROGRESS_KEY, gameState.multiplication.progressByKey || {});
    } catch (e) {
        console.warn("Falha ao salvar progresso da tabuada por chave:", e);
    }
}

function getSavedTrailIndexForKey(key, expectedLen) {
    if (!gameState.multiplication.progressByKey) loadMultProgressMap();
    const idx = Number(gameState.multiplication.progressByKey?.[key] ?? 0);
    if (!Number.isFinite(idx) || idx < 0) return 0;
    if (Number.isInteger(expectedLen) && expectedLen > 0 && idx >= expectedLen) return 0; // ciclo completo -> reinicia
    return Math.floor(idx);
}

function setSavedTrailIndexForKey(key, idx) {
    if (!gameState.multiplication.progressByKey) loadMultProgressMap();
    const n = Number(idx);
    gameState.multiplication.progressByKey[key] = Number.isFinite(n) && n >= 0 ? Math.floor(n) : 0;
    saveMultProgressMap();
}


// --- MAPA (TRILHA) NO ESTILO DUOLINGO (clean) ---
const PATH_PROGRESS_KEY = 'matemagica_path_progress_v1';

function loadPathProgress() {
    try {
        const obj = profileStorageGetJson(PATH_PROGRESS_KEY, {});
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (e) {
        return {};
    }
}

function savePathProgress(obj) {
    try { profileStorageSetJson(PATH_PROGRESS_KEY, obj || {}); } catch (e) {}
}

function getPathDone(operation, level) {
    const data = loadPathProgress();
    return Math.max(0, Math.min(10, Number(data?.[operation]?.[level] ?? 0)));
}

function setPathDone(operation, level, done) {
    const data = loadPathProgress();
    if (!data[operation]) data[operation] = {};
    data[operation][level] = Math.max(0, Math.min(10, Number(done) || 0));
    savePathProgress(data);
}

function ensureLearningMapUI() {
    const screen = document.getElementById('level-selection-screen');
    if (!screen) return;

    let card = document.getElementById('learning-map-card');
    if (!card) {
        card = document.createElement('div');
        card.id = 'learning-map-card';
        card.className = 'info-card map-card';
        card.innerHTML = `
            <div class="map-header">
                <h2>Trilha (mapa)</h2>
                <p class="map-sub">Visualize seu progresso e avance passo a passo.</p>
            </div>
            <div id="learning-map-rows" class="map-rows"></div>
        `;
        const header = screen.querySelector('header');
        if (header && header.parentNode) {
            header.parentNode.insertBefore(card, header.nextSibling);
        } else {
            screen.appendChild(card);
        }
    }
}


function updateLevelButtonsForOperation(operation) {
    const apprenticeBtn = document.getElementById('level-apprentice-btn');
    const easyBtn = document.querySelector('.level-btn[data-level="easy"]');
    if (!apprenticeBtn) return;

    const hasApprentice = !!((getOperationTrailStages(String(operation || ''), 'apprentice') || []).length);
    apprenticeBtn.classList.toggle('hidden', !hasApprentice);
    apprenticeBtn.setAttribute('aria-hidden', hasApprentice ? 'false' : 'true');

    if (easyBtn) {
        easyBtn.disabled = false;
        easyBtn.classList.remove('locked-level');
        easyBtn.setAttribute('aria-disabled', 'false');
        easyBtn.title = '';
    }
}

function renderLearningMapPreview(operation) {
    ensureLearningMapUI();
    const rowsEl = document.getElementById('learning-map-rows');
    if (!rowsEl) return;

    const labels = { apprentice: 'Aprendiz', easy: 'Fácil', medium: 'Médio', advanced: 'Difícil' };
    const levels = getOperationLevelOrder(operation).map((key) => ({ key, label: labels[key] || key }));

    const makeNodes = (done, total = 10) => {
        const nodes = [];
        for (let i = 0; i < total; i++) {
            let cls = 'map-node locked';
            if (i < done) cls = 'map-node done';
            if (i === done) cls = 'map-node current';
            nodes.push(`<span class="${cls}" aria-hidden="true"></span>`);
        }
        return nodes.join('');
    };

    rowsEl.innerHTML = levels.map(lvl => {
        let meta = '';
        let done = 0;
        const stages = getOperationTrailStages(operation, lvl.key) || [];

        if (isMasteryTrailOperation(operation) && stages.length) {
            const unlockedIdx = getSavedOperationStageUnlock(operation, lvl.key, stages.length);
            done = Math.max(0, Math.min(9, unlockedIdx));
            const stageLabel = String(stages[unlockedIdx]?.label || '');
            meta = `Etapa ${unlockedIdx + 1}/${stages.length}${stageLabel ? ` • ${stageLabel}` : ''}`;
        } else if (operation === 'multiplication') {
            const r = getTabuadaRangeByLevel(lvl.key);
            const key = `${r.min}-${r.max}|${r.multMin}-${r.multMax}`;
            const bankSize = getTrailTargetSize(r.min, r.max, r.multMin, r.multMax);
            const idx = getSavedTrailIndexForKey(key, bankSize);
            const ratio = bankSize > 0 ? (idx / bankSize) : 0;
            done = Math.max(0, Math.min(10, Math.floor(ratio * 10)));
            meta = `${idx}/${bankSize}`;
        } else {
            const bankSize = getOperationTrailBankSize(operation, lvl.key);
            const idx = getSavedOperationTrailIndex(operation, lvl.key, bankSize);
            const ratio = bankSize > 0 ? (idx / bankSize) : 0;
            done = Math.max(0, Math.min(10, Math.floor(ratio * 10)));
            meta = bankSize > 0 ? `${idx}/${bankSize}` : `${done}/10`;
        }

        return `
          <div class="map-row" data-level="${lvl.key}">
            <div class="map-label">${lvl.label}</div>
            <div class="map-nodes" aria-label="Progresso ${lvl.label}">${makeNodes(done, 10)}</div>
            <div class="map-meta">${meta}</div>
          </div>
        `;
    }).join('');

    rowsEl.querySelectorAll('.map-row').forEach(row => {
        row.addEventListener('click', () => {
            const lvl = row.getAttribute('data-level');
            const btn = document.querySelector(`.level-btn[data-level="${lvl}"]`);
            if (btn) btn.click();
        });
    });
}


function carregarXP() {

    gameState.xp = parseInt(profileStorageGetRaw('matemagica_xp')) || 0;
    playerXPElement.textContent = `XP: ${gameState.xp}`;
}
function atualizarXP(amount) {
    gameState.xp += amount;
    
    // Soma XP ganho nesta rodada (para relatório final)
    if (gameState && gameState.isGameActive) {
        gameState.xpGainedRound = (Number(gameState.xpGainedRound) || 0) + amount;
    }
playerXPElement.textContent = `XP: ${gameState.xp}`;
    profileStorageSetText('matemagica_xp', String(gameState.xp));
}

/** Carrega os erros do jogador do Local Storage. */
function carregarErros() {
    try {
        const errorsJson = profileStorageGetRaw('matemagica_errors');
        if (errorsJson) {
            gameState.errors = JSON.parse(errorsJson);
        }
    } catch (e) {
        console.error("Erro ao carregar erros do localStorage:", e);
        gameState.errors = [];
    }
}

/** Salva os erros atuais no Local Storage. */
function salvarErros() {
    try {
        // Limita o número de erros salvos para não sobrecarregar o localStorage
        const errorsToSave = gameState.errors.slice(-50); 
        profileStorageSetJson('matemagica_errors', errorsToSave);
    } catch (e) {
        console.error("Erro ao salvar erros no localStorage:", e);
    }
}

// --- RANKING (Recordes + Histórico Local) ---
const RANKING_STORAGE_KEY = 'matemagica_high_scores_v1';

/** Carrega ranking (recordes) do localStorage */
function carregarRanking() {
    try {
        const raw = profileStorageGetRaw(RANKING_STORAGE_KEY);
        gameState.highScores = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(gameState.highScores)) gameState.highScores = [];
    } catch (e) {
        console.warn('Falha ao carregar ranking:', e);
        gameState.highScores = [];
    }
}

/** Salva ranking no localStorage */
function salvarRanking() {
    try {
        profileStorageSetJson(RANKING_STORAGE_KEY, gameState.highScores || []);
    } catch (e) {
        console.warn('Falha ao salvar ranking:', e);
    }
}

/** Adiciona uma partida no histórico e mantém os melhores no topo */
function registrarPartidaNoRanking(entry) {
    if (!entry) return;

    // Normaliza campos
    const safe = {
        timestamp: entry.timestamp || Date.now(),
        score: Number(entry.score || 0),
        operation: entry.operation || 'unknown',
        level: entry.level || 'unknown',
        mode: entry.mode || (gameState.isRapidMode ? 'rapido' : 'estudo'),
        submode: entry.submode || '',
        acertos: Number(entry.acertos || 0),
        erros: Number(entry.erros || 0),
        total: Number(entry.total || 0),
        accuracy: Number(entry.accuracy || 0),
        studentName: (getStudentProfile().name || ''),
        studentTurma: (getStudentProfile().turma || ''),
        studentEscola: (getStudentProfile().escola || '')
    };

    gameState.highScores.unshift(safe);

    // Ordena por score desc, depois por acurácia desc, depois mais recente
    gameState.highScores.sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        if (b.accuracy !== a.accuracy) return b.accuracy - a.accuracy;
        return b.timestamp - a.timestamp;
    });

    // Mantém até 60 registros (suficiente para histórico local)
    if (gameState.highScores.length > 60) gameState.highScores = gameState.highScores.slice(0, 60);

    salvarRanking();
}

/** Renderiza o ranking na tela */
function renderRanking() {
    const container = document.getElementById('ranking-list-container');
    const noMsg = document.getElementById('no-records-message');
    if (!container || !noMsg) return;

    container.innerHTML = '';

    const list = gameState.highScores || [];
    if (list.length === 0) {
        noMsg.classList.remove('hidden');
        return;
    }
    noMsg.classList.add('hidden');

    // Mostra TOP 10 + Histórico recente (até 20)
    const top10 = list.slice(0, 10);
    const recent = list.slice(0, 20);

    const makeHeader = (txt) => {
        const h = document.createElement('h2');
        h.textContent = txt;
        h.style.margin = '14px 0 8px';
        h.style.fontSize = '1.1em';
        return h;
    };

    const makeItem = (e, idx) => {
        const item = document.createElement('div');
        item.className = 'ranking-item';
        const d = new Date(e.timestamp);
        const dateStr = d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });

        const whoParts = [];
        if (e.studentName) whoParts.push(`Aluno: ${e.studentName}`);
        if (e.studentTurma) whoParts.push(`Turma: ${e.studentTurma}`);
        if (e.studentEscola) whoParts.push(`Escola: ${e.studentEscola}`);
        const whoStr = whoParts.length ? (whoParts.join(' • ') + ' • ') : '';

        const opMap = {
            addition: 'Adição (+)',
            subtraction: 'Subtração (−)',
            multiplication: 'Multiplicação (×)',
            division: 'Divisão (÷)',
            potenciacao: 'Potenciação',
            radiciacao: 'Radiciação'
        };

        const opLabel = opMap[e.operation] || e.operation;
        const lvlMap = { apprentice: 'Aprendiz', easy: 'Fácil', medium: 'Médio', advanced: 'Difícil' };
        const lvl = lvlMap[e.level] || e.level;

        item.innerHTML = `
            <div class="ranking-left">
                <div class="ranking-title"><strong>#${idx + 1}</strong> • ${opLabel} • ${lvl} • ${e.mode}${e.submode ? ' • ' + e.submode : ''}</div>
                <div class="ranking-meta">${whoStr}${dateStr} • Acertos: ${e.acertos}/${e.total} • Erros: ${e.erros} • Precisão: ${Math.round(e.accuracy)}%</div>
            </div>
            <div class="ranking-score">${e.score}</div>
        `;
        return item;
    };

    container.appendChild(makeHeader('Top 10 (Melhores pontuações)'));
    top10.forEach((e, idx) => container.appendChild(makeItem(e, idx)));

    container.appendChild(makeHeader('Histórico recente (últimas partidas)'));
    recent.forEach((e, idx) => container.appendChild(makeItem(e, idx)));
}

// --- PWA (Offline + Instalável) ---
function initPWA() {
    try {
        // Injeta o manifest sem mexer no layout do HTML
        if (!document.querySelector('link[rel="manifest"]')) {
            const link = document.createElement('link');
            link.rel = 'manifest';
            link.href = 'manifest.webmanifest';
            document.head.appendChild(link);
        }

        // Theme color para barra do navegador (especialmente mobile)
        if (!document.querySelector('meta[name="theme-color"]')) {
            const meta = document.createElement('meta');
            meta.name = 'theme-color';
            meta.content = '#111827';
            document.head.appendChild(meta);
        }

        // Service Worker (offline)
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js').then((reg) => {
                try { PET_LEVEL1_UI.bindSWUpdateFlow(); } catch (_) {}
                return reg;
            }).catch(err => {
                console.warn('Service Worker não registrado:', err);
            });
        }
    } catch (e) {
        console.warn('Falha initPWA:', e);
    }
}

// --- PAINEL DO PROFESSOR (Rede de Ensino) ---
const TEACHER_PREFS_KEY = 'matemagica_teacher_prefs_v1';

function loadTeacherPrefs() {
    try {
        const raw = localStorage.getItem(TEACHER_PREFS_KEY);
        const prefs = raw ? JSON.parse(raw) : {};
        if (prefs && typeof prefs === 'object') {
            if (prefs.projection) document.body.classList.add('projection-mode');
            if (prefs.lowStimulus) document.body.classList.add('low-stimulus');
        }
    } catch {}
}

function saveTeacherPrefs(prefs) {
    try { localStorage.setItem(TEACHER_PREFS_KEY, JSON.stringify(prefs || {})); } catch {}
}

function initTeacherPanel() {
    // Evita duplicar
    if (document.getElementById('teacher-fab')) return;

    const fab = document.createElement('button');
    fab.id = 'teacher-fab';
    fab.className = 'teacher-fab';
    fab.type = 'button';
    fab.title = 'Painel do Professor';
    fab.setAttribute('aria-label', 'Abrir Painel do Professor');
    fab.textContent = '👩‍🏫';
    document.body.appendChild(fab);

    const overlay = document.createElement('div');
    overlay.id = 'teacher-panel-overlay';
    overlay.className = 'teacher-overlay hidden';
    overlay.innerHTML = `
      <div class="teacher-panel" role="dialog" aria-modal="true" aria-label="Painel do Professor">
        <div class="teacher-panel-header">
          <h2>Painel do Professor</h2>
          <button id="tp-close" class="btn-secondary" type="button">Fechar</button>
        </div>

        <div class="teacher-panel-section">
          <div class="teacher-row">
            <button id="tp-projection" class="btn-action btn-secondary" type="button">Modo Projeção</button>
            <button id="tp-low" class="btn-action btn-secondary" type="button">Baixo Estímulo</button>
            <button id="tp-video" class="btn-action btn-secondary" type="button" title="Assistir vídeo curto explicando as funções do PET.">🎥 Ajuda em vídeo</button>
          </div>
          <p class="teacher-help">Use <strong>Projeção</strong> no datashow e <strong>Baixo estímulo</strong> para reduzir animações e distrações.</p>
          <div class="teacher-scroll-tip" aria-hidden="true">↕ Role a tela para subir ou descer dentro deste painel.</div>
        </div>

        <div class="teacher-panel-section">
          <div class="teacher-row">
            <button id="tp-export" class="btn-action btn-secondary" type="button">Exportar Dados</button>
            <button id="tp-import" class="btn-action btn-secondary" type="button">Importar Dados</button>
          </div>
          <p class="teacher-help">Exporta/Importa: XP, Ranking e Erros (backup local, sem internet).</p>
        </div>

        <div class="teacher-panel-section">
          <h3>Relatório CSV (sessões)</h3>
          <div class="tp-filter-grid" aria-label="Filtros do relatório">
            <div class="tp-field">
              <label class="tp-label" for="tp-fop">Operação</label>
              <select id="tp-fop" class="tp-input"></select>
            </div>
            <div class="tp-field">
              <label class="tp-label" for="tp-flv">Nível</label>
              <select id="tp-flv" class="tp-input"></select>
            </div>
            <div class="tp-field">
              <label class="tp-label" for="tp-fturma">Turma</label>
              <select id="tp-fturma" class="tp-input"></select>
            </div>
            <div class="tp-field">
              <label class="tp-label" for="tp-faluno">Aluno</label>
              <select id="tp-faluno" class="tp-input"></select>
            </div>
            <div class="tp-field">
              <label class="tp-label" for="tp-fstart">De</label>
              <input id="tp-fstart" class="tp-input" type="date" />
            </div>
            <div class="tp-field">
              <label class="tp-label" for="tp-fend">Até</label>
              <input id="tp-fend" class="tp-input" type="date" />
            </div>
          </div>
          <div class="teacher-row tp-export-row" style="margin-top:10px;">
            <button id="tp-export-csv" class="btn-action btn-secondary" type="button">📄 Exportar CSV (Tudo)</button>
            <button id="tp-export-csv-sessao" class="btn-action btn-secondary" type="button">📄 Só Rodadas</button>
            <button id="tp-export-csv-erros" class="btn-action btn-secondary" type="button">📄 Só Treino de Erros</button>
            <button id="tp-clear-csv-filters" class="btn-secondary" type="button">Limpar filtros</button>
          </div>
          <p id="tp-report-summary" class="teacher-help">Selecione filtros e exporte o relatório. (Dados locais deste dispositivo.)</p>

          <div class="tp-skill-report" aria-label="Leitura pedagógica por habilidade">
            <div class="tp-preview-title"><strong>Leitura pedagógica por habilidade</strong></div>
            <div class="tp-skill-cards">
              <div class="tp-skill-card">
                <div class="tp-skill-label">Habilidade atual</div>
                <div id="tp-skill-current" class="tp-skill-value">—</div>
              </div>
              <div class="tp-skill-card">
                <div class="tp-skill-label">Última habilidade dominada</div>
                <div id="tp-skill-mastered" class="tp-skill-value">—</div>
              </div>
              <div class="tp-skill-card">
                <div class="tp-skill-label">Habilidade com maior erro</div>
                <div id="tp-skill-weak" class="tp-skill-value">—</div>
              </div>
              <div class="tp-skill-card">
                <div class="tp-skill-label">Estabilidade do domínio</div>
                <div id="tp-skill-stability" class="tp-skill-value">—</div>
              </div>
            </div>
            <div class="tp-skill-grid">
              <div class="tp-skill-box">
                <div class="tp-preview-table-wrap">
                  <table class="tp-table" aria-label="Taxa de acerto por habilidade">
                    <thead>
                      <tr>
                        <th>Habilidade</th>
                        <th>Semáforo</th>
                        <th>Estabilidade</th>
                        <th>Precisão</th>
                        <th>Erro típico / distrator</th>
                      </tr>
                    </thead>
                    <tbody id="tp-skill-accuracy-body"></tbody>
                  </table>
                </div>
              </div>
              <div class="tp-skill-box">
                <div id="tp-skill-stuck" class="tp-skill-stuck-list" aria-label="Alunos travados por habilidade"></div>
              </div>
            </div>
            <div id="tp-skill-actions" class="tp-skill-actions" aria-label="Plano de intervenção automática"></div>
            <p id="tp-skill-note" class="teacher-help">Baseado nas rodadas da trilha registradas neste dispositivo.</p>
          </div>

          <div class="tp-preview" aria-label="Prévia das sessões filtradas">
            <div class="tp-preview-title"><strong>Prévia (até 30)</strong></div>
            <div class="tp-preview-table-wrap">
              <table id="tp-preview-table" class="tp-table" aria-label="Tabela de prévia das sessões">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Hora</th>
                    <th>Tipo</th>
                    <th>Operação</th>
                    <th>Nível</th>
                    <th>Modo</th>
                    <th>Questões</th>
                    <th>Precisão</th>
                    <th>Tempo</th>
                    <th>XP</th>
                  </tr>
                </thead>
                <tbody id="tp-preview-tbody"></tbody>
              </table>
            </div>
            <p id="tp-preview-note" class="teacher-help">Mostrando as últimas sessões do filtro (máx. 30). Para análise completa, exporte o CSV.</p>
          </div>
        </div>

        <div class="teacher-panel-section">
          <button id="tp-reset" class="btn-secondary" type="button">Resetar dados do perfil atual</button>
          <p class="teacher-help">Cuidado: apaga ranking, XP, conquistas e histórico do perfil atual.</p>
        </div>
      
        <div class="teacher-panel-section">
          <details class="teacher-guide">
            <summary>Guia rápido (1 minuto)</summary>
            <ul>
              <li><strong>Modo Projeção</strong>: melhora a leitura no projetor (alto contraste e tamanhos maiores).</li>
              <li><strong>Baixo Estímulo</strong>: reduz animações e flashes (bom para foco).</li>
              <li><strong>Exportar Dados</strong>: gera um arquivo JSON com ranking, erros e XP (backup / levar para outro PC).</li>
              <li><strong>Importar Dados</strong>: restaura o backup no dispositivo.</li>
              <li><strong>Perfil do estudante</strong>: na tela inicial, toque em <strong>Perfil</strong> para entrar com PIN, trocar de aluno ou usar o modo visitante. Nome/turma/escola entram no relatório.</li>
            </ul>
          </details>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);

    const prefs = (() => {
        try { return JSON.parse(localStorage.getItem(TEACHER_PREFS_KEY) || '{}'); } catch { return {}; }
    })();

    const close = () => overlay.classList.add('hidden');
    const open = () => {
        overlay.classList.remove('hidden');
        // Atualiza filtros/resumo do relatório quando abrir
        try { initCsvFiltersOnce(); } catch (_) {}
        try { updateCsvSummary(); } catch (_) {}
    };

    fab.addEventListener('click', () => {
        if (overlay.classList.contains('hidden')) open(); else close();
    });

    overlay.addEventListener('click', (e) => {
        if (e.target === overlay) close();
    });

    overlay.querySelector('#tp-close').addEventListener('click', close);

    // Botão na Home (se existir) abre o painel do professor
    try {
        const homeBtn = document.getElementById('btn-open-teacher-panel');
        if (homeBtn) {
            homeBtn.addEventListener('click', () => {
                try { open(); } catch (_) {}
            });
        }

    // Vídeo de ajuda (mesmo vídeo da Home)
    try {
        const btnVideo = overlay.querySelector('#tp-video');
        const openVideo = () => {
            try {
                if (typeof window.PET_OPEN_TUTORIAL_VIDEO === 'function') return window.PET_OPEN_TUTORIAL_VIDEO();
                const hb = document.getElementById('btn-open-tutorial-video');
                if (hb && typeof hb.click === 'function') hb.click();
            } catch (_) {}
        };
        if (btnVideo) {
            btnVideo.addEventListener('click', openVideo);
            btnVideo.addEventListener('pointerup', (e) => {
                if (e && e.pointerType && e.pointerType !== 'mouse') {
                    try { openVideo(); } catch (_) {}
                }
            });
        }
    } catch (_) {}

    } catch (_) {}

    // Toggles
    const btnProj = overlay.querySelector('#tp-projection');
    const btnLow = overlay.querySelector('#tp-low');

    const refreshBtnStates = () => {
        btnProj.classList.toggle('active', !!prefs.projection);
        btnLow.classList.toggle('active', !!prefs.lowStimulus);
        btnProj.textContent = prefs.projection ? 'Projeção: ON' : 'Modo Projeção';
        btnLow.textContent = prefs.lowStimulus ? 'Baixo estímulo: ON' : 'Baixo Estímulo';
    };

    btnProj.addEventListener('click', () => {
        prefs.projection = !prefs.projection;
        document.body.classList.toggle('projection-mode', !!prefs.projection);
        saveTeacherPrefs(prefs);
        refreshBtnStates();
    });

    btnLow.addEventListener('click', () => {
        prefs.lowStimulus = !prefs.lowStimulus;
        document.body.classList.toggle('low-stimulus', !!prefs.lowStimulus);
        saveTeacherPrefs(prefs);
        refreshBtnStates();
    });

    // Export / Import
    const exportBtn = overlay.querySelector('#tp-export');
    const importBtn = overlay.querySelector('#tp-import');

    // Relatório CSV (sessões) com filtros
    const csvOpSel = overlay.querySelector('#tp-fop');
    const csvLvSel = overlay.querySelector('#tp-flv');
    const csvClassSel = overlay.querySelector('#tp-fturma');
    const csvStudentSel = overlay.querySelector('#tp-faluno');
    const csvStart = overlay.querySelector('#tp-fstart');
    const csvEnd = overlay.querySelector('#tp-fend');
    const csvSummary = overlay.querySelector('#tp-report-summary');
    const csvExportBtn = overlay.querySelector('#tp-export-csv');
    const csvClearBtn = overlay.querySelector('#tp-clear-csv-filters');
    const csvExportSessaoBtn = overlay.querySelector('#tp-export-csv-sessao');
    const csvExportErrosBtn = overlay.querySelector('#tp-export-csv-erros');
    const previewTbody = overlay.querySelector('#tp-preview-tbody');
    const previewNote = overlay.querySelector('#tp-preview-note');
    const skillCurrentEl = overlay.querySelector('#tp-skill-current');
    const skillMasteredEl = overlay.querySelector('#tp-skill-mastered');
    const skillWeakEl = overlay.querySelector('#tp-skill-weak');
    const skillStabilityEl = overlay.querySelector('#tp-skill-stability');
    const skillAccuracyBody = overlay.querySelector('#tp-skill-accuracy-body');
    const skillStuckEl = overlay.querySelector('#tp-skill-stuck');
    const skillActionsEl = overlay.querySelector('#tp-skill-actions');
    const skillNoteEl = overlay.querySelector('#tp-skill-note');

    const fillSelect = (sel, options) => {
        if (!sel) return;
        sel.innerHTML = '';
        options.forEach((opt) => {
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label;
            sel.appendChild(o);
        });
    };

    const initCsvFiltersOnce = () => {
        try {
            if (csvOpSel && csvOpSel.options && csvOpSel.options.length) return; // já preenchido

            const opOptions = [
                { value: 'all', label: 'Todas' },
                { value: 'addition', label: 'Adição (+)' },
                { value: 'subtraction', label: 'Subtração (-)' },
                { value: 'multiplication', label: 'Multiplicação (×)' },
                { value: 'division', label: 'Divisão (÷)' },
                { value: 'potenciacao', label: 'Potenciação (aⁿ)' },
                { value: 'radiciacao', label: 'Radiciação (√)' }
            ];
            const lvOptions = [
                { value: 'all', label: 'Todos' },
                { value: 'apprentice', label: 'Aprendiz' },
                { value: 'easy', label: 'Fácil' },
                { value: 'medium', label: 'Médio' },
                { value: 'advanced', label: 'Avançado' }
            ];

            fillSelect(csvOpSel, opOptions);
            fillSelect(csvLvSel, lvOptions);

            // Turma/Aluno: deriva do histórico (perfil) para permitir filtros sem cadastro extra
            const histAll = loadAllPetSessionHistory();
            const turmaSet = new Map(); // name -> name
            const alunoSetByTurma = new Map(); // turma -> Set(aluno)

            (Array.isArray(histAll) ? histAll : []).forEach((it) => {
                const turma = String(it.className || it.profileTurma || '').trim();
                const aluno = String(it.studentName || it.profileName || '').trim();
                if (turma) {
                    turmaSet.set(turma, turma);
                    if (!alunoSetByTurma.has(turma)) alunoSetByTurma.set(turma, new Set());
                    if (aluno) alunoSetByTurma.get(turma).add(aluno);
                }
            });

            const turmaOptions = [{ value: 'all', label: 'Todas' }]
                .concat(Array.from(turmaSet.values()).sort((a,b)=>a.localeCompare(b,'pt-BR')).map(t => ({ value: 'n:' + t, label: t })));

            fillSelect(csvClassSel, turmaOptions);

            const rebuildAlunoOptions = () => {
                const tSel = csvClassSel ? String(csvClassSel.value || 'all') : 'all';
                const opts = [{ value: 'all', label: 'Todos' }];
                if (tSel !== 'all' && tSel.startsWith('n:')) {
                    const turma = tSel.slice(2);
                    const set = alunoSetByTurma.get(turma);
                    if (set && set.size) {
                        Array.from(set.values()).sort((a,b)=>a.localeCompare(b,'pt-BR')).forEach((a) => {
                            opts.push({ value: 'n:' + a, label: a });
                        });
                    }
                }
                fillSelect(csvStudentSel, opts);
            };

            rebuildAlunoOptions();
            if (csvClassSel) {
                csvClassSel.addEventListener('change', () => {
                    rebuildAlunoOptions();
                });
            }

            // Padrão: últimos 30 dias
            const today = petDateKeyLocal();
            if (csvStart && !csvStart.value) csvStart.value = petAddDaysToKey(today, -30);
            if (csvEnd && !csvEnd.value) csvEnd.value = today;
        } catch (_) {}
    };


    const sessionTypeLabel = (t) => {
        const type = String(t || '');
        if (type === 'treino_erros') return 'Treino de Erros';
        return 'Rodada';
    };

    const formatXPCell = (it) => {
        const earned = Math.round(Number(it.xpEarned || 0));
        const bonus = Math.round(Number(it.xpBonus || 0));
        const total = earned + bonus;
        if (bonus > 0) return `${total} (+${bonus})`;
        return String(total);
    };

    const renderCsvPreview = (itemsDesc) => {
        try {
            if (!previewTbody) return;

            const arr = Array.isArray(itemsDesc) ? itemsDesc : [];
            const top = arr.slice(0, 30);

            previewTbody.innerHTML = '';

            if (!top.length) {
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 10;
                td.className = 'tp-empty';
                td.textContent = 'Nenhuma sessão encontrada com os filtros atuais.';
                tr.appendChild(td);
                previewTbody.appendChild(tr);
                return;
            }

            top.forEach((it) => {
                const tr = document.createElement('tr');

                const cells = [
                    formatDateBRFromTs(it.endedAt),
                    formatTimeBR(it.endedAt),
                    sessionTypeLabel(it.sessionType),
                    (it.operationLabel || it.operation || ''),
                    (it.levelLabel || it.level || ''),
                    (it.modeLabel || it.mode || ''),
                    String(it.answered ?? ''),
                    (it.accuracy == null ? '' : `${numBR(it.accuracy, 1)}%`),
                    (it.avgSec == null ? '' : `${numBR(it.avgSec, 1)}s`),
                    formatXPCell(it)
                ];

                cells.forEach((val, i) => {
                    const td = document.createElement('td');
                    if (i === 2) {
                        const span = document.createElement('span');
                        span.className = 'tp-pill ' + (String(it.sessionType) === 'treino_erros' ? 'tp-pill-warn' : 'tp-pill-ok');
                        span.textContent = val;
                        td.appendChild(span);
                    } else {
                        td.textContent = val;
                    }
                    tr.appendChild(td);
                });

                previewTbody.appendChild(tr);
            });
        } catch (_) {}
    };

    const renderTeacherSkillReport = (itemsDesc) => {
        try {
            const report = buildTeacherSkillReport(itemsDesc);

            if (skillCurrentEl) skillCurrentEl.textContent = report.currentSkill || '—';
            if (skillMasteredEl) skillMasteredEl.textContent = report.lastMastered || '—';
            if (skillWeakEl) skillWeakEl.textContent = report.highestError || '—';
            if (skillStabilityEl) skillStabilityEl.textContent = report.stabilitySummary || '—';
            if (skillNoteEl) skillNoteEl.textContent = report.note || 'Baseado nas rodadas da trilha registradas neste dispositivo.';

            if (skillAccuracyBody) {
                skillAccuracyBody.innerHTML = '';
                if (!report.skillRows.length) {
                    const tr = document.createElement('tr');
                    const td = document.createElement('td');
                    td.colSpan = 5;
                    td.className = 'tp-empty';
                    td.textContent = 'Sem dados suficientes por habilidade neste filtro.';
                    tr.appendChild(td);
                    skillAccuracyBody.appendChild(tr);
                } else {
                    report.skillRows.forEach((row) => {
                        const tr = document.createElement('tr');
                        const values = [row.label, row.trafficLabel, row.stabilityLabel, `${numBR(row.accuracy, 1)}%`, `${row.commonError} | ${row.commonDistractor}`];
                        values.forEach((val, idx) => {
                            const td = document.createElement('td');
                            td.textContent = val;
                            if (idx === 0 || idx === 4) td.style.whiteSpace = 'normal';
                            if (idx === 1) {
                                td.className = `tp-traffic-cell tp-traffic-${row.trafficCode || 'yellow'}`;
                            }
                            tr.appendChild(td);
                        });
                        skillAccuracyBody.appendChild(tr);
                    });
                }
            }

            if (skillStuckEl) {
                skillStuckEl.innerHTML = '';
                if (!report.stuckGroups.length) {
                    const div = document.createElement('div');
                    div.className = 'tp-empty';
                    div.textContent = 'Nenhum agrupamento de alunos travados na mesma habilidade neste filtro.';
                    skillStuckEl.appendChild(div);
                } else {
                    report.stuckGroups.forEach((group) => {
                        const box = document.createElement('div');
                        box.className = 'tp-skill-stuck-item';
                        const title = document.createElement('div');
                        title.className = 'tp-skill-stuck-title';
                        title.textContent = `${group.label} • ${group.trafficLabel}`;
                        const meta = document.createElement('div');
                        meta.className = 'tp-skill-stuck-meta';
                        meta.textContent = `${group.count} aluno(s) abaixo de 80% • média ${numBR(group.avgAccuracy, 1)}% • ${group.stabilityLabel}`;
                        const names = document.createElement('div');
                        names.className = 'tp-skill-stuck-names';
                        names.textContent = group.students.join(', ');
                        const prereq = document.createElement('div');
                        prereq.className = 'tp-skill-stuck-meta';
                        prereq.textContent = `Pré-requisito/base: ${group.prerequisite}`;
                        const err = document.createElement('div');
                        err.className = 'tp-skill-stuck-meta';
                        err.textContent = `Erro típico: ${group.commonError} • Distrator dominante: ${group.commonDistractor}`;
                        const plan = document.createElement('div');
                        plan.className = 'tp-skill-plan';
                        plan.textContent = group.planText;
                        box.appendChild(title);
                        box.appendChild(meta);
                        box.appendChild(names);
                        box.appendChild(prereq);
                        box.appendChild(err);
                        box.appendChild(plan);
                        skillStuckEl.appendChild(box);
                    });
                }
            }

            if (skillActionsEl) {
                skillActionsEl.innerHTML = '';
                if (!report.interventions.length) {
                    const div = document.createElement('div');
                    div.className = 'tp-empty';
                    div.textContent = 'Sem intervenção automática prioritária neste filtro.';
                    skillActionsEl.appendChild(div);
                } else {
                    report.interventions.forEach((item) => {
                        const box = document.createElement('div');
                        box.className = 'tp-skill-action-item';
                        const title = document.createElement('div');
                        title.className = 'tp-skill-stuck-title';
                        title.textContent = `${item.label} • ${item.trafficLabel}`;
                        const meta = document.createElement('div');
                        meta.className = 'tp-skill-stuck-meta';
                        meta.textContent = `${item.stabilityLabel} • Base: ${item.prerequisite}`;
                        const err = document.createElement('div');
                        err.className = 'tp-skill-stuck-meta';
                        err.textContent = `Erro típico dominante: ${item.commonError} • Distrator dominante: ${item.commonDistractor}`;
                        const plan = document.createElement('div');
                        plan.className = 'tp-skill-plan';
                        plan.textContent = item.planText;
                        box.appendChild(title);
                        box.appendChild(meta);
                        box.appendChild(err);
                        box.appendChild(plan);
                        skillActionsEl.appendChild(box);
                    });
                }
            }
        } catch (_) {}
    };
    const updateCsvSummary = () => {
        try {
            if (!csvSummary) return;
            const hist = loadAllPetSessionHistory();
            const filtered = filterPetSessionHistory(hist, {
                operation: csvOpSel ? csvOpSel.value : 'all',
                level: csvLvSel ? csvLvSel.value : 'all',
                classKey: csvClassSel ? csvClassSel.value : 'all',
                studentKey: csvStudentSel ? csvStudentSel.value : 'all',
                startDate: csvStart ? csvStart.value : '',
                endDate: csvEnd ? csvEnd.value : ''
            });

            // Contagem por tipo (rodadas vs treino de erros)
            let countRodadas = 0;
            let countTreinos = 0;
            filtered.forEach((it) => {
                const t = String(it.sessionType || '');
                if (t === 'treino_erros') countTreinos += 1;
                else countRodadas += 1;
            });

            const s = summarizePetSessions(filtered);
            const avgAcc = (s.avgAccuracy == null) ? '-' : `${numBR(s.avgAccuracy, 1)}%`;
            const avgSec = (s.avgSec == null) ? '-' : `${numBR(s.avgSec, 1)}s`;
            const first = s.firstTs ? formatDateBRFromTs(s.firstTs) : '-';
            const last = s.lastTs ? formatDateBRFromTs(s.lastTs) : '-';

            csvSummary.textContent =
                `Sessões no filtro: ${s.sessions} (Rodadas: ${countRodadas} | Treino de erros: ${countTreinos}) | ` +
                `Questões: ${s.totalAnswered} | Precisão média: ${avgAcc} | Tempo médio: ${avgSec} | Período: ${first} → ${last}`;

            // Prévia (top 30)
            try { renderCsvPreview(filtered); } catch (_) {}
            try { renderTeacherSkillReport(filtered); } catch (_) {}

            // Nota contextual
            try {
                if (previewNote) {
                    previewNote.textContent = `Mostrando as últimas ${Math.min(30, filtered.length)} sessão(ões) do filtro (máx. 30). Para análise completa, exporte o CSV.`;
                }
            } catch (_) {}
        } catch (_) {
            try {
                if (csvSummary) csvSummary.textContent = 'Selecione filtros e exporte o relatório. (Dados locais deste dispositivo.)';
            } catch (_) {}
            try { renderCsvPreview([]); } catch (_) {}
        }
    };

    const clearCsvFilters = () => {
        try {
            if (csvOpSel) csvOpSel.value = 'all';
            if (csvLvSel) csvLvSel.value = 'all';
            if (csvClassSel) csvClassSel.value = 'all';
            if (csvStudentSel) csvStudentSel.value = 'all';
            if (csvStart) csvStart.value = '';
            if (csvEnd) csvEnd.value = '';
            updateCsvSummary();
        } catch (_) {}
    };

    // Mantém o resumo sempre atualizado
    const bindCsvInputs = () => {
        [csvOpSel, csvLvSel, csvClassSel, csvStudentSel, csvStart, csvEnd].forEach((el) => {
            if (!el) return;
            el.addEventListener('change', updateCsvSummary);
        });
        if (csvClearBtn) csvClearBtn.addEventListener('click', clearCsvFilters);
        if (csvExportBtn) {
            csvExportBtn.addEventListener('click', () => {
                try {
                    const hist = loadAllPetSessionHistory();
                    const filtered = filterPetSessionHistory(hist, {
                        operation: csvOpSel ? csvOpSel.value : 'all',
                        level: csvLvSel ? csvLvSel.value : 'all',
                        classKey: csvClassSel ? csvClassSel.value : 'all',
                studentKey: csvStudentSel ? csvStudentSel.value : 'all',
                startDate: csvStart ? csvStart.value : '',
                        endDate: csvEnd ? csvEnd.value : ''
                    });
                    const today = petDateKeyLocal();
                    const opTag = (csvOpSel && csvOpSel.value !== 'all') ? csvOpSel.value : 'todas';
                    const lvTag = (csvLvSel && csvLvSel.value !== 'all') ? csvLvSel.value : 'todos';
                    const filename = `PET_relatorio_sessoes_${today}_op-${opTag}_nv-${lvTag}.csv`;
                    exportPetSessionHistoryCSVUsingItems(filtered, { filename });
                } catch (_) {
                    try { PET_LEVEL1_UI.showToast('Não foi possível exportar o relatório filtrado.', { type: 'error', timeout: 3000 }); } catch (_) {}
                }
            });
        }

        if (csvExportSessaoBtn) {
            csvExportSessaoBtn.addEventListener('click', () => {
                try {
                    const hist = loadAllPetSessionHistory();
                    const filtered = filterPetSessionHistory(hist, {
                        operation: csvOpSel ? csvOpSel.value : 'all',
                        level: csvLvSel ? csvLvSel.value : 'all',
                        classKey: csvClassSel ? csvClassSel.value : 'all',
                studentKey: csvStudentSel ? csvStudentSel.value : 'all',
                startDate: csvStart ? csvStart.value : '',
                        endDate: csvEnd ? csvEnd.value : ''
                    }).filter(it => String(it.sessionType || '') === 'sessao');

                    const today = petDateKeyLocal();
                    const opTag = (csvOpSel && csvOpSel.value !== 'all') ? csvOpSel.value : 'todas';
                    const lvTag = (csvLvSel && csvLvSel.value !== 'all') ? csvLvSel.value : 'todos';
                    const filename = `PET_relatorio_rodadas_${today}_op-${opTag}_nv-${lvTag}.csv`;
                    exportPetSessionHistoryCSVUsingItems(filtered, { filename });
                } catch (_) {
                    try { PET_LEVEL1_UI.showToast('Não foi possível exportar apenas as rodadas.', { type: 'error', timeout: 3000 }); } catch (_) {}
                }
            });
        }

        if (csvExportErrosBtn) {
            csvExportErrosBtn.addEventListener('click', () => {
                try {
                    const hist = loadAllPetSessionHistory();
                    const filtered = filterPetSessionHistory(hist, {
                        operation: csvOpSel ? csvOpSel.value : 'all',
                        level: csvLvSel ? csvLvSel.value : 'all',
                        classKey: csvClassSel ? csvClassSel.value : 'all',
                studentKey: csvStudentSel ? csvStudentSel.value : 'all',
                startDate: csvStart ? csvStart.value : '',
                        endDate: csvEnd ? csvEnd.value : ''
                    }).filter(it => String(it.sessionType || '') === 'treino_erros');

                    const today = petDateKeyLocal();
                    const opTag = (csvOpSel && csvOpSel.value !== 'all') ? csvOpSel.value : 'todas';
                    const lvTag = (csvLvSel && csvLvSel.value !== 'all') ? csvLvSel.value : 'todos';
                    const filename = `PET_relatorio_treino_erros_${today}_op-${opTag}_nv-${lvTag}.csv`;
                    exportPetSessionHistoryCSVUsingItems(filtered, { filename });
                } catch (_) {
                    try { PET_LEVEL1_UI.showToast('Não foi possível exportar apenas o treino de erros.', { type: 'error', timeout: 3000 }); } catch (_) {}
                }
            });
        }
    };

    const downloadTextFile = (filename, text) => {
        const blob = new Blob([text], { type: 'application/json;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 500);
    };

    exportBtn.addEventListener('click', () => {
        const payload = {
            version: 'v12',
            exportedAt: Date.now(),
            xp: gameState.xp,
            errors: gameState.errors || [],
            highScores: gameState.highScores || [],
            teacherPrefs: prefs || {}
        };
        downloadTextFile('matemagica_backup.json', JSON.stringify(payload, null, 2));
        showFeedbackMessage('Backup exportado!', 'success');
    });

    importBtn.addEventListener('click', () => {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'application/json';
        input.style.display = 'none';
        document.body.appendChild(input);

        input.addEventListener('change', () => {
            const file = input.files && input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = () => {
                try {
                    const data = JSON.parse(String(reader.result || '{}'));
                    // ✅ Importação de progresso do ALUNO (exportado na Área do Estudante)
                    try {
                        if (data && data.petStudentExport === true && Array.isArray(data.sessionHistory)) {
                            const existing = loadPetSessionHistory();
                            const seen = new Set((existing || []).map(it => String(it.id || it.endedAt || '')));
                            const incoming = data.sessionHistory.filter(it => {
                                const k = String(it.id || it.endedAt || '');
                                if (!k || seen.has(k)) return false;
                                seen.add(k);
                                return true;
                            });
                            const merged = (existing || []).concat(incoming);
                            savePetSessionHistory(merged);
                            try { showFeedbackMessage('Progresso do aluno importado! (Sessões adicionadas ao relatório)', 'success'); } catch (_) {}
                            // Não retorna: ainda pode importar backup do professor no mesmo arquivo? (mantemos continuidade)
                        }
                    } catch (_) {}
                    if (data.xp != null) { gameState.xp = Number(data.xp) || 0; profileStorageSetText('matemagica_xp', String(gameState.xp)); }
                    if (Array.isArray(data.errors)) { gameState.errors = data.errors; salvarErros(); }
                    if (Array.isArray(data.highScores)) { gameState.highScores = data.highScores; salvarRanking(); }
                    if (data.teacherPrefs) { saveTeacherPrefs(data.teacherPrefs); loadTeacherPrefs(); }
                    showFeedbackMessage('Backup importado! Recarregando...', 'success', 2500);
                    setTimeout(() => location.reload(), 700);
                } catch (e) {
                    showFeedbackMessage('Arquivo inválido.', 'error');
                }
            };
            reader.readAsText(file);
            input.remove();
        });

        input.click();
    });

    // Reset
    overlay.querySelector('#tp-reset').addEventListener('click', () => {
        if (!confirm(isGuestProfileActive() ? 'Tem certeza? Isso apaga os dados do visitante nesta sessão.' : 'Tem certeza? Isso apaga XP, ranking, conquistas e histórico do perfil ativo neste computador.')) return;
        try {
            profileStorageRemove('matemagica_xp');
            profileStorageRemove('matemagica_errors');
            profileStorageRemove(RANKING_STORAGE_KEY);
            localStorage.removeItem(TEACHER_PREFS_KEY);
            // Também remove sessão em andamento (se existir)
            profileStorageRemove(PET_SESSION_KEY);
        } catch {}
        showFeedbackMessage(isGuestProfileActive() ? 'Dados do visitante apagados. Recarregando...' : 'Dados do perfil ativo apagados. Recarregando...', 'info', 2000);
        setTimeout(() => location.reload(), 700);
    });

    // Inicializa e liga o relatório CSV (sessões)
    try { initCsvFiltersOnce(); } catch (_) {}
    try { bindCsvInputs(); } catch (_) {}
    try { updateCsvSummary(); } catch (_) {}

    refreshBtnStates();
}


function initStudentPanel() {
    // Evita duplicar
    if (document.getElementById('student-panel-overlay')) return;

    const overlay = document.createElement('div');
    overlay.id = 'student-panel-overlay';
    overlay.className = 'teacher-overlay hidden';
    overlay.setAttribute('aria-hidden', 'true');

    overlay.innerHTML = `
      <div class="teacher-panel" role="dialog" aria-modal="true" aria-label="Área do Estudante">
        <div class="teacher-panel-header">
          <h2>Área do Estudante</h2>
          <button id="sp-close" class="btn-secondary" type="button">Fechar</button>
        </div>

        <div class="teacher-panel-section">
          <h3>Seu resumo (últimos 7 dias)</h3>
          <div class="tp-filter-grid" aria-label="Resumo dos últimos 7 dias">
            <div class="tp-field">
              <div class="tp-label">Sessões</div>
              <div class="tp-input" id="sp-kv-sessions" aria-label="Sessões nos últimos 7 dias">0</div>
            </div>
            <div class="tp-field">
              <div class="tp-label">Precisão média</div>
              <div class="tp-input" id="sp-kv-acc" aria-label="Precisão média nos últimos 7 dias">—</div>
            </div>
            <div class="tp-field">
              <div class="tp-label">Tempo médio</div>
              <div class="tp-input" id="sp-kv-sec" aria-label="Tempo médio por questão">—</div>
            </div>
            <div class="tp-field">
              <div class="tp-label">Sequência</div>
              <div class="tp-input" id="sp-kv-streak" aria-label="Sequência de dias estudados">0</div>
            </div>
          </div>

          <p id="sp-insight" class="teacher-help">—</p>

          <div class="teacher-scroll-tip" aria-hidden="true">↕ Role a tela para subir ou descer dentro deste painel.</div>

          <div class="teacher-row" style="margin-top:10px;">
            <button id="sp-read" class="btn-action btn-secondary" type="button" title="Ler o resumo em voz alta (se o áudio do dispositivo permitir).">🔊 Ler meu resumo</button>
            <button id="sp-video" class="btn-action btn-secondary" type="button" title="Assistir vídeo curto explicando as funções do PET.">🎥 Ajuda em vídeo</button>
          </div>
        </div>

        <div class="teacher-panel-section">
          <h3>Dicas do seu desempenho</h3>
          <div class="tp-preview" aria-label="Dicas e pontos de atenção">
            <div class="tp-preview-title"><strong>Foco recomendado</strong></div>
            <div id="sp-focus" class="teacher-help">—</div>
            <div class="tp-preview-title" style="margin-top:10px;"><strong>Você está indo bem em</strong></div>
            <div id="sp-strong" class="teacher-help">—</div>
          </div>
        </div>

        <div class="teacher-panel-section">
          <h3>Exportar para o professor</h3>
          <div class="teacher-row">
            <button id="sp-export" class="btn-action btn-secondary" type="button" title="Baixa um arquivo (.json) para enviar ao professor (WhatsApp/e-mail).">📤 Baixar progresso (JSON)</button>
            <button id="sp-copy" class="btn-action btn-secondary" type="button" title="Copia um código compacto do seu progresso para colar e enviar ao professor.">📋 Copiar código</button>
          </div>
          <p class="teacher-help">
            Seus dados ficam <strong>somente neste dispositivo</strong>. Ao exportar, você escolhe quando compartilhar com o professor.
          </p>
        </div>
      </div>
    `;

    document.body.appendChild(overlay);

    let lastFocusEl = null;

    const isOpen = () => !overlay.classList.contains('hidden');

    const close = () => {
        overlay.classList.add('hidden');
        overlay.setAttribute('aria-hidden', 'true');
        try { if (lastFocusEl && lastFocusEl.focus) lastFocusEl.focus(); } catch (_) {}
        lastFocusEl = null;
    };

    const open = () => {
        lastFocusEl = document.activeElement;
        refreshStudentPanel();
        overlay.classList.remove('hidden');
        overlay.setAttribute('aria-hidden', 'false');
        try { overlay.querySelector('#sp-close')?.focus(); } catch (_) {}
    };

    // fechar ao clicar fora do painel
    overlay.addEventListener('click', (e) => {
        try { if (e.target === overlay) close(); } catch (_) {}
    });

    overlay.querySelector('#sp-close')?.addEventListener('click', close);

    // ESC fecha
    document.addEventListener('keydown', (e) => {
        if (!isOpen()) return;
        if (e.key === 'Escape') {
            e.preventDefault();
            close();
        }
    });

    // Focus trap simples (Tab)
    overlay.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        if (!isOpen()) return;
        const focusables = overlay.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const list = Array.from(focusables).filter(el => !el.disabled && el.offsetParent !== null);
        if (!list.length) return;
        const first = list[0];
        const last = list[list.length - 1];
        const active = document.activeElement;
        if (e.shiftKey && active === first) {
            e.preventDefault();
            last.focus();
        } else if (!e.shiftKey && active === last) {
            e.preventDefault();
            first.focus();
        }
    });

    // Botão na Home abre a área do estudante
    try {
        const homeBtn = document.getElementById('btn-open-student-panel');
        if (homeBtn) homeBtn.addEventListener('click', () => { try { open(); } catch (_) {} });

    // Vídeo de ajuda (mesmo vídeo da Home)
    try {
        const btnVideo = overlay.querySelector('#sp-video');
        const openVideo = () => {
            try {
                if (typeof window.PET_OPEN_TUTORIAL_VIDEO === 'function') return window.PET_OPEN_TUTORIAL_VIDEO();
                const hb = document.getElementById('btn-open-tutorial-video');
                if (hb && typeof hb.click === 'function') hb.click();
            } catch (_) {}
        };
        if (btnVideo) {
            btnVideo.addEventListener('click', openVideo);
            btnVideo.addEventListener('pointerup', (e) => {
                if (e && e.pointerType && e.pointerType !== 'mouse') {
                    try { openVideo(); } catch (_) {}
                }
            });
        }
    } catch (_) {}

    } catch (_) {}

    // Ler resumo
    overlay.querySelector('#sp-read')?.addEventListener('click', () => {
        try {
            const sessions = overlay.querySelector('#sp-kv-sessions')?.textContent || '';
            const acc = overlay.querySelector('#sp-kv-acc')?.textContent || '';
            const sec = overlay.querySelector('#sp-kv-sec')?.textContent || '';
            const streak = overlay.querySelector('#sp-kv-streak')?.textContent || '';
            const insight = overlay.querySelector('#sp-insight')?.textContent || '';
            const msg = `Seu resumo dos últimos 7 dias. Sessões: ${sessions}. Precisão média: ${acc}. Tempo médio: ${sec}. Sequência: ${streak} dias. ${insight}`;
            if (typeof speak === 'function') speak(msg);
        } catch (_) {}
    });

    // Exportar JSON
    overlay.querySelector('#sp-export')?.addEventListener('click', () => {
        try {
            const payload = buildStudentExportPayload();
            downloadTextFile('pet_progresso_aluno.json', JSON.stringify(payload, null, 2), 'application/json;charset=utf-8');
            try { showFeedbackMessage('Progresso exportado! Envie o arquivo ao professor.', 'success'); } catch (_) {}
        } catch (_) {
            try { showFeedbackMessage('Não foi possível exportar agora.', 'error'); } catch (_) {}
        }
    });

    // Copiar código
    overlay.querySelector('#sp-copy')?.addEventListener('click', async () => {
        try {
            const payload = buildStudentExportCodePayload();
            const code = encodeStudentExportCode(payload);
            try {
                await navigator.clipboard.writeText(code);
                try { showFeedbackMessage('Código copiado! Cole e envie ao professor.', 'success'); } catch (_) {}
            } catch (_) {
                // fallback: prompt
                window.prompt('Copie o código abaixo e envie ao professor:', code);
            }
        } catch (_) {
            try { showFeedbackMessage('Não foi possível copiar o código.', 'error'); } catch (_) {}
        }
    });

    // helpers locais para download e código (reaproveita do professor se existir)
    function downloadTextFile(filename, text, mime) {
        const blob = new Blob([text], { type: mime || 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 500);
    }

    function encodeStudentExportCode(payload) {
        try {
            const jsonStr = JSON.stringify(payload);
            // btoa seguro para unicode
            const utf8 = encodeURIComponent(jsonStr).replace(/%([0-9A-F]{2})/g, (_, p1) => String.fromCharCode(parseInt(p1, 16)));
            const b64 = btoa(utf8);

            // Base64 URL-safe (melhor para WhatsApp) e sem padding
            return 'PET.' + b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
        } catch (_) {
            return '';
        }
    }

    // Payload compacto para o "Copiar código" (curto e importável).
    function buildStudentExportCodePayload() {
        const full = buildStudentExportPayload();
        const now = Date.now();
        const maxDays = 14;
        const cutoff = now - (maxDays * 24 * 60 * 60 * 1000);

        const opMap = {
            addition: 'a',
            subtraction: 's',
            multiplication: 'm',
            division: 'd',
            exponentiation: 'p',
            radication: 'r'
        };
        const lvlMap = { apprentice: 'p', easy: 'e', medium: 'm', advanced: 'a' };

        const history = Array.isArray(full.sessionHistory) ? full.sessionHistory : [];
        const recent = history
            .filter(it => Number(it.endedAt || 0) >= cutoff)
            .slice(0, 50); // limita para manter curto

        const sessions = recent.map(it => {
            const endedAt = Number(it.endedAt || 0);
            const dayAgo = Math.max(0, Math.min(maxDays, Math.floor((now - endedAt) / (24 * 60 * 60 * 1000))));
            const op = opMap[String(it.operation || '')] || 'x';
            const lvl = lvlMap[String(it.level || '')] || 'm';
            const acc10 = Math.round((Number(it.accuracy || 0)) * 10);      // % em décimos
            const sec10 = (it.avgSec == null) ? -1 : Math.round((Number(it.avgSec || 0)) * 10);
            const ans = Math.max(0, Math.round(Number(it.answered || 0)));
            const hit = Math.max(0, Math.round(Number(it.hits || 0)));
            const mis = Math.max(0, Math.round(Number(it.misses || 0)));
            const fast = String(it.mode || '') === 'rapido' ? 1 : 0;
            return [dayAgo, op, lvl, acc10, sec10, ans, hit, mis, fast];
        });

        return {
            v: 1,                 // versão do código
            t: now,               // export timestamp
            av: String(full.appVersion || ''),
            p: [String(full.profile?.name || ''), String(full.profile?.turma || ''), String(full.profile?.escola || '')],
            pr: [Number(full.progress?.streak || 0) || 0, Number(full.progress?.xp || 0) || 0],
            s: sessions
        };
    }

    function buildStudentExportPayload() {
        const history = (typeof loadPetSessionHistory === 'function') ? loadPetSessionHistory() : [];
        const progress = (typeof loadPetProgress === 'function') ? loadPetProgress() : {};
        const profile = (typeof getStudentProfile === 'function') ? (getStudentProfile() || {}) : {};
        return {
            petStudentExport: true,
            exportedAt: Date.now(),
            appVersion: (document.body.getAttribute('data-version') || ''),
            profile: {
                name: String(profile.name || ''),
                turma: String(profile.turma || ''),
                escola: String(profile.escola || '')
            },
            progress,
            sessionHistory: Array.isArray(history) ? history : []
        };
    }

    function refreshStudentPanel() {
        try {
            const history = (typeof loadPetSessionHistory === 'function') ? loadPetSessionHistory() : [];
            const now = Date.now();
            const weekAgo = now - (7 * 24 * 60 * 60 * 1000);
            const last7 = Array.isArray(history) ? history.filter(it => Number(it.endedAt || 0) >= weekAgo) : [];
            const sum = (typeof summarizePetSessions === 'function') ? summarizePetSessions(last7.slice().reverse()) : { sessions: last7.length };

            // streak
            let streak = 0;
            try { streak = Number((typeof loadPetProgress === 'function' ? loadPetProgress() : {}).streak || 0) || 0; } catch (_) {}

            overlay.querySelector('#sp-kv-sessions').textContent = String(sum.sessions || 0);
            overlay.querySelector('#sp-kv-acc').textContent = (sum.avgAccuracy == null) ? '—' : `${Math.round(sum.avgAccuracy * 10) / 10}%`;
            overlay.querySelector('#sp-kv-sec').textContent = (sum.avgSec == null) ? '—' : `${Math.round(sum.avgSec * 10) / 10}s`;
            overlay.querySelector('#sp-kv-streak').textContent = String(streak);

            // dificuldades: por maior misses e menor acurácia
            const worst = last7
                .filter(it => Number(it.answered || 0) >= 5)
                .sort((a,b) => (Number(b.misses||0) - Number(a.misses||0)) || (Number(a.accuracy||0) - Number(b.accuracy||0)))
                .slice(0,3);

            const best = last7
                .filter(it => Number(it.answered || 0) >= 5)
                .sort((a,b) => (Number(b.accuracy||0) - Number(a.accuracy||0)) || (Number(b.hits||0) - Number(a.hits||0)))
                .slice(0,3);

            const fmt = (it) => {
                const op = String(it.operationLabel || it.operation || '');
                const lv = String(it.levelLabel || it.level || '');
                const acc = (it.accuracy == null) ? '' : ` — ${Math.round(Number(it.accuracy||0)*10)/10}%`;
                return `${op} • ${lv}${acc}`;
            };

            const focusText = worst.length
                ? `Priorize: ${worst.map(fmt).join(' | ')}. Sugestão: treine no Modo Estudo e faça 10 questões sem pressa.`
                : `Você não tem dados suficientes dos últimos 7 dias. Faça 1–2 sessões no Modo Estudo para gerar um diagnóstico.`;

            const strongText = best.length
                ? `${best.map(fmt).join(' | ')}. Continue mantendo a consistência!`
                : `—`;

            overlay.querySelector('#sp-focus').textContent = focusText;
            overlay.querySelector('#sp-strong').textContent = strongText;

            // insight curto
            const insight = (sum.sessions || 0) === 0
                ? 'Sem sessões nos últimos 7 dias. Uma sessão curta hoje já reativa sua sequência.'
                : (sum.avgAccuracy != null && sum.avgAccuracy < 70)
                    ? 'Sua precisão está abaixo de 70%. Use o Modo Estudo para entender o passo a passo.'
                    : 'Bom trabalho! Mantenha consistência e tente melhorar um pouco o tempo, sem perder precisão.';

            overlay.querySelector('#sp-insight').textContent = insight;
        } catch (_) {}
    }
}




/** Atualiza a interface (botão e lista) de treinamento de erros. */
function updateErrorTrainingButton() {
    const errorCount = gameState.errors.length;
    const hasErrors = errorCount > 0;
    
    // Na tela de resultados, mostra o botão para treinar erros se houver erros
    if (btnTreinarErros) {
        btnTreinarErros.style.display = hasErrors ? 'inline-block' : 'none';
    }
    
    // Na tela de Treinamento de Erros, atualiza a mensagem e botões
    if (errorCountMessage) {
        errorCountMessage.textContent = hasErrors 
            ? `Você tem ${errorCount} erro(s) salvo(s) para treinar.`
            : 'Nenhum erro salvo ainda. Comece a jogar para identificarmos seus pontos fracos!';
    }
    
    if (btnStartTraining) {
        btnStartTraining.disabled = !hasErrors;
        btnStartTraining.textContent = hasErrors 
            ? `Começar Treinamento com ${errorCount} Erros`
            : 'Começar Treinamento';
    }
    
    if (btnClearErrors) {
        btnClearErrors.disabled = !hasErrors;
    }

    if (errorListContainer) {
        displayErrorList();
    }
}

/** Exibe a lista dos últimos erros na tela de treinamento. */
function displayErrorList() {
    if (!errorListContainer) return;

    errorListContainer.innerHTML = '';
    
    // Mostra apenas os 10 últimos erros (mais recentes)
    const errorsToShow = gameState.errors.slice(-10).reverse();

    if (errorsToShow.length === 0) {
        errorListContainer.innerHTML = '<p class="incentive-message" style="text-align: center;">Jogue o Modo Rápido e erre para ver seus erros aqui!</p>';
        return;
    }

    errorsToShow.forEach(error => {
        const item = document.createElement('div');
        item.classList.add('error-item');
        
        // Formata a data (opcional, para ser mais legível)
        const date = new Date(error.timestamp).toLocaleDateString('pt-BR');
        
        item.innerHTML = `
            <div>
                <strong>Questão: ${error.question}</strong>
                <p>Sua Resposta: <span class="wrong-answer">${error.userAnswer}</span></p>
                <p>Resposta Correta: <span class="correct-answer">${error.correctAnswer}</span></p>
            </div>
            <p style="font-size: 0.8em; color: var(--cor-texto-principal); opacity: 0.7;">
                ${error.operation.toUpperCase()} | Errado em: ${date}
            </p>
        `;
        errorListContainer.appendChild(item);
    });
}

// --- TREINAMENTO DE ERROS (Modo Professor / Reforço) ---
function buildQuestionFromError(err) {
    // Preferência: usar num1/num2 quando disponível
    const op = err.operation || 'addition';
    let num1 = err.num1;
    let num2 = err.num2;

    // Fallback: tentar extrair da string
    if ((num1 == null || num2 == null) && typeof err.question === 'string') {
        const q = err.question;
        const mAdd = q.match(/(\d+)\s*\+\s*(\d+)/);
        const mSub = q.match(/(\d+)\s*[−-]\s*(\d+)/);
        const mMul = q.match(/(\d+)\s*[x×]\s*(\d+)/);
        const mDiv = q.match(/(\d+)\s*[÷/]\s*(\d+)/);
        const mPow = q.match(/(\d+)\s*(?:\^|⁰|¹|²|³|⁴|⁵|⁶|⁷|⁸|⁹)/); // base pelo menos

        if (mAdd) { num1 = parseInt(mAdd[1]); num2 = parseInt(mAdd[2]); }
        else if (mSub) { num1 = parseInt(mSub[1]); num2 = parseInt(mSub[2]); }
        else if (mMul) { num1 = parseInt(mMul[1]); num2 = parseInt(mMul[2]); }
        else if (mDiv) { num1 = parseInt(mDiv[1]); num2 = parseInt(mDiv[2]); }
        else if (mPow) {
            // tenta achar expoente sobrescrito (último char numérico sobrescrito)
            const base = parseInt(q);
            const sup = q.match(/[⁰¹²³⁴⁵⁶⁷⁸⁹]+/);
            if (Number.isFinite(base) && sup) {
                num1 = base;
                // converte sobrescrito
                const map = {'⁰':'0','¹':'1','²':'2','³':'3','⁴':'4','⁵':'5','⁶':'6','⁷':'7','⁸':'8','⁹':'9'};
                num2 = parseInt(sup[0].split('').map(c=>map[c]||'').join(''));
            }
        }
    }

    // monta um objeto de questão no formato do jogo
    // se num1/num2 faltarem, gera aleatória para não travar
    if (num1 == null || num2 == null) {
        const q = generateQuestion(op);
        q.answer = err.correctAnswer;
        q.question = err.question;
        q.voiceQuestion = err.question;
        return q;
    }

    const correct = Number(err.correctAnswer);

    let questionStr = '';
    let voiceQ = '';
    switch (op) {
        case 'addition':
            questionStr = `${num1} + ${num2} = ?`;
            voiceQ = `Qual é o resultado de ${num1} mais ${num2}?`;
            break;
        case 'subtraction':
            questionStr = `${num1} − ${num2} = ?`;
            voiceQ = `Qual é o resultado de ${num1} menos ${num2}?`;
            break;
        case 'multiplication':
            questionStr = `${num1} × ${num2} = ?`;
            voiceQ = `Qual é o resultado de ${num1} vezes ${num2}?`;
            break;
        case 'division':
            questionStr = `${num1} ÷ ${num2} = ?`;
            voiceQ = `Qual é o resultado de ${num1} dividido por ${num2}?`;
            break;
        case 'potenciacao': {
            const expSup = toSuperscript(num2);
            questionStr = `${num1}${expSup} = ?`;
            voiceQ = `${num1} elevado a ${num2}. Qual é o resultado?`;
            break;
        }
        case 'radiciacao':
            if (num2 === 3) {
                questionStr = `∛${num1} = ?`;
                voiceQ = `Qual é a raiz cúbica de ${num1}?`;
            } else {
                questionStr = `√${num1} = ?`;
                voiceQ = `Qual é a raiz quadrada de ${num1}?`;
            }
            break;
        default:
            questionStr = `${err.question || ''}`;
            voiceQ = `${err.question || ''}`;
            break;
    }

    const opts = buildQuestionOptions(op, correct, {
        num1,
        num2,
        questionString: questionStr.replace(/\s*=\s*\?\s*$/, ''),
        voiceQuestion: voiceQ,
        stageLabel: err.stageLabel || '',
        level: gameState.currentLevel || ''
    });

    return {
        question: questionStr,
        voiceQuestion: voiceQ,
        answer: correct,
        options: opts,
        voiceOptions: opts,
        operacao: op,
        num1: num1,
        num2: num2
    };
}

function startErrorTraining() {
    if (!Array.isArray(gameState.errors) || gameState.errors.length === 0) {
        showFeedbackMessage('Sem erros para treinar.', 'info');
        return;
    }

    // Configura modo treinamento
    gameState.isTrainingErrors = true;
    gameState.isRapidMode = false; // treinamento sem tempo
    modeEstudoBtn.classList.add('active');
    modeRapidoBtn.classList.remove('active');
    stopTimer();

    // Desabilita "mostrar resposta" e "tempo" durante o treino (foco em acerto)
    if (btnShowAnswer) btnShowAnswer.disabled = true;
    if (btnExtendTime) btnExtendTime.disabled = true;

    // Monta fila (mais recentes primeiro) – pode ajustar se quiser
    const queue = gameState.errors.slice(0, 25).map(buildQuestionFromError);
    gameState.trainingQueue = queue;
    gameState.trainingIndex = 0;

    // Define total e inicia
    gameState.totalQuestions = queue.length;
    gameState.questionNumber = 0;
    gameState.score = 0;
    gameState.acertos = 0;
    gameState.erros = 0;

    // Prioridade 2/3: zera métricas da sessão
    gameState.xpGainedRound = 0;
    gameState.__summaryShown = false;
    gameState.__petProgressUpdate = null;
    gameState.__petStreakRewardApplied = false;
    gameState.lastSkillMicroExplanationKey = '';

// Prioridade 2: métricas da sessão (para resumo pós-sessão)
    gameState.totalAnswerTimeMs = 0;
    gameState.questionsAnswered = 0;
    gameState.questionStartedAt = Date.now();
    gameState.__summaryShown = false;
    resetPriority3RoundPedagogy();
    resetSessionDiagnostics();
    gameState.isGameActive = true;
    gameState.xpGainedRound = 0;
    gameState.isTrainingErrors = false;
    gameState.attemptsThisQuestion = 0;

    // Prioridade 2: marca início da questão (para tempo médio)
    gameState.questionStartedAt = Date.now();
    if (btnShowAnswer) btnShowAnswer.disabled = false;
    if (btnExtendTime) btnExtendTime.disabled = false;

    exibirTela('game-screen');
    nextTrainingQuestion();
}

function nextTrainingQuestion() {
    const q = gameState.trainingQueue[gameState.trainingIndex];
    if (!q) {
        endTraining();
        return;
    }

    gameState.questionNumber++;
    gameState.currentQuestion = q;
    gameState.attemptsThisQuestion = 0;

    // UI
    questionCounter.textContent = `Treino: ${gameState.trainingIndex + 1}/${gameState.trainingQueue.length}`;
    questionText.textContent = q.question;

    // Carrega opções
answerOptions.forEach((btn, i) => {
        btn.classList.remove('correct', 'wrong');
        btn.disabled = false;
        const numEl = btn.querySelector('.option-number');
        const txtEl = btn.querySelector('.answer-text');
        if (numEl) numEl.textContent = `${i + 1})`;
        if (txtEl) txtEl.textContent = q.options[i];
    });

    // ✅ Garante que nenhuma alternativa venha "selecionada" (com foco)
    clearAnswerFocus();
    renderPriority3ComprehensionPanel(q, { phase: 'before' });

    // Progresso do ciclo: reusa badge existente
    updateCycleProgressUI();

    // Voz
    speakSequence(buildVoiceTextsForQuestion(q));
}

function endTraining() {
    gameState.isGameActive = false;
    gameState.isTrainingErrors = false;

    // Reabilita botões
    if (btnShowAnswer) btnShowAnswer.disabled = false;
    if (btnExtendTime) btnExtendTime.disabled = false;

    showFeedbackMessage('Treinamento concluído! 🎯', 'success', 2500);
    
    // Prioridade 3: atualiza sequência + conquistas ao concluir sessão
    try {
        const attemptsTotal3 = Math.max(1, Number(gameState.acertos || 0) + Number(gameState.erros || 0));
        const accuracy3 = (Number(gameState.acertos || 0) / attemptsTotal3) * 100;
        const answered3 = (Number.isFinite(gameState.totalQuestions) && gameState.totalQuestions !== Infinity)
            ? Number(gameState.totalQuestions)
            : Number(gameState.questionNumber || 0);

        const upd = updatePetProgressOnSessionEnd({
            answered: answered3,
            accuracy: Math.round(accuracy3 * 10) / 10,
            mode: gameState.isRapidMode ? 'rapid' : 'study'
        });

        gameState.__petProgressUpdate = upd;

        // Recompensa de sequência (XP bônus)
        try {
            const bonus = applyPetStreakRewardIfAny(upd);
            try { gameState.__petBonusXpApplied = bonus; } catch (_) {}
            if (bonus > 0) {
                try {
                    const lbl = (upd.streakReward && upd.streakReward.label) ? upd.streakReward.label : 'sequência';
                    PET_LEVEL1_UI.showToast(`🎁 Bônus de sequência: +${bonus} XP (${lbl})`);
                } catch (_) {}
            }
        } catch (_) {}

        if (upd && Array.isArray(upd.newlyUnlocked) && upd.newlyUnlocked.length) {
            const cat = getPetBadgeCatalog();
            const names = upd.newlyUnlocked
                .map(id => (cat.find(b => b.id === id)?.title) || id)
                .slice(0, 3);

            try {
                if (upd.newlyUnlocked.length === 1) {
                    PET_LEVEL1_UI.showToast(`🎖 Nova conquista: ${names[0]}`);
                } else {
                    PET_LEVEL1_UI.showToast(`🎖 ${upd.newlyUnlocked.length} conquistas desbloqueadas!`);
                }
            } catch (_) {}
        } else if (upd && upd.streakChanged) {
            try { PET_LEVEL1_UI.showToast(`🔥 Sequência: ${Number(upd.progress?.streak || 0)} dia(s)`); } catch (_) {}
        }
    } catch (_) {}

    try { recordPetCompletedSession({ sessionType: 'treino_erros', upd: gameState.__petProgressUpdate, bonusApplied: Number(gameState.__petBonusXpApplied || 0) }); } catch (_) {}

    exibirTela('result-screen');
    // Prioridade 3+: mostra recompensas/conquistas desta sessão na tela de resultado
    try { setTimeout(() => { renderPetSessionRewardsOnResultScreen(); }, 80); } catch (_) {}


    // Prioridade 2: mostra resumo pós-sessão (modal)
    try { setTimeout(() => { maybeShowSessionSummary(xpGained); }, 350); } catch (_) {}
}



// --- LÓGICA DO JOGO: GERAÇÃO DE QUESTÕES ---

function randomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}


function toSuperscript(num) {
    // Converte número inteiro para caracteres sobrescritos Unicode (ex.: 3 -> ³, 12 -> ¹²)
    const map = {
        '0': '⁰','1': '¹','2': '²','3': '³','4': '⁴','5': '⁵','6': '⁶','7': '⁷','8': '⁸','9': '⁹','-': '⁻'
    };
    return String(num).split('').map(ch => map[ch] ?? ch).join('');
}


// --- HELPERS (Tabuada e UI) ---
function shuffleArray(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
}
function rangeInclusive(min, max) {
    const out = [];
    for (let i = min; i <= max; i++) out.push(i);
    return out;
}

const OPERATION_TRAIL_INDEX_KEY = 'pet_operation_trail_index_v2';
const OPERATION_STAGE_UNLOCK_KEY = 'pet_operation_stage_unlock_v1';
const OPERATION_SKILL_REVIEW_KEY = 'pet_operation_skill_review_v1';
const MULT_APPRENTICE_COMPLETED_KEY = 'pet_multiplication_apprentice_completed_v1';

function isMultiplicationApprenticeLevel(level) {
    return String(level || '') === 'apprentice';
}

function isMultiplicationApprenticeSession() {
    return gameState.currentOperation === 'multiplication' && isMultiplicationApprenticeLevel(gameState.currentLevel) && !!(gameState.operationTrail && gameState.operationTrail.masteryMode);
}

function isMultiplicationMasteryTrailSession() {
    return gameState.currentOperation === 'multiplication' && !!(gameState.operationTrail && gameState.operationTrail.masteryMode);
}

function isMultiplicationApprenticeCompleted() {
    try { return profileStorageGetRaw(MULT_APPRENTICE_COMPLETED_KEY) === '1'; } catch (_) { return false; }
}

function setMultiplicationApprenticeCompleted(done) {
    try {
        if (done) profileStorageSetText(MULT_APPRENTICE_COMPLETED_KEY, '1');
        else profileStorageRemove(MULT_APPRENTICE_COMPLETED_KEY);
    } catch (_) {}
}

function randFrom(arr) {
    if (!Array.isArray(arr) || !arr.length) return null;
    return arr[randomInt(0, arr.length - 1)];
}

function clampTrailIndex(idx, bankSize) {
    const n = Math.max(0, Number(idx) || 0);
    const total = Math.max(0, Number(bankSize) || 0);
    if (total <= 0) return 0;
    return n >= total ? 0 : Math.floor(n);
}

function getOperationTrailKey(operation, level) {
    return `${String(operation || '')}::${String(level || '')}`;
}

function isMasteryTrailOperation(operation) {
    return operation === 'addition' || operation === 'subtraction' || operation === 'division' || operation === 'potenciacao' || operation === 'radiciacao' || operation === 'multiplication';
}

function getOperationMasteryConfig(operation, currentStage) {
    const stageCount = Math.max(1, Number(currentStage?.count) || 1);
    const base = {
        targetAccuracy: 0.8,
        reviewEvery: stageCount <= 3 ? 2 : 3,
        stageTarget: stageCount
    };

    if (operation === 'potenciacao' || operation === 'radiciacao') {
        return {
            targetAccuracy: 0.8,
            reviewEvery: stageCount <= 3 ? 2 : 3,
            stageTarget: stageCount
        };
    }

    return base;
}

function loadOperationStageUnlockMap() {
    try {
        const raw = profileStorageGetRaw(OPERATION_STAGE_UNLOCK_KEY);
        const obj = raw ? JSON.parse(raw) : {};
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (_) {
        return {};
    }
}

function saveOperationStageUnlockMap(map) {
    try { profileStorageSetJson(OPERATION_STAGE_UNLOCK_KEY, map || {}); } catch (_) {}
}

function getSavedOperationStageUnlock(operation, level, totalStages) {
    const map = loadOperationStageUnlockMap();
    const key = getOperationTrailKey(operation, level);
    const raw = Math.max(0, Number(map[key]) || 0);
    const maxIdx = Math.max(0, (Number(totalStages) || 1) - 1);
    return Math.min(raw, maxIdx);
}

function setSavedOperationStageUnlock(operation, level, stageIndex, totalStages) {
    const map = loadOperationStageUnlockMap();
    const key = getOperationTrailKey(operation, level);
    const maxIdx = Math.max(0, (Number(totalStages) || 1) - 1);
    map[key] = Math.min(Math.max(0, Number(stageIndex) || 0), maxIdx);
    saveOperationStageUnlockMap(map);
}

function loadOperationSkillReviewMap() {
    try {
        const raw = profileStorageGetRaw(OPERATION_SKILL_REVIEW_KEY);
        const obj = raw ? JSON.parse(raw) : {};
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (_) {
        return {};
    }
}

function saveOperationSkillReviewMap(map) {
    try { profileStorageSetJson(OPERATION_SKILL_REVIEW_KEY, map || {}); } catch (_) {}
}

function getOperationSkillReviewKey(operation, level, stageIndex) {
    return `${getOperationTrailKey(operation, level)}::stage::${Math.max(0, Number(stageIndex) || 0)}`;
}

function getOperationSkillReviewRecord(operation, level, stageIndex) {
    const map = loadOperationSkillReviewMap();
    return map[getOperationSkillReviewKey(operation, level, stageIndex)] || null;
}

function updateOperationSkillReviewRecord(operation, level, stageIndex, stageLabel, learningType, wasCorrect, meta = {}) {
    try {
        const map = loadOperationSkillReviewMap();
        const key = getOperationSkillReviewKey(operation, level, stageIndex);
        const now = Date.now();
        const prev = map[key] && typeof map[key] === 'object' ? map[key] : {};
        const recent = Array.isArray(prev.recentResults) ? prev.recentResults.slice(-11) : [];
        recent.push({ ok: wasCorrect ? 1 : 0, ts: now });
        const totalAsked = Math.max(0, Number(prev.totalAsked) || 0) + 1;
        const totalCorrect = Math.max(0, Number(prev.totalCorrect) || 0) + (wasCorrect ? 1 : 0);
        const typicalErrors = (prev.typicalErrors && typeof prev.typicalErrors === 'object') ? { ...prev.typicalErrors } : {};
        const bridgeStats = (prev.bridgeStats && typeof prev.bridgeStats === 'object') ? { ...prev.bridgeStats } : { asked: 0, correct: 0 };
        if (meta && meta.typicalError) {
            const keyErr = String(meta.typicalError).trim();
            if (keyErr) typicalErrors[keyErr] = Math.max(0, Number(typicalErrors[keyErr]) || 0) + 1;
        }
        if (meta && meta.isBridgeQuestion) {
            bridgeStats.asked = Math.max(0, Number(bridgeStats.asked) || 0) + 1;
            if (wasCorrect) bridgeStats.correct = Math.max(0, Number(bridgeStats.correct) || 0) + 1;
        }
        map[key] = {
            operation,
            level,
            stageIndex: Math.max(0, Number(stageIndex) || 0),
            stageLabel: String(stageLabel || prev.stageLabel || ''),
            learningType: String(learningType || prev.learningType || 'fluency'),
            totalAsked,
            totalCorrect,
            totalWrong: Math.max(0, totalAsked - totalCorrect),
            consecutiveWrong: wasCorrect ? 0 : (Math.max(0, Number(prev.consecutiveWrong) || 0) + 1),
            lastSeenAt: now,
            lastWrongAt: wasCorrect ? Number(prev.lastWrongAt || 0) : now,
            recentResults: recent,
            typicalErrors,
            lastTypicalError: String(meta?.typicalError || prev.lastTypicalError || ''),
            bridgeStats,
            lastBridgeAt: meta?.isBridgeQuestion ? now : Number(prev.lastBridgeAt || 0)
        };
        saveOperationSkillReviewMap(map);
    } catch (_) {}
}

function registerOperationSkillTypicalError(operation, level, stageIndex, stageLabel, learningType, typicalError) {
    try {
        const map = loadOperationSkillReviewMap();
        const key = getOperationSkillReviewKey(operation, level, stageIndex);
        const prev = map[key] && typeof map[key] === 'object' ? map[key] : {};
        const typicalErrors = (prev.typicalErrors && typeof prev.typicalErrors === 'object') ? { ...prev.typicalErrors } : {};
        const safe = String(typicalError || '').trim();
        if (!safe) return;
        typicalErrors[safe] = Math.max(0, Number(typicalErrors[safe]) || 0) + 1;
        map[key] = {
            ...prev,
            operation,
            level,
            stageIndex: Math.max(0, Number(stageIndex) || 0),
            stageLabel: String(stageLabel || prev.stageLabel || ''),
            learningType: String(learningType || prev.learningType || 'fluency'),
            typicalErrors,
            lastTypicalError: safe,
            lastWrongAt: Date.now()
        };
        saveOperationSkillReviewMap(map);
    } catch (_) {}
}

function getMostCommonTypicalError(record) {
    try {
        const stats = (record && typeof record.typicalErrors === 'object') ? record.typicalErrors : {};
        const ranked = Object.entries(stats).sort((a, b) => Number(b[1] || 0) - Number(a[1] || 0));
        return ranked.length ? String(ranked[0][0] || '') : '';
    } catch (_) {
        return '';
    }
}

function getSkillStabilityMeta(record, masteryThreshold = 0.8) {
    if (!record || typeof record !== 'object') return { code: 'novo', label: 'Sem histórico suficiente', detail: 'Ainda sem base suficiente para medir estabilidade.' };
    const recent = Array.isArray(record.recentResults) ? record.recentResults.slice(-4) : [];
    const previous = Array.isArray(record.recentResults) ? record.recentResults.slice(-8, -4) : [];
    const recentAcc = averageSkillWindow(recent);
    const previousAcc = previous.length ? averageSkillWindow(previous) : recentAcc;
    if (recent.length < 2 && previous.length < 2) return { code: 'novo', label: 'Sem histórico suficiente', detail: 'A habilidade ainda precisa de mais tentativas para medir estabilidade.' };
    if (recentAcc >= masteryThreshold && previousAcc >= masteryThreshold) return { code: 'stable', label: 'Mantém domínio', detail: 'A habilidade segue estável nas últimas rodadas.' };
    if (recentAcc >= masteryThreshold && previousAcc < masteryThreshold) return { code: 'today', label: 'Dominou hoje', detail: 'A habilidade avançou nesta rodada e merece reforço breve para fixar.' };
    if (recentAcc < masteryThreshold && previousAcc >= masteryThreshold) return { code: 'drop', label: 'Domínio caiu', detail: 'A habilidade já esteve estável, mas começou a oscilar.' };
    return { code: 'building', label: 'Em construção', detail: 'A habilidade ainda está em formação e pede mais prática guiada.' };
}

function getPedagogicalTrafficLight(record, masteryThreshold = 0.8) {
    if (!record || typeof record !== 'object') return { code: 'yellow', label: '🟡 Instável' };
    const recent = Array.isArray(record.recentResults) ? record.recentResults.slice(-4) : [];
    const recentAcc = averageSkillWindow(recent);
    const overall = Math.max(0, Number(record.totalCorrect || 0)) / Math.max(1, Number(record.totalAsked || 0));
    const wrongStreak = Math.max(0, Number(record.consecutiveWrong) || 0);
    if (recentAcc >= masteryThreshold && overall >= masteryThreshold && wrongStreak <= 1) return { code: 'green', label: '🟢 Dominada' };
    if (recentAcc < 0.6 || wrongStreak >= 2) return { code: 'red', label: '🔴 Intervenção' };
    return { code: 'yellow', label: '🟡 Instável' };
}

function getStageKeyFromQuestion(question, trail) {
    const resolvedStageIndex = question?.isConsolidation
        ? Math.max(0, Number(question?.consolidationStageIndex ?? question?.stageIndex ?? trail?.currentStageIndex) || 0)
        : (question?.isReview
            ? Math.max(0, Number(question?.sourceStageIndex ?? question?.stageIndex ?? trail?.currentStageIndex) || 0)
            : Math.max(0, Number(question?.masteryStageIndex ?? question?.stageIndex ?? trail?.currentStageIndex) || 0));
    const resolvedStageLabel = question?.isConsolidation
        ? String(question?.consolidationStageLabel || question?.stageLabel || '')
        : String(question?.isReview ? (question?.sourceStageLabel || question?.stageLabel || '') : (question?.masteryStageLabel || question?.stageLabel || ''));
    const learningType = question?.learningType || inferStageLearningType(trail?.operation || question?.operacao || '', resolvedStageLabel);
    return { resolvedStageIndex, resolvedStageLabel, learningType };
}

function getDistractorDiagnosis(question, selectedAnswer) {
    try {
        const q = question || {};
        const op = String(q.operacao || '');
        const label = normalizeSkillStageLabel(q.masteryStageLabel || q.stageLabel || '').toLowerCase();
        const qText = String(q.voiceQuestion || q.question || '').replace(/\s*=\s*\?\s*$/, '').trim();
        const qLower = qText.toLowerCase();
        const answer = Number(q.answer);
        const selected = Number(selectedAnswer);
        const num1 = Number(q.num1);
        const num2 = Number(q.num2);
        const knownResult = parseTrailingResult(qText);
        if (!Number.isFinite(selected) || !Number.isFinite(answer) || selected === answer) return null;

        const make = (code, errLabel, feedback) => ({ code, label: errLabel, feedback });
        const directMeta = Array.isArray(q.distractorMeta)
            ? q.distractorMeta.find((it) => Number(it?.value) === selected)
            : null;
        if (directMeta && (directMeta.code || directMeta.label || directMeta.feedback)) {
            return make(String(directMeta.code || ''), String(directMeta.label || ''), String(directMeta.feedback || ''));
        }

        if (op === 'addition') {
            if (qText.includes('?') || label.includes('parcela faltante') || label.includes('desconhecida')) {
                const known = Number.isFinite(num1) ? num1 : 0;
                const total = Number.isFinite(knownResult) ? knownResult : (Number.isFinite(num2) ? known + num2 : answer + known);
                if (selected === known) return make('addition_used_known_term', 'Confundiu a parcela faltante com a parcela já conhecida.', 'Olhe para o total e pense: qual número falta para completar a soma? Use a operação inversa para descobrir a parcela que está faltando.');
                if (selected === total) return make('addition_used_total', 'Marcou o total, não a parcela faltante.', 'Quando aparece um termo faltando, a resposta não é o total. Compare o total com a parcela conhecida e encontre quanto falta.');
                if (Number.isFinite(total) && selected === (total - known + 1 || 0)) return make('addition_missing_off_by_one', 'Achou a parcela faltante, mas errou por 1.', 'Subtraia a parcela conhecida do total e confira a diferença final com calma.');
            }
            if ((qText.match(/\+/g) || []).length >= 2) {
                const partial = Number.isFinite(num1) ? num1 : 0;
                const third = Number.isFinite(num2) ? num2 : 0;
                if (selected === partial || selected === (answer - third)) return make('addition_stopped_partial_sum', 'Parou na soma parcial e esqueceu de juntar a última parcela.', 'Some duas parcelas primeiro e depois acrescente a terceira. Não pare no resultado parcial.');
                if (selected === answer + third) return make('addition_added_last_twice', 'Contou a última parcela duas vezes.', 'Depois de somar as duas primeiras parcelas, acrescente a última apenas uma vez.');
            }
            const noCarry = placeValueAdditionWithoutCarry(num1, num2);
            if ((label.includes('reagrupamento') || noCarry !== answer) && selected === noCarry) {
                return make('addition_no_carry', 'Somou sem completar o reagrupamento.', 'Some as unidades primeiro. Quando a soma passar de 9, troque 10 unidades por 1 dezena antes de continuar.');
            }
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === Math.abs(num1 - num2)) return make('addition_as_subtraction', 'Subtraiu os números em vez de somar.', 'O sinal é de adição. Junte as quantidades em vez de comparar a diferença entre elas.');
            if (Math.abs(selected - answer) === 10) return make('addition_place_value_shift', 'Errou na troca de dezenas e unidades.', 'Confira se a dezena foi levada para a casa certa depois da soma das unidades.');
            if (Math.abs(selected - answer) === 1) return make('addition_off_by_one', 'Chegou perto, mas errou por 1.', 'Refaça a contagem final das unidades antes de confirmar a resposta.');
        }

        if (op === 'subtraction') {
            if (/^\?\s*-/.test(qText)) {
                const subtrahend = Number.isFinite(num2) ? num2 : 0;
                const diff = Number.isFinite(knownResult) ? knownResult : 0;
                if (selected === diff) return make('subtraction_used_difference', 'Marcou a diferença, não o número que falta.', 'Pense: qual número, ao tirar o subtraendo, produz a diferença dada? Some diferença e subtraendo para descobrir o minuendo.');
                if (selected === subtrahend) return make('subtraction_used_subtrahend', 'Confundiu o termo que falta com o subtraendo.', 'O valor que falta é o número inteiro antes da subtração. Some a diferença com o subtraendo para encontrá-lo.');
            }
            if (qText.includes('- ?')) {
                const minuend = Number.isFinite(num1) ? num1 : 0;
                const diff = Number.isFinite(knownResult) ? knownResult : 0;
                if (selected === diff) return make('subtraction_used_difference_again', 'Marcou a diferença em vez do termo faltante.', 'Compare o minuendo com a diferença e descubra quanto precisa ser tirado.');
                if (selected === minuend) return make('subtraction_used_minuend', 'Marcou o minuendo, não o subtraendo que falta.', 'O minuendo já está na conta. A resposta é o valor que precisa ser retirado para sobrar a diferença pedida.');
            }
            const noBorrow = placeValueSubtractionWithoutBorrow(num1, num2);
            if ((label.includes('reserva') || label.includes('emprest')) && selected === noBorrow) {
                return make('subtraction_no_borrow', 'Subtraiu sem fazer a reserva corretamente.', 'Quando o número de cima é menor, empreste 1 dezena para conseguir subtrair as unidades antes de continuar.');
            }
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 + num2)) return make('subtraction_as_addition', 'Somou os números em vez de subtrair.', 'O sinal é de subtração. Compare quanto deve ser retirado do total, não quanto seria a soma dos termos.');
            if (Math.abs(selected - answer) === 10) return make('subtraction_place_value_shift', 'Errou na troca entre dezenas e unidades.', 'Confira em qual casa a reserva foi feita e repita a subtração por ordens.');
            if (Math.abs(selected - answer) === 1) return make('subtraction_off_by_one', 'Chegou perto, mas errou por 1.', 'Refaça a última conta das unidades e confirme se não faltou uma retirada.');
        }

        if (op === 'multiplication') {
            if (qLower.includes('grupos de')) {
                const groups = Number.isFinite(num1) ? num1 : 0;
                const size = Number.isFinite(num2) ? num2 : 0;
                if (selected === groups + size) return make('multiplication_sum_instead_product', 'Somou grupos e quantidade em vez de multiplicar.', 'Multiplicar grupos iguais não é somar os dois números. Pense em quantos itens há em cada grupo e repita esse valor pelo número de grupos.');
                if (selected === groups * Math.max(1, size - 1) || selected === Math.max(1, groups - 1) * size) return make('multiplication_missed_one_group', 'Perdeu um grupo na contagem.', 'Conte grupo por grupo ou use a soma repetida para não esquecer nenhum conjunto.');
                if (selected === groups * size + size) return make('multiplication_extra_group', 'Contou um grupo a mais.', 'Confira quantos grupos realmente aparecem na situação antes de multiplicar.');
            }
            if (qText.includes(' + ')) {
                const times = Number.isFinite(num1) ? num1 : 0;
                const addend = Number.isFinite(num2) ? num2 : 0;
                if (selected === times + addend) return make('multiplication_simple_sum', 'Transformou a soma repetida em uma soma simples.', 'Na soma repetida, o mesmo número aparece várias vezes. Some todas as parcelas iguais ou pense na multiplicação correspondente.');
                if (selected === Math.max(1, times - 1) * addend) return make('multiplication_missing_repetition', 'Parou uma repetição antes de terminar a soma repetida.', 'Conte quantas parcelas iguais aparecem e só depois transforme em multiplicação.');
                if (selected === (times + 1) * addend) return make('multiplication_extra_repetition', 'Contou uma repetição a mais.', 'Confira quantas vezes o número realmente foi repetido antes de responder.');
            }
            if (/^Dobro|^Triplo/i.test(qText)) {
                const factor = Number.isFinite(num1) ? num1 : 2;
                const base = Number.isFinite(num2) ? num2 : 0;
                if (selected === base + factor) return make('multiplication_added_word_problem', 'Somou o fator ao número em vez de aplicar dobro ou triplo.', 'Dobro é 2 vezes o número. Triplo é 3 vezes o número. Multiplique o valor base pelo fator pedido.');
                if (factor === 2 && selected === base * 3) return make('multiplication_triplo_instead_dobro', 'Confundiu dobro com triplo.', 'Dobro significa 2 vezes. Triplo significa 3 vezes. Volte ao fator pedido antes de multiplicar.');
                if (factor === 3 && selected === base * 2) return make('multiplication_dobro_instead_triplo', 'Confundiu triplo com dobro.', 'Triplo é 3 vezes o número. Não pare no dobro.');
            }
            if (qText.includes('__')) {
                const step = Number.isFinite(num1) ? num1 : 0;
                const count = Number.isFinite(num2) ? num2 : 0;
                if (selected === step * Math.max(1, count - 1)) return make('multiplication_skip_one_less', 'Parou um salto antes de chegar ao total.', 'Na contagem em saltos, siga até completar todos os saltos pedidos.');
                if (selected === step * (count + 1)) return make('multiplication_skip_one_more', 'Deu um salto a mais.', 'Conte os saltos um por um e pare exatamente na quantidade pedida.');
                if (selected === step + count) return make('multiplication_skip_sum', 'Somou os números em vez de contar os saltos.', 'Contagem em saltos cresce de passo em passo. Não some o passo com a quantidade de saltos.');
            }
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 + num2)) return make('multiplication_as_addition', 'Confundiu multiplicação com adição.', 'Multiplicar não é somar os fatores. Pense em grupos iguais ou em soma repetida para achar o produto.');
            if (Number.isFinite(num1) && Number.isFinite(num2) && [num1 * Math.max(1, num2 - 1), num1 * (num2 + 1), Math.max(1, num1 - 1) * num2, (num1 + 1) * num2].includes(selected)) return make('multiplication_factor_shift', 'Errou por um fator a menos ou a mais.', 'Confira se usou o fator correto em todos os grupos antes de responder.');
        }

        if (op === 'division') {
            if (qLower.includes('(resto)')) {
                const dividend = Number.isFinite(num1) ? num1 : 0;
                const divisor = Number.isFinite(num2) && num2 !== 0 ? num2 : 1;
                const quotient = Math.floor(dividend / divisor);
                if (selected === quotient) return make('division_remainder_as_quotient', 'Confundiu resto com quociente.', 'O quociente mostra quantos grupos completos cabem. O resto é o que sobra depois da divisão.');
                if (selected === divisor) return make('division_remainder_as_divisor', 'Marcou o divisor no lugar do resto.', 'O divisor é o número que reparte. O resto é o que sobra depois de formar os grupos completos.');
                if (Math.abs(selected - answer) === 1) return make('division_remainder_neighbor', 'Chegou perto do resto, mas errou a sobra final.', 'Monte os grupos completos primeiro e conte exatamente quantos itens ainda sobram.');
            }
            if (/^\?\s*÷/.test(qText)) {
                const divisor = Number.isFinite(num2) ? num2 : 1;
                const quotient = Number.isFinite(knownResult) ? knownResult : Math.floor((answer || 0) / Math.max(1, divisor));
                if (selected === quotient) return make('division_missing_dividend_used_quotient', 'Marcou o quociente, não o dividendo.', 'Para achar o dividendo, multiplique divisor e quociente.');
                if (selected === divisor + quotient) return make('division_missing_dividend_sum', 'Somou divisor e quociente em vez de recompor a divisão.', 'Use a relação inversa: dividendo = divisor × quociente.');
                if (selected === answer + divisor) return make('division_missing_dividend_near', 'Chegou perto do dividendo, mas usou uma conta inadequada.', 'Volte para a multiplicação que recompõe a divisão.');
            }
            if (qText.includes('÷ ?')) {
                const dividend = Number.isFinite(num1) ? num1 : 0;
                const quotient = Number.isFinite(knownResult) ? knownResult : 1;
                if (selected === quotient) return make('division_missing_divisor_used_quotient', 'Marcou o quociente em vez do divisor.', 'Pergunte: por qual número devo dividir o dividendo para obter o quociente?');
                if (selected === dividend) return make('division_missing_divisor_used_dividend', 'Marcou o dividendo, não o divisor.', 'O dividendo já está na conta. A resposta deve ser o número que reparte.');
            }
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 * num2)) return make('division_as_multiplication', 'Confundiu divisão com multiplicação.', 'Na divisão, você descobre quantos cabem ou quanto fica em cada grupo. Use a multiplicação só para conferir no final.');
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 - num2)) return make('division_as_subtraction', 'Tratou a divisão como uma subtração simples.', 'Dividir não é só tirar um número do outro. Pergunte quantos grupos cabem ou quanto fica em cada grupo.');
            if (selected === num1) return make('division_used_dividend', 'Marcou o dividendo no lugar do resultado.', 'O dividendo é o número total. A resposta precisa mostrar quanto cabe ou quanto fica em cada grupo.');
            if (selected === num2) return make('division_used_divisor', 'Marcou o divisor no lugar do resultado.', 'O divisor é o número que reparte. A resposta é o quociente ou o resto, conforme a pergunta.');
        }

        if (op === 'potenciacao') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 * num2)) return make('power_as_multiplication', 'Confundiu potência com multiplicação simples.', 'Potência não é base vezes expoente. É a base multiplicada por ela mesma o número de vezes indicado pelo expoente.');
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 + num2)) return make('power_as_sum', 'Somou base e expoente.', 'Base e expoente não são somados. Reescreva a potência como multiplicação repetida.');
            if (Number.isFinite(num1) && Number.isFinite(num2) && num2 > 1 && selected === (num1 ** (num2 - 1))) return make('power_exponent_minus_one', 'Usou um expoente a menos.', 'Conte quantas vezes a base precisa aparecer na multiplicação repetida.');
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 ** (num2 + 1))) return make('power_exponent_plus_one', 'Usou um expoente a mais.', 'Confira quantas repetições da base o expoente realmente pede.');
            if (label.includes('expoente 1') && selected !== num1) return make('power_exponent_one_rule', 'Ainda não consolidou a regra do expoente 1.', 'Qualquer base elevada a 1 permanece com o próprio valor da base.');
            if (label.includes('expoente 0') && selected !== 1) return make('power_zero_rule', 'Ainda não consolidou a regra do expoente zero.', 'Qualquer base diferente de zero elevada a zero vale 1.');
        }

        if (op === 'radiciacao') {
            const isCube = Number(q.num2) === 3 || qText.includes('∛');
            if (qLower.includes('aproximada')) {
                if (Math.abs(selected - answer) === 1) return make('root_estimation_neighbor', 'Escolheu uma raiz vizinha na estimativa.', 'Compare entre quais quadrados perfeitos o número está e escolha a raiz mais próxima.');
                if (Number.isFinite(num1) && selected === Math.round(num1 / 2)) return make('root_as_half', 'Leu a raiz como metade do número.', 'Raiz não é dividir por 2. Procure o número que, multiplicado por ele mesmo, produz o valor dado.');
                if (Number.isFinite(num1) && selected === num1) return make('root_used_radicand', 'Repetiu o número que está dentro da raiz.', 'A resposta precisa ser o número que gera o radicando, não o próprio radicando.');
            }
            if (isCube) {
                if (Number.isFinite(answer) && selected === (answer * 3)) return make('cube_root_times_three', 'Multiplicou a raiz por 3 em vez de procurar o cubo exato.', 'Na raiz cúbica, pense em qual número multiplicado por ele mesmo 3 vezes gera o radicando.');
                if (Number.isFinite(num1) && selected === Math.round(Math.sqrt(Math.max(0, num1)))) return make('cube_root_as_square_root', 'Confundiu raiz cúbica com raiz quadrada.', 'Na raiz cúbica, o número aparece 3 vezes na multiplicação, não 2.');
                if (Math.abs(selected - answer) === 1) return make('cube_root_neighbor', 'Escolheu uma raiz cúbica vizinha.', 'Confira os cubos perfeitos próximos antes de responder.');
            }
            if (Number.isFinite(answer) && selected === (answer * 2)) return make('square_root_doubled', 'Dobrou a raiz em vez de procurar o número correto.', 'Raiz quadrada não é o dobro do resultado. Procure o número que multiplicado por ele mesmo gera o radicando.');
            if (Number.isFinite(num1) && selected === Math.round(num1 / 2)) return make('square_root_as_half', 'Leu a raiz como divisão por 2.', 'Raiz quadrada não é metade do número. Pense em qual número ao quadrado produz o radicando.');
            if (Number.isFinite(answer) && selected === (answer * answer)) return make('square_root_as_square', 'Deu o quadrado do número em vez da raiz.', 'A raiz desfaz a potência. Se o radicando é 49, a resposta é 7, não 49 nem 7².');
            if (Math.abs(selected - answer) === 1) return make('square_root_neighbor', 'Escolheu uma raiz vizinha.', 'Confira os quadrados perfeitos próximos para localizar a raiz exata.');
        }

        return null;
    } catch (_) {
        return null;
    }
}

function classifyTypicalError(question, selectedAnswer) {
    try {
        const diagnosis = getDistractorDiagnosis(question, selectedAnswer);
        if (diagnosis && diagnosis.label) return diagnosis.label;

        const q = question || {};
        const op = String(q.operacao || '');
        const label = normalizeSkillStageLabel(q.masteryStageLabel || q.stageLabel || '').toLowerCase();
        const answer = Number(q.answer);
        const selected = Number(selectedAnswer);
        const num1 = Number(q.num1);
        const num2 = Number(q.num2);
        if (!Number.isFinite(selected) || !Number.isFinite(answer)) return 'Erro de cálculo ou atenção nesta habilidade.';

        if (op === 'addition') {
            if (label.includes('reagrupamento') && selected < answer) return 'Somou sem completar o reagrupamento.';
            if (label.includes('parcela faltante') || label.includes('desconhecida')) return 'Teve dificuldade em usar a operação inversa para achar a parcela faltante.';
        }

        if (op === 'subtraction') {
            if ((label.includes('reserva') || label.includes('emprest')) && selected > answer) return 'Subtraiu sem fazer a reserva corretamente.';
            if (label.includes('minuendo') || label.includes('subtraendo') || label.includes('falt')) return 'Teve dificuldade em descobrir o termo faltante da subtração.';
        }

        if (op === 'multiplication') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 + num2)) return 'Confundiu multiplicação com adição.';
            if (label.includes('saltos') && selected < answer) return 'Perdeu a contagem em saltos antes de chegar ao total.';
        }

        if (op === 'division') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 * num2)) return 'Confundiu divisão com multiplicação.';
            if (label.includes('resto')) {
                const quotient = Number.isFinite(num1) && Number.isFinite(num2) && num2 !== 0 ? Math.floor(num1 / num2) : null;
                if (quotient != null && selected === quotient) return 'Confundiu resto com quociente.';
            }
            if (label.includes('divisor') || label.includes('dividendo')) return 'Teve dificuldade em identificar o papel do divisor ou do dividendo.';
        }

        if (op === 'potenciacao') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 * num2)) return 'Confundiu potência com multiplicação simples.';
            if (label.includes('expoente 0') && selected !== 1) return 'Ainda não consolidou a regra do expoente zero.';
        }

        if (op === 'radiciacao') {
            if (Number(q.num2) === 3 && Number.isFinite(num1) && selected === Math.round(num1 / 3)) return 'Leu a raiz cúbica como divisão por 3.';
            if (Number(q.num2) !== 3 && Number.isFinite(num1) && selected === Math.round(num1 / 2)) return 'Leu a raiz como divisão por 2.';
            if (Number.isFinite(num1) && selected === (Math.round(Math.sqrt(Math.abs(num1))) ** 2)) return 'Confundiu raiz com o quadrado do número.';
        }

        return 'Erro de cálculo ou atenção nesta habilidade.';
    } catch (_) {
        return 'Erro de cálculo ou atenção nesta habilidade.';
    }
}

function averageSkillWindow(arr) {
    if (!Array.isArray(arr) || !arr.length) return 1;
    const vals = arr.map((it) => Number(it?.ok ? 1 : 0));
    return vals.reduce((s, n) => s + n, 0) / vals.length;
}

function computeSkillWeaknessScore(record) {
    if (!record || typeof record !== 'object') return 1;
    const totalAsked = Math.max(0, Number(record.totalAsked) || 0);
    const totalCorrect = Math.max(0, Number(record.totalCorrect) || 0);
    const overallAcc = totalAsked > 0 ? (totalCorrect / totalAsked) : 1;
    const recent = Array.isArray(record.recentResults) ? record.recentResults.slice(-4) : [];
    const previous = Array.isArray(record.recentResults) ? record.recentResults.slice(-8, -4) : [];
    const recentAcc = averageSkillWindow(recent);
    const previousAcc = previous.length ? averageSkillWindow(previous) : recentAcc;
    const recentErrors = recent.filter((it) => !it?.ok).length;
    const decline = Math.max(0, previousAcc - recentAcc);
    const wrongStreak = Math.max(0, Number(record.consecutiveWrong) || 0);
    let score = 1;
    score += (1 - overallAcc) * 3.2;
    score += (1 - recentAcc) * 4.2;
    score += recentErrors * 1.2;
    score += Math.min(3, wrongStreak) * 1.1;
    score += decline * 6.5;
    const lastWrongAt = Math.max(0, Number(record.lastWrongAt) || 0);
    if (lastWrongAt && (Date.now() - lastWrongAt) < (1000 * 60 * 30)) score += 1.6;
    return Math.max(0.6, score);
}

function weightedPickIndex(items) {
    const safe = Array.isArray(items) ? items.filter((it) => Number(it?.weight) > 0) : [];
    if (!safe.length) return null;
    const total = safe.reduce((s, it) => s + Number(it.weight || 0), 0);
    let roll = Math.random() * total;
    for (const item of safe) {
        roll -= Number(item.weight || 0);
        if (roll <= 0) return item.index;
    }
    return safe[safe.length - 1].index;
}

function inferStageLearningType(operation, stageLabel) {
    const label = normalizeTrailLabel(stageLabel);
    if (!label) return 'fluency';
    const comprehensionTokens = [
        'faltante', 'desconhecida', 'desconhecido', 'completar', 'contexto', 'problema', 'estimativa',
        'comparar', 'compare', 'interpreta', 'relacao', 'relação', 'comutatividade', 'decomposicao',
        'decomposição', 'grupos iguais', 'soma repetida', 'contagem em saltos', 'padroes', 'padrões',
        'valor faltante', 'numero entre', 'número entre', 'expressao', 'expressão', 'leitura', 'conferencia',
        'conferência', 'reconhecer', 'escolher raiz', 'contextos', 'distributiva', 'dobro e triplo', 'ideia de'
    ];
    if (operation === 'division' && (label.includes('resto') || label.includes('dividendo') || label.includes('divisor'))) return 'comprehension';
    if (operation === 'multiplication' && (label.includes('tabuada') || label.includes('dominio final') || label.includes('domínio final'))) return 'fluency';
    if (comprehensionTokens.some((token) => label.includes(token))) return 'comprehension';
    return 'fluency';
}

function getLearningTypeLabel(type) {
    return String(type || '') === 'comprehension' ? 'Compreensão' : 'Fluência';
}

function pickSmartReviewStageIndex(operation, level, currentStageIndex) {
    const maxIdx = Math.max(0, Number(currentStageIndex) || 0);
    if (maxIdx <= 0) return 0;
    const weighted = [];
    for (let i = 0; i < maxIdx; i++) {
        const rec = getOperationSkillReviewRecord(operation, level, i);
        let weight = computeSkillWeaknessScore(rec);
        if (!rec) weight = 1 + ((i === maxIdx - 1) ? 0.8 : 0.15 * (i + 1));
        if (i === maxIdx - 1) weight += 0.7;
        weighted.push({ index: i, weight });
    }
    const picked = weightedPickIndex(weighted);
    return Number.isInteger(picked) ? picked : Math.max(0, maxIdx - 1);
}

function buildLevelConsolidationPlan(operation, level) {
    const stages = getOperationTrailStages(operation, level);
    if (!Array.isArray(stages) || !stages.length) return [];
    const analyzed = stages.map((stage, idx) => {
        const learningType = inferStageLearningType(operation, stage?.label || '');
        const weakness = computeSkillWeaknessScore(getOperationSkillReviewRecord(operation, level, idx));
        return { stageIndex: idx, stage, learningType, weakness };
    });
    const byWeakness = analyzed.slice().sort((a, b) => b.weakness - a.weakness || a.stageIndex - b.stageIndex);
    const fluency = byWeakness.filter((it) => it.learningType === 'fluency');
    const comprehension = byWeakness.filter((it) => it.learningType === 'comprehension');
    const target = Math.max(6, Math.min(8, analyzed.length >= 8 ? 8 : analyzed.length));
    const plan = [];
    const used = new Set();
    const takeFrom = (arr, n) => {
        for (const item of arr) {
            if (plan.length >= target || n <= 0) break;
            if (used.has(item.stageIndex)) continue;
            plan.push({ stageIndex: item.stageIndex, stageLabel: item.stage?.label || '', learningType: item.learningType });
            used.add(item.stageIndex);
            n--;
        }
    };
    takeFrom(comprehension, Math.min(4, Math.max(2, comprehension.length ? Math.ceil(target / 2) : 0)));
    takeFrom(fluency, Math.min(4, Math.max(2, fluency.length ? Math.ceil(target / 2) : 0)));
    takeFrom(byWeakness, target - plan.length);
    while (plan.length < target) {
        const fallback = analyzed[plan.length % analyzed.length];
        plan.push({ stageIndex: fallback.stageIndex, stageLabel: fallback.stage?.label || '', learningType: fallback.learningType });
    }
    return plan.slice(0, target).map((item, idx) => ({ ...item, seq: idx }));
}

function getConsolidationResult(operation, level, trail) {
    const cons = trail?.consolidation;
    if (!cons || !Array.isArray(cons.plan) || !cons.plan.length) return null;
    const total = Math.max(0, Number(cons.asked) || 0);
    const correct = Math.max(0, Number(cons.correct) || 0);
    const accuracy = total > 0 ? (correct / total) : 0;
    const targetAcc = Number(trail?.targetAccuracy || 0.8);
    const perStage = cons.perStage && typeof cons.perStage === 'object' ? cons.perStage : {};
    let weakStageIndex = null;
    let weakStageAccuracy = 1;
    Object.keys(perStage).forEach((key) => {
        const rec = perStage[key] || {};
        const asked = Math.max(0, Number(rec.asked) || 0);
        const hits = Math.max(0, Number(rec.correct) || 0);
        if (!asked) return;
        const acc = hits / asked;
        if (acc < targetAcc && acc <= weakStageAccuracy) {
            weakStageAccuracy = acc;
            weakStageIndex = Math.max(0, Number(key) || 0);
        }
    });
    const stages = getOperationTrailStages(operation, level) || [];
    return {
        passed: total >= cons.plan.length && accuracy >= targetAcc && weakStageIndex == null,
        total,
        correct,
        accuracy,
        weakStageIndex,
        weakStageLabel: weakStageIndex == null ? '' : String(stages[weakStageIndex]?.label || ''),
        weakLearningType: weakStageIndex == null ? '' : inferStageLearningType(operation, stages[weakStageIndex]?.label || ''),
        weakStageAccuracy: weakStageIndex == null ? null : weakStageAccuracy
    };
}

function maybeStartLevelConsolidationRound() {
    const trail = gameState.operationTrail;
    if (!trail || !trail.masteryMode || trail.consolidationMode) return false;
    const currentStage = Math.max(0, Number(trail.currentStageIndex) || 0);
    const lastStageIndex = Math.max(0, Number(trail.totalStages || 1) - 1);
    if (currentStage < lastStageIndex) return false;
    const asked = Math.max(0, Number(trail.currentStageAsked) || 0);
    const correct = Math.max(0, Number(trail.currentStageCorrect) || 0);
    const target = Math.max(1, Number(trail.stageTarget) || 1);
    const acc = asked > 0 ? (correct / asked) : 0;
    if (asked < target || acc < Number(trail.targetAccuracy || 0.8)) return false;

    const plan = buildLevelConsolidationPlan(trail.operation, trail.level);
    if (!plan.length) return false;

    trail.consolidationMode = true;
    trail.consolidation = {
        plan,
        index: 0,
        asked: 0,
        correct: 0,
        perStage: {}
    };
    trail.supportMode = 'normal';
    trail.supportEscalations = 0;
    trail.supportHint = '';
    trail.stageType = 'mixed';
    gameState.totalQuestions = Math.max(Number(gameState.totalQuestions || 0), Number(gameState.questionNumber || 0)) + plan.length;
    showFeedbackControlled('🧩 Prova de consolidação iniciada: agora o app vai misturar habilidades de fluência e compreensão para validar o nível.', 'info', gameState.isRapidMode ? 5600 : 7600);
    return true;
}

function computeMasterySessionTotalQuestions(stageCount, currentStageIndex, reviewEvery = 3) {
    const mainCount = Math.max(1, Number(stageCount) || 1);
    const idx = Math.max(0, Number(currentStageIndex) || 0);
    const spacing = Math.max(1, Number(reviewEvery) || 3);
    if (idx <= 0) return mainCount;
    let reviews = 0;
    for (let mainAsked = 1; mainAsked < mainCount; mainAsked++) {
        if (mainAsked % spacing === 0) reviews++;
    }
    return mainCount + reviews;
}

function normalizeAdaptiveSupportMode(mode) {
    const raw = String(mode || 'normal').toLowerCase().trim();
    if (raw === 'very_guided' || raw === 'muito_guiado' || raw === 'muito guiado') return 'very_guided';
    if (raw === 'guided' || raw === 'guiado') return 'guided';
    return 'normal';
}

function getAdaptiveSupportLabel(mode) {
    const safe = normalizeAdaptiveSupportMode(mode);
    if (safe === 'very_guided') return 'Muito guiado';
    if (safe === 'guided') return 'Guiado';
    return 'Normal';
}

function getAdaptiveSupportProfile(operation, level, stageLabel, mode) {
    const safe = normalizeAdaptiveSupportMode(mode);
    const label = normalizeSkillStageLabel(stageLabel).toLowerCase();
    const profile = {
        mode: safe,
        label: getAdaptiveSupportLabel(safe),
        timeMultiplier: safe === 'very_guided' ? 1.7 : (safe === 'guided' ? 1.35 : 1),
        optionsMode: safe,
        stageLabel,
        supportHint: ''
    };
    if (safe === 'normal') return profile;

    if (operation === 'addition') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: números menores, dica visual de dezenas e alternativas mais separadas.'
            : 'Apoio guiado: números menores e uma pista curta para organizar a soma.';
        if (label.includes('reagrupamento')) profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: some as unidades primeiro e marque quando passar de 9 para formar 1 dezena.'
            : 'Apoio guiado: observe quando as unidades passam de 9 e troque 10 por 1 dezena.';
    } else if (operation === 'subtraction') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: números menores, destaque para a reserva e alternativas menos parecidas.'
            : 'Apoio guiado: compare os algarismos e veja se precisa emprestar uma dezena.';
        if (label.includes('reserva')) profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: faça a reserva com calma e confira a nova dezena antes de subtrair.'
            : 'Apoio guiado: quando o número de cima é menor, empreste 1 dezena.';
    } else if (operation === 'division') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: divisões menores, grupos mais simples e menos pressão de tempo.'
            : 'Apoio guiado: pense em quantos grupos iguais podem ser formados.';
        if (label.includes('resto')) profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: divida em grupos pequenos e observe o que sobra depois de formar os grupos completos.'
            : 'Apoio guiado: forme os grupos completos primeiro; o que sobrar é o resto.';
    } else if (operation === 'potenciacao') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: bases pequenas, expoentes curtos e leitura expandida da potência.'
            : 'Apoio guiado: leia a potência como multiplicação repetida antes de calcular.';
    } else if (operation === 'radiciacao') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: raízes exatas menores e pista do quadrado ou cubo perfeito mais próximo.'
            : 'Apoio guiado: procure o número que multiplicado por ele mesmo gera o valor dado.';
    } else if (operation === 'multiplication') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: fatores menores, grupos visuais e contagem em saltos mais curta.'
            : 'Apoio guiado: pense em grupos iguais ou soma repetida antes de responder.';
    }
    return profile;
}

function getCurrentAdaptiveSupportProfile() {
    try {
        const trail = gameState.operationTrail || null;
        if (!trail || !trail.masteryMode) return null;
        return getAdaptiveSupportProfile(
            gameState.currentOperation,
            gameState.currentLevel,
            gameState.currentQuestion?.stageLabel || trail.currentStageLabel || '',
            trail.supportMode || 'normal'
        );
    } catch (_) {
        return null;
    }
}

function ensureAdaptiveSupportPanel() {
    let panel = document.getElementById('adaptive-support-panel');
    if (panel) return panel;
    try {
        const area = document.querySelector('#game-screen .question-area');
        if (!area) return null;
        panel = document.createElement('div');
        panel.id = 'adaptive-support-panel';
        panel.className = 'adaptive-support-panel hidden';
        panel.innerHTML = '<div class="adaptive-support-chip" id="adaptive-support-chip">Apoio: Normal</div><div class="adaptive-support-text" id="adaptive-support-text"></div>';
        area.appendChild(panel);
        return panel;
    } catch (_) {
        return null;
    }
}

function updateAdaptiveSupportPanel() {
    try {
        const panel = ensureAdaptiveSupportPanel();
        if (!panel) return;
        const chip = panel.querySelector('#adaptive-support-chip');
        const text = panel.querySelector('#adaptive-support-text');
        const profile = getCurrentAdaptiveSupportProfile();
        if (!profile || profile.mode === 'normal') {
            panel.classList.add('hidden');
            panel.setAttribute('aria-hidden', 'true');
            return;
        }
        panel.classList.remove('hidden');
        panel.setAttribute('aria-hidden', 'false');
        panel.dataset.mode = profile.mode;
        if (chip) chip.textContent = `Apoio: ${profile.label}`;
        if (text) text.textContent = profile.supportHint || 'Apoio ativo para reduzir a pressão e reforçar esta habilidade.';
    } catch (_) {}
}

function randIntFromList(list) {
    const arr = Array.isArray(list) ? list.filter((n) => Number.isFinite(Number(n))).map(Number) : [];
    if (!arr.length) return 0;
    return arr[Math.floor(Math.random() * arr.length)];
}

function buildAdaptiveSupportQuestion(operation, stageLabel, supportMode) {
    const safe = normalizeAdaptiveSupportMode(supportMode);
    if (safe === 'normal') return null;
    const hard = safe === 'very_guided';
    const label = normalizeSkillStageLabel(stageLabel).toLowerCase();

    if (operation === 'addition') {
        if (label.includes('completar') || label.includes('faltante')) {
            const total = hard ? randomInt(4, 10) : randomInt(6, 18);
            const known = randomInt(0, Math.max(0, total - 1));
            return qAdditionMissing(total, known, stageLabel, Math.random() < 0.5);
        }
        if (label.includes('3 parcelas') || label.includes('três parcelas')) {
            const a = hard ? randomInt(0, 3) : randomInt(0, 5);
            const b = hard ? randomInt(0, 3) : randomInt(0, 4);
            const c = hard ? randomInt(0, 3) : randomInt(0, 4);
            return qAddition3(a, b, c, stageLabel);
        }
        if (label.includes('dezenas')) {
            return qAddition(randFrom(hard ? [10,20,30] : [10,20,30,40]), randFrom(hard ? [10,20] : [10,20,30]), stageLabel);
        }
        if (label.includes('sem reagrupamento')) {
            const [a,b] = randAdditionNoCarry(hard ? 10 : 10, hard ? 24 : 38, 1, hard ? 4 : 8);
            return qAddition(a,b,stageLabel);
        }
        if (label.includes('reagrupamento')) {
            const [a,b] = randAdditionWithCarry(hard ? 10 : 14, hard ? 26 : 39, 1, hard ? 4 : 7);
            return qAddition(a,b,stageLabel);
        }
        return qAddition(hard ? randomInt(0, 9) : randomInt(4, 25), hard ? randomInt(0, 9) : randomInt(2, 18), stageLabel);
    }

    if (operation === 'subtraction') {
        if (label.includes('minuendo desconhecido') || label.includes('número que falta')) {
            const diff = hard ? randomInt(2, 15) : randomInt(5, 40);
            const sub = hard ? randomInt(0, 9) : randomInt(3, 25);
            return qUnknownMinuend(diff, sub, stageLabel);
        }
        if (label.includes('subtraendo desconhecido') || label.includes('resultado faltante') || label.includes('falta')) {
            const minuend = hard ? randomInt(8, 20) : randomInt(15, 60);
            const diff = hard ? randomInt(1, minuend - 1) : randomInt(4, minuend - 2);
            return qUnknownSubtrahend(minuend, diff, stageLabel);
        }
        if (label.includes('sem reserva')) {
            const [a,b] = randSubtractionNoBorrow(hard ? 10 : 12, hard ? 24 : 45, 0, hard ? 9 : 18);
            return qSubtraction(a,b,stageLabel);
        }
        if (label.includes('reserva')) {
            const [a,b] = randSubtractionWithBorrow(hard ? 12 : 18, hard ? 30 : 54, 1, hard ? 9 : 18);
            return qSubtraction(a,b,stageLabel);
        }
        return qSubtraction(hard ? randomInt(6, 20) : randomInt(20, 60), hard ? randomInt(0, 9) : randomInt(4, 25), stageLabel);
    }

    if (operation === 'division') {
        if (label.includes('resto')) {
            const divisor = randFrom(hard ? [2,3,4] : [2,3,4,5]);
            const quotient = hard ? randomInt(2, 5) : randomInt(2, 7);
            const remainder = randomInt(1, Math.max(1, divisor - 1));
            return qDivisionRemainder(divisor * quotient + remainder, divisor, stageLabel);
        }
        if (label.includes('dividendo')) {
            const divisor = randFrom(hard ? [2,3,4] : [2,3,4,5]);
            const quotient = hard ? randomInt(2, 5) : randomInt(2, 8);
            return qDivisionFindDividend(divisor, quotient, stageLabel);
        }
        if (label.includes('divisor')) {
            const divisor = randFrom(hard ? [2,3,4] : [2,3,4,5]);
            const quotient = hard ? randomInt(2, 5) : randomInt(2, 8);
            return qDivisionFindDivisor(divisor * quotient, quotient, stageLabel);
        }
        const [dividend, divisor] = randExactDivision(2, hard ? 4 : 6, 2, hard ? 6 : 9);
        return qDivision(dividend, divisor, stageLabel);
    }

    if (operation === 'potenciacao') {
        if (label.includes('expoente 0')) return qPower(randFrom([2,3,4,5]), 0, stageLabel);
        if (label.includes('expoente 1')) return qPower(randFrom([2,3,4,5,6]), 1, stageLabel);
        if (label.includes('cubo')) return qPower(randFrom(hard ? [2,3] : [2,3,4]), 3, stageLabel);
        if (label.includes('expandida') || label.includes('multiplicação repetida')) return qPowerExpanded(randFrom(hard ? [2,3] : [2,3,4]), hard ? 2 : randFrom([2,3]), stageLabel);
        return qPower(randFrom(hard ? [2,3,4] : [2,3,4,5]), randFrom(hard ? [2] : [2,3]), stageLabel);
    }

    if (operation === 'radiciacao') {
        if (label.includes('cúbica') || label.includes('cubica')) {
            return qCubeRoot(randIntFromList(hard ? [8, 27] : [8, 27, 64, 125]), stageLabel);
        }
        if (label.includes('estimativa') || label.includes('aproximada')) {
            return qRootEstimate(randIntFromList(hard ? [9,16,25,36] : [9,16,25,36,49,64,81]), stageLabel);
        }
        return qRoot(randIntFromList(hard ? [4,9,16,25,36] : [4,9,16,25,36,49,64,81,100]), stageLabel);
    }

    if (operation === 'multiplication') {
        if (label.includes('grupos')) return qEqualGroups(hard ? randomInt(2,4) : randomInt(2,5), hard ? randomInt(2,3) : randomInt(2,5), stageLabel);
        if (label.includes('soma repetida')) return qRepeatedAddition(randFrom(hard ? [2,3] : [2,3,4,5]), hard ? randomInt(2,3) : randomInt(2,4), stageLabel);
        if (label.includes('dobro') || label.includes('triplo')) return qDoubleTriple(hard ? randomInt(2,6) : randomInt(2,9), label.includes('triplo') && !hard ? 3 : randFrom(hard ? [2] : [2,3]), stageLabel);
        if (label.includes('saltos')) return qSkipCounting(randFrom(hard ? [2,3,5] : [2,3,5,10]), hard ? randomInt(3,4) : randomInt(3,6), stageLabel);
        const m = label.match(/tabuada[s]? do\s+(\d+)/i);
        if (m) return qMultiplicationBasic(Number(m[1]), hard ? randomInt(1,4) : randomInt(1,6), stageLabel);
        if (label.includes('tabuadas 1 e 2')) return qMultiplicationBasic(randFrom([1,2]), hard ? randomInt(1,4) : randomInt(1,6), stageLabel);
        if (label.includes('tabuadas 11 e 12')) return qMultiplicationBasic(randFrom([11,12]), hard ? randomInt(1,6) : randomInt(1,10), stageLabel);
        if (label.includes('tabuadas 13 a 15')) return qMultiplicationBasic(randFrom([13,14,15]), hard ? randomInt(1,5) : randomInt(1,8), stageLabel);
        if (label.includes('tabuadas 16 a 20')) return qMultiplicationBasic(randFrom([16,17,18,19,20]), hard ? randomInt(1,4) : randomInt(1,6), stageLabel);
        return qMultiplicationBasic(randFrom(hard ? [2,3,4,5] : [2,3,4,5,6,7,8,9,10]), hard ? randomInt(1,4) : randomInt(1,8), stageLabel);
    }

    return null;
}

function applyAdaptiveSupportToQuestion(question, meta) {
    if (!question || !meta) return question;
    const safeMode = normalizeAdaptiveSupportMode(meta.supportMode || 'normal');
    const profile = getAdaptiveSupportProfile(meta.operation, meta.level, meta.stageLabel || question.stageLabel || '', safeMode);
    question.supportMode = profile.mode;
    question.supportLabel = profile.label;
    question.supportHint = profile.supportHint || '';
    question.options = buildQuestionOptions(question.operacao || meta.operation, Number(question.answer), {
        num1: question.num1,
        num2: question.num2,
        supportMode: profile.mode,
        stageLabel: question.stageLabel || meta.stageLabel || '',
        questionString: String(question.question || '').replace(/\s*=\s*\?\s*$/, ''),
        voiceQuestion: question.voiceQuestion || question.question || '',
        level: meta.level || gameState.currentLevel || '',
        studyDistractorsOnly: !gameState.isRapidMode
    });
    question.voiceOptions = question.options;
    question.distractorMeta = Array.isArray(question.options?.__distractorMeta)
        ? question.options.__distractorMeta.map((it) => ({ ...it }))
        : [];
    return question;
}

function maybeAdjustAdaptiveSupportAfterResolution() {
    try {
        const trail = gameState.operationTrail;
        if (!trail || !trail.masteryMode) return;
        const asked = Math.max(0, Number(trail.currentStageAsked) || 0);
        if (asked <= 0) return;
        const correct = Math.max(0, Number(trail.currentStageCorrect) || 0);
        const misses = Math.max(0, asked - correct);
        const accuracy = correct / asked;
        const current = normalizeAdaptiveSupportMode(trail.supportMode || 'normal');
        let next = current;
        if (misses >= 2 && accuracy < 0.45) next = 'very_guided';
        else if (misses >= 2 || (asked >= 3 && accuracy < 0.7)) next = 'guided';
        else if (asked >= 3 && accuracy >= 0.8) next = 'normal';
        if (next === current) return;
        trail.supportMode = next;
        if (next === 'normal') {
            trail.supportHint = '';
        } else {
            const profile = getAdaptiveSupportProfile(trail.operation, trail.level, trail.currentStageLabel || '', next);
            trail.supportHint = profile.supportHint || '';
        }
        if (current === 'normal' && next !== 'normal') {
            trail.supportEscalations = Math.max(0, Number(trail.supportEscalations) || 0) + 1;
        }
        if (gameState.isRapidMode && Number.isFinite(gameState.timeLeft) && Number.isFinite(gameState.maxTime)) {
            const profile = getAdaptiveSupportProfile(trail.operation, trail.level, trail.currentStageLabel || '', next);
            const boosted = Math.round((Number(gameState.maxTime) || 0) * (profile.timeMultiplier || 1));
            if (boosted > Number(gameState.maxTime || 0)) {
                gameState.maxTime = boosted;
                gameState.timeLeft = Math.max(Number(gameState.timeLeft || 0), Math.round(boosted * 0.72));
            }
        }
        updateAdaptiveSupportPanel();
        if (next !== 'normal') {
            const profile = getAdaptiveSupportProfile(trail.operation, trail.level, trail.currentStageLabel || '', next);
            showFeedbackControlled(`🛟 Apoio ${profile.label.toLowerCase()} ativado nesta habilidade. ${profile.supportHint}`, 'info', gameState.isRapidMode ? 5200 : 7600);
        }
    } catch (_) {}
}


const INITIAL_DIAGNOSTIC_KEY = 'pet_initial_diagnostic_v1';

function loadInitialDiagnosticMap() {
    try {
        const raw = profileStorageGetRaw(INITIAL_DIAGNOSTIC_KEY);
        const obj = raw ? JSON.parse(raw) : {};
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (_) {
        return {};
    }
}

function saveInitialDiagnosticMap(map) {
    try { profileStorageSetJson(INITIAL_DIAGNOSTIC_KEY, map || {}); } catch (_) {}
}

function getInitialDiagnosticRecord(operation, level) {
    const map = loadInitialDiagnosticMap();
    return map[getOperationTrailKey(operation, level)] || null;
}

function setInitialDiagnosticRecord(operation, level, record) {
    const map = loadInitialDiagnosticMap();
    map[getOperationTrailKey(operation, level)] = record;
    saveInitialDiagnosticMap(map);
}

function getOperationLevelOrder(operation) {
    const hasApprentice = !!((getOperationTrailStages(operation, 'apprentice') || []).length);
    return hasApprentice
        ? ['apprentice', 'easy', 'medium', 'advanced']
        : ['easy', 'medium', 'advanced'];
}

function getPreviousOperationLevel(operation, level) {
    const levels = getOperationLevelOrder(operation);
    const idx = levels.indexOf(String(level || ''));
    return idx > 0 ? levels[idx - 1] : null;
}

function isStageBasedOperationLevel(operation, level) {
    const stages = getOperationTrailStages(operation, level);
    return Array.isArray(stages) && stages.length > 0;
}

function shouldRunInitialDiagnostic(operation, level, force = false) {
    if (!operation || !level) return false;
    if (String(level || '') !== 'apprentice') return false;
    if (!isStageBasedOperationLevel(operation, level)) return false;
    if (operation === 'multiplication' && gameState.multiplication && gameState.multiplication.mode === 'direct') return false;
    if (force) return true;
    const rec = getInitialDiagnosticRecord(operation, level);
    if (rec && rec.completed) return false;
    const stages = getOperationTrailStages(operation, level);
    if (Array.isArray(stages) && stages.length) {
        const unlocked = getSavedOperationStageUnlock(operation, level, stages.length);
        if (unlocked > 0) return false;
    }
    return true;
}

function getDiagnosticStageSampleIndices(totalStages) {
    const maxIdx = Math.max(0, Number(totalStages || 1) - 1);
    const base = [0, 1, 3, 5, 7, 9];
    const out = [];
    base.forEach((idx) => {
        const safe = Math.max(0, Math.min(maxIdx, Number(idx) || 0));
        if (!out.includes(safe)) out.push(safe);
    });
    for (let i = 0; out.length < Math.min(6, Math.max(1, maxIdx + 1)); i++) {
        const safe = Math.max(0, Math.min(maxIdx, i));
        if (!out.includes(safe)) out.push(safe);
        if (i > maxIdx + 6) break;
    }
    return out.slice(0, 6);
}

function buildInitialDiagnosticPlan(operation, level) {
    const stages = getOperationTrailStages(operation, level);
    if (!Array.isArray(stages) || !stages.length) return [];
    const indices = getDiagnosticStageSampleIndices(stages.length);
    return indices.map((stageIndex, idx) => ({
        seq: idx,
        operation,
        level,
        stageIndex,
        stage: stages[stageIndex] || stages[0],
        totalStages: stages.length,
        bankSize: getOperationTrailBankSize(operation, level)
    })).filter((it) => it && it.stage && typeof it.stage.gen === 'function');
}

function getDiagnosticSuggestedStageIndex(correctCount, totalStages) {
    const maxIdx = Math.max(0, Number(totalStages || 1) - 1);
    const map = [0, 0, 1, 2, 4, 6, 8];
    const safeCorrect = Math.max(0, Math.min(6, Number(correctCount) || 0));
    return Math.max(0, Math.min(maxIdx, map[safeCorrect] ?? 0));
}

function setModeButtonVisualState(isRapid) {
    if (modeRapidoBtn) modeRapidoBtn.classList.toggle('active', !!isRapid);
    if (modeEstudoBtn) modeEstudoBtn.classList.toggle('active', !isRapid);
}

function buildDiagnosticReinforcementText(results) {
    const wrong = Array.isArray(results) ? results.filter((it) => !it.correct) : [];
    if (!wrong.length) return 'Você demonstrou segurança nas habilidades amostradas desta trilha.';
    const counts = {};
    wrong.forEach((it) => {
        const label = String(it.stageLabel || 'Habilidade atual').trim();
        counts[label] = (counts[label] || 0) + 1;
    });
    const ranked = Object.entries(counts).sort((a,b) => b[1] - a[1]).slice(0, 2).map(([label]) => label);
    if (!ranked.length) return 'Faça uma retomada breve da habilidade atual antes de acelerar.';
    if (ranked.length === 1) return `Reforço indicado: ${ranked[0]}.`;
    return `Reforço indicado: ${ranked[0]} e ${ranked[1]}.`;
}

function normalizeTrailLabel(str) {
    return String(str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
}

function findStageIndexByKeywords(stages, keywords) {
    if (!Array.isArray(stages) || !Array.isArray(keywords) || !keywords.length) return -1;
    const wanted = keywords.map((k) => normalizeTrailLabel(k)).filter(Boolean);
    return stages.findIndex((stage) => {
        const label = normalizeTrailLabel(stage?.label || '');
        return wanted.every((token) => label.includes(token));
    });
}

function getSkillPrerequisiteInfo(operation, stageLabel) {
    const label = normalizeTrailLabel(stageLabel);
    const base = { label: 'Base anterior da própria habilidade', action: 'Aplique 1 rodada guiada e retome a habilidade em Modo Estudo.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: [] };
    if (!label) return base;

    if (operation === 'addition' && label.includes('reagrupamento')) {
        return { label: 'Composição de dezenas e soma sem reagrupamento', action: 'Retomar composição de dezenas e uma rodada guiada de soma sem reagrupamento antes do “vai um”.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['sem reagrupamento'] };
    }
    if (operation === 'subtraction' && label.includes('reserva')) {
        return { label: 'Valor posicional e subtração sem reserva', action: 'Retomar valor posicional e uma rodada guiada de subtração sem reserva antes do empréstimo.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['sem reserva'] };
    }
    if (operation === 'division' && label.includes('resto')) {
        return { label: 'Multiplicação e agrupamento', action: 'Treinar a relação multiplicação × divisão e agrupamentos antes de voltar ao resto.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['relação', 'multiplicação', 'divisão'] };
    }
    if (operation === 'division' && (label.includes('divisor') || label.includes('dividendo'))) {
        return { label: 'Leitura da estrutura da divisão', action: 'Retomar quem é total, divisor e quociente com uma rodada guiada de leitura de divisão.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['quociente'] };
    }
    if (operation === 'multiplication' && (label.includes('tabuada') || label.includes('produtos maiores'))) {
        return { label: 'Grupos iguais e contagem em saltos', action: 'Voltar para grupos iguais e contagem em saltos antes de acelerar a tabuada.', avoidRapid: label.includes('tabuada do 7') || label.includes('tabuada do 8') || label.includes('tabuada do 9'), guidedRounds: 1, sameOperationKeywords: ['grupos iguais'] };
    }
    if (operation === 'potenciacao') {
        return { label: 'Multiplicação repetida', action: 'Reescrever a potência como produto repetido antes de tentar de novo.', avoidRapid: label.includes('expoente 0') || label.includes('expoente 1'), guidedRounds: 1, sameOperationKeywords: ['multiplicação repetida'] };
    }
    if (operation === 'radiciacao' && (label.includes('raiz cubica') || label.includes('raizes cubicas') || label.includes('raízes cúbicas'))) {
        return { label: 'Potenciação e cubos perfeitos', action: 'Consolidar cubos perfeitos e a relação entre potência e raiz antes das raízes cúbicas.', avoidRapid: true, guidedRounds: 2, sameOperationKeywords: ['relação entre potência e raiz'] };
    }
    if (operation === 'radiciacao') {
        return { label: 'Potenciação e quadrados perfeitos', action: 'Reforçar quadrados perfeitos e a relação inversa entre potência e raiz.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['quadrados perfeitos'] };
    }
    return base;
}

function findPrerequisiteStageIndex(operation, stages, stageLabel) {
    const info = getSkillPrerequisiteInfo(operation, stageLabel);
    const keywords = Array.isArray(info.sameOperationKeywords) ? info.sameOperationKeywords : [];
    const idx = findStageIndexByKeywords(stages, keywords);
    return idx;
}

function buildTeacherInterventionPlan({ operation = '', level = '', stageIndex = 0, stageLabel = '', record = null, studentNames = [] } = {}) {
    const prerequisite = getSkillPrerequisiteInfo(operation, stageLabel);
    const traffic = getPedagogicalTrafficLight(record);
    const stability = getSkillStabilityMeta(record);
    const commonError = getMostCommonTypicalError(record) || 'Sem erro típico dominante ainda.';
    const parts = [];
    if (traffic.code === 'red') parts.push('Aplicar 1 rodada guiada imediatamente.');
    else if (traffic.code === 'yellow') parts.push('Aplicar 1 retomada curta antes de acelerar.');
    else parts.push('Manter uma revisão curta para fixar o domínio.');
    parts.push(prerequisite.action);
    if (prerequisite.avoidRapid) parts.push('Evitar Modo Rápido nesta habilidade até estabilizar.');
    if (stability.code === 'drop') parts.push('O domínio caiu: revisar essa habilidade por 2 sessões curtas.');
    const who = Array.isArray(studentNames) && studentNames.length ? `Aluno(s): ${studentNames.join(', ')}.` : '';
    return {
        prerequisite: prerequisite.label,
        commonError,
        stability: stability.label,
        traffic: traffic.label,
        planText: `${who} ${parts.join(' ')}`.trim()
    };
}

function getAutomaticRetakeRecommendation(operation, level, trail) {
    if (!trail || !trail.masteryMode) return '';
    const asked = Math.max(0, Number(trail.currentStageAsked) || 0);
    const correct = Math.max(0, Number(trail.currentStageCorrect) || 0);
    if (asked <= 0) return '';

    const accuracy = asked > 0 ? (correct / asked) : 0;
    const currentStageIndex = Math.max(0, Number(trail.currentStageIndex) || 0);
    const stages = getOperationTrailStages(operation, level) || [];
    const totalStages = Math.max(1, Number(trail.totalStages || stages.length || 1));
    const currentLabel = String(trail.currentStageLabel || stages[currentStageIndex]?.label || 'Habilidade atual').trim();
    const normalizedLabel = normalizeTrailLabel(currentLabel);
    const targetAccuracy = Number(trail.targetAccuracy || 0.8);
    const passed = asked >= Math.max(1, Number(trail.stageTarget) || 1) && accuracy >= targetAccuracy;
    if (passed) return '';

    let suggestedStageIndex = currentStageIndex;
    let suggestionIntro = 'Retomada sugerida:';
    const prerequisite = getSkillPrerequisiteInfo(operation, currentLabel);
    let reason = prerequisite.action || 'treine esta habilidade no Modo Estudo antes de tentar avançar de novo.';

    const prereqIdx = findPrerequisiteStageIndex(operation, stages, currentLabel);
    if (prereqIdx >= 0 && prereqIdx < currentStageIndex) {
        suggestedStageIndex = prereqIdx;
    } else if (operation === 'radiciacao' && normalizedLabel.includes('cubica') && currentStageIndex > 0) {
        suggestedStageIndex = currentStageIndex - 1;
        reason = 'consolide mais uma etapa de raízes quadradas e só depois volte para as raízes cúbicas.';
    } else if (accuracy < 0.45 && currentStageIndex > 0) {
        suggestedStageIndex = currentStageIndex - 1;
        reason = 'o melhor caminho agora é voltar uma etapa para reconstruir a base antes de tentar de novo.';
    } else if (accuracy < targetAccuracy) {
        suggestionIntro = 'Próxima retomada sugerida:';
        reason = `${prerequisite.action || 'Vale refazer esta mesma etapa no Modo Estudo para fechar as lacunas antes de subir.'}${prerequisite.avoidRapid ? ' Evite o Modo Rápido nesta habilidade até estabilizar.' : ''}`;
    }

    const safeIndex = Math.max(0, Math.min(totalStages - 1, suggestedStageIndex));
    const suggestedLabel = String(stages[safeIndex]?.label || currentLabel).trim() || 'Habilidade atual';

    if (safeIndex === currentStageIndex) {
        return `${suggestionIntro} refaça a Etapa ${safeIndex + 1}: ${suggestedLabel}. ${reason}`;
    }
    return `${suggestionIntro} volte para a Etapa ${safeIndex + 1}: ${suggestedLabel}. ${reason}`;
}

function diagEscapeHtml(str) {
    return String(str || '').replace(/[&<>"']/g, (s) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
}

function closeDiagnosticSummaryOverlay() {
    const overlay = document.getElementById('diag-summary-overlay');
    if (overlay) overlay.remove();
}

function showDiagnosticSummaryOverlay(summary) {
    closeDiagnosticSummaryOverlay();
    const overlay = document.createElement('div');
    overlay.id = 'diag-summary-overlay';
    overlay.style.position = 'fixed';
    overlay.style.inset = '0';
    overlay.style.zIndex = '99999';
    overlay.style.display = 'flex';
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';
    overlay.style.padding = '18px';
    overlay.style.background = 'rgba(0,0,0,.62)';
    overlay.innerHTML = `
        <div style="width:min(92vw,560px); background:#fff; color:#111; border-radius:18px; padding:20px 18px; box-shadow:0 18px 44px rgba(0,0,0,.28); font-family:inherit;">
            <div style="display:flex; justify-content:space-between; gap:12px; align-items:flex-start; margin-bottom:10px;">
                <div>
                    <div style="font-size:1.05rem; font-weight:800;">Diagnóstico inicial concluído</div>
                    <div style="font-size:.94rem; opacity:.82; margin-top:4px;">${diagEscapeHtml(formatOperationLabel(summary.operation))} • Nível ${diagEscapeHtml(petLevelLabel(summary.selectedLevel))}</div>
                </div>
                <button type="button" id="diag-summary-close" aria-label="Fechar" style="border:none; background:#f2f2f2; border-radius:999px; width:34px; height:34px; font-size:1.1rem; cursor:pointer;">×</button>
            </div>
            <p style="margin:8px 0 0; line-height:1.45;"><strong>Acertos:</strong> ${summary.correct}/${summary.total}.</p>
            <p style="margin:8px 0 0; line-height:1.45;"><strong>Entrada sugerida:</strong> Nível ${diagEscapeHtml(petLevelLabel(summary.recommendedLevel))} • Etapa ${summary.stageIndex + 1}/${summary.totalStages}${summary.stageLabel ? ` — ${diagEscapeHtml(summary.stageLabel)}` : ''}.</p>
            <p style="margin:8px 0 0; line-height:1.45;"><strong>O que pode pular:</strong> ${diagEscapeHtml(summary.skipText)}</p>
            <p style="margin:8px 0 0; line-height:1.45;"><strong>Onde reforçar:</strong> ${diagEscapeHtml(summary.reinforcementText)}</p>
            ${summary.recommendedLevel !== summary.selectedLevel ? `<p style="margin:8px 0 0; line-height:1.45; color:#7a4b00;"><strong>Ajuste automático:</strong> esta sessão vai começar no nível ${diagEscapeHtml(petLevelLabel(summary.recommendedLevel))} para evitar começar difícil demais.</p>` : ''}
            <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:16px;">
                <button type="button" id="diag-summary-start" style="flex:1 1 220px; border:none; background:#111; color:#fff; border-radius:12px; padding:12px 14px; font-weight:700; cursor:pointer;">Iniciar trilha</button>
                <button type="button" id="diag-summary-redo" style="flex:1 1 160px; border:1px solid #d0d0d0; background:#fff; color:#111; border-radius:12px; padding:12px 14px; font-weight:700; cursor:pointer;">Refazer diagnóstico</button>
            </div>
        </div>
    `;
    document.body.appendChild(overlay);

    const close = () => closeDiagnosticSummaryOverlay();
    overlay.querySelector('#diag-summary-close')?.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });

    const startBtn = overlay.querySelector('#diag-summary-start');
    if (startBtn) {
        startBtn.addEventListener('click', () => {
            close();
            gameState.isDiagnosticMode = false;
            gameState.diagnostic = null;
            gameState.isRapidMode = !!summary.originalRapidMode;
            setModeButtonVisualState(gameState.isRapidMode);
            startGame(summary.operation, summary.recommendedLevel, { skipDiagnostic: true });
        });
    }

    const redoBtn = overlay.querySelector('#diag-summary-redo');
    if (redoBtn) {
        redoBtn.addEventListener('click', () => {
            close();
            gameState.isDiagnosticMode = false;
            gameState.diagnostic = null;
            gameState.isRapidMode = !!summary.originalRapidMode;
            setModeButtonVisualState(gameState.isRapidMode);
            startDiagnosticSession(summary.operation, summary.selectedLevel, { force: true, originalRapidMode: !!summary.originalRapidMode });
        });
    }
}

function finalizeInitialDiagnostic() {
    const diag = gameState.diagnostic;
    if (!diag) return;

    const results = Array.isArray(diag.results) ? diag.results.slice() : [];
    const total = Math.max(1, Number(diag.plan?.length) || results.length || 1);
    const correct = results.filter((it) => !!it.correct).length;
    const selectedLevel = diag.selectedLevel;
    const operation = diag.operation;
    let recommendedLevel = selectedLevel;
    let stageIndex = 0;

    const prevLevel = getPreviousOperationLevel(operation, selectedLevel);
    if (correct <= 1 && prevLevel && isStageBasedOperationLevel(operation, prevLevel)) {
        recommendedLevel = prevLevel;
        stageIndex = 0;
    } else {
        const stages = getOperationTrailStages(operation, selectedLevel) || [];
        stageIndex = getDiagnosticSuggestedStageIndex(correct, stages.length || 10);
    }

    const recommendedStages = getOperationTrailStages(operation, recommendedLevel) || [];
    const totalStages = Math.max(1, recommendedStages.length || 10);
    stageIndex = Math.max(0, Math.min(totalStages - 1, Number(stageIndex) || 0));
    const stageLabel = String(recommendedStages[stageIndex]?.label || 'Etapa inicial').trim();

    setSavedOperationStageUnlock(operation, recommendedLevel, stageIndex, totalStages);

    const skipText = stageIndex > 0
        ? `As etapas 1 a ${stageIndex} podem ser puladas nesta entrada inicial.`
        : 'Nenhuma etapa será pulada: a trilha começa na base para consolidar a habilidade.';

    const reinforcementText = buildDiagnosticReinforcementText(results);

    const summary = {
        operation,
        selectedLevel,
        recommendedLevel,
        correct,
        total,
        stageIndex,
        totalStages,
        stageLabel,
        skipText,
        reinforcementText,
        originalRapidMode: !!diag.originalRapidMode
    };

    setInitialDiagnosticRecord(operation, selectedLevel, {
        completed: true,
        ts: Date.now(),
        correct,
        total,
        recommendedLevel,
        stageIndex,
        reinforcementText
    });

    gameState.isDiagnosticMode = false;
    gameState.isGameActive = false;
    gameState.diagnostic = { ...diag, summary };
    stopTimer();
    try { clearSavedPetSession(); } catch (_) {}
    try { refreshContinueSessionButtonVisibility(); } catch (_) {}

    showDiagnosticSummaryOverlay(summary);
}

function startDiagnosticSession(operation, level, options = {}) {
    const plan = buildInitialDiagnosticPlan(operation, level);
    if (!plan.length) {
        startGame(operation, level, { skipDiagnostic: true });
        return;
    }

    try { ensurePetStorageVersion(); } catch (_) {}
    try { clearSavedPetSession(); } catch (_) {}

    const originalRapidMode = (typeof options.originalRapidMode === 'boolean')
        ? !!options.originalRapidMode
        : !!gameState.isRapidMode;

    gameState.currentOperation = operation;
    gameState.currentLevel = level;
    gameState.operationTrail = { operation: '', level: '', key: '', startIndex: 0, bankSize: 0, totalStages: plan.length };
    gameState.isGameActive = true;
    gameState.isDiagnosticMode = true;
    gameState.diagnostic = {
        operation,
        selectedLevel: level,
        originalRapidMode,
        force: !!options.force,
        plan,
        results: []
    };
    gameState.score = 0;
    gameState.questionNumber = 0;
    gameState.acertos = 0;
    gameState.erros = 0;
    gameState.answerLocked = false;
    gameState.attemptsThisQuestion = 0;
    gameState.currentQuestion = null;
    gameState.totalQuestions = plan.length;
    gameState.isRapidMode = false;
    setModeButtonVisualState(false);
    gameState.maxTime = Infinity;
    gameState.timeLeft = Infinity;

    playerScoreElement.textContent = 'Diagnóstico';

    const timeContainer = timeBar?.parentElement;
    if (timeContainer) timeContainer.style.display = 'none';
    if (btnExtendTime) btnExtendTime.style.display = 'none';
    if (btnShowAnswer) btnShowAnswer.style.display = 'block';

    exibirTela('game-screen');
    nextQuestion();
    scheduleSkillMicroExplanation(true);
    updateCycleProgressUI();
    showFeedbackControlled(`Diagnóstico inicial: responda ${plan.length} questões para o app decidir por qual etapa começar.`, 'info', 5200);
}

function generateDiagnosticQuestion(operation) {
    const diag = gameState.diagnostic;
    if (!diag || !Array.isArray(diag.plan) || !diag.plan.length) return null;
    const idx = Math.max(0, Math.min(diag.plan.length - 1, Number(gameState.questionNumber || 1) - 1));
    const meta = diag.plan[idx];
    if (!meta || !meta.stage || typeof meta.stage.gen !== 'function') return null;
    const q = meta.stage.gen({
        stageIndex: meta.stageIndex,
        stageSize: Math.max(1, Number(meta.stage.count) || 1),
        totalStages: meta.totalStages,
        bankSize: meta.bankSize,
        absoluteIndex: idx
    });
    if (q && typeof q === 'object') {
        q.stageLabel = meta.stage.label || q.stageLabel || '';
        q.stageIndex = meta.stageIndex;
        q.stageNumber = meta.stageIndex + 1;
        q.stageSize = Math.max(1, Number(meta.stage.count) || 1);
        q.diagnosticLevel = meta.level;
        q.isDiagnostic = true;
    }
    return q;
}

function handleDiagnosticAnswer(selectedAnswer, selectedButton) {
    if (!gameState.isGameActive || !gameState.isDiagnosticMode) return;
    if (gameState.answerLocked) return;
    const q = gameState.currentQuestion;
    if (!q) return;

    const isCorrect = selectedAnswer === q.answer;
    gameState.answerLocked = true;
    setTimeout(() => { gameState.answerLocked = false; }, 220);

    answerOptions.forEach((btn) => btn.disabled = true);
    if (selectedButton) {
        selectedButton.classList.remove('correct', 'wrong');
        selectedButton.classList.add(isCorrect ? 'correct' : 'wrong');
        selectedButton.blur();
        clearAnswerFocus();
    }
    answerOptions.forEach((btn) => {
        const v = parseInt(btn.querySelector('.answer-text')?.textContent);
        if (v === q.answer) btn.classList.add('correct');
    });

    showPedagogicalFeedback(isCorrect, gameState.currentOperation, q, selectedAnswer);

    gameState.acertos += isCorrect ? 1 : 0;
    gameState.erros += isCorrect ? 0 : 1;
    gameState.diagnostic.results.push({
        stageIndex: Number(q.stageIndex || 0),
        stageLabel: String(q.stageLabel || '').trim(),
        correct: !!isCorrect
    });

    setTimeout(() => {
        if (gameState.questionNumber >= gameState.totalQuestions) {
            endGame();
        } else {
            nextQuestion();
        }
    }, 1000);
}


function buildQuestionCounterLabel() {
    if (gameState.isDiagnosticMode && gameState.diagnostic) {
        return `Diagnóstico ${gameState.questionNumber}/${Math.max(1, Number(gameState.totalQuestions) || 1)}`;
    }
    const isTabuadaRound = (gameState.currentOperation === 'multiplication' && gameState.multiplication && (gameState.multiplication.mode === 'direct' || gameState.multiplication.mode === 'trail'));
    const isStructuredTrailRound = !!(gameState.operationTrail && gameState.operationTrail.bankSize > 0);
    const hasFiniteRound = !!(gameState.isRapidMode || isTabuadaRound || isStructuredTrailRound);
    const totalDisplay = hasFiniteRound ? gameState.totalQuestions : '∞';

    if (gameState.operationTrail && gameState.operationTrail.masteryMode) {
        const t = gameState.operationTrail;
        const currentType = getLearningTypeLabel(gameState.currentQuestion?.learningType || t.stageType || 'fluency');
        if (t.consolidationMode && t.consolidation && Array.isArray(t.consolidation.plan)) {
            const consIdx = Math.min(Math.max(0, Number(t.consolidation.index || 0)), Math.max(0, t.consolidation.plan.length - 1));
            return `Consolidação ${consIdx + 1}/${Math.max(1, t.consolidation.plan.length)} • ${currentType}`;
        }
        return `Etapa ${Number(t.currentStageIndex || 0) + 1}/${Number(t.totalStages || 1)} • ${currentType} • Questão ${gameState.questionNumber}/${totalDisplay}`;
    }

    return `Questão: ${gameState.questionNumber}/${totalDisplay}`;
}

function loadOperationTrailIndexMap() {
    try {
        const raw = profileStorageGetRaw(OPERATION_TRAIL_INDEX_KEY);
        const obj = raw ? JSON.parse(raw) : {};
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (_) {
        return {};
    }
}

function saveOperationTrailIndexMap(map) {
    try { profileStorageSetJson(OPERATION_TRAIL_INDEX_KEY, map || {}); } catch (_) {}
}

function getSavedOperationTrailIndex(operation, level, bankSize) {
    const map = loadOperationTrailIndexMap();
    const key = getOperationTrailKey(operation, level);
    return clampTrailIndex(map[key], bankSize);
}

function setSavedOperationTrailIndex(operation, level, idx, bankSize) {
    const map = loadOperationTrailIndexMap();
    const key = getOperationTrailKey(operation, level);
    map[key] = clampTrailIndex(idx, bankSize);
    saveOperationTrailIndexMap(map);
}


function placeValueAdditionWithoutCarry(a, b) {
    let x = Math.abs(Math.trunc(Number(a) || 0));
    let y = Math.abs(Math.trunc(Number(b) || 0));
    let place = 1;
    let total = 0;
    while (x > 0 || y > 0) {
        const digit = ((x % 10) + (y % 10)) % 10;
        total += digit * place;
        x = Math.floor(x / 10);
        y = Math.floor(y / 10);
        place *= 10;
    }
    return total;
}

function placeValueSubtractionWithoutBorrow(a, b) {
    let x = Math.abs(Math.trunc(Number(a) || 0));
    let y = Math.abs(Math.trunc(Number(b) || 0));
    let place = 1;
    let total = 0;
    while (x > 0 || y > 0) {
        const dx = x % 10;
        const dy = y % 10;
        const digit = dx >= dy ? (dx - dy) : Math.abs(dx - dy);
        total += digit * place;
        x = Math.floor(x / 10);
        y = Math.floor(y / 10);
        place *= 10;
    }
    return total;
}

function parseTrailingResult(questionString) {
    const match = String(questionString || '').match(/=\s*(-?\d+)\s*\??\s*$/);
    return match ? Number(match[1]) : null;
}

const STUDY_DISTRACTOR_STAGE_MATRIX = {
    addition: [
        { profileLabel: 'default', match: [], priorityCodes: ['addition_as_subtraction', 'addition_off_by_one', 'addition_place_value_shift'], secondaryCodes: ['addition_no_carry'] },
        { profileLabel: 'termo faltante', match: ['parcela faltante', 'desconhecida', 'completar'], priorityCodes: ['addition_used_known_term', 'addition_used_total', 'addition_missing_off_by_one'], secondaryCodes: ['addition_off_by_one'] },
        { profileLabel: 'três parcelas', match: ['3 parcelas', 'três parcelas'], priorityCodes: ['addition_stopped_partial_sum', 'addition_added_last_twice'], secondaryCodes: ['addition_off_by_one'] },
        { profileLabel: 'reagrupamento', match: ['reagrupamento'], priorityCodes: ['addition_no_carry', 'addition_place_value_shift'], secondaryCodes: ['addition_off_by_one', 'addition_as_subtraction'] },
        { profileLabel: 'dobros e composição', match: ['dobros', 'somar com 10'], priorityCodes: ['addition_place_value_shift', 'addition_off_by_one'], secondaryCodes: ['addition_as_subtraction'] }
    ],
    subtraction: [
        { profileLabel: 'default', match: [], priorityCodes: ['subtraction_as_addition', 'subtraction_off_by_one', 'subtraction_place_value_shift'], secondaryCodes: ['subtraction_no_borrow'] },
        { profileLabel: 'termo faltante', match: ['minuendo', 'subtraendo', 'falt'], priorityCodes: ['subtraction_used_difference', 'subtraction_used_subtrahend', 'subtraction_used_difference_again', 'subtraction_used_minuend'], secondaryCodes: ['subtraction_off_by_one'] },
        { profileLabel: 'reserva', match: ['reserva', 'emprest'], priorityCodes: ['subtraction_no_borrow', 'subtraction_place_value_shift'], secondaryCodes: ['subtraction_off_by_one', 'subtraction_as_addition'] }
    ],
    multiplication: [
        { profileLabel: 'default', match: [], priorityCodes: ['multiplication_as_addition', 'multiplication_factor_shift'], secondaryCodes: ['multiplication_skip_sum'] },
        { profileLabel: 'grupos iguais', match: ['grupos iguais', 'grupos'], priorityCodes: ['multiplication_sum_instead_product', 'multiplication_missed_one_group', 'multiplication_extra_group'], secondaryCodes: ['multiplication_as_addition'] },
        { profileLabel: 'soma repetida', match: ['soma repetida'], priorityCodes: ['multiplication_simple_sum', 'multiplication_missing_repetition', 'multiplication_extra_repetition'], secondaryCodes: ['multiplication_as_addition'] },
        { profileLabel: 'dobro e triplo', match: ['dobro', 'triplo'], priorityCodes: ['multiplication_added_word_problem', 'multiplication_triplo_instead_dobro', 'multiplication_dobro_instead_triplo'], secondaryCodes: ['multiplication_as_addition'] },
        { profileLabel: 'saltos', match: ['saltos'], priorityCodes: ['multiplication_skip_one_less', 'multiplication_skip_one_more', 'multiplication_skip_sum'], secondaryCodes: ['multiplication_factor_shift'] },
        { profileLabel: 'tabuada e padrões', match: ['tabuada', 'comutatividade', 'padrões', 'distributiva'], priorityCodes: ['multiplication_factor_shift', 'multiplication_as_addition'], secondaryCodes: ['multiplication_skip_sum'] }
    ],
    division: [
        { profileLabel: 'default', match: [], priorityCodes: ['division_as_multiplication', 'division_as_subtraction', 'division_used_dividend'], secondaryCodes: ['division_used_divisor'] },
        { profileLabel: 'resto', match: ['resto'], priorityCodes: ['division_remainder_as_quotient', 'division_remainder_as_divisor', 'division_remainder_neighbor'], secondaryCodes: ['division_used_divisor'] },
        { profileLabel: 'dividendo faltante', match: ['dividendo'], priorityCodes: ['division_missing_dividend_used_quotient', 'division_missing_dividend_sum', 'division_missing_dividend_near'], secondaryCodes: ['division_as_multiplication'] },
        { profileLabel: 'divisor faltante', match: ['divisor'], priorityCodes: ['division_missing_divisor_used_quotient', 'division_missing_divisor_used_dividend'], secondaryCodes: ['division_used_divisor'] },
        { profileLabel: 'relação inversa', match: ['relação', 'quociente'], priorityCodes: ['division_as_multiplication', 'division_used_dividend', 'division_used_divisor'], secondaryCodes: ['division_as_subtraction'] }
    ],
    potenciacao: [
        { profileLabel: 'default', match: [], priorityCodes: ['power_as_multiplication', 'power_as_sum', 'power_exponent_minus_one'], secondaryCodes: ['power_exponent_plus_one'] },
        { profileLabel: 'expoente 0', match: ['expoente 0'], priorityCodes: ['power_zero_rule', 'power_as_multiplication', 'power_as_sum'], secondaryCodes: ['power_exponent_plus_one'] },
        { profileLabel: 'expoente 1', match: ['expoente 1'], priorityCodes: ['power_exponent_one_rule', 'power_as_sum', 'power_as_multiplication'], secondaryCodes: ['power_exponent_plus_one'] },
        { profileLabel: 'multiplicação repetida', match: ['produto', 'expressão', 'erro comum', 'valor faltante'], priorityCodes: ['power_as_multiplication', 'power_as_sum', 'power_exponent_minus_one', 'power_exponent_plus_one'], secondaryCodes: ['power_exponent_one_rule'] }
    ],
    radiciacao: [
        { profileLabel: 'default', match: [], priorityCodes: ['square_root_as_half', 'square_root_as_square', 'square_root_neighbor'], secondaryCodes: ['square_root_doubled'] },
        { profileLabel: 'estimativa', match: ['aproximada', 'estimativa', 'não é exata', 'nao é exata', 'mais próxima', 'mais proxima', 'entre dois quadrados'], priorityCodes: ['root_estimation_neighbor', 'root_as_half', 'root_used_radicand'], secondaryCodes: ['square_root_neighbor'] },
        { profileLabel: 'raiz cúbica', match: ['cúbic', 'cubica'], priorityCodes: ['cube_root_times_three', 'cube_root_as_square_root', 'cube_root_neighbor'], secondaryCodes: ['root_as_half'] },
        { profileLabel: 'relação com potência', match: ['quadrado', 'potência', 'potencia', 'raiz'], priorityCodes: ['square_root_as_square', 'square_root_as_half', 'square_root_neighbor'], secondaryCodes: ['square_root_doubled'] }
    ]
};

function getStudyDistractorProfile(operation, ctx = {}) {
    const op = String(operation || ctx.operation || '').toLowerCase();
    const label = normalizeSkillStageLabel(ctx.stageLabel || '').toLowerCase();
    const qText = String(ctx.questionString || ctx.voiceQuestion || '').toLowerCase();
    const profiles = Array.isArray(STUDY_DISTRACTOR_STAGE_MATRIX[op]) ? STUDY_DISTRACTOR_STAGE_MATRIX[op] : [];
    if (!profiles.length) return { profileLabel: 'default', priorityCodes: [], secondaryCodes: [] };
    const defaultProfile = profiles[0] || { profileLabel: 'default', priorityCodes: [], secondaryCodes: [] };
    const matched = profiles.find((profile, idx) => idx > 0 && Array.isArray(profile.match) && profile.match.some((keyword) => label.includes(keyword) || qText.includes(keyword)));
    const chosen = matched || defaultProfile;
    return {
        profileLabel: String(chosen.profileLabel || 'default'),
        priorityCodes: Array.isArray(chosen.priorityCodes) ? chosen.priorityCodes.map(String) : [],
        secondaryCodes: Array.isArray(chosen.secondaryCodes) ? chosen.secondaryCodes.map(String) : []
    };
}

function shouldUsePedagogicalDistractors(operation, ctx = {}) {
    if (operation !== 'multiplication') return true;
    const level = String(ctx.level || gameState.currentLevel || '').toLowerCase();
    if (!gameState.isRapidMode) return true;
    return level === 'apprentice';
}

function isSimpleRapidMultiplicationSession(ctx = {}) {
    return String(ctx.operation || '').toLowerCase() === 'multiplication' && !shouldUsePedagogicalDistractors('multiplication', ctx);
}

function addPedagogicalDistractors(operation, answer, ctx, push) {
    const label = normalizeSkillStageLabel(ctx.stageLabel || '').toLowerCase();
    const qText = String(ctx.questionString || '').trim();
    const qLower = qText.toLowerCase();
    const num1 = Number(ctx.num1);
    const num2 = Number(ctx.num2);
    const knownResult = parseTrailingResult(qText);

    const pushPairNeighbors = () => {
        push(answer + 1);
        push(answer - 1);
    };

    switch (operation) {
        case 'addition': {
            if (qText.includes('?')) {
                const known = Number.isFinite(num1) ? num1 : 0;
                const total = Number.isFinite(knownResult) ? knownResult : (Number.isFinite(num2) ? known + num2 : answer + known);
                push(known);
                push(total);
                push(total - known + 1);
                push(total - known - 1);
                push(Math.abs(total - answer - 1));
                pushPairNeighbors();
                break;
            }
            if ((qText.match(/\+/g) || []).length >= 2) {
                const partial = Number.isFinite(num1) ? num1 : 0;
                const third = Number.isFinite(num2) ? num2 : 0;
                push(partial);
                push(answer - third);
                push(answer + third);
                push(partial + Math.max(1, third - 1));
                pushPairNeighbors();
                break;
            }
            const noCarry = placeValueAdditionWithoutCarry(num1, num2);
            if (label.includes('reagrupamento') || noCarry !== answer) push(noCarry);
            push(Math.abs((Number(num1) || 0) - (Number(num2) || 0)));
            push((Number(num1) || 0) + (Number(num2) || 0) + 10);
            push((Number(num1) || 0) + Math.max(0, (Number(num2) || 0) - 1));
            push((Number(num1) || 0) + Math.max(0, (Number(num2) || 0) + 1));
            pushPairNeighbors();
            break;
        }
        case 'subtraction': {
            if (/^\?\s*-/.test(qText)) {
                const subtrahend = Number.isFinite(num2) ? num2 : 0;
                const diff = Number.isFinite(knownResult) ? knownResult : 0;
                push(subtrahend);
                push(diff);
                push(diff + subtrahend + 1);
                push(Math.abs(diff - subtrahend));
                pushPairNeighbors();
                break;
            }
            if (qText.includes('- ?')) {
                const minuend = Number.isFinite(num1) ? num1 : 0;
                const diff = Number.isFinite(knownResult) ? knownResult : 0;
                push(diff);
                push(minuend);
                push(minuend + diff);
                push(Math.abs(minuend - diff - 1));
                pushPairNeighbors();
                break;
            }
            const noBorrow = placeValueSubtractionWithoutBorrow(num1, num2);
            if (label.includes('reserva') || noBorrow !== answer) push(noBorrow);
            push((Number(num1) || 0) + (Number(num2) || 0));
            push((Number(num1) || 0) - Math.max(0, (Number(num2) || 0) - 1));
            push((Number(num1) || 0) - ((Number(num2) || 0) + 1));
            push(Math.abs((Number(num1) || 0) - (Number(num2) || 0) + 10));
            pushPairNeighbors();
            break;
        }
        case 'multiplication': {
            if (qLower.includes('grupos de')) {
                const groups = Number.isFinite(num1) ? num1 : 0;
                const size = Number.isFinite(num2) ? num2 : 0;
                push(groups + size);
                push(groups * Math.max(1, size - 1));
                push(Math.max(1, groups - 1) * size);
                push(groups * size + size);
                pushPairNeighbors();
                break;
            }
            if (qText.includes(' + ')) {
                const times = Number.isFinite(num1) ? num1 : 0;
                const addend = Number.isFinite(num2) ? num2 : 0;
                push(times + addend);
                push(Math.max(1, times - 1) * addend);
                push((times + 1) * addend);
                push(addend + addend);
                pushPairNeighbors();
                break;
            }
            if (/^Dobro|^Triplo/i.test(qText)) {
                const factor = Number.isFinite(num1) ? num1 : 2;
                const base = Number.isFinite(num2) ? num2 : 0;
                push(base + factor);
                push(base * (factor === 2 ? 3 : 2));
                push(base + base);
                push(base + base + base);
                pushPairNeighbors();
                break;
            }
            if (qText.includes('__')) {
                const step = Number.isFinite(num1) ? num1 : 0;
                const count = Number.isFinite(num2) ? num2 : 0;
                push(step * Math.max(1, count - 1));
                push(step * (count + 1));
                push(step + count);
                push(Math.max(0, step * count - 1));
                pushPairNeighbors();
                break;
            }
            push((Number(num1) || 0) + (Number(num2) || 0));
            push((Number(num1) || 0) * Math.max(1, (Number(num2) || 1) - 1));
            push((Number(num1) || 0) * ((Number(num2) || 0) + 1));
            push(((Number(num1) || 0) + 1) * (Number(num2) || 0));
            pushPairNeighbors();
            break;
        }
        case 'division': {
            if (qLower.includes('(resto)')) {
                const dividend = Number.isFinite(num1) ? num1 : 0;
                const divisor = Number.isFinite(num2) && num2 !== 0 ? num2 : 1;
                const quotient = Math.floor(dividend / divisor);
                push(quotient);
                push(divisor);
                push(quotient + answer);
                push(answer + 1);
                push(answer - 1);
                break;
            }
            if (/^\?\s*÷/.test(qText)) {
                const divisor = Number.isFinite(num2) ? num2 : 1;
                const quotient = Number.isFinite(knownResult) ? knownResult : Math.floor((answer || 0) / divisor);
                push(divisor + quotient);
                push(quotient);
                push(divisor * Math.max(1, quotient - 1));
                push(answer + divisor);
                pushPairNeighbors();
                break;
            }
            if (qText.includes('÷ ?')) {
                const dividend = Number.isFinite(num1) ? num1 : 0;
                const quotient = Number.isFinite(knownResult) ? knownResult : 1;
                push(quotient);
                push(dividend);
                push(Math.max(1, answer + 1));
                push(Math.max(1, answer - 1));
                push(Math.max(1, Math.round(dividend / Math.max(1, quotient + 1))));
                break;
            }
            push((Number(num1) || 0) * Math.max(1, (Number(num2) || 1)));
            push(Number(num1) || 0);
            push(Number(num2) || 0);
            push((Number(num1) || 0) + (Number(num2) || 0));
            push(answer + 1);
            push(answer - 1);
            push((Number(num1) || 0) - (Number(num2) || 0));
            break;
        }
        case 'potenciacao': {
            const base = Number.isFinite(num1) ? num1 : 0;
            const exp = Number.isFinite(num2) ? num2 : 0;
            push(base * exp);
            push(base + exp);
            if (exp > 1) push(base ** (exp - 1));
            push(base ** (exp + 1));
            if (exp === 0) {
                push(base);
                push(0);
            }
            if (exp === 1) {
                push(1);
                push(base + 1);
            }
            pushPairNeighbors();
            break;
        }
        case 'radiciacao': {
            const radicand = Number.isFinite(num1) ? num1 : 0;
            const isCube = Number(num2) === 3 || qText.includes('∛');
            if (qLower.includes('aproximada')) {
                push(answer - 1);
                push(answer + 1);
                push(Math.round(radicand / 2));
                push(radicand);
                break;
            }
            if (isCube) {
                push(answer - 1);
                push(answer + 1);
                push(answer * 3);
                push(Math.round(Math.sqrt(Math.max(0, radicand))));
                break;
            }
            push(answer - 1);
            push(answer + 1);
            push(answer * 2);
            push(Math.round(radicand / 2));
            push(answer * answer);
            break;
        }
        default:
            pushPairNeighbors();
            push(answer + 2);
            push(answer - 2);
            break;
    }
}

function buildSimpleRapidMultiplicationOptions(answer) {
    const correct = Math.round(Number(answer) || 0);
    const pool = [];
    const push = (n) => {
        const v = Math.round(Number(n));
        if (!Number.isFinite(v) || v < 0 || v === correct || pool.includes(v)) return;
        pool.push(v);
    };
    [1, -1, 2, -2, 3, -3, 4, -4].forEach((delta) => push(correct + delta));
    let spread = Math.max(5, Math.round(Math.abs(correct) * 0.08));
    while (pool.length < 3) {
        push(correct + spread);
        push(correct - spread);
        spread += 2;
    }
    const options = [correct, ...pool.slice(0, 3)];
    for (let i = options.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [options[i], options[j]] = [options[j], options[i]];
    }
    return options;
}

function buildQuestionOptions(operation, answer, ctx = {}) {
    const supportMode = normalizeAdaptiveSupportMode(ctx.supportMode || 'normal');
    const effectiveCtx = {
        ...ctx,
        operation,
        level: ctx.level || gameState.currentLevel || ''
    };
    if (isSimpleRapidMultiplicationSession(effectiveCtx)) {
        return buildSimpleRapidMultiplicationOptions(answer);
    }
    const pool = [];
    const push = (n) => {
        if (!Number.isFinite(n)) return;
        const v = Math.round(n);
        if (v < 0 || v === answer || pool.includes(v)) return;
        pool.push(v);
    };

    if (shouldUsePedagogicalDistractors(operation, effectiveCtx)) {
        addPedagogicalDistractors(operation, answer, effectiveCtx, push);
    }

    if (pool.length < 5) {
        switch (operation) {
            case 'addition':
                push(answer + 10);
                push(answer - 10);
                push(answer + (Number(ctx.num2) || 1));
                break;
            case 'subtraction':
                push(answer + 10);
                push(answer - 10);
                push(Math.abs((Number(ctx.num1) || 0) - (Number(ctx.num2) || 0) + 2));
                break;
            case 'division':
                push(answer + 2);
                push(answer - 2);
                push(Number(ctx.num2) || 0);
                break;
            case 'potenciacao':
                push((Number(ctx.num1) || 0) * (Number(ctx.num2) || 0));
                push((Number(ctx.num1) || 0) + (Number(ctx.num2) || 0));
                break;
            case 'radiciacao':
                push(answer + 2);
                push(answer - 2);
                break;
            case 'multiplication':
                push(answer + 1);
                push(answer - 1);
                push(answer + Math.max(2, Math.abs(Number(ctx.num1) || 2)));
                push(Math.max(0, answer - Math.max(2, Math.abs(Number(ctx.num1) || 2))));
                break;
            default:
                push(answer + 2);
                push(answer - 2);
                break;
        }
    }

    let spread = Math.max(2, Math.round(Math.abs(answer) * 0.12));
    while (pool.length < 6) {
        push(answer + randomInt(-spread, spread));
        push(answer + randomInt(spread + 1, spread + 4));
        push(answer - randomInt(spread + 1, spread + 4));
        spread += 2;
    }

    let candidatePool = pool.slice();
    if (supportMode !== 'normal') {
        const minGap = supportMode === 'very_guided' ? Math.max(3, Math.ceil(Math.abs(answer) * 0.18)) : Math.max(2, Math.ceil(Math.abs(answer) * 0.1));
        candidatePool = candidatePool
            .sort((a, b) => Math.abs(b - answer) - Math.abs(a - answer))
            .filter((n, idx, arr) => Math.abs(n - answer) >= minGap || idx >= arr.length - 2);
        while (candidatePool.length < 3) {
            push(answer + randomInt(minGap + 2, minGap + 8));
            push(answer - randomInt(minGap + 2, minGap + 8));
            candidatePool = pool.slice().sort((a, b) => Math.abs(b - answer) - Math.abs(a - answer));
        }
    }

    const options = [answer, ...candidatePool.slice(0, 3)];
    for (let i = options.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [options[i], options[j]] = [options[j], options[i]];
    }
    return options;
}

function buildQuestionPayload(operation, num1, num2, answer, questionString, questionSpeak, stageLabel) {
    const options = buildQuestionOptions(operation, answer, { num1, num2, stageLabel: stageLabel || '', questionString, voiceQuestion: questionSpeak || questionString, level: gameState.currentLevel || '' });
    return {
        question: `${questionString} = ?`,
        voiceQuestion: questionSpeak || questionString,
        answer,
        options,
        voiceOptions: options,
        operacao: operation,
        num1,
        num2,
        stageLabel: stageLabel || ''
    };
}

function normalizeSkillStageLabel(label) {
    return String(label || '')
        .replace(/^\s*Revis[aã]o:\s*/i, '')
        .replace(/\s+/g, ' ')
        .trim();
}

function getSkillMicroExplanation(operation, stageLabel) {
    const label = normalizeSkillStageLabel(stageLabel).toLowerCase();
    if (!label) return '';

    if (label.includes('revisão mista')) return 'Misture estratégias já treinadas e resolva com calma antes de escolher a resposta.';
    if (label.includes('domínio final')) return 'Aqui vale consistência: resolva com atenção e confirme o raciocínio antes de responder.';

    if (operation === 'addition') {
        if (label.includes('até 10') || label.includes('até 20')) return 'Some primeiro as unidades. Se a soma ainda couber na mesma dezena, não há troca.';
        if (label.includes('dezenas exatas')) return 'Pense em dezenas inteiras: 20 + 30 é o mesmo que 2 dezenas + 3 dezenas.';
        if (label.includes('com reagrupamento')) return 'Quando a soma passa de 9, trocamos 10 unidades por 1 dezena.';
        if (label.includes('sem reagrupamento')) return 'Some unidades com unidades e dezenas com dezenas, sem precisar trocar de ordem.';
        if (label.includes('3 parcelas')) return 'Some duas parcelas primeiro e depois acrescente a terceira.';
        if (label.includes('parcela faltante')) return 'Pense: qual número falta para completar o total pedido?';
        if (label.includes('decomposição')) return 'Quebre os números em centenas, dezenas e unidades para somar por partes.';
        if (label.includes('contexto')) return 'Transforme a situação em conta de soma e marque quais valores entram juntos.';
        if (label.includes('estimativa')) return 'Arredonde mentalmente para conferir se o resultado está perto do esperado.';
        if (label.includes('parcela desconhecida')) return 'Use a soma conhecida e descubra qual valor falta para chegar ao total.';
        if (label.includes('tabela') || label.includes('valores')) return 'Leia os valores com atenção e some item por item antes de responder.';
        if (label.includes('composição')) return 'Junte as partes informadas para descobrir o total da situação.';
        if (label.includes('estratégias mentais')) return 'Procure completar dezenas ou centenas para somar mais rápido.';
        return 'Some por ordens: unidades, dezenas e centenas, conferindo se precisa reagrupamento.';
    }

    if (operation === 'subtraction') {
        if (label.includes('até 10') || label.includes('até 20')) return 'Conte para trás ou pense na diferença entre os números.';
        if (label.includes('dezenas exatas')) return 'Subtrair dezenas exatas é comparar grupos de 10.';
        if (label.includes('com reserva') || label.includes('reserva encadeada')) return 'Quando o número de cima é menor, emprestamos 1 dezena.';
        if (label.includes('sem reserva')) return 'Subtraia unidades de unidades e dezenas de dezenas, sem empréstimo.';
        if (label.includes('diferença')) return 'Pergunte: quanto falta para sair do menor e chegar ao maior?';
        if (label.includes('resultado faltante')) return 'Use a operação inversa para descobrir qual resultado completa a conta.';
        if (label.includes('número que falta') || label.includes('minuendo desconhecido')) return 'Pense no número inicial que, ao tirar a parte dada, produz a diferença.';
        if (label.includes('subtraendo desconhecido')) return 'Descubra quanto foi tirado comparando o valor inicial com a diferença.';
        if (label.includes('decomposição')) return 'Separe centenas, dezenas e unidades para enxergar melhor a retirada.';
        if (label.includes('situações-problema') || label.includes('interpretação')) return 'Veja quem é o todo, quem foi retirado e qual diferença precisa encontrar.';
        if (label.includes('estratégias mentais')) return 'Use compensação: ajuste os números mentalmente e depois corrija o resultado.';
        return 'Na subtração, compare as ordens e veja se precisa reservar antes de calcular.';
    }

    if (operation === 'multiplication') {
        if (label.includes('grupos iguais')) return 'Multiplicar é juntar grupos com a mesma quantidade.';
        if (label.includes('soma repetida')) return 'Troque a adição repetida por uma multiplicação: quantidade de grupos × quantidade em cada grupo.';
        if (label.includes('dobro')) return 'Dobro é duas vezes a mesma quantidade; triplo é três vezes.';
        if (label.includes('triplo')) return 'Triplo é juntar a mesma quantidade 3 vezes.';
        if (label.includes('saltos')) return 'Na contagem em saltos, cada passo acrescenta sempre a mesma quantidade.';
        if (label.includes('tabuada do 2')) return 'A tabuada do 2 cresce de 2 em 2.';
        if (label.includes('tabuada do 3')) return 'Na tabuada do 3, some 3 a cada novo resultado.';
        if (label.includes('tabuada do 5')) return 'Na tabuada do 5, observe o padrão final em 0 ou 5.';
        if (label.includes('tabuada do 10')) return 'Multiplicar por 10 é acrescentar um zero ao número inteiro.';
        if (label.includes('tabuadas 1 e 2')) return 'Comece pelos fatos mais curtos e observe que multiplicar por 1 mantém a quantidade.';
        if (label.includes('tabuada do 4')) return 'A tabuada do 4 pode ser pensada como dobro do dobro.';
        if (label.includes('tabuada do 6')) return 'Use o apoio da tabuada do 3 e dobre o resultado para pensar no 6.';
        if (label.includes('tabuada do 7')) return 'No 7, vale montar grupos iguais e repetir a tabuada até ganhar fluência.';
        if (label.includes('tabuada do 8')) return 'A tabuada do 8 pode ser vista como dobro da tabuada do 4.';
        if (label.includes('tabuada do 9')) return 'No 9, confira padrões e use a ideia de 10 vezes menos 1 vez.';
        if (label.includes('tabuada do 11') || label.includes('multiplicar por 11 e 12')) return 'Procure padrões e apoie-se em 10 vezes mais a parte que falta.';
        if (label.includes('tabuadas 13 a 15')) return 'Quebre o fator maior em partes conhecidas para multiplicar com segurança.';
        if (label.includes('tabuadas 16 a 20')) return 'Use dobros, 10 vezes e decomposição para não depender só de decorar.';
        if (label.includes('comutatividade')) return 'Na multiplicação, trocar a ordem dos fatores não muda o resultado.';
        if (label.includes('padrões')) return 'Observe regularidades nas tabuadas para responder com mais rapidez.';
        if (label.includes('relação multiplicação e divisão')) return 'Multiplicação e divisão se conferem: se 6×4=24, então 24÷6=4.';
        if (label.includes('grupos iguais com 6 a 10')) return 'Pense no total como grupos iguais com quantidades maiores, sem perder a regularidade.';
        if (label.includes('dobrar para multiplicar')) return 'Dobrar pode ajudar: 14×3 é o dobro de 7×3.';
        if (label.includes('distributiva')) return 'Quebre o fator maior em partes simples e some os produtos.';
        if (label.includes('produtos maiores')) return 'Organize o cálculo e use estratégias, não apenas memorização.';
        if (label.includes('contextos multiplicativos')) return 'Descubra quantos grupos há e quantos elementos existem em cada grupo.';
        if (label.includes('revisão')) return 'Revise pensando em grupos iguais, propriedades e padrões das tabuadas.';
        if (label.includes('domínio final')) return 'Mostre segurança na multiplicação antes de avançar para a próxima trilha.';
        return 'Pense na multiplicação como grupos iguais, não só como memorização de tabuada.';
    }

    if (operation === 'division') {
        if (label.includes('repartir')) return 'Dividir é repartir em partes iguais.';
        if (label.includes('agrupar')) return 'Pense em quantos grupos iguais cabem no total.';
        if (label.includes('exata')) return 'Use a tabuada inversa para descobrir quantas vezes o divisor cabe no dividendo.';
        if (label.includes('relação') && label.includes('multiplic')) return 'Confira pela multiplicação: quociente × divisor deve voltar ao dividendo.';
        if (label.includes('quociente')) return 'O quociente diz quantos grupos completos foram formados.';
        if (label.includes('divisor')) return 'O divisor mostra o tamanho de cada grupo.';
        if (label.includes('dividendo')) return 'O dividendo é o total que será repartido.';
        if (label.includes('resto')) return 'Nem sempre a divisão fecha exata; o que sobra é o resto.';
        if (label.includes('contexto')) return 'Leia quem reparte, o total e o tamanho de cada grupo antes de calcular.';
        if (label.includes('múltiplos') || label.includes('divisores')) return 'Procure quais multiplicações do divisor chegam ou se aproximam do dividendo.';
        if (label.includes('estimativa')) return 'Aproxime mentalmente para prever quantas vezes o divisor cabe no total.';
        if (label.includes('erros comuns')) return 'Cuidado para não trocar divisor por quociente; confira a multiplicação de volta.';
        return 'Na divisão, descubra quantos grupos iguais podem ser formados sem perder o total.';
    }

    if (operation === 'potenciacao') {
        if (label.includes('multiplicação repetida')) return 'Potência mostra quantas vezes a base é multiplicada por ela mesma.';
        if (label.includes('quadrado')) return 'Quadrado é multiplicar o número por ele mesmo duas vezes.';
        if (label.includes('cubo')) return 'Cubo é multiplicar a base por ela mesma três vezes.';
        if (label.includes('base e expoente')) return 'A base é o número repetido; o expoente diz quantas repetições fazer.';
        if (label.includes('comparar')) return 'Compare o valor da potência com calma antes de escolher a resposta.';
        if (label.includes('aplicação em contexto')) return 'Traga a potência para a ideia de repetição: a base se repete o número de vezes indicado pelo expoente.';
        if (label.includes('completar') || label.includes('valor faltante')) return 'Reescreva a potência como multiplicação para descobrir o valor que falta.';
        if (label.includes('escrita expandida')) return 'Transforme a potência em produto repetido para enxergar melhor o cálculo.';
        if (label.includes('potência de 10')) return 'Em potências de 10, conte quantos zeros aparecem de acordo com o expoente.';
        if (label.includes('expoente 0')) return 'Todo número diferente de zero elevado a 0 vale 1.';
        if (label.includes('expoente 1')) return 'Todo número elevado a 1 continua igual à própria base.';
        if (label.includes('erro comum')) return 'Não confunda potência com multiplicação simples: observe base e expoente.';
        return 'Reescreva a potência como multiplicação repetida para não se perder no cálculo.';
    }

    if (operation === 'radiciacao') {
        if (label.includes('raiz cúbica') || label.includes('raízes cúbicas')) return 'Na raiz cúbica, procure o número que multiplicado por ele mesmo 3 vezes gera o valor dado.';
        if (label.includes('ideia de raiz')) return 'Raiz quadrada é o número que, multiplicado por ele mesmo, gera o valor dado.';
        if (label.includes('quadrados perfeitos')) return 'Procure qual número ao quadrado produz exatamente o valor da raiz.';
        if (label.includes('relacionar raiz e quadrado') || label.includes('relação entre potência e raiz') || label.includes('relação inversa com potência')) return 'Lembre: raiz e potência são operações inversas.';
        if (label.includes('encontrar número pelo quadrado')) return 'Pense em qual número, ao quadrado, produz o valor mostrado.';
        if (label.includes('completar raiz')) return 'Teste mentalmente quadrados conhecidos até achar o valor pedido.';
        if (label.includes('comparar raízes') || label.includes('comparar resultados')) return 'Compare os quadrados perfeitos mais próximos antes de responder.';
        if (label.includes('reconhecer quadrado perfeito')) return 'Quadrado perfeito é o resultado de um número multiplicado por ele mesmo.';
        if (label.includes('não é exata') || label.includes('estimativa') || label.includes('mais próxima') || label.includes('entre dois quadrados')) return 'Veja entre quais quadrados perfeitos o número está para estimar a raiz.';
        if (label.includes('erro comum')) return 'Confirme se você está procurando a raiz e não o quadrado do número.';
        if (label.includes('conferência por multiplicação')) return 'Multiplique a raiz por ela mesma para conferir se volta ao valor inicial.';
        return 'Procure o número que multiplicado por ele mesmo gera o valor dentro da raiz.';
    }

    return '';
}

let __skillMicroExplanationTimer = null;
function getCurrentSkillMicroExplanationMeta() {
    try {
        if (!gameState || !gameState.isGameActive || gameState.isTrainingErrors) return null;
        const operation = String(gameState.currentOperation || '');
        if (!operation) return null;
        const trail = gameState.operationTrail || null;
        if (!trail || !trail.masteryMode) return null;

        const rawLabel = String(
            trail.currentStageLabel ||
            gameState.currentQuestion?.masteryStageLabel ||
            gameState.currentQuestion?.stageLabel || ''
        ).trim();
        const label = normalizeSkillStageLabel(rawLabel);
        const hint = getSkillMicroExplanation(operation, label);
        if (!label || !hint) return null;

        const stageNo = Math.max(1, Number(trail.currentStageIndex || 0) + 1);
        const totalStages = Math.max(1, Number(trail.totalStages || 1));
        const repeatSlot = (operation === 'multiplication' && isMultiplicationApprenticeLevel(gameState.currentLevel))
            ? Math.floor(Math.max(0, Number(gameState.questionNumber || 1) - 1) / 2)
            : 0;
        return {
            key: `${operation}|${gameState.currentLevel || ''}|${stageNo}|${label}|${repeatSlot}`,
            operation,
            stageNo,
            totalStages,
            label,
            hint
        };
    } catch (_) {
        return null;
    }
}

function scheduleSkillMicroExplanation(force = false) {
    try {
        if (__skillMicroExplanationTimer) {
            clearTimeout(__skillMicroExplanationTimer);
            __skillMicroExplanationTimer = null;
        }

        const meta = getCurrentSkillMicroExplanationMeta();
        if (!meta) return;
        if (!force && gameState.lastSkillMicroExplanationKey === meta.key) return;
        gameState.lastSkillMicroExplanationKey = meta.key;

        const duration = gameState.isRapidMode ? 6500 : 12000;
        const message = `🧠 Etapa ${meta.stageNo}/${meta.totalStages} — ${meta.label}: ${meta.hint}`;

        __skillMicroExplanationTimer = setTimeout(() => {
            __skillMicroExplanationTimer = null;
            if (!gameState.isGameActive || gameState.currentScreen !== 'game-screen') return;
            showFeedbackMessage(message, 'info', duration);
        }, 220);
    } catch (_) {}
}

function randAdditionNoCarry(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const b = randomInt(minB, maxB);
        if (((a % 10) + (b % 10)) < 10) return [a, b];
    }
    return [randomInt(minA, maxA), randomInt(minB, maxB)];
}

function randAdditionWithCarry(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const b = randomInt(minB, maxB);
        if (((a % 10) + (b % 10)) >= 10) return [a, b];
    }
    const a = randomInt(minA, maxA);
    const b = randomInt(minB, maxB);
    return [a, b];
}

function randSubtractionNoBorrow(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const b = randomInt(minB, Math.min(maxB, a));
        if ((a % 10) >= (b % 10) && a >= b) return [a, b];
    }
    const a = randomInt(minA, maxA);
    const b = randomInt(minB, Math.min(maxB, a));
    return [Math.max(a, b), Math.min(a, b)];
}

function randSubtractionWithBorrow(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const maxLocalB = Math.min(maxB, a - 1);
        if (maxLocalB < minB) continue;
        const b = randomInt(minB, maxLocalB);
        if ((a % 10) < (b % 10) && a > b) return [a, b];
    }
    const a = randomInt(Math.max(minA, minB + 1), maxA);
    const b = randomInt(minB, Math.min(maxB, a - 1));
    return [a, b];
}

function randExactDivision(divMin, divMax, qMin, qMax) {
    const divisor = randomInt(divMin, divMax);
    const quotient = randomInt(qMin, qMax);
    return [divisor * quotient, divisor, quotient];
}

function randPerfectSquare(rootMin, rootMax) {
    const root = randomInt(rootMin, rootMax);
    return [root * root, root];
}


function makeStage(label, count, gen) {
    return { label, count, gen };
}

function qAddition(a, b, label) {
    return buildQuestionPayload('addition', a, b, a + b, `${a} + ${b}`, `${a} mais ${b}`, label);
}

function qAddition3(a, b, c, label) {
    return buildQuestionPayload('addition', a + b, c, a + b + c, `${a} + ${b} + ${c}`, `${a} mais ${b} mais ${c}`, label);
}

function qAdditionMissing(total, known, label, missingOnLeft = false) {
    const missing = total - known;
    return buildQuestionPayload(
        'addition',
        known,
        missing,
        missing,
        missingOnLeft ? `? + ${known} = ${total}` : `${known} + ? = ${total}`,
        `complete ${known} para chegar a ${total}`,
        label
    );
}

function qSubtraction(a, b, label) {
    return buildQuestionPayload('subtraction', a, b, a - b, `${a} - ${b}`, `${a} menos ${b}`, label);
}

function qUnknownMinuend(diff, subtrahend, label) {
    const answer = diff + subtrahend;
    return buildQuestionPayload('subtraction', answer, subtrahend, answer, `? - ${subtrahend} = ${diff}`, `qual número menos ${subtrahend} é igual a ${diff}`, label);
}

function qUnknownSubtrahend(minuend, diff, label) {
    const answer = minuend - diff;
    return buildQuestionPayload('subtraction', minuend, answer, answer, `${minuend} - ? = ${diff}`, `quanto falta tirar de ${minuend} para dar ${diff}`, label);
}

function qDivision(dividend, divisor, label) {
    const quotient = Math.floor(dividend / divisor);
    return buildQuestionPayload('division', dividend, divisor, quotient, `${dividend} ÷ ${divisor}`, `${dividend} dividido por ${divisor}`, label);
}

function qDivisionRemainder(dividend, divisor, label) {
    const remainder = dividend % divisor;
    return buildQuestionPayload('division', dividend, divisor, remainder, `${dividend} ÷ ${divisor} (resto)`, `qual é o resto de ${dividend} dividido por ${divisor}`, label);
}

function qDivisionFindDividend(divisor, quotient, label) {
    const answer = divisor * quotient;
    return buildQuestionPayload('division', answer, divisor, answer, `? ÷ ${divisor} = ${quotient}`, `qual dividendo dividido por ${divisor} dá ${quotient}`, label);
}

function qDivisionFindDivisor(dividend, quotient, label) {
    const answer = Math.floor(dividend / quotient);
    return buildQuestionPayload('division', dividend, answer, answer, `${dividend} ÷ ? = ${quotient}`, `qual divisor faz ${dividend} dividido por ele ser igual a ${quotient}`, label);
}

function qPower(base, exp, label) {
    return buildQuestionPayload('potenciacao', base, exp, base ** exp, `${base}${toSuperscript(exp)}`, `${base} elevado a ${exp}`, label);
}

function qPowerExpanded(base, exp, label) {
    const question = Array.from({ length: exp }, () => String(base)).join(' × ');
    return buildQuestionPayload('potenciacao', base, exp, base ** exp, question, `${base} multiplicado por ele mesmo ${exp} vezes`, label);
}

function qRoot(square, label) {
    const root = Math.round(Math.sqrt(square));
    return buildQuestionPayload('radiciacao', square, null, root, `√${square}`, `raiz quadrada de ${square}`, label);
}

function qRootEstimate(square, label) {
    const root = Math.round(Math.sqrt(square));
    return buildQuestionPayload('radiciacao', square, null, root, `√${square} (aproximada)`, `raiz quadrada aproximada de ${square}`, label);
}

function qCubeRoot(cube, label) {
    const root = Math.round(Math.cbrt(cube));
    return buildQuestionPayload('radiciacao', cube, 3, root, `∛${cube}`, `raiz cúbica de ${cube}`, label);
}

function qMultiplicationBasic(a, b, label) {
    return buildQuestionPayload('multiplication', a, b, a * b, `${a} x ${b}`, `${a} vezes ${b}`, label);
}

function qEqualGroups(groups, size, label) {
    const total = groups * size;
    return buildQuestionPayload('multiplication', groups, size, total, `${groups} grupos de ${size}`, `${groups} grupos com ${size} em cada grupo`, label);
}

function qRepeatedAddition(addend, times, label) {
    const total = addend * times;
    const parts = Array.from({ length: times }, () => String(addend));
    return buildQuestionPayload('multiplication', times, addend, total, parts.join(' + '), parts.join(' mais '), label);
}

function qDoubleTriple(base, factor, label) {
    const total = base * factor;
    const word = factor === 2 ? 'Dobro' : 'Triplo';
    return buildQuestionPayload('multiplication', factor, base, total, `${word} de ${base}`, `${word.toLowerCase()} de ${base}`, label);
}

function qSkipCounting(step, count, label) {
    const seq = Array.from({ length: count }, (_, i) => step * (i + 1));
    const answer = seq[seq.length - 1];
    const shown = seq.slice(0, -1).join(', ');
    return buildQuestionPayload('multiplication', step, count, answer, `${shown}, __`, `contagem em saltos de ${step} em ${step}`, label);
}

function buildBridgeQuestion(operation, stageLabel) {
    const label = `Questão-ponte: ${normalizeSkillStageLabel(stageLabel) || 'Relação entre habilidades'}`;
    if (operation === 'addition' || operation === 'subtraction') {
        const a = randomInt(6, 35);
        const b = randomInt(2, Math.max(3, a - 1));
        const total = a + b;
        const q = buildQuestionPayload(operation, total, a, b, `Se ${a} + ${b} = ${total}, então ${total} - ${a}`, `use a relação entre adição e subtração: se ${a} mais ${b} é ${total}, quanto é ${total} menos ${a}`, label);
        q.bridgeFamily = 'addition-subtraction';
        q.bridgeHint = 'Use a operação inversa para conferir o raciocínio.';
        return q;
    }
    if (operation === 'multiplication' || operation === 'division') {
        const a = randFrom([2,3,4,5,6,7,8,9,10]);
        const b = randomInt(2, 10);
        const total = a * b;
        const q = buildQuestionPayload(operation, total, a, b, `Se ${a} × ${b} = ${total}, então ${total} ÷ ${a}`, `use a relação entre multiplicação e divisão: se ${a} vezes ${b} é ${total}, quanto é ${total} dividido por ${a}`, label);
        q.bridgeFamily = 'multiplication-division';
        q.bridgeHint = 'Conferir multiplicação e divisão ajuda a estabilizar o quociente.';
        return q;
    }
    if (operation === 'potenciacao' || operation === 'radiciacao') {
        const base = randFrom([2,3,4,5,6,7,8,9]);
        const square = base * base;
        const q = buildQuestionPayload(operation, square, 2, base, `Se ${base}² = ${square}, então √${square}`, `use a relação entre potência e raiz: se ${base} ao quadrado é ${square}, qual é a raiz de ${square}`, label);
        q.bridgeFamily = 'power-root';
        q.bridgeHint = 'Potência e raiz são operações inversas.';
        return q;
    }
    return null;
}

function shouldInjectBridgeQuestion(operation, learningType, isReview = false, isConsolidation = false) {
    if (!operation) return false;
    const baseChance = (learningType === 'comprehension') ? 0.24 : 0.14;
    const boosted = (operation === 'division' || operation === 'radiciacao' || operation === 'multiplication') ? 0.05 : 0;
    const reviewBoost = isReview ? 0.08 : 0;
    const consolidationBoost = isConsolidation ? 0.06 : 0;
    return Math.random() < Math.min(0.42, baseChance + boosted + reviewBoost + consolidationBoost);
}

function getOperationTrailStages(operation, level) {
    const STAGES = {
        multiplication: {
            apprentice: [
                makeStage('Ideia de grupos iguais', 5, () => { const groups=randomInt(2,5), size=randomInt(2,4); return qEqualGroups(groups, size, 'Ideia de grupos iguais'); }),
                makeStage('Soma repetida', 5, () => { const addend=randFrom([2,3,4,5]); const times=randomInt(2,4); return qRepeatedAddition(addend, times, 'Soma repetida'); }),
                makeStage('Dobro e triplo', 5, () => { const factor=Math.random() < 0.55 ? 2 : 3; const base=randomInt(2,9); return qDoubleTriple(base, factor, 'Dobro e triplo'); }),
                makeStage('Contagem em saltos', 5, () => { const step=randFrom([2,3,5,10]); const count=randomInt(3,6); return qSkipCounting(step, count, 'Contagem em saltos'); }),
                makeStage('Tabuada do 2', 5, () => qMultiplicationBasic(2, randomInt(1,10), 'Tabuada do 2')),
                makeStage('Tabuada do 3', 5, () => qMultiplicationBasic(3, randomInt(1,10), 'Tabuada do 3')),
                makeStage('Tabuada do 5', 5, () => qMultiplicationBasic(5, randomInt(1,10), 'Tabuada do 5')),
                makeStage('Tabuada do 10', 5, () => qMultiplicationBasic(10, randomInt(1,10), 'Tabuada do 10')),
                makeStage('Revisão mista guiada', 5, () => { const pool=[
                    () => { const groups=randomInt(2,5), size=randomInt(2,5); return qEqualGroups(groups, size, 'Revisão mista guiada'); },
                    () => { const addend=randFrom([2,3,5]); const times=randomInt(2,4); return qRepeatedAddition(addend, times, 'Revisão mista guiada'); },
                    () => { const step=randFrom([2,3,5,10]); const count=randomInt(3,6); return qSkipCounting(step, count, 'Revisão mista guiada'); },
                    () => { const base=randFrom([2,3,5,10]); return qMultiplicationBasic(base, randomInt(1,10), 'Revisão mista guiada'); }
                ]; return randFrom(pool)(); }),
                makeStage('Domínio final', 5, () => { const pool=[
                    () => { const factor=randFrom([2,3]); const base=randomInt(2,9); return qDoubleTriple(base, factor, 'Domínio final'); },
                    () => { const groups=randomInt(2,6), size=randFrom([2,3,5,10]); return qEqualGroups(groups, size, 'Domínio final'); },
                    () => { const base=randFrom([2,3,5,10]); return qMultiplicationBasic(base, randomInt(1,10), 'Domínio final'); }
                ]; return randFrom(pool)(); })
            ],
            easy: [
                makeStage('Tabuadas 1 e 2', 10, () => qMultiplicationBasic(randFrom([1,2]), randomInt(1,10), 'Tabuadas 1 e 2')),
                makeStage('Tabuada do 3', 10, () => qMultiplicationBasic(3, randomInt(1,10), 'Tabuada do 3')),
                makeStage('Tabuada do 4', 10, () => qMultiplicationBasic(4, randomInt(1,10), 'Tabuada do 4')),
                makeStage('Tabuada do 5', 10, () => qMultiplicationBasic(5, randomInt(1,10), 'Tabuada do 5')),
                makeStage('Grupos iguais até 5', 10, () => qEqualGroups(randomInt(2,5), randomInt(2,5), 'Grupos iguais até 5')),
                makeStage('Soma repetida até 5', 10, () => qRepeatedAddition(randFrom([2,3,4,5]), randomInt(2,5), 'Soma repetida até 5')),
                makeStage('Comutatividade', 10, () => { const a=randFrom([2,3,4,5]); const b=randomInt(1,10); return Math.random() < 0.5 ? qMultiplicationBasic(a, b, 'Comutatividade') : qMultiplicationBasic(b, a, 'Comutatividade'); }),
                makeStage('Padrões das tabuadas 2 e 5', 10, () => qMultiplicationBasic(randFrom([2,5]), randomInt(1,10), 'Padrões das tabuadas 2 e 5')),
                makeStage('Revisão mista do nível fácil', 10, () => { const pool=[
                    () => qMultiplicationBasic(randFrom([1,2,3,4,5]), randomInt(1,10), 'Revisão mista do nível fácil'),
                    () => qEqualGroups(randomInt(2,5), randomInt(2,5), 'Revisão mista do nível fácil'),
                    () => qRepeatedAddition(randFrom([2,3,4,5]), randomInt(2,5), 'Revisão mista do nível fácil')
                ]; return randFrom(pool)(); }),
                makeStage('Domínio final do nível fácil', 10, () => { const pool=[
                    () => qMultiplicationBasic(randFrom([2,3,4,5]), randomInt(1,10), 'Domínio final do nível fácil'),
                    () => qEqualGroups(randomInt(2,5), randFrom([3,4,5]), 'Domínio final do nível fácil'),
                    () => qRepeatedAddition(randFrom([2,3,4,5]), randomInt(3,5), 'Domínio final do nível fácil')
                ]; return randFrom(pool)(); })
            ],
            medium: [
                makeStage('Tabuada do 6', 10, () => qMultiplicationBasic(6, randomInt(1,10), 'Tabuada do 6')),
                makeStage('Tabuada do 7', 10, () => qMultiplicationBasic(7, randomInt(1,10), 'Tabuada do 7')),
                makeStage('Tabuada do 8', 10, () => qMultiplicationBasic(8, randomInt(1,10), 'Tabuada do 8')),
                makeStage('Tabuada do 9', 10, () => qMultiplicationBasic(9, randomInt(1,10), 'Tabuada do 9')),
                makeStage('Tabuada do 10', 10, () => qMultiplicationBasic(10, randomInt(1,10), 'Tabuada do 10')),
                makeStage('Relação multiplicação e divisão', 10, () => qMultiplicationBasic(randFrom([6,7,8,9,10]), randomInt(1,10), 'Relação multiplicação e divisão')),
                makeStage('Comutatividade com fatores 6 a 10', 10, () => { const a=randFrom([6,7,8,9,10]); const b=randomInt(1,10); return Math.random() < 0.5 ? qMultiplicationBasic(a, b, 'Comutatividade com fatores 6 a 10') : qMultiplicationBasic(b, a, 'Comutatividade com fatores 6 a 10'); }),
                makeStage('Grupos iguais com 6 a 10', 10, () => qEqualGroups(randomInt(2,6), randFrom([6,7,8,9,10]), 'Grupos iguais com 6 a 10')),
                makeStage('Revisão mista do nível médio', 10, () => { const pool=[
                    () => qMultiplicationBasic(randFrom([6,7,8,9,10]), randomInt(1,10), 'Revisão mista do nível médio'),
