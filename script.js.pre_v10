                makeStage('Dois dígitos sem reagrupamento', 5, () => { const a=randomInt(10,18), b=randomInt(1,9); if ((a % 10) + b > 9) return qAddition(a - ((a % 10) + b - 9), b, 'Dois dígitos sem reagrupamento'); return qAddition(a,b,'Dois dígitos sem reagrupamento'); }),
                makeStage('Três parcelas pequenas', 5, () => { const a=randomInt(0,4), b=randomInt(0,3), c=randomInt(0,3); return qAddition3(a,b,c,'Três parcelas pequenas'); }),
