                makeStage('Completar até 10', 5, () => { const total=randomInt(3,10), known=randomInt(0,total-1); return qAdditionMissing(total, known, 'Completar até 10', Math.random()<0.5); }),
                makeStage('Dobros simples', 5, () => { const n=randomInt(1,9); return qAddition(n,n,'Dobros simples'); }),
