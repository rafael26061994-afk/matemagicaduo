                makeStage('Revisão mista do nível', 10, () => { const pool=[() => { const a=randomInt(350,999), b=randomInt(120,799); return qSubtraction(Math.max(a,b+10), b, 'Revisão mista do nível'); }, () => { const diff=randomInt(80,500), sub=randomInt(40,350); return qUnknownMinuend(diff, sub, 'Revisão mista do nível'); }, () => { const minuend=randomInt(250,999), diff=randomInt(50,minuend-20); return qUnknownSubtrahend(minuend, diff, 'Revisão mista do nível'); }]; return randFrom(pool)(); }),
                makeStage('Domínio final do nível', 10, () => { const pool=[() => { const a=randomInt(1000,6999), b=randomInt(120,3999); return qSubtraction(Math.max(a,b+100), b, 'Domínio final do nível'); }, () => { const a=randFrom([999,1999,2999,3999]), b=randomInt(20,450); return qSubtraction(a,b,'Domínio final do nível'); }]; return randFrom(pool)(); })
