            });
        }
    } catch (_) {}
}
function ensureContinueSessionButton() {
    const home = document.getElementById('home-screen');
    if (!home) return;
    const anchor = document.getElementById('btn-show-ranking');
    if (!anchor) return;
    let continueBtn = document.getElementById('btn-continue-session');
    if (!continueBtn) {
        continueBtn = document.createElement('button');
        continueBtn.type = 'button';
        continueBtn.id = 'btn-continue-session';
        continueBtn.className = 'main-btn';
        continueBtn.textContent = '▶ Continuar';
        anchor.insertAdjacentElement('afterend', continueBtn);
    }
    let newGameBtn = document.getElementById('btn-new-game');
    if (!newGameBtn) {
        newGameBtn = document.createElement('button');
        newGameBtn.type = 'button';
        newGameBtn.id = 'btn-new-game';
        newGameBtn.className = 'main-btn';
        newGameBtn.textContent = '🆕 Novo Jogo';
        continueBtn.insertAdjacentElement('afterend', newGameBtn);
    }
    const continueNow = () => {
        const snap = loadSavedPetSession();
        if (!snap) {
            refreshContinueSessionButtonVisibility();
            try { PET_LEVEL1_UI.showToast('Nenhum andamento salvo no perfil atual.', { type: 'info', timeout: 2600 }); } catch (_) {}
            return;
        }
        resumePetSessionFromSnapshot(snap);
    };
    const confirmNewGame = () => {
        const runReset = () => {
            try { stopTimer(); } catch (_) {}
            try { gameState.isGameActive = false; } catch (_) {}
            try { clearSavedPetSession(); } catch (_) {}
            clearAllPetGameData({ preserveSettings: true });
            try { refreshContinueSessionButtonVisibility(); } catch (_) {}
            try { refreshPetProgressMini(); } catch (_) {}
            try { showFeedbackMessage('Novo jogo iniciado. Dados do progresso foram apagados do perfil atual.', 'info', 2400); } catch (_) {}
            setTimeout(() => {
                try { window.location.reload(); } catch (_) { exibirTela('home-screen'); }
            }, 350);
        };
        if (window.PET_LEVEL1_UI && PET_LEVEL1_UI.openModal) {
            PET_LEVEL1_UI.openModal({
                title: 'Novo jogo',
                html: `<p>Isso vai apagar o andamento salvo, XP, conquistas, histórico, ranking e progresso do perfil atual.</p><p style="margin-top:8px;"><strong>Deseja começar do zero?</strong></p>`,
                primaryText: 'Apagar e começar',
                secondaryText: 'Cancelar',
                onPrimary: runReset
            });
            return;
        }
        if (confirm('Isso vai apagar os dados salvos do perfil atual e começar do zero. Continuar?')) runReset();
    };
    continueBtn.disabled = false;
    continueBtn.setAttribute('aria-disabled', 'false');
    newGameBtn.disabled = false;
    newGameBtn.setAttribute('aria-disabled', 'false');
    bindReliableHomeButtons();
}
function refreshContinueSessionButtonVisibility() {
    const btn = document.getElementById('btn-continue-session');
    if (!btn) return;
    const snap = loadSavedPetSession();
    btn.style.display = 'block';
    btn.disabled = false;
    btn.textContent = '▶ Continuar';
    btn.title = snap ? 'Retomar o andamento salvo do perfil atual.' : 'Nenhum andamento salvo no perfil atual. Toque para verificar.';
    btn.setAttribute('aria-disabled', 'false');
    try { btn.style.setProperty('pointer-events', 'auto', 'important'); } catch (_) {}
    try { btn.style.setProperty('cursor', 'pointer'); } catch (_) {}
}
function petContinueNow(ev = null) {
    try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
    const snap = loadSavedPetSession();
    if (!snap) {
        const now = Date.now();
        if (!window.__petNoSaveToastAt || (now - window.__petNoSaveToastAt) > 1200) {
            window.__petNoSaveToastAt = now;
            try { PET_LEVEL1_UI.showToast('Nenhum andamento salvo no perfil atual.', { type: 'info', timeout: 2200 }); } catch (_) {
                try { alert('Nenhum andamento salvo no perfil atual.'); } catch (_) {}
            }
        }
        try { refreshContinueSessionButtonVisibility(); } catch (_) {}
        return false;
    }
    try { resumePetSessionFromSnapshot(snap); } catch (_) {
        try { alert('Não foi possível retomar o andamento salvo agora.'); } catch (_) {}
    }
    return false;
}
function petConfirmNewGame(ev = null) {
    try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
    const runReset = () => {
        try { stopTimer(); } catch (_) {}
        try { gameState.isGameActive = false; } catch (_) {}
        try { clearSavedPetSession(); } catch (_) {}
        clearAllPetGameData({ preserveSettings: true });
        try { refreshContinueSessionButtonVisibility(); } catch (_) {}
        try { refreshPetProgressMini(); } catch (_) {}
        try { showFeedbackMessage('Novo jogo iniciado. Dados do progresso foram apagados do perfil atual.', 'info', 2400); } catch (_) {}
        setTimeout(() => {
            try { window.location.reload(); } catch (_) { exibirTela('home-screen'); }
        }, 250);
    };
    if (window.PET_LEVEL1_UI && PET_LEVEL1_UI.openModal) {
        PET_LEVEL1_UI.openModal({
            title: 'Novo jogo',
            html: `<p>Isso vai apagar o andamento salvo, XP, conquistas, histórico, ranking e progresso do perfil atual.</p><p style="margin-top:8px;"><strong>Deseja começar do zero?</strong></p>`,
            primaryText: 'Apagar e começar',
            secondaryText: 'Cancelar',
            onPrimary: runReset
        });
        return false;
    }
    if (confirm('Isso vai apagar os dados salvos do perfil atual e começar do zero. Continuar?')) runReset();
    return false;
}
function bindReliableHomeButton(button, actionName) {
    if (!button) return;
    button.type = 'button';
    button.disabled = false;
    button.setAttribute('aria-disabled', 'false');
    try { button.style.setProperty('pointer-events', 'auto', 'important'); } catch (_) {}
    try { button.style.setProperty('touch-action', 'manipulation'); } catch (_) {}
    try { button.style.setProperty('cursor', 'pointer'); } catch (_) {}
    const handler = (ev) => {
        try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
        const now = Date.now();
        if (__petHomeActionLock.action === actionName && (now - __petHomeActionLock.at) < 650) return false;
        __petHomeActionLock.action = actionName;
        __petHomeActionLock.at = now;
        if (actionName === 'achievements') return openPetAchievementsModalSafe(ev || null);
        if (actionName === 'continue') return petContinueNow(ev || null);
        if (actionName === 'new-game') return petConfirmNewGame(ev || null);
        return false;
    };
    if (!button.dataset.petBoundClick) {
        button.addEventListener('click', handler);
        button.dataset.petBoundClick = '1';
    }
    try { ensureTouchClick(button); } catch (_) {}
}
function bindReliableHomeButtons() {
    bindReliableHomeButton(document.getElementById('btn-pet-achievements'), 'achievements');
    bindReliableHomeButton(document.getElementById('btn-continue-session'), 'continue');
    bindReliableHomeButton(document.getElementById('btn-new-game'), 'new-game');
}
window.__petHomeDirectAction = function(actionName, ev = null) {
    try { if (ev) { ev.preventDefault(); ev.stopPropagation(); } } catch (_) {}
    if (actionName === 'achievements') {
        openPetAchievementsModalSafe(ev || null);
        return false;
    }
    if (actionName === 'continue') return petContinueNow(ev || null);
    if (actionName === 'new-game') return petConfirmNewGame(ev || null);
    return false;
};
function initPetSessionPersistence() {
    ensurePetStorageVersion();
    ensureContinueSessionButton();
    refreshContinueSessionButtonVisibility();
    // Salva quando o app perde foco
    try {
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) savePetSessionSnapshotNow();
        });
        window.addEventListener('beforeunload', () => {
            savePetSessionSnapshotNow();
        });
    } catch (_) {}
    // Auto-save leve (captura timeLeft no rápido)
    try {
        setInterval(() => {
            if (gameState.isGameActive && gameState.currentQuestion) {
                savePetSessionSnapshotNow();
                refreshContinueSessionButtonVisibility();
            }
        }, 2000);
    } catch (_) {}
    // Mantém o botão Continuar disponível na Home, sem abrir a sessão automaticamente.
    try { refreshContinueSessionButtonVisibility(); } catch (_) {}
}
function bindHomePrimaryActions() {
    if (window.__petHomePrimaryActionsBound) return;
    window.__petHomePrimaryActionsBound = true;
}
function loadStudentProfile() {
    try {
        const obj = profileStorageGetJson(PROFILE_STORAGE_KEY, { name: '', turma: '', escola: '' });
        gameState.studentProfile = {
            name: String(obj?.name || '').trim(),
            turma: String(obj?.turma || '').trim(),
            escola: String(obj?.escola || '').trim()
        };
    } catch (e) {
        gameState.studentProfile = { name: '', turma: '', escola: '' };
    }
    syncProfileButtonLabel();
    return gameState.studentProfile;
}
function saveStudentProfile(profile) {
    const safe = sanitizeStudentProfile(profile);
    profileStorageSetJson(PROFILE_STORAGE_KEY, safe);
    gameState.studentProfile = safe;
    if (!isGuestProfileActive()) {
        updateStoredProfileMeta(gameState.activeProfileId, safe);
        try { syncCloudProfileMetaForCurrentProfile(); } catch (_) {}
    }
    syncProfileButtonLabel();
    return safe;
}
function getStudentProfile() {
    return gameState.studentProfile || loadStudentProfile();
}
const PROFILE_INDEX_KEY = 'pet_profiles_index_v1';
const PROFILE_ACTIVE_KEY = 'pet_active_profile_id_v1';
const PROFILE_GUEST_ID = '__guest__';
const PROFILE_SCOPE_PREFIX = 'pet_profile';
const PROFILE_GUEST_PREFIX = 'pet_guest';
const PROFILE_MAX_COUNT = 60;
const PROFILE_BOOT_TOKEN_KEY = 'pet_profile_boot_token_v1';
const PROFILE_SCOPED_KEYS = [
    PROFILE_STORAGE_KEY,
    PET_SESSION_KEY,
    PET_PROGRESS_KEY,
    PET_SESSION_HISTORY_KEY,
    PET_LAST_SUMMARY_KEY,
    'matemagica_xp',
    'matemagica_errors',
    'matemagica_mult_cfg',
    'matemagica_mult_progress_map_v1',
    'matemagica_path_progress_v1',
    'matemagica_high_scores_v1',
    'pet_operation_trail_index_v2',
    'pet_operation_stage_unlock_v1',
    'pet_operation_skill_review_v1',
    'pet_multiplication_apprentice_completed_v1',
    'pet_initial_diagnostic_v1'
];
const PROFILE_RESETTABLE_KEYS = PROFILE_SCOPED_KEYS.filter((key) => key !== PROFILE_STORAGE_KEY);
let __profileOverlay = null;
let __profileBtn = null;
let __profileForceLock = false;
let __profileGateResolver = null;
let __profileSelectedId = null;
let __profileCreateMode = false;
function sanitizeStudentProfile(profile) {
    return {
        name: String(profile?.name || '').trim().slice(0, 50),
        turma: String(profile?.turma || '').trim().slice(0, 30),
        escola: String(profile?.escola || '').trim().slice(0, 60)
    };
}
function escapeHtml(value) {
    return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}
function normalizePin(pin) {
    return String(pin || '').replace(/\D+/g, '').slice(0, 6);
}
function isValidProfilePin(pin) {
    return /^\d{4,6}$/.test(normalizePin(pin));
}
function hashProfilePin(pin) {
    const src = normalizePin(pin);
    let h1 = 5381;
    let h2 = 52711;
    for (let i = 0; i < src.length; i++) {
        const code = src.charCodeAt(i);
        h1 = (((h1 << 5) + h1) ^ code) >>> 0;
        h2 = (((h2 << 5) + h2) + code) >>> 0;
    }
    return `${h1.toString(16)}${h2.toString(16)}`;
}
function generateProfileId() {
    return `p_${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`;
}
function normalizeStoredProfile(record) {
    const safeMeta = sanitizeStudentProfile(record || {});
    return {
        id: String(record?.id || generateProfileId()),
        name: safeMeta.name || 'Aluno',
        turma: safeMeta.turma || '',
        escola: safeMeta.escola || '',
        pinHash: String(record?.pinHash || ''),
        mustSetPin: !!record?.mustSetPin || !String(record?.pinHash || ''),
        createdAt: Number(record?.createdAt || Date.now()),
        lastUsedAt: Number(record?.lastUsedAt || 0)
    };
}
function loadProfilesIndex() {
    const def = { version: 1, profiles: [] };
    try {
        const raw = localStorage.getItem(PROFILE_INDEX_KEY);
        const obj = raw ? JSON.parse(raw) : def;
        const profiles = Array.isArray(obj?.profiles) ? obj.profiles.map(normalizeStoredProfile).slice(0, PROFILE_MAX_COUNT) : [];
        return { version: 1, profiles };
    } catch (_) {
        return def;
    }
}
function saveProfilesIndex(index) {
    const safe = {
        version: 1,
        profiles: Array.isArray(index?.profiles) ? index.profiles.map(normalizeStoredProfile).slice(0, PROFILE_MAX_COUNT) : []
    };
    try { localStorage.setItem(PROFILE_INDEX_KEY, JSON.stringify(safe)); } catch (_) {}
    return safe;
}
function getStoredProfiles() {
    return loadProfilesIndex().profiles;
}
function getStoredProfile(profileId) {
    return getStoredProfiles().find((p) => p.id === String(profileId || '')) || null;
}
function saveProfileRaw(baseKey, rawValue, profileId = null) {
    const id = profileId || gameState.activeProfileId || PROFILE_GUEST_ID;
    const driver = id === PROFILE_GUEST_ID ? sessionStorage : localStorage;
    const scopedKey = id === PROFILE_GUEST_ID ? `${PROFILE_GUEST_PREFIX}::${baseKey}` : `${PROFILE_SCOPE_PREFIX}::${id}::${baseKey}`;
    try { driver.setItem(scopedKey, rawValue); } catch (_) {}
}
function isGuestProfileActive(profileId = null) {
    const id = profileId || gameState.activeProfileId;
    return id === PROFILE_GUEST_ID || !!gameState.isGuestProfile;
}
function getScopedStorageKey(baseKey, profileId = null) {
    const id = profileId || gameState.activeProfileId;
    if (!id) return baseKey;
    return id === PROFILE_GUEST_ID ? `${PROFILE_GUEST_PREFIX}::${baseKey}` : `${PROFILE_SCOPE_PREFIX}::${id}::${baseKey}`;
}
function getScopedStorageDriver(profileId = null) {
    const id = profileId || gameState.activeProfileId;
    return id === PROFILE_GUEST_ID ? sessionStorage : localStorage;
}
function profileStorageGetRaw(baseKey, profileId = null) {
    try {
        const driver = getScopedStorageDriver(profileId);
        const scoped = driver.getItem(getScopedStorageKey(baseKey, profileId));
        if (scoped != null) return scoped;
    } catch (_) {}
    if (!profileId && !gameState.activeProfileId && !isGuestProfileActive()) {
        try { return localStorage.getItem(baseKey); } catch (_) {}
    }
    return null;
}
function profileStorageGetJson(baseKey, fallback, profileId = null) {
    const raw = profileStorageGetRaw(baseKey, profileId);
    return safeJsonParse(raw, fallback);
}
function profileStorageSetJson(baseKey, value, profileId = null) {
    saveProfileRaw(baseKey, JSON.stringify(value), profileId || gameState.activeProfileId || PROFILE_GUEST_ID);
}
function profileStorageSetText(baseKey, value, profileId = null) {
    saveProfileRaw(baseKey, String(value), profileId || gameState.activeProfileId || PROFILE_GUEST_ID);
}
function profileStorageRemove(baseKey, profileId = null) {
    const id = profileId || gameState.activeProfileId;
    if (!id) return;
    try {
        getScopedStorageDriver(id).removeItem(getScopedStorageKey(baseKey, id));
    } catch (_) {}
}
function clearScopedProfileData(profileId = null, keys = PROFILE_RESETTABLE_KEYS) {
    const id = profileId || gameState.activeProfileId;
    if (!id) return;
    (Array.isArray(keys) ? keys : PROFILE_RESETTABLE_KEYS).forEach((key) => profileStorageRemove(key, id));
}
function clearGuestSessionData() {
    clearScopedProfileData(PROFILE_GUEST_ID, PROFILE_SCOPED_KEYS);
}
function createStoredProfile(meta, pin, options = {}) {
    const safeMeta = sanitizeStudentProfile(meta);
    const idx = loadProfilesIndex();
    const rec = normalizeStoredProfile({
        id: options.id || generateProfileId(),
        ...safeMeta,
        pinHash: isValidProfilePin(pin) ? hashProfilePin(pin) : '',
        mustSetPin: !!options.mustSetPin || !isValidProfilePin(pin),
        createdAt: Date.now(),
        lastUsedAt: 0
    });
    idx.profiles.unshift(rec);
    saveProfilesIndex(idx);
    profileStorageSetJson(PROFILE_STORAGE_KEY, safeMeta, rec.id);
    return rec;
}
function updateStoredProfileMeta(profileId, meta) {
    if (!profileId || profileId === PROFILE_GUEST_ID) return null;
    const safeMeta = sanitizeStudentProfile(meta);
    const idx = loadProfilesIndex();
    idx.profiles = idx.profiles.map((p) => p.id === profileId ? normalizeStoredProfile({ ...p, ...safeMeta }) : p);
    saveProfilesIndex(idx);
    profileStorageSetJson(PROFILE_STORAGE_KEY, safeMeta, profileId);
    return getStoredProfile(profileId);
}
function updateStoredProfilePin(profileId, pin) {
    if (!profileId || profileId === PROFILE_GUEST_ID || !isValidProfilePin(pin)) return null;
    const idx = loadProfilesIndex();
    idx.profiles = idx.profiles.map((p) => p.id === profileId ? normalizeStoredProfile({ ...p, pinHash: hashProfilePin(pin), mustSetPin: false }) : p);
    saveProfilesIndex(idx);
    return getStoredProfile(profileId);
}
function touchStoredProfile(profileId) {
    if (!profileId || profileId === PROFILE_GUEST_ID) return;
    const idx = loadProfilesIndex();
    idx.profiles = idx.profiles.map((p) => p.id === profileId ? normalizeStoredProfile({ ...p, lastUsedAt: Date.now() }) : p);
    saveProfilesIndex(idx);
    try { localStorage.setItem(PROFILE_ACTIVE_KEY, profileId); } catch (_) {}
}
function verifyStoredProfilePin(profileId, pin) {
    const profile = getStoredProfile(profileId);
    if (!profile) return false;
    if (profile.mustSetPin || !profile.pinHash) return false;
    return profile.pinHash === hashProfilePin(pin);
}
function hasLegacyProfileData() {
    return PROFILE_SCOPED_KEYS.some((key) => {
        try { return localStorage.getItem(key) != null; } catch (_) { return false; }
    });
}
function migrateLegacyProfileDataIfNeeded() {
    const idx = loadProfilesIndex();
    if (idx.profiles.length) return idx;
    if (!hasLegacyProfileData()) return idx;
    const legacyMeta = safeJsonParse(localStorage.getItem(PROFILE_STORAGE_KEY), {});
    const profile = createStoredProfile({
        name: String(legacyMeta?.name || '').trim() || 'Aluno local',
        turma: String(legacyMeta?.turma || '').trim(),
        escola: String(legacyMeta?.escola || '').trim()
    }, '', { mustSetPin: true });
    PROFILE_SCOPED_KEYS.forEach((baseKey) => {
        try {
            const raw = localStorage.getItem(baseKey);
            if (raw != null) saveProfileRaw(baseKey, raw, profile.id);
        } catch (_) {}
    });
    PROFILE_SCOPED_KEYS.forEach((baseKey) => {
        try { localStorage.removeItem(baseKey); } catch (_) {}
    });
    try { localStorage.removeItem(PROFILE_ACTIVE_KEY); } catch (_) {}
    return loadProfilesIndex();
}
function syncProfileButtonLabel() {
    if (!__profileBtn) return;
    const label = isGuestProfileActive()
        ? 'Perfil'
        : (String(gameState.studentProfile?.name || '').trim() || 'Perfil');
    const shortLabel = label.length > 14 ? `${label.slice(0, 14)}…` : label;
    __profileBtn.innerHTML = `<span class="icon">👤</span> ${shortLabel}`;
    __profileBtn.title = isGuestProfileActive()
        ? 'Abrir perfis neste dispositivo'
        : (label === 'Perfil' ? 'Perfis neste dispositivo' : `Perfil ativo: ${label}`);
}
function activateStoredProfileContext(profileId) {
    const profile = getStoredProfile(profileId);
    if (!profile) return null;
    gameState.activeProfileId = profile.id;
    gameState.isGuestProfile = false;
    touchStoredProfile(profile.id);
    loadStudentProfile();
    syncProfileButtonLabel();
    return profile;
}
function activateGuestProfileContext() {
    clearGuestSessionData();
    gameState.activeProfileId = PROFILE_GUEST_ID;
    gameState.isGuestProfile = true;
    gameState.studentProfile = { name: 'Visitante', turma: '', escola: '' };
    profileStorageSetJson(PROFILE_STORAGE_KEY, gameState.studentProfile, PROFILE_GUEST_ID);
    try { localStorage.removeItem(PROFILE_ACTIVE_KEY); } catch (_) {}
    syncProfileButtonLabel();
}
function getPreferredProfileId() {
    try {
        const saved = String(localStorage.getItem(PROFILE_ACTIVE_KEY) || '');
        if (saved && getStoredProfile(saved)) return saved;
    } catch (_) {}
    const list = getStoredProfiles();
    return list.length ? list[0].id : null;
}
function setProfileBootToken(profileId) {
    try { sessionStorage.setItem(PROFILE_BOOT_TOKEN_KEY, String(profileId || '')); } catch (_) {}
}
function consumeProfileBootToken() {
    try {
        const token = String(sessionStorage.getItem(PROFILE_BOOT_TOKEN_KEY) || '');
        sessionStorage.removeItem(PROFILE_BOOT_TOKEN_KEY);
        return token || '';
    } catch (_) {
        return '';
    }
}
function loadProfileBoundState() {
    loadStudentProfile();
    carregarXP();
    carregarErros();
    carregarRanking();
    loadMultiplicationConfig();
    loadMultProgressMap();
}
function getProfileHistoryFor(profileId) {
    const raw = profileStorageGetRaw(PET_SESSION_HISTORY_KEY, profileId);
    const arr = safeJsonParse(raw, []);
    return Array.isArray(arr) ? arr : [];
}
function loadAllPetSessionHistory() {
    const out = [];
    getStoredProfiles().forEach((profile) => {
        getProfileHistoryFor(profile.id).forEach((item) => out.push(item));
    });
    if (isGuestProfileActive()) {
        getProfileHistoryFor(PROFILE_GUEST_ID).forEach((item) => out.push(item));
    }
    return out.sort((a, b) => Number(b?.endedAt || 0) - Number(a?.endedAt || 0));
}
function openProfileOverlay(options = {}) {
    ensureProfileUI();
    if (!__profileOverlay) return Promise.resolve(null);
    const lockedMode = !!options.locked;
    if (!lockedMode && !__profileOverlay.classList.contains('hidden')) return Promise.resolve(false);
    if (!petGuardAction(lockedMode ? 'profile-overlay-open-locked' : 'profile-overlay-open', lockedMode ? 220 : 420)) return Promise.resolve(false);
    __profileForceLock = lockedMode;
    document.body.classList.toggle('profile-lock-active', __profileForceLock);
    const closeBtn = __profileOverlay.querySelector('#profile-close');
    if (closeBtn) closeBtn.style.display = __profileForceLock ? 'none' : 'inline-flex';
    __profileOverlay.classList.remove('hidden');
    const profiles = getStoredProfiles();
    if (!__profileSelectedId || !getStoredProfile(__profileSelectedId)) {
        __profileSelectedId = getPreferredProfileId();
    }
    if (!profiles.length) __profileCreateMode = true;
    refreshProfileOverlay();
    if (!__profileForceLock) return Promise.resolve(true);
    return new Promise((resolve) => {
        __profileGateResolver = resolve;
    });
}
function closeProfileOverlay(force = false) {
    if (!__profileOverlay) return;
    if (__profileForceLock && !force) return;
    __profileOverlay.classList.add('hidden');
    document.body.classList.remove('profile-lock-active');
    __profileForceLock = false;
}
function resolveProfileGate(result = true) {
    if (typeof __profileGateResolver === 'function') {
        const fn = __profileGateResolver;
        __profileGateResolver = null;
        fn(result);
    }
}
function refreshProfileOverlay() {
    if (!__profileOverlay) return;
    const profiles = getStoredProfiles();
    const selected = __profileSelectedId ? getStoredProfile(__profileSelectedId) : null;
    const listEl = __profileOverlay.querySelector('#profile-list');
    const stateEl = __profileOverlay.querySelector('#profile-selected-state');
    const loginHintEl = __profileOverlay.querySelector('#profile-login-hint');
    const loginPinEl = __profileOverlay.querySelector('#profile-login-pin');
    const enterBtn = __profileOverlay.querySelector('#profile-enter');
    const createBtn = __profileOverlay.querySelector('#profile-create');
    const createShortcutBtn = __profileOverlay.querySelector('#profile-create-shortcut');
    const saveBtn = __profileOverlay.querySelector('#profile-save-current');
    const guestBtn = __profileOverlay.querySelector('#profile-guest');
    const lockBtn = __profileOverlay.querySelector('#profile-lock');
    const nameEl = __profileOverlay.querySelector('#profile-name');
    const turmaEl = __profileOverlay.querySelector('#profile-turma');
    const escolaEl = __profileOverlay.querySelector('#profile-escola');
    const pinEl = __profileOverlay.querySelector('#profile-pin');
    const pin2El = __profileOverlay.querySelector('#profile-pin-confirm');
    const formTitleEl = __profileOverlay.querySelector('#profile-form-title');
    const formHintEl = __profileOverlay.querySelector('#profile-form-hint');
    const modeBadgeEl = __profileOverlay.querySelector('#profile-mode-badge');
    if (listEl) {
        listEl.innerHTML = profiles.map((profile) => {
            const active = profile.id === __profileSelectedId;
            const pinState = profile.mustSetPin ? 'Definir PIN' : 'PIN ativo';
            const lastUsed = profile.lastUsedAt ? formatTimeBR(profile.lastUsedAt) : 'Nunca usado';
            return `
              <button class="profile-card ${active ? 'selected' : ''}" type="button" data-profile-id="${profile.id}">
                <span class="profile-card-name">${escapeHtml(profile.name || 'Aluno')}</span>
                <span class="profile-card-meta">${escapeHtml(profile.turma || 'Sem turma')} • ${escapeHtml(pinState)}</span>
                <span class="profile-card-last">${escapeHtml(lastUsed)}</span>
              </button>
            `;
        }).join('');
        listEl.querySelectorAll('[data-profile-id]').forEach((btn) => {
            btn.addEventListener('click', () => {
                __profileSelectedId = btn.getAttribute('data-profile-id');
                __profileCreateMode = false;
                refreshProfileOverlay();
            });
        });
    }
    if (modeBadgeEl) {
        if (__profileCreateMode) modeBadgeEl.textContent = 'Novo perfil';
        else if (selected) modeBadgeEl.textContent = selected.mustSetPin ? 'PIN pendente' : 'Perfil selecionado';
        else modeBadgeEl.textContent = profiles.length ? 'Selecione um perfil' : 'Sem perfis';
    }
    if (selected && !__profileCreateMode) {
        if (nameEl) nameEl.value = selected.name || '';
        if (turmaEl) turmaEl.value = selected.turma || '';
        if (escolaEl) escolaEl.value = selected.escola || '';
        if (formTitleEl) formTitleEl.textContent = selected.mustSetPin ? 'Complete e defina o PIN' : 'Editar perfil selecionado';
        if (formHintEl) formHintEl.textContent = selected.mustSetPin
            ? 'Esse perfil veio da versão antiga. Defina um PIN para continuar usando no computador compartilhado.'
            : 'Você pode corrigir nome, turma, escola e trocar o PIN deste perfil.';
    } else {
        if (nameEl) nameEl.value = '';
        if (turmaEl) turmaEl.value = '';
        if (escolaEl) escolaEl.value = '';
        if (formTitleEl) formTitleEl.textContent = 'Criar novo perfil';
        if (formHintEl) formHintEl.textContent = 'Use PIN de 4 a 6 dígitos. Este perfil ficará salvo apenas neste computador.';
    }
    if (pinEl) pinEl.value = '';
    if (pin2El) pin2El.value = '';
    if (loginPinEl) loginPinEl.value = '';
    if (stateEl) {
        stateEl.textContent = selected
            ? `${selected.name || 'Aluno'}${selected.turma ? ` • ${selected.turma}` : ''}`
            : (profiles.length ? 'Selecione um perfil acima.' : 'Nenhum perfil criado ainda.');
    }
    if (loginHintEl) {
        loginHintEl.textContent = selected
            ? (selected.mustSetPin ? 'Esse perfil precisa definir um PIN antes do primeiro acesso.' : 'Digite o PIN do perfil selecionado para entrar.')
            : 'Selecione um perfil acima ou clique em "Criar novo perfil + PIN".';
    }
    if (enterBtn) enterBtn.disabled = !(selected && !selected.mustSetPin && !!selected.pinHash);
    if (saveBtn) saveBtn.textContent = (__profileCreateMode || !selected) ? 'Criar perfil e PIN' : (selected.mustSetPin ? 'Salvar perfil e PIN' : 'Salvar alterações');
    if (createBtn) createBtn.textContent = 'Novo perfil';
    if (createShortcutBtn) createShortcutBtn.textContent = 'Criar novo perfil + PIN';
    if (guestBtn) guestBtn.textContent = 'Entrar como visitante';
    if (lockBtn) lockBtn.style.display = __profileForceLock ? 'none' : 'inline-flex';
    try { refreshProfileCloudUi(); } catch (_) {}
}
function ensureProfileUI() {
    if (__profileBtn && __profileOverlay) return;
    const bar = document.querySelector('.settings-bar');
    if (!bar) return;
    if (!__profileBtn) {
        __profileBtn = document.createElement('button');
        __profileBtn.id = 'btn-student-profile';
        __profileBtn.className = 'setting-btn';
        __profileBtn.type = 'button';
        __profileBtn.innerHTML = '<span class="icon">👤</span> Perfil';
        bar.appendChild(__profileBtn);
        bindGuardedClick(__profileBtn, 'profile-overlay-button', () => {
            openProfileOverlay({ locked: false });
            return false;
        }, { minIntervalMs: 420, bindToken: 'profile-overlay-button' });
    }
    if (!__profileOverlay) {
        const overlay = document.createElement('div');
        overlay.id = 'profile-overlay';
        overlay.className = 'teacher-overlay hidden';
        overlay.innerHTML = `
          <div class="teacher-panel profile-panel profile-device-panel" role="dialog" aria-modal="true" aria-label="Perfis neste dispositivo">
            <div class="teacher-panel-header">
              <div>
                <div id="profile-mode-badge" class="profile-mode-badge">Perfis</div>
                <h3>Perfis neste dispositivo</h3>
              </div>
              <button id="profile-close" class="teacher-close" type="button" aria-label="Fechar">✕</button>
            </div>
            <p class="teacher-help">
              Computador compartilhado exige <strong>PIN</strong>. Cada aluno entra no próprio perfil. <strong>Visitante</strong> não salva dados após fechar a sessão.
            </p>
            <div class="profile-scroll-tip">↕ Role a tela para subir ou descer até o campo de PIN.</div>
            <div class="teacher-panel-section">
              <div class="profile-section-title">Perfis salvos</div>
              <div id="profile-list" class="profile-list"></div>
            </div>
            <div class="teacher-panel-section">
              <div class="profile-section-title">Entrar no perfil</div>
              <div id="profile-selected-state" class="profile-inline-note">Selecione um perfil acima.</div>
              <div id="profile-login-hint" class="teacher-help" style="margin-top:8px;"></div>
              <label class="tp-label">PIN</label>
              <input id="profile-login-pin" class="tp-input" type="password" inputmode="numeric" maxlength="6" placeholder="4 a 6 dígitos">
              <div class="teacher-row" style="margin-top: 12px; gap: 8px; flex-wrap: wrap;">
                <button id="profile-enter" class="btn-action" type="button">Entrar</button>
                <button id="profile-create-shortcut" class="btn-action btn-secondary" type="button">Criar novo perfil + PIN</button>
                <button id="profile-guest" class="btn-action btn-secondary" type="button">Entrar como visitante</button>
                <button id="profile-lock" class="btn-action btn-secondary" type="button">Bloquear acesso</button>
              </div>
            </div>
            <div class="teacher-panel-section">
              <div class="profile-section-title" id="profile-form-title">Criar novo perfil</div>
              <p id="profile-form-hint" class="teacher-help">Use PIN de 4 a 6 dígitos.</p>
              <label class="tp-label">Nome do aluno</label>
              <input id="profile-name" class="tp-input" type="text" maxlength="50" placeholder="Ex.: Ana, João, Aluno 12">
              <label class="tp-label">Turma</label>
              <input id="profile-turma" class="tp-input" type="text" maxlength="30" placeholder="Ex.: 701, 8ºA">
              <label class="tp-label">Escola</label>
              <input id="profile-escola" class="tp-input" type="text" maxlength="60" placeholder="Ex.: E.M. ...">
              <label class="tp-label">PIN</label>
              <input id="profile-pin" class="tp-input" type="password" inputmode="numeric" maxlength="6" placeholder="4 a 6 dígitos">
              <label class="tp-label">Confirmar PIN</label>
              <input id="profile-pin-confirm" class="tp-input" type="password" inputmode="numeric" maxlength="6" placeholder="Repita o PIN">
              <div class="teacher-row" style="margin-top: 12px; gap: 8px; flex-wrap: wrap;">
                <button id="profile-save-current" class="btn-action" type="button">Criar perfil</button>
                <button id="profile-create" class="btn-action btn-secondary" type="button">Novo perfil</button>
              </div>
            </div>
            <div class="teacher-panel-section">
              <div class="profile-section-title">Conta online e sincronização</div>
              <div id="profile-cloud-badge" class="profile-inline-note">Conta online opcional</div>
              <p class="teacher-help">Use e-mail e senha apenas para backup, continuidade entre dispositivos e sincronização. O <strong>PIN continua sendo local</strong> neste computador.</p>
              <div id="profile-cloud-status" class="profile-inline-note" data-level="info">Conta online opcional para backup e sincronização.</div>
              <label class="tp-label">E-mail</label>
              <input id="profile-cloud-email" class="tp-input" type="email" maxlength="120" placeholder="seuemail@exemplo.com">
              <label class="tp-label">Senha da conta online</label>
              <input id="profile-cloud-password" class="tp-input" type="password" maxlength="80" placeholder="Mínimo recomendado: 8 caracteres">
              <div class="teacher-row" style="margin-top: 12px; gap: 8px; flex-wrap: wrap;">
                <button id="profile-cloud-signin" class="btn-action" type="button">Entrar na nuvem</button>
                <button id="profile-cloud-signup" class="btn-action btn-secondary" type="button">Criar conta online</button>
                <button id="profile-cloud-link" class="btn-action btn-secondary" type="button">Vincular perfil atual</button>
                <button id="profile-cloud-sync" class="btn-action btn-secondary" type="button">Sincronizar agora</button>
                <button id="profile-cloud-signout" class="btn-action btn-secondary" type="button" style="display:none;">Sair da conta online</button>
              </div>
            </div>
          </div>
        `;
        document.body.appendChild(overlay);
        __profileOverlay = overlay;
        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeProfileOverlay(); });
        overlay.querySelector('#profile-close').addEventListener('click', () => closeProfileOverlay());
        const openCreateProfileMode = () => {
            __profileCreateMode = true;
            __profileSelectedId = null;
            refreshProfileOverlay();
            setTimeout(() => {
                try { overlay.querySelector('#profile-name')?.focus(); } catch (_) {}
            }, 20);
        };
        overlay.querySelector('#profile-create').addEventListener('click', openCreateProfileMode);
        overlay.querySelector('#profile-create-shortcut').addEventListener('click', openCreateProfileMode);
        overlay.querySelector('#profile-lock').addEventListener('click', () => {
            closeProfileOverlay(true);
            setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
        });
        overlay.querySelector('#profile-guest').addEventListener('click', () => {
            activateGuestProfileContext();
            closeProfileOverlay(true);
            if (__profileForceLock) resolveProfileGate(true);
            else {
                setProfileBootToken(PROFILE_GUEST_ID);
                setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
            }
        });
        overlay.querySelector('#profile-enter').addEventListener('click', () => {
            const selected = __profileSelectedId ? getStoredProfile(__profileSelectedId) : null;
            const pin = normalizePin(overlay.querySelector('#profile-login-pin').value);
            if (!selected) {
                showFeedbackMessage('Selecione um perfil primeiro.', 'error', 1800);
                return;
            }
            if (!verifyStoredProfilePin(selected.id, pin)) {
                showFeedbackMessage('PIN inválido.', 'error', 1800);
                return;
            }
            activateStoredProfileContext(selected.id);
            closeProfileOverlay(true);
            if (__profileGateResolver) resolveProfileGate(true);
            else {
                setProfileBootToken(selected.id);
                setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
            }
        });
        overlay.querySelector('#profile-save-current').addEventListener('click', () => {
            const meta = {
                name: overlay.querySelector('#profile-name').value,
                turma: overlay.querySelector('#profile-turma').value,
                escola: overlay.querySelector('#profile-escola').value
            };
            const safeMeta = sanitizeStudentProfile(meta);
            const pin = normalizePin(overlay.querySelector('#profile-pin').value);
            const pin2 = normalizePin(overlay.querySelector('#profile-pin-confirm').value);
            if (!safeMeta.name) {
                showFeedbackMessage('Nome do aluno é obrigatório.', 'error', 1800);
                return;
            }
            const selected = __profileCreateMode ? null : (__profileSelectedId ? getStoredProfile(__profileSelectedId) : null);
            const needsPin = !selected || !!selected.mustSetPin || pin || pin2;
            if (needsPin) {
                if (!isValidProfilePin(pin)) {
                    showFeedbackMessage('Use PIN de 4 a 6 dígitos.', 'error', 1800);
                    return;
                }
                if (pin !== pin2) {
                    showFeedbackMessage('PIN e confirmação não conferem.', 'error', 1800);
                    return;
                }
            }
            if (!selected) {
                const created = createStoredProfile(safeMeta, pin);
                __profileSelectedId = created.id;
                __profileCreateMode = false;
                activateStoredProfileContext(created.id);
                closeProfileOverlay(true);
                if (__profileGateResolver) resolveProfileGate(true);
                else {
                    setProfileBootToken(created.id);
                    setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 40);
                }
                return;
            }
            updateStoredProfileMeta(selected.id, safeMeta);
            if (needsPin && isValidProfilePin(pin)) updateStoredProfilePin(selected.id, pin);
            if (gameState.activeProfileId === selected.id && !gameState.isGuestProfile) {
                saveStudentProfile(safeMeta);
            }
            showFeedbackMessage('Perfil salvo neste dispositivo.', 'success', 1600);
            refreshProfileOverlay();
            if (__profileForceLock) {
                activateStoredProfileContext(selected.id);
                closeProfileOverlay(true);
                resolveProfileGate(true);
            }
        });
        overlay.querySelector('#profile-cloud-signup').addEventListener('click', async () => {
            const email = String(overlay.querySelector('#profile-cloud-email')?.value || '').trim();
            const password = String(overlay.querySelector('#profile-cloud-password')?.value || '');
            if (!isCloudFeatureConfigured()) {
                setProfileCloudUiMessage('Preencha supabaseUrl e supabaseAnonKey em js/pet-config.js primeiro.', 'error');
                return;
            }
            if (!email || !password) {
                setProfileCloudUiMessage('Informe e-mail e senha da conta online.', 'error');
                return;
            }
            try {
                setProfileCloudUiBusy(true);
                const result = await window.PETAuth.signUpWithEmail(email, password);
                const authError = result?.error;
                if (authError) throw authError;
                await syncCloudProfileMetaForCurrentProfile();
                setProfileCloudUiMessage('Conta online criada. Verifique seu e-mail se o projeto exigir confirmação.', 'success');
                await refreshProfileCloudUi();
            } catch (err) {
                setProfileCloudUiMessage(`Falha ao criar conta: ${String(err?.message || err)}`, 'error');
            } finally {
                setProfileCloudUiBusy(false);
            }
        });
        overlay.querySelector('#profile-cloud-signin').addEventListener('click', async () => {
            const email = String(overlay.querySelector('#profile-cloud-email')?.value || '').trim();
            const password = String(overlay.querySelector('#profile-cloud-password')?.value || '');
            if (!isCloudFeatureConfigured()) {
                setProfileCloudUiMessage('Preencha supabaseUrl e supabaseAnonKey em js/pet-config.js primeiro.', 'error');
                return;
            }
            if (!email || !password) {
                setProfileCloudUiMessage('Informe e-mail e senha da conta online.', 'error');
                return;
            }
            try {
                setProfileCloudUiBusy(true);
                const result = await window.PETAuth.signInWithEmail(email, password);
                const authError = result?.error;
                if (authError) throw authError;
                await syncCloudProfileMetaForCurrentProfile();
                const boot = await runCloudBootstrapForCurrentProfile();
                if (boot?.mode === 'remote-preferred') {
                    setProfileCloudUiMessage('Conta conectada e progresso mais recente carregado da nuvem.', 'success');
                } else {
                    setProfileCloudUiMessage('Conta conectada. Perfil local pronto para sincronizar.', 'success');
                }
                await refreshProfileCloudUi();
            } catch (err) {
                setProfileCloudUiMessage(`Falha ao entrar: ${String(err?.message || err)}`, 'error');
            } finally {
                setProfileCloudUiBusy(false);
            }
        });
        overlay.querySelector('#profile-cloud-link').addEventListener('click', async () => {
            try {
                setProfileCloudUiBusy(true);
                const linked = await syncCloudProfileMetaForCurrentProfile();
                if (!linked) throw new Error('Selecione um perfil local ativo e entre na conta online antes de vincular.');
                setProfileCloudUiMessage('Perfil local vinculado à conta online.', 'success');
                await refreshProfileCloudUi();
            } catch (err) {
                setProfileCloudUiMessage(`Falha ao vincular: ${String(err?.message || err)}`, 'error');
            } finally {
                setProfileCloudUiBusy(false);
            }
        });
        overlay.querySelector('#profile-cloud-sync').addEventListener('click', async () => {
            try {
                setProfileCloudUiBusy(true);
                const result = await queueCloudSyncForCurrentProfile('progress');
                const processed = Number(result?.processed || 0);
                const failed = Number(result?.failed || 0);
                setProfileCloudUiMessage(`Sincronização executada. Processados: ${processed}. Falhas pendentes: ${failed}.`, failed ? 'error' : 'success');
                await refreshProfileCloudUi();
            } catch (err) {
                setProfileCloudUiMessage(`Falha ao sincronizar: ${String(err?.message || err)}`, 'error');
            } finally {
                setProfileCloudUiBusy(false);
            }
        });
        overlay.querySelector('#profile-cloud-signout').addEventListener('click', async () => {
            try {
                setProfileCloudUiBusy(true);
                await window.PETAuth.signOut();
                setProfileCloudUiMessage('Conta online desconectada neste navegador.', 'success');
                await refreshProfileCloudUi();
            } catch (err) {
                setProfileCloudUiMessage(`Falha ao sair da conta: ${String(err?.message || err)}`, 'error');
            } finally {
                setProfileCloudUiBusy(false);
            }
        });
        try {
            if (window.PETAuth && window.PETAuth.onAuthStateChange) {
                window.PETAuth.onAuthStateChange(async () => {
                    try { await refreshProfileCloudUi(); } catch (_) {}
                });
            }
        } catch (_) {}
    }
    syncProfileButtonLabel();
}

function isCloudFeatureConfigured() {
    try {
        return !!(window.PETConfig && window.PETConfig.supabaseUrl && window.PETConfig.supabaseAnonKey);
    } catch (_) {
        return false;
    }
}
async function getCloudSessionSafe() {
    try {
        if (!window.PETAuth || !isCloudFeatureConfigured()) return null;
        return await window.PETAuth.getSession();
    } catch (_) {
        return null;
    }
}
function getProfileCloudUiState() {
    return window.__petCloudUiState || (window.__petCloudUiState = { busy: false, message: '', level: 'info' });
}
function setProfileCloudUiMessage(message, level = 'info') {
    const state = getProfileCloudUiState();
    state.message = String(message || '');
    state.level = String(level || 'info');
    const box = document.querySelector('#profile-cloud-status');
    if (box) {
        box.textContent = state.message || 'Conta online opcional para backup e sincronização.';
        box.setAttribute('data-level', state.level);
    }
}
function setProfileCloudUiBusy(flag) {
    const state = getProfileCloudUiState();
    state.busy = !!flag;
    ['#profile-cloud-signin', '#profile-cloud-signup', '#profile-cloud-signout', '#profile-cloud-sync', '#profile-cloud-link'].forEach((sel) => {
        const el = document.querySelector(sel);
        if (el) el.disabled = !!flag;
    });
}
async function refreshProfileCloudUi() {
    if (!__profileOverlay) return;
    const statusBadge = __profileOverlay.querySelector('#profile-cloud-badge');
    const emailEl = __profileOverlay.querySelector('#profile-cloud-email');
    const pwdEl = __profileOverlay.querySelector('#profile-cloud-password');
    const signOutBtn = __profileOverlay.querySelector('#profile-cloud-signout');
    const signInBtn = __profileOverlay.querySelector('#profile-cloud-signin');
    const signUpBtn = __profileOverlay.querySelector('#profile-cloud-signup');
    const syncBtn = __profileOverlay.querySelector('#profile-cloud-sync');
    const linkBtn = __profileOverlay.querySelector('#profile-cloud-link');
    const activeCtx = (window.PETBridge && window.PETBridge.getActiveProfileContext) ? window.PETBridge.getActiveProfileContext() : { deviceProfileId: null, isGuest: true };
    const hasLocalProfile = !!(activeCtx && activeCtx.deviceProfileId && !activeCtx.isGuest);
    const configured = isCloudFeatureConfigured();
    const session = await getCloudSessionSafe();
    const email = session?.user?.email || '';
    const linkMap = (window.PETLocalDriver && window.PETLocalDriver.getCloudLinkMap) ? window.PETLocalDriver.getCloudLinkMap() : {};
    const linked = !!(activeCtx?.deviceProfileId && linkMap[activeCtx.deviceProfileId]);
    if (statusBadge) {
        if (!configured) statusBadge.textContent = 'Supabase não configurado';
        else if (!session) statusBadge.textContent = 'Conta online desconectada';
        else if (!hasLocalProfile) statusBadge.textContent = 'Visitante não sincroniza';
        else statusBadge.textContent = linked ? 'Perfil vinculado à nuvem' : 'Conta conectada, perfil local não vinculado';
    }
    if (signOutBtn) signOutBtn.style.display = session ? 'inline-flex' : 'none';
    if (signInBtn) signInBtn.style.display = session ? 'none' : 'inline-flex';
    if (signUpBtn) signUpBtn.style.display = session ? 'none' : 'inline-flex';
    if (syncBtn) syncBtn.style.display = session ? 'inline-flex' : 'none';
    if (linkBtn) linkBtn.style.display = session ? 'inline-flex' : 'none';
    if (syncBtn) syncBtn.disabled = !session || !hasLocalProfile;
    if (linkBtn) linkBtn.disabled = !session || !hasLocalProfile;
    if (emailEl) emailEl.disabled = !!session;
    if (pwdEl) pwdEl.disabled = !!session;
    const state = getProfileCloudUiState();
    setProfileCloudUiMessage(state.message || (configured
        ? (session
            ? (email ? `Conta conectada: ${email}` : 'Conta online conectada.')
            : 'Conta online opcional para backup e sincronização.')
        : 'Preencha supabaseUrl e supabaseAnonKey em js/pet-config.js para ativar a nuvem.'), state.level || 'info');
}
async function runCloudBootstrapForCurrentProfile() {
    try {
        if (!window.PETBridge || !window.PETBridge.bootstrapCurrentProfileFromCloud) return { mode: 'unavailable' };
        const result = await window.PETBridge.bootstrapCurrentProfileFromCloud();
        if (result && result.mode === 'remote-preferred') {
            loadProfileBoundState();
            try { refreshPetProgressMini(); } catch (_) {}
            try { refreshContinueSessionButtonVisibility(); } catch (_) {}
            try { syncProfileButtonLabel(); } catch (_) {}
        }
        return result || { mode: 'noop' };
    } catch (err) {
        console.warn('Falha ao carregar snapshot cloud:', err);
        return { mode: 'error', error: err };
    }
}
async function queueCloudSyncForCurrentProfile(kind = 'progress', payload = null) {
    try {
        if (!window.PETBridge || !window.PETSync || !window.PETRepositories) return { mode: 'unavailable' };
        const ctx = window.PETBridge.getActiveProfileContext();
        if (!ctx || !ctx.deviceProfileId || ctx.isGuest) return { mode: 'guest-or-missing' };
        if (!(await getCloudSessionSafe())) return { mode: 'local-only-no-session' };
        const profile = window.PETRepositories.profiles.readLocal(ctx.deviceProfileId, false);
        await window.PETRepositories.profiles.ensureCloudLinked(ctx.deviceProfileId, profile);
        if (kind === 'session' && payload) {
            await window.PETRepositories.sessions.queueSync(ctx.deviceProfileId, payload);
        } else {
            const snap = window.PETRepositories.progress.readLocalSnapshot(ctx.deviceProfileId, false);
            await window.PETRepositories.progress.queueSync(ctx.deviceProfileId, snap);
        }
        return await window.PETSync.syncNow();
    } catch (err) {
        console.warn('Falha ao sincronizar com a nuvem:', err);
        return { mode: 'error', error: err };
    }
}
async function syncCloudProfileMetaForCurrentProfile() {
    try {
        if (!window.PETBridge || !window.PETRepositories) return null;
        const ctx = window.PETBridge.getActiveProfileContext();
        if (!ctx || !ctx.deviceProfileId || ctx.isGuest) return null;
        if (!(await getCloudSessionSafe())) return null;
        const profile = window.PETRepositories.profiles.readLocal(ctx.deviceProfileId, false);
        return await window.PETRepositories.profiles.ensureCloudLinked(ctx.deviceProfileId, profile);
    } catch (err) {
        console.warn('Falha ao vincular perfil local à nuvem:', err);
        return null;
    }
}

async function bootstrapProfileAccess() {
    migrateLegacyProfileDataIfNeeded();
    ensureProfileUI();
    const bootToken = consumeProfileBootToken();
    if (bootToken === PROFILE_GUEST_ID) {
        activateGuestProfileContext();
        return;
    }
    if (bootToken && getStoredProfile(bootToken) && !getStoredProfile(bootToken).mustSetPin) {
        activateStoredProfileContext(bootToken);
        return;
    }
    __profileCreateMode = !getStoredProfiles().length;
    __profileSelectedId = null;
    activateGuestProfileContext();
}
// --- PROGRESSO POR TRILHA DA TABUADA (salva por faixa/nível) ---
const MULT_PROGRESS_KEY = 'matemagica_mult_progress_map_v1';
function loadMultProgressMap() {
    try {
        const map = profileStorageGetJson(MULT_PROGRESS_KEY, {});
        gameState.multiplication.progressByKey = (map && typeof map === 'object') ? map : {};
    } catch (e) {
        gameState.multiplication.progressByKey = {};
    }
    return gameState.multiplication.progressByKey;
}
function saveMultProgressMap() {
    try {
        profileStorageSetJson(MULT_PROGRESS_KEY, gameState.multiplication.progressByKey || {});
    } catch (e) {
        console.warn("Falha ao salvar progresso da tabuada por chave:", e);
    }
}
function getSavedTrailIndexForKey(key, expectedLen) {
    if (!gameState.multiplication.progressByKey) loadMultProgressMap();
    const idx = Number(gameState.multiplication.progressByKey?.[key] ?? 0);
    if (!Number.isFinite(idx) || idx < 0) return 0;
    if (Number.isInteger(expectedLen) && expectedLen > 0 && idx >= expectedLen) return 0; // ciclo completo -> reinicia
    return Math.floor(idx);
}
function setSavedTrailIndexForKey(key, idx) {
    if (!gameState.multiplication.progressByKey) loadMultProgressMap();
    const n = Number(idx);
    gameState.multiplication.progressByKey[key] = Number.isFinite(n) && n >= 0 ? Math.floor(n) : 0;
    saveMultProgressMap();
}
// --- MAPA (TRILHA) NO ESTILO DUOLINGO (clean) ---
const PATH_PROGRESS_KEY = 'matemagica_path_progress_v1';
function loadPathProgress() {
    try {
        const obj = profileStorageGetJson(PATH_PROGRESS_KEY, {});
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (e) {
        return {};
    }
}
function savePathProgress(obj) {
    try { profileStorageSetJson(PATH_PROGRESS_KEY, obj || {}); } catch (e) {}
}
function getPathDone(operation, level) {
    const data = loadPathProgress();
    return Math.max(0, Math.min(10, Number(data?.[operation]?.[level] ?? 0)));
}
function setPathDone(operation, level, done) {
    const data = loadPathProgress();
    if (!data[operation]) data[operation] = {};
    data[operation][level] = Math.max(0, Math.min(10, Number(done) || 0));
    savePathProgress(data);
}
function ensureLearningMapUI() {
    const screen = document.getElementById('level-selection-screen');
    if (!screen) return;
    let card = document.getElementById('learning-map-card');
    if (!card) {
        card = document.createElement('div');
        card.id = 'learning-map-card';
        card.className = 'info-card map-card';
        card.innerHTML = `
            <div class="map-header">
                <h2>Trilha (mapa)</h2>
                <p class="map-sub">Visualize seu progresso e avance passo a passo.</p>
            </div>
            <div id="learning-map-rows" class="map-rows"></div>
        `;
        const header = screen.querySelector('header');
        if (header && header.parentNode) {
            header.parentNode.insertBefore(card, header.nextSibling);
        } else {
            screen.appendChild(card);
        }
    }
}
function getOperationLevelReviewAggregate(operation, level) {
    try {
        const map = loadOperationSkillReviewMap();
        const prefix = `${getOperationTrailKey(operation, level)}::stage::`;
        const records = Object.entries(map || {})
            .filter(([key, value]) => key.startsWith(prefix) && value && typeof value === 'object')
            .map(([, value]) => value);
        if (!records.length) {
            return {
                hasEvidence: false,
                totalAsked: 0,
                totalCorrect: 0,
                overallAcc: 0,
                maxWrongStreak: 0,
                anyRed: false,
                latestRecord: null,
                independentAsked: 0,
                independentCorrect: 0,
                assistedAsked: 0,
                assistedCorrect: 0,
                independentAcc: 0,
                assistedAcc: 0,
                maintainedSessions: 0,
                supportHeavy: false
            };
        }
        let totalAsked = 0;
        let totalCorrect = 0;
        let maxWrongStreak = 0;
        let anyRed = false;
        let latestRecord = null;
        let independentAsked = 0;
        let independentCorrect = 0;
        let assistedAsked = 0;
        let assistedCorrect = 0;
        let maintainedSessions = 0;
        records.forEach((record) => {
            totalAsked += Math.max(0, Number(record.totalAsked) || 0);
            totalCorrect += Math.max(0, Number(record.totalCorrect) || 0);
            independentAsked += Math.max(0, Number(record.independentAsked) || 0);
            independentCorrect += Math.max(0, Number(record.independentCorrect) || 0);
            assistedAsked += Math.max(0, Number(record.assistedAsked) || 0);
            assistedCorrect += Math.max(0, Number(record.assistedCorrect) || 0);
            const evidence = getStageEvidenceProfile(record);
            maintainedSessions += Math.max(0, Number(evidence.maintainedSessions) || 0);
            maxWrongStreak = Math.max(maxWrongStreak, Math.max(0, Number(record.consecutiveWrong) || 0));
            const traffic = getPedagogicalTrafficLight(record);
            if (traffic.code === 'red') anyRed = true;
            if (!latestRecord || Number(record.lastSeenAt || 0) > Number(latestRecord.lastSeenAt || 0)) latestRecord = record;
        });
        return {
            hasEvidence: totalAsked > 0,
            totalAsked,
            totalCorrect,
            overallAcc: totalAsked > 0 ? (totalCorrect / totalAsked) : 0,
            maxWrongStreak,
            anyRed,
            latestRecord,
            independentAsked,
            independentCorrect,
            assistedAsked,
            assistedCorrect,
            independentAcc: independentAsked > 0 ? (independentCorrect / independentAsked) : 0,
            assistedAcc: assistedAsked > 0 ? (assistedCorrect / assistedAsked) : 0,
            maintainedSessions,
            supportHeavy: assistedAsked > independentAsked && assistedAsked > 0
        };
    } catch (_) {
        return {
            hasEvidence: false,
            totalAsked: 0,
            totalCorrect: 0,
            overallAcc: 0,
            maxWrongStreak: 0,
            anyRed: false,
            latestRecord: null,
            independentAsked: 0,
            independentCorrect: 0,
            assistedAsked: 0,
            assistedCorrect: 0,
            independentAcc: 0,
            assistedAcc: 0,
            maintainedSessions: 0,
            supportHeavy: false
        };
    }
}
function getOperationLevelProgressRatio(operation, level) {
    try {
        const stages = getOperationTrailStages(operation, level) || [];
        if (Array.isArray(stages) && stages.length) {
            if (isMasteryTrailOperation(operation)) {
                const unlocked = getSavedOperationStageUnlock(operation, level, stages.length);
                const review = getOperationLevelReviewAggregate(operation, level);
                if (!review.hasEvidence && unlocked <= 0) return 0;
                return Math.max(0, Math.min(1, unlocked / Math.max(1, stages.length - 1)));
            }
            const bankSize = getOperationTrailBankSize(operation, level);
            const idx = getSavedOperationTrailIndex(operation, level, bankSize);
            return bankSize > 0 ? Math.max(0, Math.min(1, idx / bankSize)) : 0;
        }
        if (operation === 'multiplication') {
            const r = getTabuadaRangeByLevel(level);
            const key = `${r.min}-${r.max}|${r.multMin}-${r.multMax}`;
            const bankSize = getTrailTargetSize(r.min, r.max, r.multMin, r.multMax);
            const idx = getSavedTrailIndexForKey(key, bankSize);
            return bankSize > 0 ? Math.max(0, Math.min(1, idx / bankSize)) : 0;
        }
        return 0;
    } catch (_) {
        return 0;
    }
}
function ensureLevelPedagogyCard() {
    try {
        const screen = document.getElementById('level-selection-screen');
        if (!screen) return null;
        let card = document.getElementById('level-pedagogy-card');
        if (card) return card;
        card = document.createElement('div');
        card.id = 'level-pedagogy-card';
        card.className = 'info-card level-pedagogy-card';
        card.innerHTML = `
            <h2>Liberação pedagógica</h2>
            <p id="level-pedagogy-summary">Os níveis agora mostram se estão liberados, em consolidação, dominados, bloqueados ou pedindo retorno.</p>
            <div id="level-unlock-progress-card" class="level-unlock-progress-card" aria-live="polite">
                <div class="level-unlock-progress-head">
                    <strong id="level-unlock-progress-title">Progresso para liberar o próximo nível</strong>
                    <span id="level-unlock-progress-value" class="level-unlock-progress-value">0%</span>
                </div>
                <div class="level-unlock-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-labelledby="level-unlock-progress-title">
                    <div id="level-unlock-progress-fill" class="level-unlock-progress-fill" style="width:0%"></div>
                </div>
                <p id="level-unlock-progress-note" class="level-unlock-progress-note">Consolide o nível atual para liberar o próximo.</p>
                <div class="level-unlock-progress-insights">
                    <div class="level-unlock-insight">
                        <span class="level-unlock-label">Principal gargalo</span>
                        <strong id="level-unlock-primary-bottleneck">—</strong>
                    </div>
                    <div class="level-unlock-insight">
                        <span class="level-unlock-label">Próxima ação</span>
                        <strong id="level-unlock-next-action">—</strong>
                    </div>
                    <div class="level-unlock-insight">
                        <span class="level-unlock-label">Confiança da decisão</span>
                        <strong id="level-unlock-confidence">—</strong>
                    </div>
                </div>
                <button id="level-unlock-progress-explain-toggle" class="btn-action btn-secondary level-unlock-explain-toggle" type="button" aria-expanded="false" aria-controls="level-unlock-progress-explain">Como esta barra é calculada?</button>
                <div id="level-unlock-progress-explain" class="level-unlock-progress-explain hidden">
                    <p id="level-unlock-progress-explain-note" class="level-unlock-progress-explain-note">A barra resume os critérios pedagógicos usados para a liberação.</p>
                    <ul id="level-unlock-progress-criteria" class="level-unlock-progress-criteria"></ul>
                </div>
            </div>
            <div class="level-pedagogy-legend" aria-hidden="true">
                <span class="level-state-chip state-released">✅ Liberado</span>
                <span class="level-state-chip state-consolidating">🟡 Consolidação</span>
                <span class="level-state-chip state-mastered">🟢 Dominado</span>
                <span class="level-state-chip state-return">↩️ Retorno</span>
                <span class="level-state-chip state-locked">🔒 Bloqueado</span>
            </div>
        `;
        const mapCard = document.getElementById('learning-map-card');
        const levelSelection = screen.querySelector('.level-selection');
        if (mapCard && mapCard.parentNode) {
            mapCard.parentNode.insertBefore(card, mapCard.nextSibling);
        } else if (levelSelection && levelSelection.parentNode) {
            levelSelection.parentNode.insertBefore(card, levelSelection);
        } else {
            screen.appendChild(card);
        }
        const explainToggle = card.querySelector('#level-unlock-progress-explain-toggle');
        const explainBox = card.querySelector('#level-unlock-progress-explain');
        if (explainToggle && explainBox && !explainToggle.dataset.bound) {
            explainToggle.dataset.bound = '1';
            explainToggle.addEventListener('click', () => {
                const expanded = explainToggle.getAttribute('aria-expanded') === 'true';
                explainToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
                explainBox.classList.toggle('hidden', expanded);
            });
        }
        return card;
    } catch (_) {
        return null;
    }
}
function getOperationLevelPedagogyContext(operation, level) {
    const stages = getOperationTrailStages(operation, level) || [];
    const totalStages = Array.isArray(stages) ? stages.length : 0;
    const review = getOperationLevelReviewAggregate(operation, level);
    const progressRatio = getOperationLevelProgressRatio(operation, level);
    const unlockedIdx = totalStages ? getSavedOperationStageUnlock(operation, level, totalStages) : 0;
    const currentStageIndex = Math.max(0, Math.min(Math.max(0, totalStages - 1), unlockedIdx));
    const currentStageLabel = String(stages[currentStageIndex]?.label || 'Habilidade atual').trim();
    const currentRecord = totalStages ? getOperationSkillReviewRecord(operation, level, currentStageIndex) : null;
    const currentSkillProfile = getPedagogySkillProfile(operation, currentStageLabel, level);
    const currentEvidence = getStageEvidenceProfile(currentRecord, null, { operation, stageLabel: currentStageLabel, level });
    const currentBlocking = getBlockingTypicalErrorMeta(operation, currentStageLabel, currentRecord, { operation, stageLabel: currentStageLabel, level });
    const prereqGate = getStagePrerequisiteGate(operation, level, stages, currentStageIndex, currentStageLabel);
    const finalStageIndex = Math.max(0, totalStages - 1);
    const finalRecord = totalStages ? getOperationSkillReviewRecord(operation, level, finalStageIndex) : null;
    const finalStageLabel = String(stages[finalStageIndex]?.label || '');
    const finalSkillProfile = getPedagogySkillProfile(operation, finalStageLabel, level);
    const finalEvidence = getStageEvidenceProfile(finalRecord, null, { operation, stageLabel: finalStageLabel, level });
    const finalBlocking = getBlockingTypicalErrorMeta(operation, finalStageLabel, finalRecord, { operation, stageLabel: finalStageLabel, level });
    const stageProgressTarget = totalStages > 1 ? Math.max(1, totalStages - 1) : 1;
    const stageProgressRatio = totalStages > 0 ? Math.max(0, Math.min(1, unlockedIdx / stageProgressTarget)) : Math.max(0, Math.min(1, progressRatio));
    return {
        stages,
        totalStages,
        review,
        progressRatio,
        unlockedIdx,
        currentStageIndex,
        currentStageLabel,
        currentRecord,
        currentEvidence,
        currentBlocking,
        currentSkillProfile,
        prereqGate,
        finalRecord,
        finalEvidence,
        finalBlocking,
        finalSkillProfile,
        finalStageIndex,
        stageProgressRatio
    };
}
function computePedagogicalUnlockProgressMeta({ evidence = null, blocking = null, prereqGate = null, stageProgressRatio = 0, skillProfile = null, manualOverride = null } = {}) {
    const safeEvidence = evidence && typeof evidence === 'object' ? evidence : null;
    const profile = skillProfile && typeof skillProfile === 'object' ? skillProfile : getPedagogySkillProfile('', '', '');
    const threshold = Math.max(0.01, Number(safeEvidence?.masteryThreshold) || 0.8);
    const independentAsked = Math.max(0, Number(safeEvidence?.independentAsked) || 0);
    const missingIndependent = Math.max(0, Number(safeEvidence?.missingIndependentEvidence) || 0);
    const independentTarget = Math.max(1, independentAsked + missingIndependent);
    const maintenanceCount = Math.max(0, Number(safeEvidence?.maintainedSessions) || 0);
    const maintenanceMissing = Math.max(0, Number(safeEvidence?.missingMaintenanceSessions) || 0);
    const maintenanceTarget = Math.max(1, maintenanceCount + maintenanceMissing);
    const criteria = [
        {
            key: 'trail',
            label: 'Trilha do nível',
            ratio: Math.max(0, Math.min(1, Number(stageProgressRatio) || 0)),
            detail: `${Math.round(Math.max(0, Math.min(1, Number(stageProgressRatio) || 0)) * 100)}% do nível percorrido`,
            weight: Number(profile.progressWeight) || 1
        },
        {
            key: 'evidence',
            label: 'Evidências independentes',
            ratio: safeEvidence ? Math.max(0, Math.min(1, independentAsked / independentTarget)) : 0,
            detail: safeEvidence ? `${Math.min(independentTarget, independentAsked)}/${independentTarget}` : '0/0',
            weight: Number(profile.evidenceWeight) || 1
        },
        {
            key: 'precision',
            label: 'Precisão independente',
            ratio: safeEvidence && independentAsked > 0 ? Math.max(0, Math.min(1, (Number(safeEvidence.independentAcc) || 0) / threshold)) : 0,
            detail: safeEvidence && independentAsked > 0 ? `${Math.round((Number(safeEvidence.independentAcc) || 0) * 100)}% de ${Math.round(threshold * 100)}%` : `0% de ${Math.round(threshold * 100)}%`,
            weight: Number(profile.precisionWeight) || 1
        },
        {
            key: 'maintenance',
            label: 'Sessões de manutenção',
            ratio: safeEvidence ? Math.max(0, Math.min(1, maintenanceCount / maintenanceTarget)) : 0,
            detail: safeEvidence ? `${Math.min(maintenanceTarget, maintenanceCount)}/${maintenanceTarget}` : '0/0',
            weight: Number(profile.maintenanceWeight) || 1
        },
        {
            key: 'autonomy',
            label: 'Autonomia maior que apoio',
            ratio: safeEvidence ? (safeEvidence.supportHeavy ? Math.max(0, Math.min(1, (independentAsked + 1) / Math.max(2, (Number(safeEvidence.assistedAsked) || 0) + 1))) : 1) : 0,
            detail: safeEvidence ? (safeEvidence.supportHeavy ? 'apoio ainda pesa mais' : 'autonomia suficiente') : 'sem evidência',
            weight: Number(profile.autonomyWeight) || 1
        },
        {
            key: 'blocking',
            label: 'Erro dominante desbloqueado',
            ratio: blocking && blocking.isBlocking ? 0 : 1,
            detail: blocking && blocking.isBlocking ? `bloqueado por ${blocking.label || 'erro dominante'}` : 'sem erro dominante bloqueador',
            weight: Number(profile.blockingWeight) || 1
        },
        {
            key: 'prereq',
            label: 'Pré-requisito da etapa',
            ratio: prereqGate && prereqGate.required ? (prereqGate.ok ? 1 : 0) : 1,
            detail: prereqGate && prereqGate.required ? (prereqGate.ok ? 'pré-requisito consolidado' : `falta ${prereqGate.prerequisiteLabel || 'base anterior'}`) : 'sem pré-requisito pendente',
            weight: Number(profile.prereqWeight) || 1
        },
        {
            key: 'freshness',
            label: 'Prática recente',
            ratio: safeEvidence && safeEvidence.stale ? 0 : 1,
            detail: safeEvidence && safeEvidence.stale ? `${safeEvidence.daysWithoutPractice || 0} dia(s) sem prática` : 'prática recente',
            weight: Number(profile.freshnessWeight) || 1
        }
    ];
    const weightedTotal = criteria.reduce((acc, item) => acc + (Number(item.weight) || 1), 0);
    const weightedScore = criteria.reduce((acc, item) => acc + ((Number(item.ratio) || 0) * (Number(item.weight) || 1)), 0);
    const percent = Math.round((weightedScore / Math.max(1, weightedTotal)) * 100);
    const missing = [];
    if (safeEvidence?.missingIndependentEvidence > 0) missing.push(`${safeEvidence.missingIndependentEvidence} evidência(s) independente(s)`);
    if (safeEvidence && independentAsked > 0 && Number(safeEvidence.independentAcc || 0) < threshold) missing.push(`precisão independente em ${Math.round((Number(safeEvidence.independentAcc) || 0) * 100)}%`);
    if (safeEvidence?.missingMaintenanceSessions > 0) missing.push(`${safeEvidence.missingMaintenanceSessions} sessão(ões) de manutenção`);
    if (safeEvidence?.supportHeavy) missing.push('reduzir dependência de apoio');
    if (blocking && blocking.isBlocking) missing.push(`resolver erro dominante: ${blocking.label || blocking.code || 'bloqueador atual'}`);
    if (prereqGate && prereqGate.required && !prereqGate.ok) missing.push(`consolidar ${prereqGate.prerequisiteLabel || 'o pré-requisito da etapa'}`);
    if (safeEvidence?.stale) missing.push('retomar prática recente');
    const confidence = computePedagogicalDecisionConfidence({ evidence: safeEvidence, blocking, prereqGate, manualOverride, skillProfile: profile });
    const bottleneck = buildPedagogicalBottleneckMeta({ evidence: safeEvidence, blocking, prereqGate, manualOverride, confidence });
    const explain = [
        `A barra mistura trilha, autonomia, manutenção, erro dominante, pré-requisito e prática recente.`,
        `Nesta habilidade o sistema está usando um perfil ${profile.label}, então alguns critérios pesam mais do que outros.`
    ].join(' ');
    return {
        percent,
        criteria,
        missingText: missing.join('; '),
        complete: percent >= 100 && !missing.length,
        bottleneck,
        confidence,
        explain,
        skillProfile: profile
    };
}
function getNextLevelUnlockProgress(operation, states = null) {
    const levels = getOperationLevelOrder(operation);
    if (!Array.isArray(levels) || !levels.length) return null;
    const resolvedStates = states || computeOperationLevelPedagogicalStates(operation);
    const firstLockedIndex = levels.findIndex((level, index) => index > 0 && resolvedStates[level]?.code === 'locked');
    let sourceLevel = '';
    let targetLevel = '';
    if (firstLockedIndex > 0) {
        sourceLevel = levels[firstLockedIndex - 1];
        targetLevel = levels[firstLockedIndex];
    } else {
        const firstUnmasteredIndex = levels.findIndex((level) => resolvedStates[level]?.code !== 'mastered');
        if (firstUnmasteredIndex === -1) {
            const lastLevel = levels[levels.length - 1] || '';
            return {
                sourceLevel: lastLevel,
                targetLevel: '',
                percent: 100,
                title: 'Todos os níveis já foram liberados',
                note: 'Você já conquistou domínio suficiente para avançar em toda a trilha desta operação.',
                missingText: '',
                criteria: [],
                stateCode: 'mastered'
            };
        }
        sourceLevel = levels[firstUnmasteredIndex];
        targetLevel = levels[firstUnmasteredIndex + 1] || '';
    }
    const ctx = getOperationLevelPedagogyContext(operation, sourceLevel);
    const sourceState = resolvedStates[sourceLevel] || null;
    const evidence = ctx.finalEvidence?.hasEvidence ? ctx.finalEvidence : ctx.currentEvidence;
    const blocking = ctx.finalBlocking?.isBlocking ? ctx.finalBlocking : ctx.currentBlocking;
    const skillProfile = ctx.finalEvidence?.hasEvidence ? ctx.finalSkillProfile : ctx.currentSkillProfile;
    const progress = computePedagogicalUnlockProgressMeta({
        evidence,
        blocking,
        prereqGate: ctx.prereqGate,
        stageProgressRatio: ctx.stageProgressRatio,
        skillProfile,
        manualOverride: sourceState?.manualOverride || null
    });
    const percent = sourceState?.code === 'mastered' ? 100 : progress.percent;
    const sourceLabel = petLevelLabel(sourceLevel || '');
    const targetLabel = targetLevel ? petLevelLabel(targetLevel) : '';
    let title = targetLabel
        ? `Progresso para liberar ${targetLabel}`
        : `Progresso de domínio em ${sourceLabel}`;
    let note = targetLabel
        ? `Consolide ${sourceLabel} para liberar ${targetLabel}.`
        : `Consolide ${sourceLabel} para fechar a trilha atual.`;
    if (sourceState?.code === 'mastered') {
        note = targetLabel
            ? `${sourceLabel} já atingiu domínio suficiente para liberar ${targetLabel}.`
            : `${sourceLabel} já está dominado.`;
    } else if (progress.missingText) {
        note = `${note} Falta: ${progress.missingText}.`;
    }
    return {
        sourceLevel,
        targetLevel,
        sourceLabel,
        targetLabel,
        percent,
        title,
        note,
        missingText: progress.missingText,
        criteria: progress.criteria,
        stateCode: sourceState?.code || '',
        bottleneck: progress.bottleneck,
        confidence: progress.confidence,
        explain: progress.explain,
        skillProfile: progress.skillProfile,
        nextAction: sourceState?.nextAction || ''
    };
}
function updateLevelUnlockProgressCard(operation, states = null) {
    try {
        const card = ensureLevelPedagogyCard();
        if (!card) return null;
        const titleEl = document.getElementById('level-unlock-progress-title');
        const valueEl = document.getElementById('level-unlock-progress-value');
        const noteEl = document.getElementById('level-unlock-progress-note');
        const fillEl = document.getElementById('level-unlock-progress-fill');
        const wrapEl = document.getElementById('level-unlock-progress-card');
        const barEl = card.querySelector('.level-unlock-progress-bar');
        const bottleneckEl = document.getElementById('level-unlock-primary-bottleneck');
        const nextActionEl = document.getElementById('level-unlock-next-action');
        const confidenceEl = document.getElementById('level-unlock-confidence');
        const explainNoteEl = document.getElementById('level-unlock-progress-explain-note');
        const criteriaEl = document.getElementById('level-unlock-progress-criteria');
        const meta = getNextLevelUnlockProgress(operation, states);
        if (!meta) {
            if (wrapEl) wrapEl.classList.add('hidden');
            return null;
        }
        if (wrapEl) wrapEl.classList.remove('hidden');
        const percent = Math.max(0, Math.min(100, Number(meta.percent) || 0));
        if (titleEl) titleEl.textContent = meta.title || 'Progresso para liberar o próximo nível';
        if (valueEl) valueEl.textContent = `${percent}%`;
        if (noteEl) noteEl.textContent = meta.note || 'Consolide o nível atual para liberar o próximo.';
        if (fillEl) fillEl.style.width = `${percent}%`;
        if (barEl) {
            barEl.setAttribute('aria-valuenow', String(percent));
            barEl.setAttribute('aria-valuetext', `${percent}% para ${meta.targetLabel || meta.sourceLabel || 'o próximo passo pedagógico'}`);
        }
        if (bottleneckEl) bottleneckEl.textContent = meta.bottleneck ? `${meta.bottleneck.label}: ${meta.bottleneck.detail}` : 'Sem gargalo crítico no momento.';
        if (nextActionEl) nextActionEl.textContent = meta.nextAction || 'Continue praticando até estabilizar a habilidade.';
        if (confidenceEl) confidenceEl.textContent = meta.confidence ? `${meta.confidence.label} (${meta.confidence.percent}%)` : '—';
        if (explainNoteEl) explainNoteEl.textContent = meta.explain || 'A barra resume os critérios pedagógicos usados para a liberação.';
        if (criteriaEl) {
            criteriaEl.innerHTML = (Array.isArray(meta.criteria) ? meta.criteria : []).map((item) => {
                const ratio = Math.round(Math.max(0, Math.min(1, Number(item?.ratio) || 0)) * 100);
                const weight = Number(item?.weight) || 1;
                return `<li><strong>${item?.label || 'Critério'}</strong> — ${ratio}% • peso ${weight.toFixed(2).replace(/\.00$/, '')}. <span>${item?.detail || ''}</span></li>`;
            }).join('');
        }
        if (wrapEl) {
            wrapEl.dataset.targetLevel = meta.targetLevel || '';
            wrapEl.dataset.sourceLevel = meta.sourceLevel || '';
            wrapEl.title = [meta.note || '', meta.bottleneck?.detail || '', meta.nextAction || ''].filter(Boolean).join(' • ');
        }
        return meta;
    } catch (_) {
        return null;
    }
}
function computeOperationLevelPedagogicalStates(operation) {
    const policy = getPedagogyPolicyConfig();
    const levels = getOperationLevelOrder(operation);
    const out = {};
    levels.forEach((level, index) => {
        const prev = index > 0 ? levels[index - 1] : null;
        const ctx = getOperationLevelPedagogyContext(operation, level);
        const {
            stages,
            totalStages,
            review,
            progressRatio,
            unlockedIdx,
            currentStageIndex,
            currentStageLabel,
            currentRecord,
            currentEvidence,
            currentBlocking,
            prereqGate,
            finalRecord,
            finalEvidence,
            finalBlocking,
            currentSkillProfile,
            finalSkillProfile
        } = ctx;
        const prevState = prev ? out[prev] : null;
        const hasEvidence = !!review.hasEvidence || progressRatio > 0.02 || unlockedIdx > 0;
        const started = hasEvidence;
        const ownMastered = totalStages
            ? (unlockedIdx >= Math.max(0, totalStages - 1) && finalEvidence.autonomyReady && !finalBlocking.isBlocking && !finalEvidence.stale)
            : (progressRatio >= 0.9);
        const currentWeak = !!(review.hasEvidence && (review.anyRed || review.overallAcc < Number(policy.warningAccuracyMin || 0.6) || review.maxWrongStreak >= Math.max(2, Number(policy.wrongStreakLimit) || 2)));
        const autonomyWeak = currentEvidence.hasEvidence && (!currentEvidence.independentReady || currentEvidence.supportHeavy);
        const maintenanceWeak = currentEvidence.hasEvidence && !currentEvidence.maintenanceReady;
        const prerequisiteWeak = prereqGate.required && !prereqGate.ok;
        const blockingWeak = currentBlocking.isBlocking;
        const freshnessWeak = currentEvidence.hasEvidence && currentEvidence.stale;
        const missingText = buildLevelGateMissingText({ evidence: currentEvidence, blocking: currentBlocking, prereqGate });
        let code = 'released';
        let badge = '✅ Liberado';
        let detail = 'Pode iniciar este nível.';
        let recommendation = '';
        let returnLevel = '';
        let technicalReason = '';
        if (!prev) {
            if (ownMastered) {
                code = 'mastered';
                badge = '🟢 Dominado';
                detail = 'Base consolidada com domínio independente.';
                recommendation = levels[index + 1]
                    ? `${petLevelLabel(level)} dominado. O próximo passo pedagógico é ${petLevelLabel(levels[index + 1])}.`
                    : 'Este nível já mostrou domínio independente e manutenção do desempenho.';
            } else if (started) {
                code = (blockingWeak || prerequisiteWeak || currentWeak || freshnessWeak) ? 'return' : 'consolidating';
                badge = code === 'return' ? '↩️ Retorno' : '🟡 Consolidação';
                technicalReason = blockingWeak
                    ? currentBlocking.detail
                    : prerequisiteWeak
                        ? prereqGate.detail
                        : freshnessWeak
                            ? `o domínio ficou desatualizado após ${currentEvidence.daysWithoutPractice} dia(s) sem prática recente.`
                            : autonomyWeak
                                ? 'autonomia ainda fraca para tratar este nível como liberado.'
                                : maintenanceWeak
                                    ? 'o desempenho ainda não se manteve em mais de uma sessão.'
                                    : 'o nível já começou, mas ainda precisa consolidar por domínio.';
                detail = totalStages
                    ? `Etapa ${Math.min(totalStages, currentStageIndex + 1)}/${totalStages} • ${currentStageLabel}.`
                    : `Em progresso: ${Math.round(progressRatio * 100)}% concluído.`;
                recommendation = [technicalReason, missingText].filter(Boolean).join(' ');
            } else {
                code = 'released';
                badge = '✅ Liberado';
                detail = 'Ponto de entrada pedagógico.';
                recommendation = `Política ${policy.label}: pode começar por aqui e construir autonomia antes de subir.`;
            }
        } else if (!prevState || prevState.code !== 'mastered') {
            if (hasEvidence) {
                code = 'return';
                badge = `↩️ Retomar ${petLevelLabel(prev)}`;
                technicalReason = prevState?.technicalReason
                    ? `o nível anterior (${petLevelLabel(prev)}) ainda não sustenta avanço: ${prevState.technicalReason}`
                    : `o nível anterior (${petLevelLabel(prev)}) ainda não mostrou domínio independente suficiente.`;
                detail = `A base de ${petLevelLabel(prev)} ainda não está firme para sustentar ${petLevelLabel(level)}.`;
                recommendation = `${technicalReason} ${missingText || `Consolide ${petLevelLabel(prev)} por domínio antes de voltar.`}`.trim();
                returnLevel = prev;
            } else {
                code = 'locked';
                badge = '🔒 Bloqueado';
                technicalReason = prevState?.technicalReason
                    ? `pré-requisito de nível não cumprido: ${prevState.technicalReason}`
                    : `pré-requisito de nível não cumprido: ${petLevelLabel(prev)} ainda não está dominado.`;
                detail = `Exige domínio em ${petLevelLabel(prev)} antes de liberar ${petLevelLabel(level)}.`;
                recommendation = `${technicalReason} Conquiste domínio em ${petLevelLabel(prev)} para liberar ${petLevelLabel(level)}.`;
                returnLevel = prev;
            }
        } else if (ownMastered) {
            code = 'mastered';
            badge = '🟢 Dominado';
            detail = 'Este nível já mostrou domínio independente e manutenção.';
            recommendation = levels[index + 1]
                ? `${petLevelLabel(level)} dominado. Pode seguir para ${petLevelLabel(levels[index + 1])}.`
                : 'Este é o nível mais alto atualmente dominado.';
        } else if (blockingWeak || prerequisiteWeak || freshnessWeak || currentWeak) {
            code = 'return';
            badge = `↩️ Retomar ${petLevelLabel(prev)}`;
            technicalReason = blockingWeak
                ? currentBlocking.detail
                : prerequisiteWeak
                    ? prereqGate.detail
                    : freshnessWeak
                        ? `o domínio de ${petLevelLabel(level)} ficou desatualizado após ${currentEvidence.daysWithoutPractice} dia(s) sem prática.`
                        : 'o desempenho atual ainda não sustenta permanência neste nível.';
            detail = `Ainda não é seguro permanecer em ${petLevelLabel(level)} sem rever a base anterior.`;
            recommendation = `${technicalReason} ${missingText}`.trim();
            returnLevel = prev;
        } else if (started) {
            code = 'consolidating';
            badge = '🟡 Consolidação';
            technicalReason = autonomyWeak
                ? 'a autonomia ainda está abaixo do mínimo para liberar por domínio.'
                : maintenanceWeak
                    ? 'falta manter o desempenho em mais de uma sessão.'
                    : 'o nível já começou, mas ainda precisa consolidar por domínio independente.';
            detail = totalStages
                ? `Etapa ${Math.min(totalStages, currentStageIndex + 1)}/${totalStages} • ${currentStageLabel}.`
                : `Em progresso: ${Math.round(progressRatio * 100)}% concluído.`;
            recommendation = [technicalReason, missingText].filter(Boolean).join(' ').trim();
        } else {
            code = 'released';
            badge = '✅ Liberado';
            technicalReason = 'pré-requisito de nível cumprido.';
            detail = `Pode iniciar ${petLevelLabel(level)}.`;
            recommendation = `Política ${policy.label}: a liberação agora depende de construir domínio independente neste nível.`;
        }

        const manualOverride = getPedagogyLevelOverride(operation, level);
        if (manualOverride && manualOverride.mode) {
            const overrideReason = manualOverride.reason || '';
            if (manualOverride.mode === 'lock') {
                code = 'locked';
                badge = '🔒 Bloqueado (professor)';
                technicalReason = overrideReason || 'bloqueio manual do professor para este perfil.';
                detail = `Override manual ativo em ${petLevelLabel(level)}.`;
                recommendation = `${technicalReason} Remova o override quando a situação pedagógica mudar.`;
                returnLevel = prev || '';
            } else if (manualOverride.mode === 'experimental') {
                code = 'consolidating';
                badge = '🧪 Observação';
                technicalReason = overrideReason || 'liberação em observação do professor para este perfil.';
                detail = `Entrada permitida em ${petLevelLabel(level)}, mas com observação pedagógica.`;
                recommendation = `${technicalReason} O sistema continuará monitorando autonomia, manutenção e erro dominante.`;
                returnLevel = '';
            } else if (manualOverride.mode === 'release') {
                code = 'released';
                badge = '🧑‍🏫 Liberado';
                technicalReason = overrideReason || 'liberação manual do professor para este perfil.';
                detail = `Entrada manual liberada em ${petLevelLabel(level)}.`;
                recommendation = `${technicalReason} Acompanhe se o aluno sustenta desempenho sem apoio excessivo.`;
                returnLevel = '';
            }
        }

        const stateSkillProfile = finalEvidence?.hasEvidence ? finalSkillProfile : currentSkillProfile;
        const confidenceMeta = computePedagogicalDecisionConfidence({
            evidence: finalEvidence?.hasEvidence ? finalEvidence : currentEvidence,
            blocking: finalBlocking?.isBlocking ? finalBlocking : currentBlocking,
            prereqGate,
            manualOverride: manualOverride ? { ...manualOverride } : null,
            skillProfile: stateSkillProfile
        });
        const bottleneckMeta = buildPedagogicalBottleneckMeta({
            evidence: finalEvidence?.hasEvidence ? finalEvidence : currentEvidence,
            blocking: finalBlocking?.isBlocking ? finalBlocking : currentBlocking,
            prereqGate,
            manualOverride: manualOverride ? { ...manualOverride } : null,
            confidence: confidenceMeta
        });
        const nextAction = buildPedagogicalNextAction({
            operation,
            level,
            stageLabel: currentStageLabel,
            evidence: finalEvidence?.hasEvidence ? finalEvidence : currentEvidence,
            blocking: finalBlocking?.isBlocking ? finalBlocking : currentBlocking,
            prereqGate,
            manualOverride: manualOverride ? { ...manualOverride } : null,
            stateCode: code,
            bottleneck: bottleneckMeta
        });
        out[level] = {
            code,
            badge,
            detail,
            recommendation,
            returnLevel,
            technicalReason,
            missing: missingText,
            policyLabel: policy.label,
            stale: !!(currentEvidence?.stale || finalEvidence?.stale),
            manualOverride: manualOverride ? { ...manualOverride } : null,
            bottleneck: bottleneckMeta,
            nextAction,
            confidence: confidenceMeta,
            skillProfile: stateSkillProfile
        };
    });
    return out;
}
function applyLevelButtonPedagogy(operation, states) {
    try {
        ensureLevelPedagogyCard();
        const summaryEl = document.getElementById('level-pedagogy-summary');
        const ordered = getOperationLevelOrder(operation).map((level) => states[level]).filter(Boolean);
        const priority = ordered.find((it) => it.code === 'return')
            || ordered.find((it) => it.code === 'consolidating')
            || ordered.find((it) => it.code === 'released')
            || ordered.find((it) => it.code === 'mastered');
        if (summaryEl) {
            if (priority) {
                const parts = [priority.technicalReason || priority.detail || '', priority.missing || '', priority.bottleneck?.detail ? `Principal gargalo: ${priority.bottleneck.detail}` : '', priority.nextAction ? `Próxima ação: ${priority.nextAction}` : '', priority.confidence?.label ? `Confiança ${priority.confidence.label.toLowerCase()} (${priority.confidence.percent}%).` : ''].filter(Boolean);
                const policyText = priority.policyLabel ? `Política ${priority.policyLabel}. ` : '';
                summaryEl.textContent = `${policyText}${priority.badge.replace(/^[^\s]+\s/, '')}: ${parts.join(' ') || 'Use o estado do nível para decidir o próximo passo.'}`;
            } else {
                const policy = getPedagogyPolicyConfig();
                summaryEl.textContent = `Política ${policy.label}. Os níveis agora mostram se estão liberados, em consolidação, dominados, bloqueados ou pedindo retorno.`;
            }
        }
        const unlockMeta = updateLevelUnlockProgressCard(operation, states);
        levelButtons.forEach((button) => {
            const level = String(button.getAttribute('data-level') || '');
            const state = states[level];
            if (!state) return;
            let chip = button.querySelector('.level-state-chip');
            if (!chip) {
                chip = document.createElement('div');
                chip.className = 'level-state-chip';
                button.appendChild(chip);
            }
            let note = button.querySelector('.level-state-note');
            if (!note) {
                note = document.createElement('div');
                note.className = 'level-state-note';
                button.appendChild(note);
            }
            chip.textContent = state.badge;
            chip.className = `level-state-chip state-${state.code}`;
            const noteParts = [];
            if (unlockMeta && unlockMeta.targetLevel === level) noteParts.push(`Progresso para liberar: ${unlockMeta.percent}%`);
            if (state.bottleneck?.detail) noteParts.push(`Gargalo: ${state.bottleneck.detail}`);
            if (state.nextAction) noteParts.push(`Ação: ${state.nextAction}`);
            noteParts.push(...[state.technicalReason || '', state.missing || '', state.detail || ''].filter(Boolean));
            note.textContent = noteParts.join(' ');
            button.dataset.pedagogyState = state.code;
            button.dataset.returnLevel = state.returnLevel || '';
            button.dataset.pedagogyMessage = [state.recommendation || '', state.missing || '', state.detail || ''].filter(Boolean).join(' ');
            button.classList.remove('level-state-locked', 'level-state-released', 'level-state-consolidating', 'level-state-mastered', 'level-state-return');
            button.classList.add(`level-state-${state.code}`);
            const shouldLock = state.code === 'locked';
            button.disabled = shouldLock;
            button.classList.toggle('locked-level', shouldLock);
            button.setAttribute('aria-disabled', shouldLock ? 'true' : 'false');
            button.title = [state.badge, unlockMeta && unlockMeta.targetLevel === level ? `Progresso para liberar: ${unlockMeta.percent}%` : '', state.bottleneck?.detail ? `Principal gargalo: ${state.bottleneck.detail}` : '', state.nextAction ? `Próxima ação: ${state.nextAction}` : '', state.confidence?.label ? `Confiança ${state.confidence.label.toLowerCase()} (${state.confidence.percent}%)` : '', state.technicalReason || state.detail || '', state.missing || ''].filter(Boolean).join(' • ');
        });
    } catch (_) {}
}
function resolveRequestedPedagogicalLevel(operation, requestedLevel) {
    const states = computeOperationLevelPedagogicalStates(operation);
    const state = states[String(requestedLevel || '')];
    if (!state) return { level: requestedLevel, state: null, blocked: false, redirected: false };
    if (state.code === 'locked') {
        return { level: requestedLevel, state, blocked: true, redirected: false };
    }
    if (state.code === 'return' && state.returnLevel) {
        return { level: state.returnLevel, state, blocked: false, redirected: state.returnLevel !== requestedLevel };
    }
    return { level: requestedLevel, state, blocked: false, redirected: false };
}

function updateLevelButtonsForOperation(operation) {
    const apprenticeBtn = document.getElementById('level-apprentice-btn');
    const easyBtn = document.querySelector('.level-btn[data-level="easy"]');
    if (!apprenticeBtn) return;
    const hasApprentice = !!((getOperationTrailStages(String(operation || ''), 'apprentice') || []).length);
    apprenticeBtn.classList.toggle('hidden', !hasApprentice);
    apprenticeBtn.setAttribute('aria-hidden', hasApprentice ? 'false' : 'true');
    if (easyBtn) {
        easyBtn.disabled = false;
        easyBtn.classList.remove('locked-level');
        easyBtn.setAttribute('aria-disabled', 'false');
        easyBtn.title = '';
    }
    const states = computeOperationLevelPedagogicalStates(String(operation || ''));
    applyLevelButtonPedagogy(String(operation || ''), states);
}
function renderLearningMapPreview(operation) {
    ensureLearningMapUI();
    const rowsEl = document.getElementById('learning-map-rows');
    if (!rowsEl) return;
    const labels = { apprentice: 'Aprendiz', easy: 'Fácil', medium: 'Médio', advanced: 'Difícil' };
    const states = computeOperationLevelPedagogicalStates(operation);
    const levels = getOperationLevelOrder(operation).map((key) => ({ key, label: labels[key] || key }));
    const makeNodes = (done, total = 10) => {
        const nodes = [];
        for (let i = 0; i < total; i++) {
            let cls = 'map-node locked';
            if (i < done) cls = 'map-node done';
            if (i === done) cls = 'map-node current';
            nodes.push(`<span class="${cls}" aria-hidden="true"></span>`);
        }
        return nodes.join('');
    };
    rowsEl.innerHTML = levels.map(lvl => {
        let meta = '';
        let done = 0;
        const state = states[lvl.key] || { code: 'released', badge: '✅ Liberado', detail: 'Pode iniciar este nível.' };
        const stages = getOperationTrailStages(operation, lvl.key) || [];
        if (isMasteryTrailOperation(operation) && stages.length) {
            const unlockedIdx = getSavedOperationStageUnlock(operation, lvl.key, stages.length);
            done = Math.max(0, Math.min(9, unlockedIdx));
            const safeIdx = Math.max(0, Math.min(stages.length - 1, unlockedIdx));
            const stageLabel = String(stages[safeIdx]?.label || '');
            meta = `Etapa ${Math.max(1, unlockedIdx + 1)}/${stages.length}${stageLabel ? ` • ${stageLabel}` : ''}`;
        } else if (operation === 'multiplication') {
            const r = getTabuadaRangeByLevel(lvl.key);
            const key = `${r.min}-${r.max}|${r.multMin}-${r.multMax}`;
            const bankSize = getTrailTargetSize(r.min, r.max, r.multMin, r.multMax);
            const idx = getSavedTrailIndexForKey(key, bankSize);
            const ratio = bankSize > 0 ? (idx / bankSize) : 0;
            done = Math.max(0, Math.min(10, Math.floor(ratio * 10)));
            meta = `${idx}/${bankSize}`;
        } else {
            const bankSize = getOperationTrailBankSize(operation, lvl.key);
            const idx = getSavedOperationTrailIndex(operation, lvl.key, bankSize);
            const ratio = bankSize > 0 ? (idx / bankSize) : 0;
            done = Math.max(0, Math.min(10, Math.floor(ratio * 10)));
            meta = bankSize > 0 ? `${idx}/${bankSize}` : `${done}/10`;
        }
        return `
          <div class="map-row map-row-state-${state.code}" data-level="${lvl.key}" title="${diagEscapeHtml(state.recommendation || state.detail || '')}">
            <div class="map-label">${lvl.label}</div>
            <div class="map-nodes" aria-label="Progresso ${lvl.label}">${makeNodes(done, 10)}</div>
            <div class="map-meta">${state.badge} • ${meta}</div>
          </div>
        `;
    }).join('');
    rowsEl.querySelectorAll('.map-row').forEach(row => {
        row.addEventListener('click', () => {
            const lvl = row.getAttribute('data-level');
            const btn = document.querySelector(`.level-btn[data-level="${lvl}"]`);
            if (btn) btn.click();
        });
    });
}
function carregarXP() {
    gameState.xp = parseInt(profileStorageGetRaw('matemagica_xp')) || 0;
    playerXPElement.textContent = `XP: ${gameState.xp}`;
}
function atualizarXP(amount) {
    gameState.xp += amount;
    
    // Soma XP ganho nesta rodada (para relatório final)
    if (gameState && gameState.isGameActive) {
        gameState.xpGainedRound = (Number(gameState.xpGainedRound) || 0) + amount;
    }
playerXPElement.textContent = `XP: ${gameState.xp}`;
    profileStorageSetText('matemagica_xp', String(gameState.xp));
}
/** Carrega os erros do jogador do Local Storage. */
function carregarErros() {
    try {
        const errorsJson = profileStorageGetRaw('matemagica_errors');
        if (errorsJson) {
            gameState.errors = JSON.parse(errorsJson);
        }
    } catch (e) {
        console.error("Erro ao carregar erros do localStorage:", e);
        gameState.errors = [];
    }
}
/** Salva os erros atuais no Local Storage. */
function salvarErros() {
    try {
        // Limita o número de erros salvos para não sobrecarregar o localStorage
        const errorsToSave = gameState.errors.slice(-50); 
        profileStorageSetJson('matemagica_errors', errorsToSave);
    } catch (e) {
        console.error("Erro ao salvar erros no localStorage:", e);
    }
}
// --- RANKING (Recordes + Histórico Local) ---
const RANKING_STORAGE_KEY = 'matemagica_high_scores_v1';
/** Carrega ranking (recordes) do localStorage */
function carregarRanking() {
    try {
        const raw = profileStorageGetRaw(RANKING_STORAGE_KEY);
        gameState.highScores = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(gameState.highScores)) gameState.highScores = [];
    } catch (e) {
        console.warn('Falha ao carregar ranking:', e);
        gameState.highScores = [];
    }
}
/** Salva ranking no localStorage */
function salvarRanking() {
    try {
        profileStorageSetJson(RANKING_STORAGE_KEY, gameState.highScores || []);
    } catch (e) {
        console.warn('Falha ao salvar ranking:', e);
    }
}
/** Adiciona uma partida no histórico e mantém os melhores no topo */
function registrarPartidaNoRanking(entry) {
    if (!entry) return;
    // Normaliza campos
    const safe = {
        timestamp: entry.timestamp || Date.now(),
        score: Number(entry.score || 0),
        operation: entry.operation || 'unknown',
        level: entry.level || 'unknown',
        mode: entry.mode || (gameState.isRapidMode ? 'rapido' : 'estudo'),
        submode: entry.submode || '',
        acertos: Number(entry.acertos || 0),
        erros: Number(entry.erros || 0),
        total: Number(entry.total || 0),
        accuracy: Number(entry.accuracy || 0),
        studentName: (getStudentProfile().name || ''),
        studentTurma: (getStudentProfile().turma || ''),
        studentEscola: (getStudentProfile().escola || '')
    };
    gameState.highScores.unshift(safe);
    // Ordena por score desc, depois por acurácia desc, depois mais recente
    gameState.highScores.sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        if (b.accuracy !== a.accuracy) return b.accuracy - a.accuracy;
        return b.timestamp - a.timestamp;
    });
    // Mantém até 60 registros (suficiente para histórico local)
    if (gameState.highScores.length > 60) gameState.highScores = gameState.highScores.slice(0, 60);
    salvarRanking();
}
/** Renderiza o ranking na tela */
function renderRanking() {
    const container = document.getElementById('ranking-list-container');
    const noMsg = document.getElementById('no-records-message');
    if (!container || !noMsg) return;
    container.innerHTML = '';
    const list = gameState.highScores || [];
    if (list.length === 0) {
        noMsg.classList.remove('hidden');
        return;
    }
    noMsg.classList.add('hidden');
    // Mostra TOP 10 + Histórico recente (até 20)
    const top10 = list.slice(0, 10);
    const recent = list.slice(0, 20);
    const makeHeader = (txt) => {
        const h = document.createElement('h2');
        h.textContent = txt;
        h.style.margin = '14px 0 8px';
        h.style.fontSize = '1.1em';
        return h;
    };
    const makeItem = (e, idx) => {
        const item = document.createElement('div');
        item.className = 'ranking-item';
        const d = new Date(e.timestamp);
        const dateStr = d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        const whoParts = [];
        if (e.studentName) whoParts.push(`Aluno: ${e.studentName}`);
        if (e.studentTurma) whoParts.push(`Turma: ${e.studentTurma}`);
        if (e.studentEscola) whoParts.push(`Escola: ${e.studentEscola}`);
        const whoStr = whoParts.length ? (whoParts.join(' • ') + ' • ') : '';
        const opMap = {
            addition: 'Adição (+)',
            subtraction: 'Subtração (−)',
            multiplication: 'Multiplicação (×)',
            division: 'Divisão (÷)',
            potenciacao: 'Potenciação',
            radiciacao: 'Radiciação'
        };
        const opLabel = opMap[e.operation] || e.operation;
        const lvlMap = { apprentice: 'Aprendiz', easy: 'Fácil', medium: 'Médio', advanced: 'Difícil' };
        const lvl = lvlMap[e.level] || e.level;
        item.innerHTML = `
            <div class="ranking-left">
                <div class="ranking-title"><strong>#${idx + 1}</strong> • ${opLabel} • ${lvl} • ${e.mode}${e.submode ? ' • ' + e.submode : ''}</div>
                <div class="ranking-meta">${whoStr}${dateStr} • Acertos: ${e.acertos}/${e.total} • Erros: ${e.erros} • Precisão: ${Math.round(e.accuracy)}%</div>
            </div>
            <div class="ranking-score">${e.score}</div>
        `;
        return item;
    };
    container.appendChild(makeHeader('Top 10 (Melhores pontuações)'));
    top10.forEach((e, idx) => container.appendChild(makeItem(e, idx)));
    container.appendChild(makeHeader('Histórico recente (últimas partidas)'));
    recent.forEach((e, idx) => container.appendChild(makeItem(e, idx)));
}
// --- PWA (Offline + Instalável) ---
function initPWA() {
    try {
        // Injeta o manifest sem mexer no layout do HTML
        if (!document.querySelector('link[rel="manifest"]')) {
            const link = document.createElement('link');
            link.rel = 'manifest';
            link.href = 'manifest.webmanifest';
            document.head.appendChild(link);
        }
        // Theme color para barra do navegador (especialmente mobile)
        if (!document.querySelector('meta[name="theme-color"]')) {
            const meta = document.createElement('meta');
            meta.name = 'theme-color';
            meta.content = '#111827';
            document.head.appendChild(meta);
        }
        // Service Worker (offline)
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js').then((reg) => {
                try { PET_LEVEL1_UI.bindSWUpdateFlow(); } catch (_) {}
                return reg;
            }).catch(err => {
                console.warn('Service Worker não registrado:', err);
            });
        }
    } catch (e) {
        console.warn('Falha initPWA:', e);
    }
}
// --- PAINEL DO PROFESSOR (Rede de Ensino) ---
const TEACHER_PREFS_KEY = 'matemagica_teacher_prefs_v1';
const PEDAGOGY_LEVEL_OVERRIDE_KEY = 'matemagica_pedagogy_level_overrides_v1';
function loadTeacherPrefs() {
    try {
        const raw = localStorage.getItem(TEACHER_PREFS_KEY);
        const prefs = raw ? JSON.parse(raw) : {};
        if (prefs && typeof prefs === 'object') {
            if (prefs.projection) document.body.classList.add('projection-mode');
            if (prefs.lowStimulus) document.body.classList.add('low-stimulus');
        }
    } catch {}
}
function saveTeacherPrefs(prefs) {
    try { localStorage.setItem(TEACHER_PREFS_KEY, JSON.stringify(prefs || {})); } catch {}
}
function getTeacherPrefsSafe() {
    try {
        const raw = localStorage.getItem(TEACHER_PREFS_KEY);
        const prefs = raw ? JSON.parse(raw) : {};
        return (prefs && typeof prefs === 'object') ? prefs : {};
    } catch (_) {
        return {};
    }
}
function getPedagogyPolicyLabel(key = 'balanced') {
    const safe = String(key || 'balanced').trim().toLowerCase();
    if (safe === 'rigid') return 'Rígida';
    if (safe === 'inclusive') return 'Inclusiva';
    return 'Equilibrada';
}
function getPedagogyPolicyConfig(key = '') {
    const requested = String(key || getTeacherPrefsSafe().pedagogyPolicy || 'balanced').trim().toLowerCase();
    const safe = ['rigid', 'balanced', 'inclusive'].includes(requested) ? requested : 'balanced';
    const configs = {
        rigid: {
            independentThreshold: 0.85,
            independentAskedMin: 5,
            maintenanceSessions: 2,
            prereqThreshold: 0.8,
            prereqAskedMin: 4,
            warningAccuracyMin: 0.65,
            wrongStreakLimit: 2,
            blockingErrorMinCount: 2,
            staleDays: 21,
            label: 'Rígida'
        },
        balanced: {
            independentThreshold: 0.8,
            independentAskedMin: 4,
            maintenanceSessions: 2,
            prereqThreshold: 0.75,
            prereqAskedMin: 3,
            warningAccuracyMin: 0.6,
            wrongStreakLimit: 2,
            blockingErrorMinCount: 2,
            staleDays: 28,
            label: 'Equilibrada'
        },
        inclusive: {
            independentThreshold: 0.75,
            independentAskedMin: 3,
            maintenanceSessions: 1,
            prereqThreshold: 0.7,
            prereqAskedMin: 2,
            warningAccuracyMin: 0.55,
            wrongStreakLimit: 3,
            blockingErrorMinCount: 3,
            staleDays: 42,
            label: 'Inclusiva'
        }
    };
    return { key: safe, ...(configs[safe] || configs.balanced) };
}
function loadPedagogyLevelOverrideMap() {
    try {
        const raw = profileStorageGetRaw(PEDAGOGY_LEVEL_OVERRIDE_KEY);
        const obj = raw ? JSON.parse(raw) : {};
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (_) {
        return {};
    }
}
function savePedagogyLevelOverrideMap(map) {
    try { profileStorageSetJson(PEDAGOGY_LEVEL_OVERRIDE_KEY, map || {}); } catch (_) {}
}
function getPedagogyLevelOverrideKey(operation, level) {
    return `${String(operation || '').trim()}::${String(level || '').trim()}`;
}
function getPedagogyLevelOverride(operation, level) {
    const map = loadPedagogyLevelOverrideMap();
    const key = getPedagogyLevelOverrideKey(operation, level);
    const item = map[key];
    return (item && typeof item === 'object') ? item : null;
}
function setPedagogyLevelOverride(operation, level, mode, reason = '') {
    try {
        const safeMode = String(mode || '').trim().toLowerCase();
        if (!['release', 'lock', 'experimental'].includes(safeMode)) return;
        const map = loadPedagogyLevelOverrideMap();
        const key = getPedagogyLevelOverrideKey(operation, level);
        map[key] = {
            mode: safeMode,
            reason: String(reason || '').trim(),
            updatedAt: Date.now(),
            policyKey: getPedagogyPolicyConfig().key
        };
        savePedagogyLevelOverrideMap(map);
    } catch (_) {}
}
function clearPedagogyLevelOverride(operation, level) {
    try {
        const map = loadPedagogyLevelOverrideMap();
        const key = getPedagogyLevelOverrideKey(operation, level);
        delete map[key];
        savePedagogyLevelOverrideMap(map);
    } catch (_) {}
}
function describePedagogyLevelOverride(override) {
    const mode = String(override?.mode || '').trim().toLowerCase();
    if (mode === 'release') return 'liberação manual';
    if (mode === 'lock') return 'bloqueio manual';
    if (mode === 'experimental') return 'liberação em observação';
    return 'sem override';
}
