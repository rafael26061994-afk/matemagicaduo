}
function classifyTypicalError(question, selectedAnswer) {
    try {
        const diagnosis = getDistractorDiagnosis(question, selectedAnswer);
        if (diagnosis && diagnosis.label) return diagnosis.label;
        const q = question || {};
        const op = String(q.operacao || '');
        const label = normalizeSkillStageLabel(q.masteryStageLabel || q.stageLabel || '').toLowerCase();
        const answer = Number(q.answer);
        const selected = Number(selectedAnswer);
        const num1 = Number(q.num1);
        const num2 = Number(q.num2);
        if (!Number.isFinite(selected) || !Number.isFinite(answer)) return 'Erro de cálculo ou atenção nesta habilidade.';
        if (op === 'addition') {
            if (label.includes('reagrupamento') && selected < answer) return 'Somou sem completar o reagrupamento.';
            if (label.includes('parcela faltante') || label.includes('desconhecida')) return 'Teve dificuldade em usar a operação inversa para achar a parcela faltante.';
        }
        if (op === 'subtraction') {
            if ((label.includes('reserva') || label.includes('emprest')) && selected > answer) return 'Subtraiu sem fazer a reserva corretamente.';
            if (label.includes('minuendo') || label.includes('subtraendo') || label.includes('falt')) return 'Teve dificuldade em descobrir o termo faltante da subtração.';
        }
        if (op === 'multiplication') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 + num2)) return 'Confundiu multiplicação com adição.';
            if (label.includes('saltos') && selected < answer) return 'Perdeu a contagem em saltos antes de chegar ao total.';
        }
        if (op === 'division') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 * num2)) return 'Confundiu divisão com multiplicação.';
            if (label.includes('resto')) {
                const quotient = Number.isFinite(num1) && Number.isFinite(num2) && num2 !== 0 ? Math.floor(num1 / num2) : null;
                if (quotient != null && selected === quotient) return 'Confundiu resto com quociente.';
            }
            if (label.includes('divisor') || label.includes('dividendo')) return 'Teve dificuldade em identificar o papel do divisor ou do dividendo.';
        }
        if (op === 'potenciacao') {
            if (Number.isFinite(num1) && Number.isFinite(num2) && selected === (num1 * num2)) return 'Confundiu potência com multiplicação simples.';
            if (label.includes('expoente 0') && selected !== 1) return 'Ainda não consolidou a regra do expoente zero.';
        }
        if (op === 'radiciacao') {
            if (Number(q.num2) === 3 && Number.isFinite(num1) && selected === Math.round(num1 / 3)) return 'Leu a raiz cúbica como divisão por 3.';
            if (Number(q.num2) !== 3 && Number.isFinite(num1) && selected === Math.round(num1 / 2)) return 'Leu a raiz como divisão por 2.';
            if (Number.isFinite(num1) && selected === (Math.round(Math.sqrt(Math.abs(num1))) ** 2)) return 'Confundiu raiz com o quadrado do número.';
        }
        return 'Erro de cálculo ou atenção nesta habilidade.';
    } catch (_) {
        return 'Erro de cálculo ou atenção nesta habilidade.';
    }
}
function averageSkillWindow(arr) {
    if (!Array.isArray(arr) || !arr.length) return 1;
    const vals = arr.map((it) => Number(it?.ok ? 1 : 0));
    return vals.reduce((s, n) => s + n, 0) / vals.length;
}
function computeSkillWeaknessScore(record) {
    if (!record || typeof record !== 'object') return 1;
    const totalAsked = Math.max(0, Number(record.totalAsked) || 0);
    const totalCorrect = Math.max(0, Number(record.totalCorrect) || 0);
    const overallAcc = totalAsked > 0 ? (totalCorrect / totalAsked) : 1;
    const recent = Array.isArray(record.recentResults) ? record.recentResults.slice(-4) : [];
    const previous = Array.isArray(record.recentResults) ? record.recentResults.slice(-8, -4) : [];
    const recentAcc = averageSkillWindow(recent);
    const previousAcc = previous.length ? averageSkillWindow(previous) : recentAcc;
    const recentErrors = recent.filter((it) => !it?.ok).length;
    const decline = Math.max(0, previousAcc - recentAcc);
    const wrongStreak = Math.max(0, Number(record.consecutiveWrong) || 0);
    let score = 1;
    score += (1 - overallAcc) * 3.2;
    score += (1 - recentAcc) * 4.2;
    score += recentErrors * 1.2;
    score += Math.min(3, wrongStreak) * 1.1;
    score += decline * 6.5;
    const lastWrongAt = Math.max(0, Number(record.lastWrongAt) || 0);
    if (lastWrongAt && (Date.now() - lastWrongAt) < (1000 * 60 * 30)) score += 1.6;
    return Math.max(0.6, score);
}
function weightedPickIndex(items) {
    const safe = Array.isArray(items) ? items.filter((it) => Number(it?.weight) > 0) : [];
    if (!safe.length) return null;
    const total = safe.reduce((s, it) => s + Number(it.weight || 0), 0);
    let roll = Math.random() * total;
    for (const item of safe) {
        roll -= Number(item.weight || 0);
        if (roll <= 0) return item.index;
    }
    return safe[safe.length - 1].index;
}
function inferStageLearningType(operation, stageLabel) {
    const label = normalizeTrailLabel(stageLabel);
    if (!label) return 'fluency';
    const comprehensionTokens = [
        'faltante', 'desconhecida', 'desconhecido', 'completar', 'contexto', 'problema', 'estimativa',
        'comparar', 'compare', 'interpreta', 'relacao', 'relação', 'comutatividade', 'decomposicao',
        'decomposição', 'grupos iguais', 'soma repetida', 'contagem em saltos', 'padroes', 'padrões',
        'valor faltante', 'numero entre', 'número entre', 'expressao', 'expressão', 'leitura', 'conferencia',
        'conferência', 'reconhecer', 'escolher raiz', 'contextos', 'distributiva', 'dobro e triplo', 'ideia de'
    ];
    if (operation === 'division' && (label.includes('resto') || label.includes('dividendo') || label.includes('divisor'))) return 'comprehension';
    if (operation === 'multiplication' && (label.includes('tabuada') || label.includes('dominio final') || label.includes('domínio final'))) return 'fluency';
    if (comprehensionTokens.some((token) => label.includes(token))) return 'comprehension';
    return 'fluency';
}
function getLearningTypeLabel(type) {
    return String(type || '') === 'comprehension' ? 'Compreensão' : 'Fluência';
}
function pickSmartReviewStageIndex(operation, level, currentStageIndex) {
    const maxIdx = Math.max(0, Number(currentStageIndex) || 0);
    if (maxIdx <= 0) return 0;
    const weighted = [];
    for (let i = 0; i < maxIdx; i++) {
        const rec = getOperationSkillReviewRecord(operation, level, i);
        let weight = computeSkillWeaknessScore(rec);
        if (!rec) weight = 1 + ((i === maxIdx - 1) ? 0.8 : 0.15 * (i + 1));
        if (i === maxIdx - 1) weight += 0.7;
        weighted.push({ index: i, weight });
    }
    const picked = weightedPickIndex(weighted);
    return Number.isInteger(picked) ? picked : Math.max(0, maxIdx - 1);
}
function buildLevelConsolidationPlan(operation, level) {
    const stages = getOperationTrailStages(operation, level);
    if (!Array.isArray(stages) || !stages.length) return [];
    const analyzed = stages.map((stage, idx) => {
        const learningType = inferStageLearningType(operation, stage?.label || '');
        const weakness = computeSkillWeaknessScore(getOperationSkillReviewRecord(operation, level, idx));
        return { stageIndex: idx, stage, learningType, weakness };
    });
    const byWeakness = analyzed.slice().sort((a, b) => b.weakness - a.weakness || a.stageIndex - b.stageIndex);
    const fluency = byWeakness.filter((it) => it.learningType === 'fluency');
    const comprehension = byWeakness.filter((it) => it.learningType === 'comprehension');
    const target = Math.max(6, Math.min(8, analyzed.length >= 8 ? 8 : analyzed.length));
    const plan = [];
    const used = new Set();
    const takeFrom = (arr, n) => {
        for (const item of arr) {
            if (plan.length >= target || n <= 0) break;
            if (used.has(item.stageIndex)) continue;
            plan.push({ stageIndex: item.stageIndex, stageLabel: item.stage?.label || '', learningType: item.learningType });
            used.add(item.stageIndex);
            n--;
        }
    };
    takeFrom(comprehension, Math.min(4, Math.max(2, comprehension.length ? Math.ceil(target / 2) : 0)));
    takeFrom(fluency, Math.min(4, Math.max(2, fluency.length ? Math.ceil(target / 2) : 0)));
    takeFrom(byWeakness, target - plan.length);
    while (plan.length < target) {
        const fallback = analyzed[plan.length % analyzed.length];
        plan.push({ stageIndex: fallback.stageIndex, stageLabel: fallback.stage?.label || '', learningType: fallback.learningType });
    }
    return plan.slice(0, target).map((item, idx) => ({ ...item, seq: idx }));
}
function getConsolidationResult(operation, level, trail) {
    const cons = trail?.consolidation;
    if (!cons || !Array.isArray(cons.plan) || !cons.plan.length) return null;
    const total = Math.max(0, Number(cons.asked) || 0);
    const correct = Math.max(0, Number(cons.correct) || 0);
    const accuracy = total > 0 ? (correct / total) : 0;
    const targetAcc = Number(trail?.targetAccuracy || 0.8);
    const perStage = cons.perStage && typeof cons.perStage === 'object' ? cons.perStage : {};
    let weakStageIndex = null;
    let weakStageAccuracy = 1;
    Object.keys(perStage).forEach((key) => {
        const rec = perStage[key] || {};
        const asked = Math.max(0, Number(rec.asked) || 0);
        const hits = Math.max(0, Number(rec.correct) || 0);
        if (!asked) return;
        const acc = hits / asked;
        if (acc < targetAcc && acc <= weakStageAccuracy) {
            weakStageAccuracy = acc;
            weakStageIndex = Math.max(0, Number(key) || 0);
        }
    });
    const stages = getOperationTrailStages(operation, level) || [];
    return {
        passed: total >= cons.plan.length && accuracy >= targetAcc && weakStageIndex == null,
        total,
        correct,
        accuracy,
        weakStageIndex,
        weakStageLabel: weakStageIndex == null ? '' : String(stages[weakStageIndex]?.label || ''),
        weakLearningType: weakStageIndex == null ? '' : inferStageLearningType(operation, stages[weakStageIndex]?.label || ''),
        weakStageAccuracy: weakStageIndex == null ? null : weakStageAccuracy
    };
}
function maybeStartLevelConsolidationRound() {
    const trail = gameState.operationTrail;
    if (!trail || !trail.masteryMode || trail.consolidationMode) return false;
    const currentStage = Math.max(0, Number(trail.currentStageIndex) || 0);
    const lastStageIndex = Math.max(0, Number(trail.totalStages || 1) - 1);
    if (currentStage < lastStageIndex) return false;
    const asked = Math.max(0, Number(trail.currentStageAsked) || 0);
    const correct = Math.max(0, Number(trail.currentStageCorrect) || 0);
    const target = Math.max(1, Number(trail.stageTarget) || 1);
    const acc = asked > 0 ? (correct / asked) : 0;
    if (asked < target || acc < Number(trail.targetAccuracy || 0.8)) return false;
    const plan = buildLevelConsolidationPlan(trail.operation, trail.level);
    if (!plan.length) return false;
    trail.consolidationMode = true;
    trail.consolidation = {
        plan,
        index: 0,
        asked: 0,
        correct: 0,
        perStage: {}
    };
    trail.supportMode = 'normal';
    trail.supportEscalations = 0;
    trail.supportHint = '';
    trail.stageType = 'mixed';
    gameState.totalQuestions = Math.max(Number(gameState.totalQuestions || 0), Number(gameState.questionNumber || 0)) + plan.length;
    showFeedbackControlled('🧩 Prova de consolidação iniciada: agora o app vai misturar habilidades de fluência e compreensão para validar o nível.', 'info', gameState.isRapidMode ? 5600 : 7600);
    return true;
}
function computeMasterySessionTotalQuestions(stageCount, currentStageIndex, reviewEvery = 3) {
    const mainCount = Math.max(1, Number(stageCount) || 1);
    const idx = Math.max(0, Number(currentStageIndex) || 0);
    const spacing = Math.max(1, Number(reviewEvery) || 3);
    if (idx <= 0) return mainCount;
    let reviews = 0;
    for (let mainAsked = 1; mainAsked < mainCount; mainAsked++) {
        if (mainAsked % spacing === 0) reviews++;
    }
    return mainCount + reviews;
}
function normalizeAdaptiveSupportMode(mode) {
    const raw = String(mode || 'normal').toLowerCase().trim();
    if (raw === 'very_guided' || raw === 'muito_guiado' || raw === 'muito guiado') return 'very_guided';
    if (raw === 'guided' || raw === 'guiado') return 'guided';
    return 'normal';
}
function getAdaptiveSupportLabel(mode) {
    const safe = normalizeAdaptiveSupportMode(mode);
    if (safe === 'very_guided') return 'Muito guiado';
    if (safe === 'guided') return 'Guiado';
    return 'Normal';
}
function getAdaptiveSupportProfile(operation, level, stageLabel, mode) {
    const safe = normalizeAdaptiveSupportMode(mode);
    const label = normalizeSkillStageLabel(stageLabel).toLowerCase();
    const profile = {
        mode: safe,
        label: getAdaptiveSupportLabel(safe),
        timeMultiplier: safe === 'very_guided' ? 1.7 : (safe === 'guided' ? 1.35 : 1),
        optionsMode: safe,
        stageLabel,
        supportHint: ''
    };
    if (safe === 'normal') return profile;
    if (operation === 'addition') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: números menores, dica visual de dezenas e alternativas mais separadas.'
            : 'Apoio guiado: números menores e uma pista curta para organizar a soma.';
        if (label.includes('reagrupamento')) profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: some as unidades primeiro e marque quando passar de 9 para formar 1 dezena.'
            : 'Apoio guiado: observe quando as unidades passam de 9 e troque 10 por 1 dezena.';
    } else if (operation === 'subtraction') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: números menores, destaque para a reserva e alternativas menos parecidas.'
            : 'Apoio guiado: compare os algarismos e veja se precisa emprestar uma dezena.';
        if (label.includes('reserva')) profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: faça a reserva com calma e confira a nova dezena antes de subtrair.'
            : 'Apoio guiado: quando o número de cima é menor, empreste 1 dezena.';
    } else if (operation === 'division') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: divisões menores, grupos mais simples e menos pressão de tempo.'
            : 'Apoio guiado: pense em quantos grupos iguais podem ser formados.';
        if (label.includes('resto')) profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: divida em grupos pequenos e observe o que sobra depois de formar os grupos completos.'
            : 'Apoio guiado: forme os grupos completos primeiro; o que sobrar é o resto.';
    } else if (operation === 'potenciacao') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: bases pequenas, expoentes curtos e leitura expandida da potência.'
            : 'Apoio guiado: leia a potência como multiplicação repetida antes de calcular.';
    } else if (operation === 'radiciacao') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: raízes exatas menores e pista do quadrado ou cubo perfeito mais próximo.'
            : 'Apoio guiado: procure o número que multiplicado por ele mesmo gera o valor dado.';
    } else if (operation === 'multiplication') {
        profile.supportHint = safe === 'very_guided'
            ? 'Apoio alto: fatores menores, grupos visuais e contagem em saltos mais curta.'
            : 'Apoio guiado: pense em grupos iguais ou soma repetida antes de responder.';
    }
    return profile;
}
function getCurrentAdaptiveSupportProfile() {
    try {
        const trail = gameState.operationTrail || null;
        if (!trail || !trail.masteryMode) return null;
        return getAdaptiveSupportProfile(
            gameState.currentOperation,
            gameState.currentLevel,
            gameState.currentQuestion?.stageLabel || trail.currentStageLabel || '',
            trail.supportMode || 'normal'
        );
    } catch (_) {
        return null;
    }
}
function ensureAdaptiveSupportPanel() {
    let panel = document.getElementById('adaptive-support-panel');
    if (panel) return panel;
    try {
        const area = document.querySelector('#game-screen .question-area');
        if (!area) return null;
        panel = document.createElement('div');
        panel.id = 'adaptive-support-panel';
        panel.className = 'adaptive-support-panel hidden';
        panel.innerHTML = '<div class="adaptive-support-chip" id="adaptive-support-chip">Apoio: Normal</div><div class="adaptive-support-text" id="adaptive-support-text"></div>';
        area.appendChild(panel);
        return panel;
    } catch (_) {
        return null;
    }
}
function updateAdaptiveSupportPanel() {
    try {
        const panel = ensureAdaptiveSupportPanel();
        if (!panel) return;
        const chip = panel.querySelector('#adaptive-support-chip');
        const text = panel.querySelector('#adaptive-support-text');
        const profile = getCurrentAdaptiveSupportProfile();
        if (!profile || profile.mode === 'normal') {
            panel.classList.add('hidden');
            panel.setAttribute('aria-hidden', 'true');
            return;
        }
        panel.classList.remove('hidden');
        panel.setAttribute('aria-hidden', 'false');
        panel.dataset.mode = profile.mode;
        if (chip) chip.textContent = `Apoio: ${profile.label}`;
        if (text) text.textContent = profile.supportHint || 'Apoio ativo para reduzir a pressão e reforçar esta habilidade.';
    } catch (_) {}
}
function randIntFromList(list) {
    const arr = Array.isArray(list) ? list.filter((n) => Number.isFinite(Number(n))).map(Number) : [];
    if (!arr.length) return 0;
    return arr[Math.floor(Math.random() * arr.length)];
}
function buildAdaptiveSupportQuestion(operation, stageLabel, supportMode) {
    const safe = normalizeAdaptiveSupportMode(supportMode);
    if (safe === 'normal') return null;
    const hard = safe === 'very_guided';
    const label = normalizeSkillStageLabel(stageLabel).toLowerCase();
    if (operation === 'addition') {
