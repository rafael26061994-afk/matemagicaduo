                    group.teacherMove || '',
                    group.studentMove || '',
                    group.checkpoint || '',
                    safePlan.note || ''
                ].map(csvEscape).join(';'));
                return;
            }
            members.forEach((member) => {
                const latestAccuracyValue = Number(member?.latestAccuracy);
                const latestAccuracyText = Number.isFinite(latestAccuracyValue) ? numBR(latestAccuracyValue, 1) : '';
                lines.push([
                    safePlan.title || 'Plano de retomada da turma',
                    safePlan.summary || '',
                    group.turma || member?.turma || '',
                    String(index + 1),
                    group.groupKey || '',
                    group.code || '',
                    group.formatted || '',
                    group.diagnosis || group.formatted || '',
                    group.topSkill || '',
                    group.prerequisite || '',
                    member?.studentName || '',
                    member?.focusKey || '',
                    String(Math.max(0, Number(member?.sessions) || 0)),
                    String(Math.max(0, Number(member?.distractorTotal) || 0)),
                    member?.highestError || member?.dominantSkill || '',
                    member?.dominantTypicalError || '',
                    member?.dominantErrorDimension || '',
                    member?.dominantDistractorCode || '',
                    member?.dominantDistractorFormatted || member?.dominantDistractorLabel || '',
                    String(Math.max(0, Number(member?.topDistractorCount) || 0)),
                    member?.latestSkill || '',
                    member?.lastMastered || '',
                    member?.stabilitySummary || '',
                    member?.operation || '',
                    member?.level || '',
                    member?.stageLabel || '',
                    latestAccuracyText,
                    member?.interventionPrerequisite || '',
                    member?.interventionCommonError || '',
                    member?.interventionPlanText || '',
                    group.teacherMove || '',
                    group.studentMove || '',
                    group.checkpoint || '',
                    safePlan.note || ''
                ].map(csvEscape).join(';'));
            });
        });
        return lines.join('\n');
    } catch (_) {
        return 'titulo_plano;resumo;turma;bloco_ordem;bloco_chave;codigo_distrator_bloco;rotulo_bloco;erro_dominante_bloco;habilidade_predominante_bloco;base_a_retomar_bloco;aluno;foco_aluno;sessoes_aluno;erros_diagnosticados_aluno;habilidade_mais_afetada_aluno;erro_tipico_dominante_aluno;dimensao_erro_aluno;codigo_distrator_aluno;rotulo_distrator_aluno;contagem_distrator_aluno;habilidade_atual_aluno;ultima_habilidade_dominada_aluno;estabilidade_aluno;operacao;nivel;etapa;ultima_precisao_pct;base_a_retomar_aluno;erro_comum_aluno;plano_individual_aluno;intervencao_docente_bloco;acao_estudante_bloco;criterio_saida_bloco;observacao\nPlano de retomada da turma;Não foi possível montar o CSV do plano da turma por aluno.;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;';
    }
}
function buildTeacherClassRetakeClipboardText(plan) {
    try {
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        const lines = [
            `${safePlan.title || 'Plano de retomada da turma'}`,
            `${safePlan.summary || 'Sem resumo disponível.'}`
        ];
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        groups.forEach((group, index) => {
            lines.push('');
            lines.push(`Bloco ${index + 1} — ${group.turma} — ${group.formatted}`);
            lines.push(`Alunos (${group.studentCount}): ${Array.isArray(group.students) ? group.students.join(', ') : ''}`);
            lines.push(`Sessões no filtro: ${group.sessions}`);
            lines.push(`Erros diagnosticados: ${group.errors}`);
            lines.push(`Habilidade mais afetada: ${group.topSkill}`);
            lines.push(`Erro-alvo: ${group.diagnosis}`);
            lines.push(`Passo 1 — Reativar a base: retomar ${group.prerequisite}.`);
            lines.push(`Passo 2 — Atacar o erro dominante: ${group.teacherMove} ${group.studentMove}`);
            lines.push(`Passo 3 — Critério de saída: ${group.checkpoint}`);
        });
        if (safePlan.note) {
            lines.push('');
            lines.push(`Observação: ${safePlan.note}`);
        }
        return lines.join('\n');
    } catch (_) {
        return 'Não foi possível montar o plano da turma para copiar.';
    }
}
function buildTeacherAllClassBlockFocusClipboardText(plan) {
    try {
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        if (!groups.length) return 'Não foi possível montar os blocos coletivos para copiar.';
        const lines = [
            'Focos coletivos da turma',
            `${safePlan.summary || 'Sem resumo disponível.'}`
        ];
        groups.forEach((group, index) => {
            const students = (Array.isArray(group.students) ? group.students : []).join(', ') || '—';
            const intervention = String(`${group.teacherMove || 'Modelar a regra correta.'} ${group.studentMove || ''}`).trim();
            lines.push('');
            lines.push(`Bloco ${index + 1} — ${group.turma || '—'} — ${group.formatted || '—'}`);
            lines.push(`Alunos no bloco: ${Math.max(0, Number(group.studentCount) || 0)}`);
            lines.push(`Sessões no filtro: ${Math.max(0, Number(group.sessions) || 0)}`);
            lines.push(`Erros diagnosticados: ${Math.max(0, Number(group.errors) || 0)}`);
            lines.push(`Habilidade predominante: ${group.topSkill || '—'}`);
            lines.push(`Erro dominante: ${group.diagnosis || group.formatted || '—'}`);
            lines.push(`Base a retomar: ${group.prerequisite || 'Base anterior da própria habilidade'}`);
            lines.push(`Critério de saída: ${group.checkpoint || 'Rever com segurança antes de avançar.'}`);
            lines.push(`Intervenção coletiva curta: ${intervention}`);
            lines.push(`Alunos: ${students}`);
        });
        if (safePlan.note) {
            lines.push('');
            lines.push(`Observação: ${safePlan.note}`);
        }
        return lines.join('\n');
    } catch (_) {
        return 'Não foi possível montar os blocos coletivos para copiar.';
    }
}
function sanitizeTeacherExportTag(value, fallback = 'todos') {
    try {
        const clean = String(value || '')
            .trim()
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^a-zA-Z0-9_-]+/g, '-')
            .replace(/^-+|-+$/g, '')
            .toLowerCase();
        return clean || fallback;
    } catch (_) {
        return fallback;
    }
}
function buildTeacherClassPlanStudentsCsvFilename(filters = {}) {
    try {
        const today = petDateKeyLocal();
        const opTag = sanitizeTeacherExportTag(filters.operation && filters.operation !== 'all' ? filters.operation : 'todas', 'todas');
        const lvTag = sanitizeTeacherExportTag(filters.level && filters.level !== 'all' ? filters.level : 'todos', 'todos');
        const turmaTag = sanitizeTeacherExportTag(filters.classKey && filters.classKey !== 'all' ? filters.classKey : 'todas', 'todas');
        return `PET_plano_turma_bloco_aluno_${today}_op-${opTag}_nv-${lvTag}_turma-${turmaTag}.csv`;
    } catch (_) {
        return `PET_plano_turma_bloco_aluno_${petDateKeyLocal()}.csv`;
    }
}
