        { profileLabel: 'estimativa', match: ['aproximada', 'estimativa', 'não é exata', 'nao é exata', 'mais próxima', 'mais proxima', 'entre dois quadrados'], priorityCodes: ['root_estimation_neighbor', 'root_as_half', 'root_used_radicand'], secondaryCodes: ['square_root_neighbor'] },
        { profileLabel: 'raiz cúbica', match: ['cúbic', 'cubica'], priorityCodes: ['cube_root_times_three', 'cube_root_as_square_root', 'cube_root_neighbor'], secondaryCodes: ['root_as_half'] },
        { profileLabel: 'relação com potência', match: ['quadrado', 'potência', 'potencia', 'raiz'], priorityCodes: ['square_root_as_square', 'square_root_as_half', 'square_root_neighbor'], secondaryCodes: ['square_root_doubled'] }
    ]
