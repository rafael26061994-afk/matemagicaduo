// Melhor compatibilidade de toque: garante ativação em alguns celulares sem duplicar/disparar sozinho.
const __petTouchClickLock = new WeakMap();
const __petTouchSyntheticState = new WeakMap();
const __petHomeActionLock = { action: '', at: 0 };
const __petUiActionLocks = new Map();
function petGuardAction(key, minIntervalMs = 550) {
    try {
        const safeKey = String(key || '').trim();
        if (!safeKey) return true;
        const now = Date.now();
        const last = Number(__petUiActionLocks.get(safeKey) || 0);
        const windowMs = Math.max(0, Number(minIntervalMs) || 0);
        if (windowMs > 0 && (now - last) < windowMs) return false;
        __petUiActionLocks.set(safeKey, now);
        return true;
    } catch (_) {
        return true;
    }
}
function bindGuardedClick(el, key, handler, opts = {}) {
    try {
        if (!el || !el.addEventListener || typeof handler !== 'function') return;
        const safeKey = String(key || el.id || 'pet-guarded-click').trim();
        const bindToken = String(opts.bindToken || safeKey);
        if (el.dataset && el.dataset.petGuardedClickBound === bindToken) return;
        if (el.dataset) el.dataset.petGuardedClickBound = bindToken;
        const intervalMs = Number(opts.minIntervalMs || 550);
        el.addEventListener('click', (ev) => {
            try { if (opts.preventDefault !== false && ev) ev.preventDefault(); } catch (_) {}
            try { if (opts.stopPropagation !== false && ev) ev.stopPropagation(); } catch (_) {}
            if (!petGuardAction(safeKey, intervalMs)) return false;
            return handler(ev || null);
        });
        if (opts.touchCompat !== false) {
            try { ensureTouchClick(el); } catch (_) {}
        }
    } catch (_) {}
}
function ensureTouchClick(el){
    try {
        if (!el || !el.addEventListener) return;
        if (el.dataset && el.dataset.petTouchCompatBound === '1') return;
        if (el.dataset) el.dataset.petTouchCompatBound = '1';
        try { if (el.style) el.style.touchAction = 'manipulation'; } catch (_) {}
        let startX = 0;
        let startY = 0;
        let startAt = 0;
        let tracking = false;
        let moved = false;
        const TAP_DISTANCE_PX = 12;
        const TAP_MAX_DURATION_MS = 450;
        const NATIVE_CLICK_GUARD_MS = 700;
        const resetTouchState = () => {
            tracking = false;
            moved = false;
            startAt = 0;
            startX = 0;
            startY = 0;
        };
        el.addEventListener('touchstart', (e) => {
            if (e && e.touches && e.touches.length > 1) {
                resetTouchState();
                return;
            }
            const touch = e && e.changedTouches && e.changedTouches[0];
            if (!touch) return;
            tracking = true;
            moved = false;
            startAt = Date.now();
            startX = Number(touch.clientX || 0);
            startY = Number(touch.clientY || 0);
        }, { passive: true });
        el.addEventListener('touchmove', (e) => {
            if (!tracking) return;
            const touch = e && e.changedTouches && e.changedTouches[0];
            if (!touch) return;
            const dx = Math.abs(Number(touch.clientX || 0) - startX);
            const dy = Math.abs(Number(touch.clientY || 0) - startY);
            if (dx > TAP_DISTANCE_PX || dy > TAP_DISTANCE_PX) moved = true;
        }, { passive: true });
        el.addEventListener('touchcancel', resetTouchState, { passive: true });
        el.addEventListener('click', (e) => {
            const state = __petTouchSyntheticState.get(el);
            if (!state) return;
            const now = Date.now();
            if (state.allowSyntheticClick && (now - state.syntheticAt) < 120) {
                state.allowSyntheticClick = false;
                return;
            }
            if (state.blockNativeUntil && now < state.blockNativeUntil) {
                try { e.preventDefault(); } catch (_) {}
                try { e.stopImmediatePropagation(); } catch (_) { try { e.stopPropagation(); } catch (_) {} }
                return false;
            }
        }, true);
        el.addEventListener('touchend', (e) => {
            const now = Date.now();
            const touch = e && e.changedTouches && e.changedTouches[0];
            const dx = touch ? Math.abs(Number(touch.clientX || 0) - startX) : 0;
            const dy = touch ? Math.abs(Number(touch.clientY || 0) - startY) : 0;
            const isTap = tracking && !moved && dx <= TAP_DISTANCE_PX && dy <= TAP_DISTANCE_PX && startAt > 0 && (now - startAt) <= TAP_MAX_DURATION_MS;
            resetTouchState();
            if (!isTap) return;
            const last = __petTouchClickLock.get(el) || 0;
            if (now - last < 450) return;
            if (el.disabled) return;
            __petTouchClickLock.set(el, now);
            __petTouchSyntheticState.set(el, {
                syntheticAt: now,
                allowSyntheticClick: true,
                blockNativeUntil: now + NATIVE_CLICK_GUARD_MS
            });
            try { e.preventDefault(); } catch (_) {}
            try { e.stopPropagation(); } catch (_) {}
            try {
                el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
            } catch (_) {
                try { el.click(); } catch (_) {}
            }
        }, { passive: false });
    } catch (_) {}
}
