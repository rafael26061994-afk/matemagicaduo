        if (label.includes('completar') || label.includes('valor faltante')) return 'Reescreva a potência como multiplicação para descobrir o valor que falta.';
        if (label.includes('escrita expandida')) return 'Transforme a potência em produto repetido para enxergar melhor o cálculo.';
        if (label.includes('potência de 10')) return 'Em potências de 10, conte quantos zeros aparecem de acordo com o expoente.';
