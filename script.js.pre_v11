function getStudyDistractorProfile(operation, ctx = {}) {
    const op = String(operation || ctx.operation || '').toLowerCase();
    const label = normalizeSkillStageLabel(ctx.stageLabel || '').toLowerCase();
    const qText = String(ctx.questionString || ctx.voiceQuestion || '').toLowerCase();
    const profiles = Array.isArray(STUDY_DISTRACTOR_STAGE_MATRIX[op]) ? STUDY_DISTRACTOR_STAGE_MATRIX[op] : [];
    if (!profiles.length) return { profileLabel: 'default', priorityCodes: [], secondaryCodes: [] };
    const defaultProfile = profiles[0] || { profileLabel: 'default', priorityCodes: [], secondaryCodes: [] };
    const matched = profiles.find((profile, idx) => idx > 0 && Array.isArray(profile.match) && profile.match.some((keyword) => label.includes(keyword) || qText.includes(keyword)));
    const chosen = matched || defaultProfile;
    return {
        profileLabel: String(chosen.profileLabel || 'default'),
        priorityCodes: Array.isArray(chosen.priorityCodes) ? chosen.priorityCodes.map(String) : [],
        secondaryCodes: Array.isArray(chosen.secondaryCodes) ? chosen.secondaryCodes.map(String) : []
    };
}
function shouldUsePedagogicalDistractors(operation, ctx = {}) {
    if (operation !== 'multiplication') return true;
    const level = String(ctx.level || gameState.currentLevel || '').toLowerCase();
    if (!gameState.isRapidMode) return true;
    return level === 'apprentice';
}
function isSimpleRapidMultiplicationSession(ctx = {}) {
    return String(ctx.operation || '').toLowerCase() === 'multiplication' && !shouldUsePedagogicalDistractors('multiplication', ctx);
}
function addPedagogicalDistractors(operation, answer, ctx, push) {
    const label = normalizeSkillStageLabel(ctx.stageLabel || '').toLowerCase();
    const qText = String(ctx.questionString || '').trim();
    const qLower = qText.toLowerCase();
    const num1 = Number(ctx.num1);
    const num2 = Number(ctx.num2);
    const knownResult = parseTrailingResult(qText);
    const pushPairNeighbors = () => {
        push(answer + 1);
        push(answer - 1);
    };
    switch (operation) {
        case 'addition': {
            if (qText.includes('?')) {
                const known = Number.isFinite(num1) ? num1 : 0;
                const total = Number.isFinite(knownResult) ? knownResult : (Number.isFinite(num2) ? known + num2 : answer + known);
                push(known);
                push(total);
                push(total - known + 1);
                push(total - known - 1);
                push(Math.abs(total - answer - 1));
                pushPairNeighbors();
                break;
            }
            if ((qText.match(/\+/g) || []).length >= 2) {
                const partial = Number.isFinite(num1) ? num1 : 0;
                const third = Number.isFinite(num2) ? num2 : 0;
                push(partial);
                push(answer - third);
                push(answer + third);
                push(partial + Math.max(1, third - 1));
                pushPairNeighbors();
                break;
            }
            const noCarry = placeValueAdditionWithoutCarry(num1, num2);
            if (label.includes('reagrupamento') || noCarry !== answer) push(noCarry);
            push(Math.abs((Number(num1) || 0) - (Number(num2) || 0)));
            push((Number(num1) || 0) + (Number(num2) || 0) + 10);
            push((Number(num1) || 0) + Math.max(0, (Number(num2) || 0) - 1));
            push((Number(num1) || 0) + Math.max(0, (Number(num2) || 0) + 1));
            pushPairNeighbors();
            break;
        }
        case 'subtraction': {
            if (String(ctx.bridgeFamily || '') === 'addition-subtraction') {
                const total = Number.isFinite(num1) ? num1 : 0;
                const knownPart = Number.isFinite(num2) ? num2 : 0;
                push(total);
                push(knownPart);
                push(total + knownPart);
                push(total - knownPart + 1);
                push(total - knownPart - 1);
                pushPairNeighbors();
                break;
            }
            if (/^\?\s*-/.test(qText)) {
                const subtrahend = Number.isFinite(num2) ? num2 : 0;
                const diff = Number.isFinite(knownResult) ? knownResult : 0;
                push(subtrahend);
                push(diff);
                push(diff + subtrahend + 1);
                push(Math.abs(diff - subtrahend));
                pushPairNeighbors();
                break;
            }
            if (qText.includes('- ?')) {
                const minuend = Number.isFinite(num1) ? num1 : 0;
                const diff = Number.isFinite(knownResult) ? knownResult : 0;
                push(diff);
                push(minuend);
                push(minuend + diff);
                push(Math.abs(minuend - diff - 1));
                pushPairNeighbors();
                break;
