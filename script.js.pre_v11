    if (op === 'addition') return 'Retome a soma juntando as partes por ordens e conferindo se o total faz sentido.';
    if (op === 'division') return 'Retome a divisão perguntando se a questão quer quantidade de grupos, tamanho dos grupos ou resto.';
    if (op === 'multiplication') return 'Retome a multiplicação em grupos iguais, soma repetida ou decomposição de fatores.';
    if (op === 'radiciacao') return 'Retome a raiz procurando qual número, ao quadrado ou ao cubo, gera o valor dado.';
