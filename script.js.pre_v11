let __skillMicroExplanationTimer = null;
function getCurrentSkillMicroExplanationMeta() {
    try {
        if (!gameState || !gameState.isGameActive || gameState.isTrainingErrors) return null;
        const operation = String(gameState.currentOperation || '');
        if (!operation) return null;
        const trail = gameState.operationTrail || null;
        if (!trail || !trail.masteryMode) return null;
        const rawLabel = String(
            trail.currentStageLabel ||
            gameState.currentQuestion?.masteryStageLabel ||
            gameState.currentQuestion?.stageLabel || ''
        ).trim();
