        { profileLabel: 'resto', match: ['resto'], priorityCodes: ['division_remainder_as_quotient', 'division_remainder_as_divisor', 'division_remainder_neighbor'], secondaryCodes: ['division_used_divisor'] },
        { profileLabel: 'dividendo faltante', match: ['dividendo'], priorityCodes: ['division_missing_dividend_used_quotient', 'division_missing_dividend_sum', 'division_missing_dividend_near'], secondaryCodes: ['division_as_multiplication'] },
        { profileLabel: 'divisor faltante', match: ['divisor'], priorityCodes: ['division_missing_divisor_used_quotient', 'division_missing_divisor_used_dividend'], secondaryCodes: ['division_used_divisor'] },
        { profileLabel: 'relação inversa', match: ['relação', 'quociente'], priorityCodes: ['division_as_multiplication', 'division_used_dividend', 'division_used_divisor'], secondaryCodes: ['division_as_subtraction'] }
    ],
    potenciacao: [
        { profileLabel: 'default', match: [], priorityCodes: ['power_as_multiplication', 'power_as_sum', 'power_exponent_minus_one'], secondaryCodes: ['power_exponent_plus_one'] },
        { profileLabel: 'expoente 0', match: ['expoente 0'], priorityCodes: ['power_zero_rule', 'power_as_multiplication', 'power_as_sum'], secondaryCodes: ['power_exponent_plus_one'] },
        { profileLabel: 'expoente 1', match: ['expoente 1'], priorityCodes: ['power_exponent_one_rule', 'power_as_sum', 'power_as_multiplication'], secondaryCodes: ['power_exponent_plus_one'] },
        { profileLabel: 'multiplicação repetida', match: ['produto', 'expressão', 'erro comum', 'valor faltante'], priorityCodes: ['power_as_multiplication', 'power_as_sum', 'power_exponent_minus_one', 'power_exponent_plus_one'], secondaryCodes: ['power_exponent_one_rule'] }
