        if (label.includes('tabuada do 5')) return 'Na tabuada do 5, observe o padrão final em 0 ou 5.';
        if (label.includes('tabuada do 10')) return 'Multiplicar por 10 é acrescentar um zero ao número inteiro.';
        if (label.includes('tabuadas 1 e 2')) return 'Comece pelos fatos mais curtos e observe que multiplicar por 1 mantém a quantidade.';
        if (label.includes('tabuada do 4')) return 'A tabuada do 4 pode ser pensada como dobro do dobro.';
        if (label.includes('tabuada do 6')) return 'Use o apoio da tabuada do 3 e dobre o resultado para pensar no 6.';
        if (label.includes('tabuada do 7')) return 'No 7, vale montar grupos iguais e repetir a tabuada até ganhar fluência.';
