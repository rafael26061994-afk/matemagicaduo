            const total = hard ? randomInt(4, 10) : randomInt(6, 18);
            const known = randomInt(0, Math.max(0, total - 1));
            return qAdditionMissing(total, known, stageLabel, Math.random() < 0.5);
        }
        if (label.includes('3 parcelas') || label.includes('três parcelas')) {
            const a = hard ? randomInt(0, 3) : randomInt(0, 5);
            const b = hard ? randomInt(0, 3) : randomInt(0, 4);
            const c = hard ? randomInt(0, 3) : randomInt(0, 4);
            return qAddition3(a, b, c, stageLabel);
        }
        if (label.includes('dezenas')) {
            return qAddition(randFrom(hard ? [10,20,30] : [10,20,30,40]), randFrom(hard ? [10,20] : [10,20,30]), stageLabel);
        }
        if (label.includes('sem reagrupamento')) {
            const [a,b] = randAdditionNoCarry(hard ? 10 : 10, hard ? 24 : 38, 1, hard ? 4 : 8);
            return qAddition(a,b,stageLabel);
        }
        if (label.includes('reagrupamento')) {
            const [a,b] = randAdditionWithCarry(hard ? 10 : 14, hard ? 26 : 39, 1, hard ? 4 : 7);
            return qAddition(a,b,stageLabel);
        }
        return qAddition(hard ? randomInt(0, 9) : randomInt(4, 25), hard ? randomInt(0, 9) : randomInt(2, 18), stageLabel);
    }
    if (operation === 'subtraction') {
        if (label.includes('minuendo desconhecido') || label.includes('número que falta')) {
            const diff = hard ? randomInt(2, 15) : randomInt(5, 40);
            const sub = hard ? randomInt(0, 9) : randomInt(3, 25);
            return qUnknownMinuend(diff, sub, stageLabel);
        }
        if (label.includes('subtraendo desconhecido') || label.includes('resultado faltante') || label.includes('falta')) {
            const minuend = hard ? randomInt(8, 20) : randomInt(15, 60);
            const diff = hard ? randomInt(1, minuend - 1) : randomInt(4, minuend - 2);
            return qUnknownSubtrahend(minuend, diff, stageLabel);
        }
        if (label.includes('sem reserva')) {
            const [a,b] = randSubtractionNoBorrow(hard ? 10 : 12, hard ? 24 : 45, 0, hard ? 9 : 18);
            return qSubtraction(a,b,stageLabel);
        }
        if (label.includes('reserva')) {
            const [a,b] = randSubtractionWithBorrow(hard ? 12 : 18, hard ? 30 : 54, 1, hard ? 9 : 18);
            return qSubtraction(a,b,stageLabel);
        }
        return qSubtraction(hard ? randomInt(6, 20) : randomInt(20, 60), hard ? randomInt(0, 9) : randomInt(4, 25), stageLabel);
    }
    if (operation === 'division') {
        if (label.includes('resto')) {
            const divisor = randFrom(hard ? [2,3,4] : [2,3,4,5]);
            const quotient = hard ? randomInt(2, 5) : randomInt(2, 7);
            const remainder = randomInt(1, Math.max(1, divisor - 1));
            return qDivisionRemainder(divisor * quotient + remainder, divisor, stageLabel);
        }
        if (label.includes('dividendo')) {
            const divisor = randFrom(hard ? [2,3,4] : [2,3,4,5]);
            const quotient = hard ? randomInt(2, 5) : randomInt(2, 8);
            return qDivisionFindDividend(divisor, quotient, stageLabel);
        }
        if (label.includes('divisor')) {
            const divisor = randFrom(hard ? [2,3,4] : [2,3,4,5]);
            const quotient = hard ? randomInt(2, 5) : randomInt(2, 8);
            return qDivisionFindDivisor(divisor * quotient, quotient, stageLabel);
        }
        const [dividend, divisor] = randExactDivision(2, hard ? 4 : 6, 2, hard ? 6 : 9);
        return qDivision(dividend, divisor, stageLabel);
    }
    if (operation === 'potenciacao') {
        if (label.includes('expoente 0')) return qPower(randFrom([2,3,4,5]), 0, stageLabel);
        if (label.includes('expoente 1')) return qPower(randFrom([2,3,4,5,6]), 1, stageLabel);
        if (label.includes('cubo')) return qPower(randFrom(hard ? [2,3] : [2,3,4]), 3, stageLabel);
        if (label.includes('expandida') || label.includes('multiplicação repetida')) return qPowerExpanded(randFrom(hard ? [2,3] : [2,3,4]), hard ? 2 : randFrom([2,3]), stageLabel);
        return qPower(randFrom(hard ? [2,3,4] : [2,3,4,5]), randFrom(hard ? [2] : [2,3]), stageLabel);
    }
    if (operation === 'radiciacao') {
        if (label.includes('cúbica') || label.includes('cubica')) {
            return qCubeRoot(randIntFromList(hard ? [8, 27] : [8, 27, 64, 125]), stageLabel);
        }
        if (label.includes('estimativa') || label.includes('aproximada')) {
            return qRootEstimate(randIntFromList(hard ? [9,16,25,36] : [9,16,25,36,49,64,81]), stageLabel);
        }
        return qRoot(randIntFromList(hard ? [4,9,16,25,36] : [4,9,16,25,36,49,64,81,100]), stageLabel);
    }
    if (operation === 'multiplication') {
        if (label.includes('grupos')) return qEqualGroups(hard ? randomInt(2,4) : randomInt(2,5), hard ? randomInt(2,3) : randomInt(2,5), stageLabel);
        if (label.includes('soma repetida')) return qRepeatedAddition(randFrom(hard ? [2,3] : [2,3,4,5]), hard ? randomInt(2,3) : randomInt(2,4), stageLabel);
        if (label.includes('dobro') || label.includes('triplo')) return qDoubleTriple(hard ? randomInt(2,6) : randomInt(2,9), label.includes('triplo') && !hard ? 3 : randFrom(hard ? [2] : [2,3]), stageLabel);
        if (label.includes('saltos')) return qSkipCounting(randFrom(hard ? [2,3,5] : [2,3,5,10]), hard ? randomInt(3,4) : randomInt(3,6), stageLabel);
        const m = label.match(/tabuada[s]? do\s+(\d+)/i);
        if (m) return qMultiplicationBasic(Number(m[1]), hard ? randomInt(1,4) : randomInt(1,6), stageLabel);
        if (label.includes('tabuadas 1 e 2')) return qMultiplicationBasic(randFrom([1,2]), hard ? randomInt(1,4) : randomInt(1,6), stageLabel);
        if (label.includes('tabuadas 11 e 12')) return qMultiplicationBasic(randFrom([11,12]), hard ? randomInt(1,6) : randomInt(1,10), stageLabel);
        if (label.includes('tabuadas 13 a 15')) return qMultiplicationBasic(randFrom([13,14,15]), hard ? randomInt(1,5) : randomInt(1,8), stageLabel);
        if (label.includes('tabuadas 16 a 20')) return qMultiplicationBasic(randFrom([16,17,18,19,20]), hard ? randomInt(1,4) : randomInt(1,6), stageLabel);
        return qMultiplicationBasic(randFrom(hard ? [2,3,4,5] : [2,3,4,5,6,7,8,9,10]), hard ? randomInt(1,4) : randomInt(1,8), stageLabel);
    }
    return null;
}
function applyAdaptiveSupportToQuestion(question, meta) {
    if (!question || !meta) return question;
    const safeMode = normalizeAdaptiveSupportMode(meta.supportMode || 'normal');
    const profile = getAdaptiveSupportProfile(meta.operation, meta.level, meta.stageLabel || question.stageLabel || '', safeMode);
    question.supportMode = profile.mode;
    question.supportLabel = profile.label;
    question.supportHint = profile.supportHint || '';
    question.options = buildQuestionOptions(question.operacao || meta.operation, Number(question.answer), {
        num1: question.num1,
        num2: question.num2,
        supportMode: profile.mode,
        stageLabel: question.stageLabel || meta.stageLabel || '',
        questionString: String(question.question || '').replace(/\s*=\s*\?\s*$/, ''),
        voiceQuestion: question.voiceQuestion || question.question || '',
        level: meta.level || gameState.currentLevel || '',
        studyDistractorsOnly: !gameState.isRapidMode
    });
    question.voiceOptions = question.options;
    question.distractorMeta = Array.isArray(question.options?.__distractorMeta)
        ? question.options.__distractorMeta.map((it) => ({ ...it }))
        : [];
    return question;
}
function maybeAdjustAdaptiveSupportAfterResolution() {
    try {
        const trail = gameState.operationTrail;
        if (!trail || !trail.masteryMode) return;
        const asked = Math.max(0, Number(trail.currentStageAsked) || 0);
        if (asked <= 0) return;
        const correct = Math.max(0, Number(trail.currentStageCorrect) || 0);
        const misses = Math.max(0, asked - correct);
        const accuracy = correct / asked;
        const current = normalizeAdaptiveSupportMode(trail.supportMode || 'normal');
        let next = current;
        const stageMap = loadOperationSkillReviewMap();
        const stageKey = getOperationSkillReviewKey(trail.operation, trail.level, Math.max(0, Number(trail.currentStageIndex) || 0));
        const review = (stageMap && typeof stageMap === 'object') ? (stageMap[stageKey] || {}) : {};
        const consecutiveWrong = Math.max(0, Number(review.consecutiveWrong) || 0);
        const heavyStruggle = consecutiveWrong >= 3 || (misses >= 3 && accuracy < 0.55);
        const moderateStruggle = misses >= 2 || (asked >= 3 && accuracy < 0.7);
        if (heavyStruggle) next = 'very_guided';
        else if (moderateStruggle) next = 'guided';
        else if (asked >= 3 && accuracy >= 0.8) next = 'normal';
        const changed = next !== current;
        trail.supportMode = next;
        if (next === 'normal') {
            trail.supportHint = '';
            trail.supportLaneRemaining = 0;
            trail.supportLaneReason = '';
        } else {
            const profile = getAdaptiveSupportProfile(trail.operation, trail.level, trail.currentStageLabel || '', next);
            trail.supportHint = profile.supportHint || '';
            const targetLane = getAdaptiveLaneSizeForMode(next);
            if (heavyStruggle || changed) {
                trail.supportLaneRemaining = Math.max(Number(trail.supportLaneRemaining || 0), targetLane);
            }
            trail.supportLaneReason = heavyStruggle
                ? 'Travou nesta habilidade e entrou em rota mais gradual com mediação concreta.'
                : 'Recebeu apoio guiado para reduzir carga e reorganizar o raciocínio.';
        }
        if (current === 'normal' && next !== 'normal') {
            trail.supportEscalations = Math.max(0, Number(trail.supportEscalations) || 0) + 1;
        }
        if (gameState.isRapidMode && Number.isFinite(gameState.timeLeft) && Number.isFinite(gameState.maxTime)) {
            const profile = getAdaptiveSupportProfile(trail.operation, trail.level, trail.currentStageLabel || '', next);
            const boosted = Math.round((Number(gameState.maxTime) || 0) * (profile.timeMultiplier || 1));
            if (boosted > Number(gameState.maxTime || 0)) {
                gameState.maxTime = boosted;
                gameState.timeLeft = Math.max(Number(gameState.timeLeft || 0), Math.round(boosted * 0.72));
            }
        }
        updateAdaptiveSupportPanel();
        if (next !== 'normal' && changed) {
            const profile = getAdaptiveSupportProfile(trail.operation, trail.level, trail.currentStageLabel || '', next);
            showFeedbackControlled(`🛟 ${trail.supportLaneReason} Apoio ${profile.label.toLowerCase()} ativado nesta habilidade. ${profile.supportHint}`, 'info', gameState.isRapidMode ? 5200 : 7600);
        }
    } catch (_) {}
}
const INITIAL_DIAGNOSTIC_KEY = 'pet_initial_diagnostic_v1';
function loadInitialDiagnosticMap() {
    try {
        const raw = profileStorageGetRaw(INITIAL_DIAGNOSTIC_KEY);
        const obj = raw ? JSON.parse(raw) : {};
        return (obj && typeof obj === 'object') ? obj : {};
    } catch (_) {
        return {};
    }
}
function saveInitialDiagnosticMap(map) {
    try { profileStorageSetJson(INITIAL_DIAGNOSTIC_KEY, map || {}); } catch (_) {}
}
function getInitialDiagnosticRecord(operation, level) {
    const map = loadInitialDiagnosticMap();
    return map[getOperationTrailKey(operation, level)] || null;
}
function setInitialDiagnosticRecord(operation, level, record) {
    const map = loadInitialDiagnosticMap();
    map[getOperationTrailKey(operation, level)] = record;
    saveInitialDiagnosticMap(map);
}
function getOperationLevelOrder(operation) {
    const hasApprentice = !!((getOperationTrailStages(operation, 'apprentice') || []).length);
    return hasApprentice
        ? ['apprentice', 'easy', 'medium', 'advanced']
        : ['easy', 'medium', 'advanced'];
}
function getPreviousOperationLevel(operation, level) {
    const levels = getOperationLevelOrder(operation);
    const idx = levels.indexOf(String(level || ''));
    return idx > 0 ? levels[idx - 1] : null;
}
function isStageBasedOperationLevel(operation, level) {
    const stages = getOperationTrailStages(operation, level);
    return Array.isArray(stages) && stages.length > 0;
}
function shouldRunInitialDiagnostic(operation, level, force = false) {
    if (!operation || !level) return false;
    if (String(level || '') !== 'apprentice') return false;
    if (!isStageBasedOperationLevel(operation, level)) return false;
    if (operation === 'multiplication' && gameState.multiplication && gameState.multiplication.mode === 'direct') return false;
    if (force) return true;
    const rec = getInitialDiagnosticRecord(operation, level);
    if (rec && rec.completed) return false;
    const stages = getOperationTrailStages(operation, level);
    if (Array.isArray(stages) && stages.length) {
        const unlocked = getSavedOperationStageUnlock(operation, level, stages.length);
        if (unlocked > 0) return false;
    }
    return true;
}
function getDiagnosticStageSampleIndices(totalStages) {
    const maxIdx = Math.max(0, Number(totalStages || 1) - 1);
    const base = [0, 1, 3, 5, 7, 9];
    const out = [];
    base.forEach((idx) => {
        const safe = Math.max(0, Math.min(maxIdx, Number(idx) || 0));
        if (!out.includes(safe)) out.push(safe);
    });
    for (let i = 0; out.length < Math.min(6, Math.max(1, maxIdx + 1)); i++) {
        const safe = Math.max(0, Math.min(maxIdx, i));
        if (!out.includes(safe)) out.push(safe);
        if (i > maxIdx + 6) break;
    }
    return out.slice(0, 6);
}
function buildInitialDiagnosticPlan(operation, level) {
    const stages = getOperationTrailStages(operation, level);
    if (!Array.isArray(stages) || !stages.length) return [];
    const indices = getDiagnosticStageSampleIndices(stages.length);
    return indices.map((stageIndex, idx) => ({
        seq: idx,
        operation,
        level,
        stageIndex,
        stage: stages[stageIndex] || stages[0],
        totalStages: stages.length,
        bankSize: getOperationTrailBankSize(operation, level)
    })).filter((it) => it && it.stage && typeof it.stage.gen === 'function');
}
function getDiagnosticSuggestedStageIndex(correctCount, totalStages) {
    const maxIdx = Math.max(0, Number(totalStages || 1) - 1);
    const map = [0, 0, 1, 2, 4, 6, 8];
    const safeCorrect = Math.max(0, Math.min(6, Number(correctCount) || 0));
    return Math.max(0, Math.min(maxIdx, map[safeCorrect] ?? 0));
}
function setModeButtonVisualState(isRapid) {
    if (modeRapidoBtn) modeRapidoBtn.classList.toggle('active', !!isRapid);
    if (modeEstudoBtn) modeEstudoBtn.classList.toggle('active', !isRapid);
}
function buildDiagnosticReinforcementText(results) {
    const wrong = Array.isArray(results) ? results.filter((it) => !it.correct) : [];
    if (!wrong.length) return 'Você demonstrou segurança nas habilidades amostradas desta trilha.';
    const counts = {};
    wrong.forEach((it) => {
        const label = String(it.stageLabel || 'Habilidade atual').trim();
        counts[label] = (counts[label] || 0) + 1;
    });
    const ranked = Object.entries(counts).sort((a,b) => b[1] - a[1]).slice(0, 2).map(([label]) => label);
    if (!ranked.length) return 'Faça uma retomada breve da habilidade atual antes de acelerar.';
    if (ranked.length === 1) return `Reforço indicado: ${ranked[0]}.`;
    return `Reforço indicado: ${ranked[0]} e ${ranked[1]}.`;
}
function normalizeTrailLabel(str) {
    return String(str || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
}
function findStageIndexByKeywords(stages, keywords) {
    if (!Array.isArray(stages) || !Array.isArray(keywords) || !keywords.length) return -1;
    const wanted = keywords.map((k) => normalizeTrailLabel(k)).filter(Boolean);
    return stages.findIndex((stage) => {
        const label = normalizeTrailLabel(stage?.label || '');
        return wanted.every((token) => label.includes(token));
    });
}
function getSkillPrerequisiteInfo(operation, stageLabel) {
    const label = normalizeTrailLabel(stageLabel);
    const base = { label: 'Base anterior da própria habilidade', action: 'Aplique 1 rodada guiada e retome a habilidade em Modo Estudo.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: [] };
    if (!label) return base;
    if (operation === 'addition' && label.includes('reagrupamento')) {
        return { label: 'Composição de dezenas e soma sem reagrupamento', action: 'Retomar composição de dezenas e uma rodada guiada de soma sem reagrupamento antes do “vai um”.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['sem reagrupamento'] };
    }
    if (operation === 'subtraction' && label.includes('reserva')) {
        return { label: 'Valor posicional e subtração sem reserva', action: 'Retomar valor posicional e uma rodada guiada de subtração sem reserva antes do empréstimo.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['sem reserva'] };
    }
    if (operation === 'division' && label.includes('resto')) {
        return { label: 'Multiplicação e agrupamento', action: 'Treinar a relação multiplicação × divisão e agrupamentos antes de voltar ao resto.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['relação', 'multiplicação', 'divisão'] };
    }
    if (operation === 'division' && (label.includes('divisor') || label.includes('dividendo'))) {
        return { label: 'Leitura da estrutura da divisão', action: 'Retomar quem é total, divisor e quociente com uma rodada guiada de leitura de divisão.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['quociente'] };
    }
    if (operation === 'multiplication' && (label.includes('tabuada') || label.includes('produtos maiores'))) {
        return { label: 'Grupos iguais e contagem em saltos', action: 'Voltar para grupos iguais e contagem em saltos antes de acelerar a tabuada.', avoidRapid: label.includes('tabuada do 7') || label.includes('tabuada do 8') || label.includes('tabuada do 9'), guidedRounds: 1, sameOperationKeywords: ['grupos iguais'] };
    }
    if (operation === 'potenciacao') {
        return { label: 'Multiplicação repetida', action: 'Reescrever a potência como produto repetido antes de tentar de novo.', avoidRapid: label.includes('expoente 0') || label.includes('expoente 1'), guidedRounds: 1, sameOperationKeywords: ['multiplicação repetida'] };
    }
    if (operation === 'radiciacao' && (label.includes('raiz cubica') || label.includes('raizes cubicas') || label.includes('raízes cúbicas'))) {
        return { label: 'Potenciação e cubos perfeitos', action: 'Consolidar cubos perfeitos e a relação entre potência e raiz antes das raízes cúbicas.', avoidRapid: true, guidedRounds: 2, sameOperationKeywords: ['relação entre potência e raiz'] };
    }
    if (operation === 'radiciacao') {
        return { label: 'Potenciação e quadrados perfeitos', action: 'Reforçar quadrados perfeitos e a relação inversa entre potência e raiz.', avoidRapid: true, guidedRounds: 1, sameOperationKeywords: ['quadrados perfeitos'] };
    }
    return base;
}
function findPrerequisiteStageIndex(operation, stages, stageLabel) {
    const info = getSkillPrerequisiteInfo(operation, stageLabel);
    const keywords = Array.isArray(info.sameOperationKeywords) ? info.sameOperationKeywords : [];
    const idx = findStageIndexByKeywords(stages, keywords);
    return idx;
}

function getPedagogySkillProfile(operation = '', stageLabel = '', level = '') {
    const safeOperation = String(operation || '').trim().toLowerCase();
    const safeLabel = normalizeTrailLabel(stageLabel);
    const safeLevel = String(level || '').trim().toLowerCase();
    const profile = {
        category: 'general',
        label: 'habilidade geral',
        independentThresholdDelta: 0,
        independentAskedDelta: 0,
        maintenanceSessionsDelta: 0,
        prereqThresholdDelta: 0,
        prereqAskedDelta: 0,
        staleDaysDelta: 0,
        blockingErrorDelta: 0,
        progressWeight: 0.9,
        evidenceWeight: 1.1,
        precisionWeight: 1.15,
        maintenanceWeight: 1,
        autonomyWeight: 1,
        blockingWeight: 1.2,
        prereqWeight: 1,
        freshnessWeight: 0.8,
        confidenceSampleMin: 4,
        confidenceSessionMin: 2
    };
    const isBaseSkill = (
        (!safeLabel && ['addition','subtraction','multiplication'].includes(safeOperation)) ||
        safeLabel.includes('sem reagrup') || safeLabel.includes('sem reserva') ||
        safeLabel.includes('grupos iguais') || safeLabel.includes('saltos') ||
        safeLabel.includes('tabuada do 2') || safeLabel.includes('tabuada do 3') ||
        safeLabel.includes('tabuada do 4') || safeLabel.includes('tabuada do 5')
    );
    const isDerivedSkill = ['division','potenciacao','radiciacao'].includes(safeOperation)
        || safeLabel.includes('relação inversa') || safeLabel.includes('termo faltante');
    const isAdvancedSkill = safeLevel === 'advanced'
        || safeLabel.includes('produtos maiores')
        || safeLabel.includes('tabuada do 7') || safeLabel.includes('tabuada do 8') || safeLabel.includes('tabuada do 9')
        || safeLabel.includes('resto')
        || safeLabel.includes('raízes cúbicas') || safeLabel.includes('raizes cubicas') || safeLabel.includes('raiz cubica')
        || safeLabel.includes('expoente 0') || safeLabel.includes('expoente 1');

    if (isBaseSkill) {
        profile.category = 'base';
        profile.label = 'base';
        profile.independentThresholdDelta += 0.03;
        profile.independentAskedDelta += 1;
        profile.prereqThresholdDelta += 0.04;
        profile.prereqAskedDelta += 1;
        profile.blockingErrorDelta -= 1;
        profile.evidenceWeight += 0.2;
        profile.precisionWeight += 0.2;
        profile.blockingWeight += 0.2;
        profile.confidenceSampleMin += 1;
    }
    if (isDerivedSkill) {
        profile.category = profile.category === 'advanced' ? 'advanced-derived' : 'derived';
        profile.label = profile.label === 'base' ? 'base/derivada' : 'derivada';
        profile.prereqThresholdDelta += 0.05;
        profile.prereqAskedDelta += 1;
        profile.prereqWeight += 0.35;
        profile.blockingWeight += 0.15;
        profile.evidenceWeight += 0.05;
    }
    if (isAdvancedSkill) {
        profile.category = profile.category === 'derived' ? 'advanced-derived' : 'advanced';
        profile.label = profile.label === 'base' ? 'base/avançada' : 'avançada';
        profile.independentAskedDelta += 1;
        profile.maintenanceSessionsDelta += 1;
        profile.staleDaysDelta -= 7;
        profile.maintenanceWeight += 0.35;
        profile.freshnessWeight += 0.15;
        profile.confidenceSessionMin += 1;
    }
    return profile;
}
function buildPedagogicalBottleneckMeta({ evidence = null, blocking = null, prereqGate = null, manualOverride = null, confidence = null } = {}) {
    if (manualOverride?.mode === 'lock') return { code: 'manual_lock', label: 'Override manual', detail: manualOverride.reason || 'bloqueio manual do professor ativo.', severity: 'high' };
    if (blocking?.isBlocking) return { code: String(blocking.code || 'blocking_error'), label: 'Erro dominante bloqueador', detail: blocking.detail || `resolver erro dominante: ${blocking.label || 'bloqueio atual'}`, severity: 'high' };
    if (prereqGate?.required && !prereqGate?.ok) return { code: 'prerequisite', label: 'Pré-requisito', detail: prereqGate.detail || `consolidar ${prereqGate.prerequisiteLabel || 'a base anterior'}`, severity: 'high' };
    if (evidence?.stale) return { code: 'stale', label: 'Prática desatualizada', detail: `retomar prática: ${evidence.daysWithoutPractice || 0} dia(s) sem exercício recente.`, severity: 'medium' };
    if (evidence?.supportHeavy) return { code: 'support_heavy', label: 'Autonomia fraca', detail: 'o apoio ainda pesa mais do que a autonomia independente.', severity: 'medium' };
    if ((evidence?.missingMaintenanceSessions || 0) > 0) return { code: 'maintenance', label: 'Confirmação pendente', detail: `falta confirmar em ${evidence.missingMaintenanceSessions} sessão(ões) com desempenho sustentado.`, severity: 'medium' };
    if ((evidence?.missingIndependentEvidence || 0) > 0) return { code: 'independent_evidence', label: 'Amostra insuficiente', detail: `faltam ${evidence.missingIndependentEvidence} evidência(s) independente(s).`, severity: 'medium' };
    if (evidence && evidence.independentAsked > 0 && evidence.independentAcc < Number(evidence.masteryThreshold || 0.8)) return { code: 'independent_accuracy', label: 'Precisão independente', detail: `a precisão independente ainda está em ${Math.round((Number(evidence.independentAcc) || 0) * 100)}%.`, severity: 'medium' };
    if (confidence && confidence.code === 'low') return { code: 'confidence_low', label: 'Confiança baixa', detail: confidence.detail || 'a decisão ainda usa pouca evidência acumulada.', severity: 'low' };
    return { code: 'none', label: 'Sem gargalo crítico', detail: 'o principal caminho agora é manter o ritmo até a liberação.', severity: 'low' };
}
function buildPedagogicalNextAction({ operation = '', level = '', stageLabel = '', evidence = null, blocking = null, prereqGate = null, manualOverride = null, stateCode = '', bottleneck = null } = {}) {
    const prerequisite = getSkillPrerequisiteInfo(operation, stageLabel);
    if (manualOverride?.mode === 'lock') return 'Converse com o professor responsável antes de tentar este nível novamente.';
    if (blocking?.isBlocking) return prerequisite.action || `Ataque o erro dominante (${blocking.label || 'bloqueador atual'}) em 1 rodada guiada antes de avançar.`;
    if (prereqGate?.required && !prereqGate?.ok) return prerequisite.action || `Retome ${prereqGate.prerequisiteLabel || 'a base anterior'} antes de insistir no próximo nível.`;
    if (evidence?.stale) return 'Faça 1 sessão curta de revisão no Modo Estudo para reativar a prática recente.';
    if (evidence?.supportHeavy) return 'Repita 1 rodada no Modo Estudo reduzindo pistas e tentando responder sem apoio pesado.';
    if ((evidence?.missingIndependentEvidence || 0) > 0) return `Registre mais ${evidence.missingIndependentEvidence} evidência(s) independente(s) neste nível antes de subir.`;
    if (evidence && evidence.independentAsked > 0 && evidence.independentAcc < Number(evidence.masteryThreshold || 0.8)) return 'Busque mais precisão sem apoio: erre menos antes de tentar liberar o próximo nível.';
    if ((evidence?.missingMaintenanceSessions || 0) > 0) return `Confirme o desempenho em mais ${evidence.missingMaintenanceSessions} sessão(ões) para validar manutenção.`;
    if (stateCode === 'released') return `Pode iniciar ${petLevelLabel(level)} e construir autonomia desde a primeira rodada.`;
    if (stateCode === 'mastered') return 'Mantenha uma revisão curta e siga para o próximo nível quando estiver disponível.';
    return bottleneck?.detail ? `Próximo passo: ${bottleneck.detail}` : 'Continue praticando com calma até consolidar a habilidade.';
}
function computePedagogicalDecisionConfidence({ evidence = null, blocking = null, prereqGate = null, manualOverride = null, skillProfile = null } = {}) {
    const profile = skillProfile && typeof skillProfile === 'object' ? skillProfile : getPedagogySkillProfile('', '', '');
    const sampleTarget = Math.max(2, Number(profile.confidenceSampleMin) || 4);
    const sessionTarget = Math.max(1, Number(profile.confidenceSessionMin) || 2);
    const criteria = [
        { ratio: evidence ? Math.max(0, Math.min(1, (Number(evidence.independentAsked) || 0) / sampleTarget)) : 0, label: 'Amostra independente' },
        { ratio: evidence ? Math.max(0, Math.min(1, (Array.isArray(evidence.sessionHistory) ? evidence.sessionHistory.length : 0) / sessionTarget)) : 0, label: 'Sessões observadas' },
        { ratio: evidence && evidence.stale ? 0 : 1, label: 'Atualidade da prática' },
        { ratio: blocking && blocking.isBlocking ? 0.35 : 1, label: 'Estabilidade do erro dominante' },
        { ratio: prereqGate && prereqGate.required ? (prereqGate.ok ? 1 : 0.4) : 1, label: 'Base prévia' },
        { ratio: manualOverride?.mode ? 0.35 : 1, label: 'Interferência manual' }
    ];
    const score = criteria.reduce((acc, item) => acc + (Number(item.ratio) || 0), 0) / Math.max(1, criteria.length);
    const pct = Math.round(score * 100);
    const code = pct >= 78 ? 'high' : (pct >= 56 ? 'medium' : 'low');
    const label = code === 'high' ? 'Alta' : (code === 'medium' ? 'Média' : 'Baixa');
    let detail = 'a decisão já tem evidência suficiente para ser tratada com mais confiança.';
    if (code === 'medium') detail = 'a decisão está razoável, mas ainda pode mudar com novas sessões independentes.';
    if (code === 'low') detail = 'a decisão ainda usa pouca evidência e deve ser lida com cautela.';
    return { code, label, percent: pct, detail, criteria };
}
function getStageEvidenceProfile(record, masteryThreshold = null, context = {}) {
    const policy = getPedagogyPolicyConfig();
    const skillProfile = getPedagogySkillProfile(context.operation || '', context.stageLabel || '', context.level || '');
    const baseThreshold = Number.isFinite(Number(masteryThreshold)) ? Number(masteryThreshold) : policy.independentThreshold;
    const resolvedThreshold = Math.max(0.55, Math.min(0.95, baseThreshold + Number(skillProfile.independentThresholdDelta || 0)));
    const independentMin = Math.max(1, (Number(policy.independentAskedMin) || 4) + Number(skillProfile.independentAskedDelta || 0));
    const maintenanceMin = Math.max(1, (Number(policy.maintenanceSessions) || 2) + Number(skillProfile.maintenanceSessionsDelta || 0));
    const staleDaysLimit = Math.max(7, (Number(policy.staleDays) || 28) + Number(skillProfile.staleDaysDelta || 0));
    if (!record || typeof record !== 'object') {
        return {
            hasEvidence: false,
            totalAsked: 0,
            totalCorrect: 0,
            independentAsked: 0,
            independentCorrect: 0,
            independentAcc: 0,
            assistedAsked: 0,
            assistedCorrect: 0,
            assistedAcc: 0,
            maintainedSessions: 0,
            supportHeavy: false,
            missingIndependentEvidence: independentMin,
            missingMaintenanceSessions: maintenanceMin,
            independentReady: false,
            maintenanceReady: false,
            autonomyReady: false,
            freshnessReady: true,
            stale: false,
            daysWithoutPractice: 0,
            staleDaysLimit,
            sessionHistory: [],
            masteryThreshold: resolvedThreshold,
            skillProfile
        };
    }
    const totalAsked = Math.max(0, Number(record.totalAsked) || 0);
    const totalCorrect = Math.max(0, Number(record.totalCorrect) || 0);
    const independentAsked = Math.max(0, Number(record.independentAsked) || 0);
    const independentCorrect = Math.max(0, Number(record.independentCorrect) || 0);
    const assistedAsked = Math.max(0, Number(record.assistedAsked) || 0);
    const assistedCorrect = Math.max(0, Number(record.assistedCorrect) || 0);
    const independentAcc = independentAsked > 0 ? (independentCorrect / independentAsked) : 0;
    const assistedAcc = assistedAsked > 0 ? (assistedCorrect / assistedAsked) : 0;
    const sessionHistory = Array.isArray(record.sessionHistory) ? record.sessionHistory.slice(-10) : [];
    const maintainedSessions = sessionHistory.filter((session) => {
        const asked = Math.max(0, Number(session?.independentAsked) || 0);
        const correct = Math.max(0, Number(session?.independentCorrect) || 0);
        return asked >= 1 && (correct / Math.max(1, asked)) >= resolvedThreshold;
    }).length;
    const supportHeavy = assistedAsked > independentAsked && assistedAsked > 0;
    const lastEvidenceAt = Math.max(
        0,
        Number(record.lastSeenAt) || 0,
        ...sessionHistory.map((session) => Math.max(0, Number(session?.ts) || 0))
    );
    const daysWithoutPractice = lastEvidenceAt > 0 ? Math.floor((Date.now() - lastEvidenceAt) / 86400000) : 0;
    const stale = lastEvidenceAt > 0 && daysWithoutPractice >= staleDaysLimit;
    const missingIndependentEvidence = Math.max(0, independentMin - independentAsked);
    const missingMaintenanceSessions = Math.max(0, maintenanceMin - maintainedSessions);
    const independentReady = independentAsked >= independentMin && independentAcc >= resolvedThreshold;
    const maintenanceReady = maintainedSessions >= maintenanceMin;
    return {
        hasEvidence: totalAsked > 0,
        totalAsked,
        totalCorrect,
        independentAsked,
        independentCorrect,
        independentAcc,
        assistedAsked,
        assistedCorrect,
        assistedAcc,
        maintainedSessions,
        supportHeavy,
        missingIndependentEvidence,
        missingMaintenanceSessions,
        independentReady,
        maintenanceReady,
        autonomyReady: independentReady && maintenanceReady && !supportHeavy && !stale,
        freshnessReady: !stale,
        stale,
        daysWithoutPractice,
        staleDaysLimit,
        sessionHistory,
        masteryThreshold: resolvedThreshold,
        skillProfile
    };
}
function getBlockingErrorProfilesForStage(operation, stageLabel = '') {
    const label = normalizeTrailLabel(stageLabel);
    if (operation === 'multiplication') {
        return [
            { code: 'mult_as_sum', detail: 'continua tratando multiplicação como soma.', tokens: ['som'], anyOf: ['multiplica', 'tabuada', 'grupos'] },
            { code: 'mult_group_loss', detail: 'perde grupos ou fatores ao multiplicar.', tokens: ['fator', 'grupo'] }
        ];
    }
    if (operation === 'division') {
        return [
            { code: 'division_as_multiplication', detail: 'continua tratando divisão como multiplicação.', tokens: ['multiplic'] },
            { code: 'division_structure_confusion', detail: 'continua confundindo dividendo, divisor e quociente.', tokens: ['divisor', 'dividendo', 'quociente'] },
            { code: 'division_inverse_confusion', detail: 'a relação inversa multiplicação ÷ divisão ainda não está firme.', tokens: ['invers', 'relação'] }
        ];
    }
    if (operation === 'addition' && label.includes('reagrup')) {
        return [
            { code: 'addition_regrouping', detail: 'ainda não consolidou o reagrupamento.', tokens: ['reagrup', 'vai um'] },
            { code: 'addition_as_subtraction', detail: 'continua trocando soma por subtração.', tokens: ['subtra'] }
        ];
    }
    if (operation === 'subtraction' && (label.includes('reserva') || label.includes('emprest'))) {
        return [
            { code: 'subtraction_reserve', detail: 'ainda não consolidou a reserva/emprestimo.', tokens: ['reserva', 'emprest'] },
            { code: 'subtraction_as_addition', detail: 'continua trocando subtração por adição.', tokens: ['adi', 'soma'] }
        ];
    }
    if (operation === 'potenciacao') {
        return [
            { code: 'power_as_multiplication', detail: 'continua tratando potência como multiplicação simples.', tokens: ['multiplic'] },
            { code: 'power_as_sum', detail: 'continua tratando potência como soma da base com o expoente.', tokens: ['soma', 'expoente'] }
        ];
    }
    if (operation === 'radiciacao') {
        return [
            { code: 'root_as_half', detail: 'continua tratando raiz como metade do número.', tokens: ['metade', 'divid'] },
            { code: 'root_inverse_confusion', detail: 'a relação entre potência e raiz ainda está instável.', tokens: ['pot', 'quadrad', 'cub'] }
        ];
    }
    return [
        { code: 'recurring_typical_error', detail: 'o erro dominante ainda está recorrente.', tokens: [] }
    ];
}
function getBlockingTypicalErrorMeta(operation, stageLabel, record, context = {}) {
    const ranked = Object.entries((record && record.typicalErrors && typeof record.typicalErrors === 'object') ? record.typicalErrors : {})
        .sort((a, b) => Number(b[1] || 0) - Number(a[1] || 0));
    if (!ranked.length) return { isBlocking: false, label: '', count: 0, detail: '' };
    const topLabel = String(ranked[0][0] || '').trim();
    const topCount = Math.max(0, Number(ranked[0][1]) || 0);
    const safe = normalizeTrailLabel(topLabel);
    const profiles = getBlockingErrorProfilesForStage(operation, stageLabel);
    const matched = profiles.find((profile) => {
        const tokens = Array.isArray(profile.tokens) ? profile.tokens : [];
        const anyOf = Array.isArray(profile.anyOf) ? profile.anyOf : [];
        const tokenMatch = !tokens.length || tokens.some((token) => safe.includes(normalizeTrailLabel(token)));
        const anyMatch = !anyOf.length || anyOf.some((token) => safe.includes(normalizeTrailLabel(token)) || normalizeTrailLabel(stageLabel).includes(normalizeTrailLabel(token)));
        return tokenMatch && anyMatch;
    });
    const skillProfile = getPedagogySkillProfile(context.operation || operation, context.stageLabel || stageLabel, context.level || '');
    const minCount = Math.max(1, (Number(getPedagogyPolicyConfig().blockingErrorMinCount) || 2) + Number(skillProfile.blockingErrorDelta || 0));
    if (!matched || topCount < minCount) return { isBlocking: false, label: topLabel, count: topCount, detail: '' };
    return {
        isBlocking: true,
        code: matched.code,
        label: topLabel,
        count: topCount,
        detail: matched.detail
    };
}
function getStagePrerequisiteGate(operation, level, stages, stageIndex, stageLabel) {
    const prerequisite = getSkillPrerequisiteInfo(operation, stageLabel);
    const prereqIdx = findPrerequisiteStageIndex(operation, stages, stageLabel);
    if (!Array.isArray(stages) || prereqIdx < 0 || prereqIdx >= Math.max(0, Number(stageIndex) || 0)) {
        return {
            required: false,
            ok: true,
            prerequisiteLabel: prerequisite.label,
            prerequisiteIndex: prereqIdx,
            detail: ''
        };
    }
    const policy = getPedagogyPolicyConfig();
    const skillProfile = getPedagogySkillProfile(operation, stageLabel, level);
    const prereqThreshold = Math.max(0.55, Math.min(0.95, Number(policy.prereqThreshold || 0.75) + Number(skillProfile.prereqThresholdDelta || 0)));
    const prereqAskedMin = Math.max(1, (Number(policy.prereqAskedMin) || 3) + Number(skillProfile.prereqAskedDelta || 0));
    const prereqRecord = getOperationSkillReviewRecord(operation, level, prereqIdx);
    const evidence = getStageEvidenceProfile(prereqRecord, prereqThreshold, { operation, stageLabel: String(stages[prereqIdx]?.label || prerequisite.label || ''), level });
    const minimumAsked = prereqAskedMin;
    const ok = evidence.independentAsked >= minimumAsked && evidence.independentAcc >= prereqThreshold && !evidence.stale;
    const prereqLabel = String(stages[prereqIdx]?.label || prerequisite.label || 'Base anterior').trim();
    let detail = '';
    if (!ok) {
        if (evidence.stale) detail = `${prereqLabel} precisa de revisão: passou ${evidence.daysWithoutPractice} dia(s) sem prática.`;
        else detail = `${prereqLabel} ainda não mostrou domínio mínimo independente.`;
    }
    return {
        required: true,
        ok,
        prerequisiteLabel: prereqLabel,
        prerequisiteIndex: prereqIdx,
        detail
    };
}
function buildLevelGateMissingText({ evidence = null, blocking = null, prereqGate = null } = {}) {
    const parts = [];
    if (evidence) {
        if (evidence.missingIndependentEvidence > 0) parts.push(`faltam ${evidence.missingIndependentEvidence} evidência(s) independentes`);
        if (evidence.independentAsked > 0 && evidence.independentAcc < Number(evidence.masteryThreshold || 0.8)) parts.push(`precisão independente ainda está em ${Math.round(evidence.independentAcc * 100)}%`);
        if (evidence.missingMaintenanceSessions > 0) parts.push(`falta confirmar em ${evidence.missingMaintenanceSessions} sessão(ões)`);
        if (evidence.supportHeavy) parts.push('o apoio ainda pesa mais que a autonomia');
        if (evidence.stale) parts.push(`revisão necessária após ${evidence.daysWithoutPractice} dia(s) sem prática`);
    }
    if (prereqGate && prereqGate.required && !prereqGate.ok) parts.push(`pré-requisito ${prereqGate.prerequisiteLabel} ainda não está consolidado`);
    if (blocking && blocking.isBlocking) parts.push(`erro dominante ainda bloqueia: ${blocking.label}`);
    return parts.join('; ');
}
function buildTeacherInterventionPlan({ operation = '', level = '', stageIndex = 0, stageLabel = '', record = null, studentNames = [] } = {}) {
    const prerequisite = getSkillPrerequisiteInfo(operation, stageLabel);
    const traffic = getPedagogicalTrafficLight(record);
    const stability = getSkillStabilityMeta(record);
    const commonError = getMostCommonTypicalError(record) || 'Sem erro típico dominante ainda.';
    const parts = [];
    if (traffic.code === 'red') parts.push('Aplicar 1 rodada guiada imediatamente.');
    else if (traffic.code === 'yellow') parts.push('Aplicar 1 retomada curta antes de acelerar.');
    else parts.push('Manter uma revisão curta para fixar o domínio.');
    parts.push(prerequisite.action);
    if (prerequisite.avoidRapid) parts.push('Evitar Modo Rápido nesta habilidade até estabilizar.');
    if (stability.code === 'drop') parts.push('O domínio caiu: revisar essa habilidade por 2 sessões curtas.');
    const who = Array.isArray(studentNames) && studentNames.length ? `Aluno(s): ${studentNames.join(', ')}.` : '';
    return {
        prerequisite: prerequisite.label,
        commonError,
        stability: stability.label,
        traffic: traffic.label,
        planText: `${who} ${parts.join(' ')}`.trim()
    };
}
function getTeacherRetakeErrorFocus({ code = '', label = '', operation = '', stageLabel = '' } = {}) {
    const safeCode = String(code || '').trim().toLowerCase();
    const safeLabel = String(label || '').trim();
    const normalizedStage = normalizeTrailLabel(stageLabel);
    const base = {
        diagnosis: safeLabel || 'Erro recorrente sem rótulo claro.',
        teacherMove: 'Reveja a regra com contraste entre exemplo certo e exemplo errado.',
        studentMove: 'Peça ao aluno para explicar a regra antes de responder e corrigir 2 itens semelhantes.',
        checkpoint: 'Fechar 4 itens seguidos sem repetir o mesmo padrão de erro.'
    };
    if (!safeCode) return base;
    if (safeCode.includes('addition_as_subtraction')) {
        return {
            diagnosis: safeLabel || 'Tratou adição como subtração.',
            teacherMove: 'Contraste + e − com pares mínimos do mesmo enunciado e destaque o sinal antes da conta.',
            studentMove: 'Resolver 4 contas dizendo em voz alta “somar junta, subtrair tira” antes de calcular.',
            checkpoint: 'Acertar 4 adições seguidas sem trocar o sinal.'
        };
    }
    if (safeCode.includes('subtraction_as_addition')) {
        return {
            diagnosis: safeLabel || 'Tratou subtração como adição.',
            teacherMove: 'Retome a ideia de tirar/comparar e contraste duas contas quase iguais mudando só o sinal.',
            studentMove: 'Resolver 4 subtrações explicando quem perde quantidade e qual número diminui.',
            checkpoint: 'Acertar 4 subtrações seguidas sem somar os termos.'
        };
    }
    if (safeCode.includes('addition_no_carry') || safeCode.includes('addition_place_value') || safeCode.includes('addition_stopped_partial_sum')) {
        return {
            diagnosis: safeLabel || 'Falha em valor posicional ou reagrupamento na adição.',
            teacherMove: 'Volte para dezenas/unidades e faça a troca de 10 unidades por 1 dezena de forma explícita.',
            studentMove: 'Montar 3 contas com material desenhado ou quadro de valor posicional antes do algoritmo.',
            checkpoint: 'Acertar 3 adições com reagrupamento explicando onde entrou o “vai um”.'
        };
    }
    if (safeCode.includes('subtraction_no_borrow') || safeCode.includes('subtraction_place_value')) {
        return {
            diagnosis: safeLabel || 'Falha em reserva/empréstimo na subtração.',
            teacherMove: 'Retome o empréstimo pelo valor posicional e mostre por que uma dezena vira 10 unidades.',
            studentMove: 'Resolver 3 subtrações com quadro posicional, marcando a troca antes de subtrair.',
            checkpoint: 'Acertar 3 subtrações com reserva sem pular a troca de dezena.'
        };
    }
    if (safeCode.includes('multiplication_as_addition') || safeCode.includes('multiplication_sum_instead_product') || safeCode.includes('multiplication_simple_sum') || safeCode.includes('multiplication_added_word_problem')) {
        return {
            diagnosis: safeLabel || 'Somou os fatores em vez de formar grupos iguais.',
            teacherMove: 'Volte para grupos iguais e soma repetida antes de cobrar tabuada automática.',
            studentMove: 'Desenhar ou falar 3 situações de grupos iguais e escrever a soma repetida antes do produto.',
            checkpoint: 'Acertar 4 multiplicações justificando cada uma com grupos iguais ou soma repetida.'
        };
    }
    if (safeCode.includes('multiplication_skip') || safeCode.includes('multiplication_extra_group') || safeCode.includes('multiplication_missed_one_group') || safeCode.includes('multiplication_factor_shift') || safeCode.includes('multiplication_extra_repetition') || safeCode.includes('multiplication_missing_repetition')) {
        return {
            diagnosis: safeLabel || 'Perdeu ou acrescentou grupo/fator na multiplicação.',
            teacherMove: 'Trabalhe contagem em saltos e conferência da quantidade de grupos antes do cálculo final.',
            studentMove: 'Resolver 4 itens marcando quantos grupos existem e qual número se repete.',
            checkpoint: 'Fechar 4 itens sem perder nem acrescentar grupo.'
        };
    }
    if (safeCode.includes('division_as_multiplication') || safeCode.includes('division_as_subtraction')) {
        return {
            diagnosis: safeLabel || 'Aplicou a operação errada na divisão.',
            teacherMove: 'Retome a pergunta da divisão: quantos grupos cabem ou quanto fica em cada grupo.',
            studentMove: 'Resolver 4 divisões e validar cada resposta pela multiplicação inversa.',
            checkpoint: 'Acertar 4 divisões consecutivas validando com a operação inversa.'
        };
    }
    if (safeCode.includes('division_used_dividend') || safeCode.includes('division_used_divisor') || safeCode.includes('division_missing_dividend') || safeCode.includes('division_missing_divisor') || safeCode.includes('division_remainder')) {
        return {
            diagnosis: safeLabel || 'Confundiu os papéis de dividendo, divisor, quociente ou resto.',
            teacherMove: 'Reforce a leitura estrutural da divisão nomeando cada termo antes de calcular.',
            studentMove: 'Em 4 itens, identificar primeiro dividendo/divisor/quociente e só depois resolver.',
            checkpoint: 'Nomear corretamente os termos e acertar 3 divisões sem trocar papéis.'
        };
    }
    if (safeCode.includes('power_as_multiplication') || safeCode.includes('power_as_sum') || safeCode.includes('power_exponent')) {
        return {
            diagnosis: safeLabel || 'Confundiu potência com operação simples sobre base e expoente.',
            teacherMove: 'Reescreva a potência como multiplicação repetida e contraste com base×expoente e base+expoente.',
            studentMove: 'Transformar 4 potências em produto repetido antes de resolver.',
            checkpoint: 'Acertar 4 potências seguidas sem usar base×expoente ou base+expoente.'
        };
    }
    if (safeCode.includes('root_as_half') || safeCode.includes('square_root_as_half') || safeCode.includes('square_root_as_square') || safeCode.includes('square_root_doubled') || safeCode.includes('root_used_radicand') || safeCode.includes('root_estimation_neighbor') || safeCode.includes('square_root_neighbor') || safeCode.includes('cube_root')) {
        const cubic = safeCode.includes('cube_root') || normalizedStage.includes('cubica') || normalizedStage.includes('cúbica');
        return {
            diagnosis: safeLabel || (cubic ? 'Confundiu raiz cúbica com outra regra.' : 'Confundiu raiz quadrada com outra regra.'),
            teacherMove: cubic
                ? 'Liste cubos perfeitos próximos e faça a ponte explícita entre potência de expoente 3 e raiz cúbica.'
                : 'Liste quadrados perfeitos próximos e faça a ponte explícita entre elevar ao quadrado e extrair a raiz.',
            studentMove: cubic
                ? 'Completar 4 pares do tipo 2³↔∛8, 3³↔∛27 antes de resolver novos itens.'
                : 'Completar 4 pares do tipo 4²↔√16, 7²↔√49 antes de resolver novos itens.',
            checkpoint: cubic
                ? 'Acertar 3 raízes cúbicas ligando cada uma ao cubo perfeito correspondente.'
                : 'Acertar 4 raízes quadradas ligando cada uma ao quadrado perfeito correspondente.'
        };
    }
    return base;
}
function buildTeacherStudentRetakeSequence(row = {}) {
    try {
        const studentName = String(row?.studentName || 'Aluno').trim() || 'Aluno';
        const skillLabel = String(row?.highestError || row?.stageLabel || row?.latestSkill || 'habilidade atual').trim() || 'habilidade atual';
        const operation = String(row?.operation || '').trim();
        const stageLabel = String(row?.stageLabel || skillLabel).trim();
        const prerequisite = String(row?.intervention?.prerequisite || 'Base anterior da própria habilidade').trim() || 'Base anterior da própria habilidade';
        const latestAccuracy = Number(row?.latestAccuracy);
        const targetAccuracy = Number.isFinite(latestAccuracy) ? (latestAccuracy < 60 ? 70 : 80) : 80;
        const focus = getTeacherRetakeErrorFocus({
            code: row?.dominantDistractorCode,
            label: row?.dominantDistractorLabel,
            operation,
            stageLabel
        });
        const rapidBlock = row?.intervention?.planText && String(row.intervention.planText).includes('Evitar Modo Rápido')
            ? ' Não liberar Modo Rápido nesta habilidade agora.'
            : '';
        const steps = [
            {
                title: 'Passo 1 — Reativar a base',
                text: `Retomar ${prerequisite}. Faça 1 rodada curta e guiada, sem tempo, com 3 a 5 itens e verbalização da regra.`
            },
            {
                title: 'Passo 2 — Atacar o erro dominante',
                text: `${focus.teacherMove} ${focus.studentMove}`
            },
            {
                title: 'Passo 3 — Reentrada controlada na habilidade',
                text: `Voltar para ${skillLabel} no Modo Estudo com 1 rodada curta. Critério de saída: atingir pelo menos ${targetAccuracy}% e ${focus.checkpoint.toLowerCase()}${rapidBlock}`
            }
        ];
        const success = `Meta imediata para ${studentName}: reduzir a repetição de “${focus.diagnosis}” e estabilizar ${skillLabel}.`;
        return {
            title: `Retomada de 3 passos — ${studentName}`,
            goal: success,
            diagnosis: focus.diagnosis,
            steps,
            note: `Base sugerida: ${prerequisite}. Habilidade-alvo: ${skillLabel}.`
        };
    } catch (_) {
        return {
            title: 'Retomada de 3 passos',
            goal: 'Não foi possível montar a retomada automática.',
            diagnosis: 'Sem diagnóstico suficiente.',
            steps: [],
            note: ''
        };
    }
}
function renderTeacherStudentRetakePlan(container, row) {
    try {
        if (!container) return;
        if (!row) {
            container.innerHTML = '<div class="tp-empty">Selecione um aluno em foco para montar a retomada.</div>';
            return;
        }
        const plan = buildTeacherStudentRetakeSequence(row);
        container.innerHTML = '';
        const title = document.createElement('div');
        title.className = 'tp-student-retake-title';
        title.textContent = plan.title || 'Retomada de 3 passos';
        container.appendChild(title);
        const goal = document.createElement('div');
        goal.className = 'tp-student-retake-goal';
        goal.textContent = plan.goal || 'Sem meta automática.';
        container.appendChild(goal);
        const diagnosis = document.createElement('div');
        diagnosis.className = 'tp-student-retake-diagnosis';
        diagnosis.textContent = `Erro-alvo: ${plan.diagnosis || 'Sem diagnóstico suficiente.'}`;
        container.appendChild(diagnosis);
        const list = document.createElement('div');
        list.className = 'tp-student-retake-list';
        (Array.isArray(plan.steps) ? plan.steps : []).forEach((step) => {
            const item = document.createElement('div');
            item.className = 'tp-student-retake-step';
            const st = document.createElement('div');
            st.className = 'tp-student-retake-step-title';
            st.textContent = step.title || 'Passo';
            const tx = document.createElement('div');
            tx.className = 'tp-student-retake-step-text';
            tx.textContent = step.text || '';
            item.appendChild(st);
            item.appendChild(tx);
            list.appendChild(item);
        });
        container.appendChild(list);
        if (plan.note) {
            const note = document.createElement('div');
            note.className = 'tp-student-retake-note';
            note.textContent = plan.note;
            container.appendChild(note);
        }
    } catch (_) {
        try {
            if (container) container.innerHTML = '<div class="tp-empty">Não foi possível montar a retomada automática.</div>';
        } catch (_) {}
    }
}
function buildTeacherStudentRetakeClipboardText(row, plan) {
    try {
        const safePlan = plan || buildTeacherStudentRetakeSequence(row || {});
        const studentName = String(row?.studentName || 'Aluno').trim() || 'Aluno';
        const turma = String(row?.turma || '—').trim() || '—';
        const sessions = Math.max(0, Number(row?.sessions) || 0);
        const errors = Math.max(0, Number(row?.distractorTotal) || 0);
        const highestError = String(row?.highestError || '—').trim() || '—';
        const dominantDistractor = String(row?.dominantDistractorFormatted || row?.dominantTypicalError || '—').trim() || '—';
        const lines = [
            `${safePlan.title || 'Retomada de 3 passos'}`,
            `Aluno: ${studentName}`,
            `Turma: ${turma}`,
            `Sessões no filtro: ${sessions}`,
            `Erros diagnosticados: ${errors}`,
            `Habilidade mais afetada: ${highestError}`,
            `Distrator dominante: ${dominantDistractor}`,
            `Meta imediata: ${safePlan.goal || 'Sem meta automática.'}`,
            `Erro-alvo: ${safePlan.diagnosis || 'Sem diagnóstico suficiente.'}`
        ];
        const steps = Array.isArray(safePlan.steps) ? safePlan.steps : [];
        steps.forEach((step, index) => {
            const title = String(step?.title || `Passo ${index + 1}`).trim() || `Passo ${index + 1}`;
            const text = String(step?.text || '').trim();
            lines.push(`${title}: ${text}`);
        });
        if (safePlan.note) lines.push(`Observação: ${safePlan.note}`);
        return lines.join('\n');
    } catch (_) {
        return 'Não foi possível montar o plano de retomada para copiar.';
    }
}
function buildTeacherStudentRetakeFilename(row) {
    const today = typeof petDateKeyLocal === 'function' ? petDateKeyLocal() : new Date().toISOString().slice(0, 10);
    const safe = (value, fallback) => String(value || fallback || 'item')
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-zA-Z0-9_-]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '')
        .toLowerCase() || String(fallback || 'item');
    const turmaTag = safe(row?.turma || 'sem-turma', 'sem-turma');
    const alunoTag = safe(row?.studentName || 'aluno', 'aluno');
    return `PET_foco_individual_${today}_turma-${turmaTag}_aluno-${alunoTag}.txt`;
}
function buildTeacherStudentRetakeCsvFilename(row) {
    const today = typeof petDateKeyLocal === 'function' ? petDateKeyLocal() : new Date().toISOString().slice(0, 10);
    const safe = (value, fallback) => String(value || fallback || 'item')
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[^a-zA-Z0-9_-]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '')
        .toLowerCase() || String(fallback || 'item');
    const turmaTag = safe(row?.turma || 'sem-turma', 'sem-turma');
    const alunoTag = safe(row?.studentName || 'aluno', 'aluno');
    return `PET_foco_individual_${today}_turma-${turmaTag}_aluno-${alunoTag}.csv`;
}
function buildTeacherStudentRetakeCsvText(row, plan) {
    try {
        const safeRow = row || {};
        const safePlan = plan || buildTeacherStudentRetakeSequence(safeRow);
        const steps = Array.isArray(safePlan.steps) ? safePlan.steps : [];
        const step1 = steps[0] || {};
        const step2 = steps[1] || {};
        const step3 = steps[2] || {};
        const top3 = Array.isArray(safeRow.topDistractors)
            ? safeRow.topDistractors.slice(0, 3).map((it) => String(it?.formatted || '').trim()).filter(Boolean).join(' • ')
            : '';
        const latestAccuracyValue = Number(safeRow?.latestAccuracy);
        const latestAccuracyText = Number.isFinite(latestAccuracyValue) ? numBR(latestAccuracyValue, 1) : '';
        const latestEndedAtText = Number(safeRow?.latestEndedAt) > 0 ? formatDateBRFromTs(safeRow.latestEndedAt) : '';
        const line = [
            safePlan.title || 'Retomada de 3 passos',
            safeRow?.studentName || 'Aluno',
            safeRow?.turma || '',
            String(Math.max(0, Number(safeRow?.sessions) || 0)),
            String(Math.max(0, Number(safeRow?.distractorTotal) || 0)),
            safeRow?.highestError || '',
            safeRow?.latestSkill || '',
            safeRow?.lastMastered || '',
            safeRow?.dominantTypicalError || '',
            safeRow?.dominantErrorDimension || '',
            safeRow?.dominantDistractorCode || '',
            safeRow?.dominantDistractorLabel || '',
            safeRow?.dominantDistractorFormatted || '',
            String(Math.max(0, Number(safeRow?.topDistractorCount) || 0)),
            top3,
            safeRow?.operation || '',
            safeRow?.level || '',
            safeRow?.stageLabel || '',
            latestAccuracyText,
            safeRow?.stabilitySummary || '',
            safeRow?.intervention?.prerequisite || '',
            safeRow?.intervention?.commonError || '',
            safeRow?.intervention?.planText || '',
            safePlan.goal || '',
            safePlan.diagnosis || '',
            step1?.title || '',
            step1?.text || '',
            step2?.title || '',
            step2?.text || '',
            step3?.title || '',
            step3?.text || '',
            safePlan.note || '',
            safeRow?.focusKey || '',
            safeRow?.hasUnnamedProfile ? 'sim' : 'nao',
            latestEndedAtText
        ].map(csvEscape).join(';');
        return [
            'titulo_foco;aluno;turma;sessoes_filtro;erros_diagnosticados;habilidade_mais_afetada;habilidade_atual;ultima_habilidade_dominada;erro_tipico_dominante;dimensao_erro_dominante;codigo_distrator_dominante;rotulo_distrator_dominante;distrator_dominante;contagem_distrator_dominante;top3_distratores;operacao;nivel;etapa;ultima_precisao_pct;estabilidade;base_a_retomar;erro_comum;plano_individual;meta_imediata;erro_alvo;passo1_titulo;passo1_texto;passo2_titulo;passo2_texto;passo3_titulo;passo3_texto;observacao;foco_aluno;perfil_sem_nome;ultima_sessao_data',
            line
        ].join('\n');
    } catch (_) {
        return 'titulo_foco;aluno;turma;sessoes_filtro;erros_diagnosticados;habilidade_mais_afetada;habilidade_atual;ultima_habilidade_dominada;erro_tipico_dominante;dimensao_erro_dominante;codigo_distrator_dominante;rotulo_distrator_dominante;distrator_dominante;contagem_distrator_dominante;top3_distratores;operacao;nivel;etapa;ultima_precisao_pct;estabilidade;base_a_retomar;erro_comum;plano_individual;meta_imediata;erro_alvo;passo1_titulo;passo1_texto;passo2_titulo;passo2_texto;passo3_titulo;passo3_texto;observacao;foco_aluno;perfil_sem_nome;ultima_sessao_data\nRetomada de 3 passos;Não foi possível montar o CSV do foco individual.;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;';
    }
}
async function copyTeacherStudentRetakeText(row) {
    const plan = buildTeacherStudentRetakeSequence(row || {});
    const payload = buildTeacherStudentRetakeClipboardText(row || {}, plan);
    try {
        await navigator.clipboard.writeText(payload);
        try { showFeedbackMessage('Plano de retomada copiado.', 'success'); } catch (_) {}
    } catch (_) {
        window.prompt('Copie o plano abaixo:', payload);
    }
    return payload;
}
function downloadTeacherStudentRetakeText(row) {
    const plan = buildTeacherStudentRetakeSequence(row || {});
    const payload = buildTeacherStudentRetakeClipboardText(row || {}, plan);
    const filename = buildTeacherStudentRetakeFilename(row || {});
    downloadTextFile(filename, payload, 'text/plain;charset=utf-8');
    try { showFeedbackMessage('Foco individual baixado em .txt.', 'success'); } catch (_) {}
    return payload;
}
function downloadTeacherStudentRetakeCsv(row) {
    const plan = buildTeacherStudentRetakeSequence(row || {});
    const payload = buildTeacherStudentRetakeCsvText(row || {}, plan);
    const filename = buildTeacherStudentRetakeCsvFilename(row || {});
    downloadTextFile(filename, payload, 'text/csv;charset=utf-8');
    try { showFeedbackMessage('Foco individual baixado em .csv.', 'success'); } catch (_) {}
    return payload;
}
function buildTeacherClassBlockFocusClipboardText(plan, focusGroupKey) {
    try {
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        const resolvedGroup = groups.find((group) => String(group?.groupKey || '') === String(focusGroupKey || '').trim());
        if (!resolvedGroup) return 'Não foi possível montar o foco coletivo do bloco para copiar.';
        const lines = [
            'Foco coletivo do bloco',
            `Turma: ${resolvedGroup.turma || '—'}`,
            `Bloco: ${resolvedGroup.formatted || '—'}`,
            `Alunos no bloco: ${Math.max(0, Number(resolvedGroup.studentCount) || 0)}`,
            `Sessões no filtro: ${Math.max(0, Number(resolvedGroup.sessions) || 0)}`,
            `Erros diagnosticados: ${Math.max(0, Number(resolvedGroup.errors) || 0)}`,
            `Habilidade predominante: ${resolvedGroup.topSkill || '—'}`,
            `Erro dominante: ${resolvedGroup.diagnosis || resolvedGroup.formatted || '—'}`,
            `Base a retomar: ${resolvedGroup.prerequisite || 'Base anterior da própria habilidade'}`,
            `Critério de saída: ${resolvedGroup.checkpoint || 'Rever com segurança antes de avançar.'}`,
            `Intervenção coletiva curta: ${String(`${resolvedGroup.teacherMove || 'Modelar a regra correta.'} ${resolvedGroup.studentMove || ''}`).trim()}`,
            `Alunos: ${(Array.isArray(resolvedGroup.students) ? resolvedGroup.students : []).join(', ') || '—'}`
        ];
        if (safePlan.note) lines.push(`Observação: ${safePlan.note}`);
        return lines.join('\n');
    } catch (_) {
        return 'Não foi possível montar o foco coletivo do bloco para copiar.';
    }
}
function buildTeacherClassBlockFocusFilename(plan, focusGroupKey) {
    try {
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        const resolvedGroup = groups.find((group) => String(group?.groupKey || '') === String(focusGroupKey || '').trim());
        const today = typeof petDateKeyLocal === 'function' ? petDateKeyLocal() : new Date().toISOString().slice(0, 10);
        const safe = (value, fallback) => String(value || fallback || 'item')
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .replace(/[^a-zA-Z0-9_-]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '')
            .toLowerCase() || String(fallback || 'item');
        const turmaTag = safe(resolvedGroup?.turma || 'sem-turma', 'sem-turma');
        const blocoTag = safe(resolvedGroup?.code || resolvedGroup?.formatted || 'bloco', 'bloco');
        return `PET_foco_bloco_${today}_turma-${turmaTag}_bloco-${blocoTag}.txt`;
    } catch (_) {
        const today = typeof petDateKeyLocal === 'function' ? petDateKeyLocal() : new Date().toISOString().slice(0, 10);
        return `PET_foco_bloco_${today}.txt`;
    }
}
function downloadTeacherClassBlockFocusText(plan, focusGroupKey) {
    const payload = buildTeacherClassBlockFocusClipboardText(plan, focusGroupKey);
    const filename = buildTeacherClassBlockFocusFilename(plan, focusGroupKey);
    downloadTextFile(filename, payload, 'text/plain;charset=utf-8');
    try { showFeedbackMessage('Foco do bloco baixado em .txt.', 'success'); } catch (_) {}
    return payload;
}
function renderTeacherClassBlockFocus(container, plan, focusGroupKey) {
    try {
        if (!container) return;
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        const resolvedGroup = groups.find((group) => String(group?.groupKey || '') === String(focusGroupKey || '').trim());
        container.innerHTML = '';
        if (!resolvedGroup) {
            container.innerHTML = '<div class="tp-empty">Use “Focar este bloco” para abrir um resumo coletivo do grupo.</div>';
            return;
        }
        const title = document.createElement('div');
        title.className = 'tp-student-focus-title';
        title.textContent = 'Foco coletivo do bloco';
        const meta = document.createElement('div');
        meta.className = 'tp-student-focus-meta';
        meta.textContent = `${resolvedGroup.turma} • ${resolvedGroup.studentCount} aluno(s) • Sessões: ${resolvedGroup.sessions} • Erros diagnosticados: ${resolvedGroup.errors}`;
        const header = document.createElement('div');
        header.className = 'tp-student-focus-header';
        header.appendChild(title);
        header.appendChild(meta);
        container.appendChild(header);
        const warning = document.createElement('div');
        warning.className = 'tp-student-focus-warning';
        warning.textContent = `Bloco em foco: ${resolvedGroup.formatted}`;
        container.appendChild(warning);
        const grid = document.createElement('div');
        grid.className = 'tp-student-focus-grid';
        const cards = [
            ['Habilidade predominante', resolvedGroup.topSkill || '—'],
            ['Erro dominante', resolvedGroup.diagnosis || resolvedGroup.formatted || '—'],
            ['Base a retomar', resolvedGroup.prerequisite || 'Base anterior da própria habilidade'],
            ['Critério de saída', resolvedGroup.checkpoint || 'Rever com segurança antes de avançar.']
        ];
        cards.forEach(([label, value]) => {
            const card = document.createElement('div');
            card.className = 'tp-student-focus-card';
            const labelEl = document.createElement('div');
            labelEl.className = 'tp-student-focus-label';
            labelEl.textContent = label;
            const valueEl = document.createElement('div');
            valueEl.className = 'tp-student-focus-value';
            valueEl.textContent = value;
            card.appendChild(labelEl);
            card.appendChild(valueEl);
            grid.appendChild(card);
        });
        container.appendChild(grid);
        const planEl = document.createElement('div');
        planEl.className = 'tp-student-focus-plan';
        planEl.innerHTML = `<strong>Intervenção coletiva curta:</strong> ${resolvedGroup.teacherMove || 'Modelar a regra correta.'} ${resolvedGroup.studentMove || ''}`.trim();
        container.appendChild(planEl);
        const actions = document.createElement('div');
        actions.className = 'tp-student-retake-actions';
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'btn-secondary tp-retake-btn';
        copyBtn.textContent = 'Copiar foco deste bloco';
        copyBtn.addEventListener('click', async () => {
            try {
                const payload = buildTeacherClassBlockFocusClipboardText(safePlan, resolvedGroup.groupKey);
                try {
                    await navigator.clipboard.writeText(payload);
                    try { showFeedbackMessage('Foco coletivo do bloco copiado.', 'success'); } catch (_) {}
                } catch (_) {
                    window.prompt('Copie o foco deste bloco abaixo:', payload);
                }
            } catch (_) {
                try { showFeedbackMessage('Não foi possível copiar o foco deste bloco.', 'error'); } catch (_) {}
            }
        });
        const downloadBtn = document.createElement('button');
        downloadBtn.type = 'button';
        downloadBtn.className = 'btn-secondary tp-retake-btn';
        downloadBtn.textContent = 'Baixar foco deste bloco';
        downloadBtn.addEventListener('click', () => {
            try {
                downloadTeacherClassBlockFocusText(safePlan, resolvedGroup.groupKey);
            } catch (_) {
                try { showFeedbackMessage('Não foi possível baixar o foco deste bloco.', 'error'); } catch (_) {}
            }
        });
        actions.appendChild(copyBtn);
        actions.appendChild(downloadBtn);
        container.appendChild(actions);
        const note = document.createElement('div');
        note.className = 'tp-student-retake-note';
        note.textContent = `Alunos do bloco: ${(Array.isArray(resolvedGroup.students) ? resolvedGroup.students : []).join(', ') || '—'}`;
        container.appendChild(note);
    } catch (_) {
        try {
            if (container) container.innerHTML = '<div class="tp-empty">Não foi possível montar o foco coletivo do bloco.</div>';
        } catch (_) {}
    }
}
function buildTeacherClassRetakePlan(rows = []) {
    try {
        const safeRows = Array.isArray(rows) ? rows.filter(Boolean) : [];
        if (!safeRows.length) {
            return {
                title: 'Plano de retomada da turma',
                summary: 'Sem dados suficientes neste filtro.',
                groups: [],
                note: 'Use o filtro do painel para selecionar uma turma ou um conjunto de alunos com histórico salvo.'
            };
        }
        const groupsMap = new Map();
        safeRows.forEach((row) => {
            const turma = String(row?.turma || 'Sem turma').trim() || 'Sem turma';
            const code = String(row?.dominantDistractorCode || '').trim();
            const formatted = String(row?.dominantDistractorFormatted || row?.dominantTypicalError || 'Sem erro dominante claro').trim() || 'Sem erro dominante claro';
            const label = String(row?.dominantDistractorLabel || row?.dominantTypicalError || formatted).trim() || formatted;
            const bucketKey = `${turma}::${code || formatted}`;
            if (!groupsMap.has(bucketKey)) {
                groupsMap.set(bucketKey, {
                    turma,
                    code,
                    formatted,
                    label,
                    students: [],
                    errors: 0,
                    sessions: 0,
                    skillHistogram: {},
                    representative: row,
                    rows: []
                });
            }
            const g = groupsMap.get(bucketKey);
            g.rows.push(row);
            g.students.push(String(row?.studentName || 'Sem nome no perfil').trim() || 'Sem nome no perfil');
            g.errors += Math.max(0, Number(row?.distractorTotal) || 0);
            g.sessions += Math.max(0, Number(row?.sessions) || 0);
            const skill = String(row?.highestError || row?.dominantSkill || row?.latestSkill || 'Habilidade atual').trim() || 'Habilidade atual';
            g.skillHistogram[skill] = Math.max(0, Number(g.skillHistogram[skill]) || 0) + Math.max(1, Number(row?.distractorTotal) || 0);
            const repErrors = Math.max(0, Number(g.representative?.distractorTotal) || 0);
            const curErrors = Math.max(0, Number(row?.distractorTotal) || 0);
            if (curErrors > repErrors) g.representative = row;
        });
        const groups = Array.from(groupsMap.values()).map((g) => {
            const topSkill = Object.entries(g.skillHistogram).sort((a, b) => {
                const diff = (Number(b[1]) || 0) - (Number(a[1]) || 0);
                if (diff !== 0) return diff;
                return String(a[0] || '').localeCompare(String(b[0] || ''), 'pt-BR');
            })[0]?.[0] || 'Habilidade atual';
            const rep = g.representative || {};
            const focus = getTeacherRetakeErrorFocus({
                code: g.code,
                label: g.label,
                operation: String(rep?.operation || '').trim(),
                stageLabel: String(rep?.stageLabel || topSkill).trim()
            });
            const prerequisite = String(rep?.intervention?.prerequisite || 'Base anterior da própria habilidade').trim() || 'Base anterior da própria habilidade';
            const uniqStudents = Array.from(new Set(g.students)).sort((a, b) => a.localeCompare(b, 'pt-BR'));
            const memberRows = (Array.isArray(g.rows) ? g.rows : []).map((row) => ({
                focusKey: String(row?.focusKey || '').trim(),
                studentName: String(row?.studentName || 'Sem nome no perfil').trim() || 'Sem nome no perfil',
                turma: String(row?.turma || g.turma || 'Sem turma').trim() || 'Sem turma',
                sessions: Math.max(0, Number(row?.sessions) || 0),
                distractorTotal: Math.max(0, Number(row?.distractorTotal) || 0),
                dominantSkill: String(row?.dominantSkill || '').trim(),
                highestError: String(row?.highestError || '').trim(),
                dominantTypicalError: String(row?.dominantTypicalError || '').trim(),
                dominantErrorDimension: String(row?.dominantErrorDimension || '').trim(),
                dominantDistractorCode: String(row?.dominantDistractorCode || '').trim(),
                dominantDistractorLabel: String(row?.dominantDistractorLabel || '').trim(),
                dominantDistractorFormatted: String(row?.dominantDistractorFormatted || '').trim(),
                topDistractorCount: Math.max(0, Number(row?.topDistractorCount) || 0),
                latestSkill: String(row?.latestSkill || '').trim(),
                lastMastered: String(row?.lastMastered || '').trim(),
                stabilitySummary: String(row?.stabilitySummary || '').trim(),
                operation: String(row?.operation || '').trim(),
                level: String(row?.level || '').trim(),
                stageLabel: String(row?.stageLabel || '').trim(),
                latestAccuracy: Number(row?.latestAccuracy),
                interventionPrerequisite: String(row?.intervention?.prerequisite || '').trim(),
                interventionCommonError: String(row?.intervention?.commonError || '').trim(),
                interventionPlanText: String(row?.intervention?.planText || '').trim()
            })).sort((a, b) => {
                const diff = (Number(b.distractorTotal) || 0) - (Number(a.distractorTotal) || 0);
                if (diff !== 0) return diff;
                return String(a.studentName || '').localeCompare(String(b.studentName || ''), 'pt-BR');
            });
            return {
                groupKey: `${g.turma}::${g.code || g.formatted}`,
                turma: g.turma,
                code: g.code,
                formatted: g.formatted,
                diagnosis: focus.diagnosis,
                topSkill,
                prerequisite,
                teacherMove: focus.teacherMove,
                studentMove: focus.studentMove,
                checkpoint: focus.checkpoint,
                students: uniqStudents,
                studentCount: uniqStudents.length,
                errors: g.errors,
                sessions: g.sessions,
                memberRows
            };
        }).sort((a, b) => {
            const diff = (Number(b.errors) || 0) - (Number(a.errors) || 0);
            if (diff !== 0) return diff;
            return String(a.turma || '').localeCompare(String(b.turma || ''), 'pt-BR');
        });
        const turmaSet = Array.from(new Set(groups.map((g) => g.turma))).filter(Boolean);
        const totalStudents = safeRows.length;
        const totalGroups = groups.length;
        return {
            title: 'Plano de retomada da turma',
            summary: `${totalStudents} aluno(s) agrupados em ${totalGroups} bloco(s) de erro dominante no filtro atual.${turmaSet.length === 1 ? ` Turma: ${turmaSet[0]}.` : ''}`,
            groups,
            note: 'Os blocos abaixo agrupam alunos com o mesmo erro dominante. Isso serve para montar retomadas curtas por grupo, não para substituir intervenção individual quando o caso estiver muito defasado.'
        };
    } catch (_) {
        return {
            title: 'Plano de retomada da turma',
            summary: 'Não foi possível montar o agrupamento da turma.',
            groups: [],
            note: ''
        };
    }
}
function renderTeacherClassRetakePlan(container, plan) {
    try {
        if (!container) return;
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        container.innerHTML = '';
        const title = document.createElement('div');
        title.className = 'tp-student-retake-title';
        title.textContent = safePlan.title || 'Plano de retomada da turma';
        container.appendChild(title);
        const summary = document.createElement('div');
        summary.className = 'tp-student-retake-goal';
        summary.textContent = safePlan.summary || 'Sem resumo disponível.';
        container.appendChild(summary);
        const groupsWrap = document.createElement('div');
        groupsWrap.className = 'tp-student-retake-list';
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        if (currentTeacherClassFocusGroupKey && !groups.some((group) => String(group?.groupKey || '') === String(currentTeacherClassFocusGroupKey))) currentTeacherClassFocusGroupKey = '';
        if (!groups.length) {
            currentTeacherClassFocusGroupKey = '';
            try { renderTeacherClassBlockFocus(classBlockFocusEl, safePlan, ''); } catch (_) {}
            const empty = document.createElement('div');
            empty.className = 'tp-empty';
            empty.textContent = 'Sem agrupamentos úteis neste filtro.';
            container.appendChild(empty);
        } else {
            groups.slice(0, 6).forEach((group, index) => {
                const item = document.createElement('div');
                item.className = 'tp-student-retake-step';
                const isActive = !!(currentTeacherClassBlockFilter && currentTeacherClassBlockFilter.groupKey === group.groupKey);
                if (isActive) item.classList.add('tp-row-active');
                const head = document.createElement('div');
                head.className = 'tp-student-retake-step-title';
                head.textContent = `Bloco ${index + 1} — ${group.turma} — ${group.formatted}`;
                const meta = document.createElement('div');
                meta.className = 'tp-student-retake-step-text';
                meta.textContent = `${group.studentCount} aluno(s) • Sessões no filtro: ${group.sessions} • Erros diagnosticados: ${group.errors} • Habilidade mais afetada: ${group.topSkill}`;
                const students = document.createElement('div');
                students.className = 'tp-student-retake-step-text';
                students.textContent = `Alunos: ${group.students.join(', ')}`;
                const p1 = document.createElement('div');
                p1.className = 'tp-student-retake-step-text';
                p1.textContent = `Passo 1 — Reativar a base: retomar ${group.prerequisite}.`;
                const p2 = document.createElement('div');
                p2.className = 'tp-student-retake-step-text';
                p2.textContent = `Passo 2 — Atacar o erro dominante: ${group.teacherMove} ${group.studentMove}`;
                const p3 = document.createElement('div');
                p3.className = 'tp-student-retake-step-text';
                p3.textContent = `Passo 3 — Critério de saída: ${group.checkpoint}`;
                const actions = document.createElement('div');
                actions.className = 'tp-student-retake-actions';
                const focusBtn = document.createElement('button');
                focusBtn.type = 'button';
                focusBtn.className = `btn-secondary tp-retake-btn${currentTeacherClassFocusGroupKey === group.groupKey ? ' is-active' : ''}`;
                focusBtn.textContent = currentTeacherClassFocusGroupKey === group.groupKey ? 'Bloco em foco' : 'Focar este bloco';
                focusBtn.addEventListener('click', () => {
                    try {
                        currentTeacherClassFocusGroupKey = group.groupKey;
                        renderTeacherClassBlockFocus(classBlockFocusEl, safePlan, currentTeacherClassFocusGroupKey);
                        renderTeacherClassRetakePlan(container, safePlan);
                    } catch (_) {
                        try { showFeedbackMessage('Não foi possível focar este bloco.', 'error'); } catch (_) {}
                    }
                });
                const copyFocusBtn = document.createElement('button');
                copyFocusBtn.type = 'button';
                copyFocusBtn.className = 'btn-secondary tp-retake-btn';
                copyFocusBtn.textContent = 'Copiar foco do bloco';
                copyFocusBtn.addEventListener('click', async () => {
                    try {
                        const payload = buildTeacherClassBlockFocusClipboardText(safePlan, group.groupKey);
                        try {
                            await navigator.clipboard.writeText(payload);
                            try { showFeedbackMessage('Foco do bloco copiado.', 'success'); } catch (_) {}
                        } catch (_) {
                            window.prompt('Copie o foco deste bloco abaixo:', payload);
                        }
                    } catch (_) {
                        try { showFeedbackMessage('Não foi possível copiar o foco do bloco.', 'error'); } catch (_) {}
                    }
                });
                const downloadFocusBtn = document.createElement('button');
                downloadFocusBtn.type = 'button';
                downloadFocusBtn.className = 'btn-secondary tp-retake-btn';
                downloadFocusBtn.textContent = 'Baixar foco do bloco';
                downloadFocusBtn.addEventListener('click', () => {
                    try {
                        downloadTeacherClassBlockFocusText(safePlan, group.groupKey);
                    } catch (_) {
                        try { showFeedbackMessage('Não foi possível baixar o foco do bloco.', 'error'); } catch (_) {}
                    }
                });
                const applyBtn = document.createElement('button');
                applyBtn.type = 'button';
                applyBtn.className = `btn-secondary tp-retake-btn${isActive ? ' is-active' : ''}`;
                applyBtn.textContent = isActive ? 'Filtro aplicado' : 'Aplicar filtro do bloco';
                applyBtn.addEventListener('click', () => {
                    try {
                        currentTeacherClassFocusGroupKey = group.groupKey;
                        currentTeacherClassBlockFilter = {
                            groupKey: group.groupKey,
                            turma: group.turma,
                            code: group.code,
                            formatted: group.formatted,
                            studentNames: Array.isArray(group.students) ? group.students.slice() : [],
                            studentCount: Math.max(0, Number(group.studentCount) || 0)
                        };
                        renderTeacherClassBlockFocus(classBlockFocusEl, safePlan, currentTeacherClassFocusGroupKey);
                        refreshTeacherClassPlanFilterUi();
                        updateCsvSummary();
                        try { showFeedbackMessage('Filtro do bloco aplicado no painel.', 'success'); } catch (_) {}
                    } catch (_) {
                        try { showFeedbackMessage('Não foi possível aplicar o filtro do bloco.', 'error'); } catch (_) {}
                    }
                });
                actions.appendChild(focusBtn);
                actions.appendChild(copyFocusBtn);
                actions.appendChild(downloadFocusBtn);
                actions.appendChild(applyBtn);
                item.appendChild(head);
                item.appendChild(meta);
                item.appendChild(students);
                item.appendChild(p1);
                item.appendChild(p2);
                item.appendChild(p3);
                item.appendChild(actions);
                groupsWrap.appendChild(item);
            });
            container.appendChild(groupsWrap);
        }
        try { renderTeacherClassBlockFocus(classBlockFocusEl, safePlan, currentTeacherClassFocusGroupKey); } catch (_) {}
        if (safePlan.note) {
            const note = document.createElement('div');
            note.className = 'tp-student-retake-note';
            note.textContent = safePlan.note;
            container.appendChild(note);
        }
    } catch (_) {
        try {
            if (container) container.innerHTML = '<div class="tp-empty">Não foi possível montar o plano da turma.</div>';
        } catch (_) {}
    }
}
function buildTeacherClassRetakeCsv(plan) {
    try {
        const safePlan = plan || buildTeacherClassRetakePlan([]);
        const groups = Array.isArray(safePlan.groups) ? safePlan.groups : [];
        const headers = [
            'titulo_plano',
            'resumo',
            'turma',
            'bloco_ordem',
            'bloco_chave',
            'codigo_distrator',
            'rotulo_bloco',
            'erro_dominante',
            'habilidade_predominante',
            'base_a_retomar',
            'intervencao_docente',
            'acao_estudante',
            'criterio_saida',
            'alunos_quantidade',
            'alunos',
            'sessoes_filtro',
            'erros_diagnosticados',
            'observacao'
        ];
        const lines = [headers.map(csvEscape).join(';')];
        if (!groups.length) {
            lines.push([
                safePlan.title || 'Plano de retomada da turma',
                safePlan.summary || 'Sem dados suficientes neste filtro.',
                '', '', '', '', '', '', '', '', '', '', '', '0', '', '0', '0', safePlan.note || ''
            ].map(csvEscape).join(';'));
            return lines.join('\n');
        }
        groups.forEach((group, index) => {
            lines.push([
                safePlan.title || 'Plano de retomada da turma',
                safePlan.summary || '',
                group.turma || '',
                String(index + 1),
                group.groupKey || '',
                group.code || '',
                group.formatted || '',
                group.diagnosis || group.formatted || '',
                group.topSkill || '',
                group.prerequisite || '',
                group.teacherMove || '',
                group.studentMove || '',
                group.checkpoint || '',
                String(Math.max(0, Number(group.studentCount) || 0)),
                Array.isArray(group.students) ? group.students.join(' | ') : '',
                String(Math.max(0, Number(group.sessions) || 0)),
                String(Math.max(0, Number(group.errors) || 0)),
                safePlan.note || ''
            ].map(csvEscape).join(';'));
        });
        return lines.join('\n');
    } catch (_) {
        return 'titulo_plano;resumo;turma;bloco_ordem;bloco_chave;codigo_distrator;rotulo_bloco;erro_dominante;habilidade_predominante;base_a_retomar;intervencao_docente;acao_estudante;criterio_saida;alunos_quantidade;alunos;sessoes_filtro;erros_diagnosticados;observacao\nPlano de retomada da turma;Não foi possível montar o CSV do plano da turma.;;;;;;;;;;;;;0;;0;0;';
    }
}
