        if (label.includes('tabela') || label.includes('valores')) return 'Leia os valores com atenção e some item por item antes de responder.';
        if (label.includes('composição')) return 'Junte as partes informadas para descobrir o total da situação.';
        if (label.includes('estratégias mentais')) return 'Procure completar dezenas ou centenas para somar mais rápido.';
