                if (selected === num2) return make('bridge_root_used_exponent', 'Marcou o expoente em vez da base/raiz procurada.', 'O expoente apenas informa quantas vezes a base aparece. A resposta é a base que gera o valor.');
                if (Number.isFinite(answer) && selected === (answer * answer)) return make('bridge_root_repeated_power', 'Voltou para a potência em vez de extrair a raiz.', 'Nesta questão, a potência aparece só como pista. A operação final pede a raiz.');
            }
            if (qLower.includes('aproximada')) {
                if (Math.abs(selected - answer) === 1) return make('root_estimation_neighbor', 'Escolheu uma raiz vizinha na estimativa.', 'Compare entre quais quadrados perfeitos o número está e escolha a raiz mais próxima.');
                if (Number.isFinite(num1) && selected === Math.round(num1 / 2)) return make('root_as_half', 'Leu a raiz como metade do número.', 'Raiz não é dividir por 2. Procure o número que, multiplicado por ele mesmo, produz o valor dado.');
                if (Number.isFinite(num1) && selected === num1) return make('root_used_radicand', 'Repetiu o número que está dentro da raiz.', 'A resposta precisa ser o número que gera o radicando, não o próprio radicando.');
            }
            if (isCube) {
                if (Number.isFinite(answer) && selected === (answer * 3)) return make('cube_root_times_three', 'Multiplicou a raiz por 3 em vez de procurar o cubo exato.', 'Na raiz cúbica, pense em qual número multiplicado por ele mesmo 3 vezes gera o radicando.');
                if (Number.isFinite(num1) && selected === Math.round(Math.sqrt(Math.max(0, num1)))) return make('cube_root_as_square_root', 'Confundiu raiz cúbica com raiz quadrada.', 'Na raiz cúbica, o número aparece 3 vezes na multiplicação, não 2.');
                if (Math.abs(selected - answer) === 1) return make('cube_root_neighbor', 'Escolheu uma raiz cúbica vizinha.', 'Confira os cubos perfeitos próximos antes de responder.');
            }
            if (Number.isFinite(answer) && selected === (answer * 2)) return make('square_root_doubled', 'Dobrou a raiz em vez de procurar o número correto.', 'Raiz quadrada não é o dobro do resultado. Procure o número que multiplicado por ele mesmo gera o radicando.');
            if (Number.isFinite(num1) && selected === Math.round(num1 / 2)) return make('square_root_as_half', 'Leu a raiz como divisão por 2.', 'Raiz quadrada não é metade do número. Pense em qual número ao quadrado produz o radicando.');
            if (Number.isFinite(answer) && selected === (answer * answer)) return make('square_root_as_square', 'Deu o quadrado do número em vez da raiz.', 'A raiz desfaz a potência. Se o radicando é 49, a resposta é 7, não 49 nem 7².');
            if (Math.abs(selected - answer) === 1) return make('square_root_neighbor', 'Escolheu uma raiz vizinha.', 'Confira os quadrados perfeitos próximos para localizar a raiz exata.');
        }
        return null;
