        return isRapid
            ? `Use a relação inversa: releia a soma dada, identifique o total e descubra qual parte está faltando na subtração.`
            : `Passo 1: releia a soma dada e localize o total.  |  Passo 2: identifique qual parte já aparece na subtração.  |  Passo 3: descubra a parte que falta sem trocar a operação.  |  Pronto`;
    }
    if (q?.bridgeFamily === 'multiplication-division' && resolvedOperation === 'division' && Number.isFinite(Number(q?.num1)) && Number.isFinite(Number(q?.num2)) && Number.isFinite(Number(q?.answer))) {
        return isRapid
            ? `Use a operação inversa: releia a multiplicação dada e descubra quantos grupos ou quanto cabe em cada grupo.`
            : `Passo 1: releia a multiplicação dada.  |  Passo 2: identifique o total e o fator conhecido.  |  Passo 3: use a divisão para recuperar a informação que falta.  |  Pronto`;
    }
    if (q?.bridgeFamily === 'power-root' && resolvedOperation === 'radiciacao' && Number.isFinite(Number(q?.num1)) && Number.isFinite(Number(q?.answer))) {
        return isRapid
            ? `Use a operação inversa: procure qual número, ao quadrado, gera o valor dado.`
            : `Passo 1: releia o valor dado.  |  Passo 2: teste quadrados conhecidos sem trocar raiz por potência.  |  Passo 3: confirme qual número gera o valor pedido.  |  Pronto`;
    }
