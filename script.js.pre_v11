        operacao: resolvedOperation,
        semanticOperation: resolvedOperation,
        operationMetadata: operation,
        operationMismatchAutoFixed: String(resolvedOperation || '') !== String(operation || ''),
        num1,
        num2,
        stageLabel: stageLabel || ''
    };
