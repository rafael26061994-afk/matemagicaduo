            options: Array.isArray(q.options) ? q.options.slice(0, 4) : [],
            operacao: q.operacao,
            num1: (q.num1 ?? null),
            num2: (q.num2 ?? null),
            stageLabel: (q.stageLabel || ''),
            stageIndex: (q.stageIndex ?? null),
            absoluteTrailIndex: (q.absoluteTrailIndex ?? null),
            bankSize: (q.bankSize ?? null),
            isReview: !!q.isReview,
            sourceStageIndex: (q.sourceStageIndex ?? null),
            sourceStageLabel: (q.sourceStageLabel || ''),
            masteryStageIndex: (q.masteryStageIndex ?? null),
            masteryStageLabel: (q.masteryStageLabel || ''),
            learningType: (q.learningType || ''),
            learningTypeLabel: (q.learningTypeLabel || ''),
            supportMode: String(q.supportMode || ''),
            supportLabel: String(q.supportLabel || ''),
            supportHint: String(q.supportHint || ''),
            visualHint: String(q.visualHint || ''),
            isSupportLane: !!q.isSupportLane,
            supportLaneReason: String(q.supportLaneReason || ''),
            isConsolidation: !!q.isConsolidation,
            consolidationStageIndex: (q.consolidationStageIndex ?? null),
            consolidationStageLabel: (q.consolidationStageLabel || '')
        } : null,
        opTrail: (gameState.operationTrail && (gameState.currentOperation !== 'multiplication' || isMultiplicationMasteryTrailSession())) ? {
            operation: gameState.operationTrail.operation,
            level: gameState.operationTrail.level,
            key: gameState.operationTrail.key,
            startIndex: gameState.operationTrail.startIndex,
            bankSize: gameState.operationTrail.bankSize,
            totalStages: gameState.operationTrail.totalStages,
            masteryMode: !!gameState.operationTrail.masteryMode,
            currentStageIndex: Number(gameState.operationTrail.currentStageIndex || 0),
            currentStageAsked: Number(gameState.operationTrail.currentStageAsked || 0),
            currentStageCorrect: Number(gameState.operationTrail.currentStageCorrect || 0),
            stageTarget: Number(gameState.operationTrail.stageTarget || 0),
            targetAccuracy: Number(gameState.operationTrail.targetAccuracy || 0),
            reviewEvery: Number(gameState.operationTrail.reviewEvery || 0),
            reviewAsked: Number(gameState.operationTrail.reviewAsked || 0),
            lastQuestionWasReview: !!gameState.operationTrail.lastQuestionWasReview,
            currentStageLabel: (gameState.operationTrail.currentStageLabel || ''),
            supportMode: String(gameState.operationTrail.supportMode || 'normal'),
            supportEscalations: Number(gameState.operationTrail.supportEscalations || 0),
            supportHint: String(gameState.operationTrail.supportHint || ''),
            supportLaneRemaining: Number(gameState.operationTrail.supportLaneRemaining || 0),
            supportLaneReason: String(gameState.operationTrail.supportLaneReason || ''),
            consolidationMode: !!gameState.operationTrail.consolidationMode,
            consolidation: gameState.operationTrail.consolidation ? JSON.parse(JSON.stringify(gameState.operationTrail.consolidation)) : null,
            stageType: String(gameState.operationTrail.stageType || 'fluency')
        } : null,
        mult: (gameState.currentOperation === 'multiplication' && gameState.multiplication) ? {
            mode: gameState.multiplication.mode,
            tabuada: gameState.multiplication.tabuada,
            trailMin: gameState.multiplication.trailMin,
            trailMax: gameState.multiplication.trailMax,
            multMin: gameState.multiplication.multMin,
            multMax: gameState.multiplication.multMax,
            trailRangeKey: gameState.multiplication.trailRangeKey,
            trailPairIndex: gameState.multiplication.trailPairIndex
