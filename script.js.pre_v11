    if (ctx.bridge === 'power-root') return `A potência serve de pista. A raiz pede o número que gera ${ctx.n1}.`;
    if (ctx.isMissingTerm) return 'Antes de testar alternativas, descubra qual valor está faltando e qual número já está dado na operação.';
    if (ctx.isMissingFactor) return 'O produto já está pronto. Seu trabalho é descobrir o fator que completa a multiplicação.';
    if (ctx.isMissingDividend || ctx.isMissingDivisor) return 'Na divisão, identifique o que já foi dado: total, tamanho do grupo ou quantidade de grupos.';
    if (ctx.isComparison) return 'A questão não pede “tirar por tirar”; ela pede a diferença entre dois valores.';
    if (ctx.isEstimation) return 'Aqui não comece calculando tudo. Primeiro faça uma previsão aproximada.';
    if (ctx.isContext) return 'Leia o enunciado procurando três coisas: o que já se sabe, o que a pergunta quer e qual operação liga essas informações.';
    if (micro) return micro;
    return 'Leia a operação e diga em voz baixa o papel de cada número antes de escolher a resposta.';
}
function getPriority3StrategyText(q) {
    const ctx = getQuestionPedagogicalContext(q);
    const operation = String(ctx.op || q?.operacao || gameState.currentOperation || '');
    const label = getPriority3StageLabel(q).toLowerCase();
    if (ctx.bridge === 'addition-subtraction') return `Monte a família de fatos com o total e a parte conhecida. Depois use essa relação para achar a parte que falta na subtração.`;
    if (ctx.bridge === 'multiplication-division') return `Confirme a relação entre total, fator conhecido e fator que falta. Em seguida leia a divisão como a operação inversa.`;
    if (ctx.bridge === 'power-root') return `Confirme a potência conhecida e use-a para voltar à raiz sem trocar a operação.`;
    if (ctx.isMissingTerm) return 'Use a operação inversa para encontrar o termo faltante antes de comparar as opções.';
    if (ctx.isMissingFactor) return 'Use fatos da tabuada ou decomposição para descobrir qual fator completa o produto.';
    if (ctx.isMissingDividend) return 'Multiplique quociente pelo divisor e some o resto, quando existir, para recuperar o total.';
    if (ctx.isMissingDivisor) return 'Pergunte qual tamanho de grupo produz o total e o resultado mostrados.';
    if (ctx.isComparison) return 'Descubra qual número é maior, qual é menor e complete do menor para o maior.';
    if (ctx.isEstimation && operation === 'addition') return 'Arredonde cada parcela, estime a soma e depois veja qual alternativa respeita essa ordem de grandeza.';
    if (ctx.isEstimation && operation === 'division') return 'Pense em múltiplos próximos do divisor para prever o quociente antes do cálculo exato.';
    if (ctx.isMental && operation === 'subtraction') return 'Use compensação ou passagem por uma dezena/centena fácil antes de terminar a conta.';
    if (ctx.isMental && operation === 'multiplication') return 'Quebre um fator em partes conhecidas ou use dobro/metade para simplificar o cálculo.';
    if (operation === 'addition') return label.includes('reagrupamento') ? 'Separe dezenas e unidades e faça a troca apenas quando a soma passar de 9.' : 'Some por partes e confira se o total faz sentido.';
    if (operation === 'subtraction') return label.includes('reserva') ? 'Compare as ordens e, se faltar unidade, empreste 1 dezena antes de subtrair.' : 'Use a diferença ou complete do menor para o maior.';
    if (operation === 'multiplication') return isMultiplicationApprenticeLevel(gameState.currentLevel) ? 'Modele grupos iguais ou saltos antes de pensar na tabuada decorada.' : 'Apoie-se em grupos iguais, padrões das tabuadas e fatos já conhecidos.';
    if (operation === 'division') return label.includes('resto') ? 'Pense em quantos grupos completos cabem e observe o que sobra.' : 'Use a multiplicação de volta para conferir o quociente.';
    if (operation === 'potenciacao') return 'Transforme a potência em multiplicação repetida e compare com potências conhecidas.';
    if (operation === 'radiciacao') return label.includes('cúbica') ? 'Procure um número que, ao cubo, gere o radicando.' : 'Procure o número que, ao quadrado, gera o radicando.';
    return 'Resolva primeiro pelo raciocínio principal e só depois use as alternativas para confirmar.';
}
function getPriority3AlternativePathText(q) {
    const ctx = getQuestionPedagogicalContext(q);
    const operation = String(ctx.op || q?.operacao || gameState.currentOperation || '');
    if (ctx.bridge === 'addition-subtraction') return 'Outro caminho: monte a soma relacionada e descubra a parte que falta antes de voltar para a subtração.';
    if (ctx.bridge === 'multiplication-division') return 'Outro caminho: confira pela multiplicação e depois releia o que a divisão está perguntando.';
    if (ctx.bridge === 'power-root') return 'Outro caminho: teste a resposta elevando-a à potência correspondente e veja se retorna ao valor dado.';
    if (ctx.isMissingTerm) return 'Outro caminho: substitua cada alternativa na conta e veja qual fecha a igualdade corretamente.';
    if (ctx.isComparison) return 'Outro caminho: marque o menor e o maior e conte quanto falta para chegar de um ao outro.';
    if (ctx.isEstimation) return 'Outro caminho: elimine primeiro as alternativas muito pequenas ou muito grandes antes do cálculo exato.';
    if (ctx.isContext) return 'Outro caminho: reescreva o problema com as palavras “total”, “cada grupo”, “sobra” ou “diferença” para revelar a operação.';
    if (operation === 'addition') return 'Outro caminho: decomponha em centenas, dezenas e unidades ou confira pela operação inversa quando houver termo faltante.';
    if (operation === 'subtraction') return 'Outro caminho: complete do menor para o maior ou confira somando a diferença ao subtraendo.';
    if (operation === 'multiplication') return 'Outro caminho: represente em grupos iguais, soma repetida ou use dobros/metades para conferir.';
    if (operation === 'division') return 'Outro caminho: multiplique quociente × divisor e veja se volta ao total, observando o resto.';
    if (operation === 'potenciacao') return 'Outro caminho: escreva a potência como produto repetido e compare com quadrados ou cubos conhecidos.';
    if (operation === 'radiciacao') return 'Outro caminho: eleve a possível resposta ao quadrado ou ao cubo para conferir se retorna ao radicando.';
    return 'Outro caminho: resolva por uma estratégia diferente e compare os dois resultados.';
}
function getResolvedFeedbackOperation(operation, q) {
    return String(getQuestionSemanticOperation(q) || q?.operacao || operation || gameState.currentOperation || '');
}
function buildAutomaticResolutionExplanation(q, opts = {}) {
