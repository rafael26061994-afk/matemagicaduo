        const meta = getCurrentSkillMicroExplanationMeta();
        if (!meta) return;
        if (!force && gameState.lastSkillMicroExplanationKey === meta.key) return;
        gameState.lastSkillMicroExplanationKey = meta.key;
        const duration = gameState.isRapidMode ? 6500 : 12000;
        const message = `🧠 Etapa ${meta.stageNo}/${meta.totalStages} — ${meta.label}: ${meta.hint}`;
        __skillMicroExplanationTimer = setTimeout(() => {
            __skillMicroExplanationTimer = null;
            if (!gameState.isGameActive || gameState.currentScreen !== 'game-screen') return;
            showFeedbackMessage(message, 'info', duration);
        }, 220);
    } catch (_) {}
}
function randAdditionNoCarry(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const b = randomInt(minB, maxB);
        if (((a % 10) + (b % 10)) < 10) return [a, b];
    }
    return [randomInt(minA, maxA), randomInt(minB, maxB)];
}
function randAdditionWithCarry(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const b = randomInt(minB, maxB);
        if (((a % 10) + (b % 10)) >= 10) return [a, b];
    }
    const a = randomInt(minA, maxA);
    const b = randomInt(minB, maxB);
    return [a, b];
}
function randSubtractionNoBorrow(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const b = randomInt(minB, Math.min(maxB, a));
        if ((a % 10) >= (b % 10) && a >= b) return [a, b];
    }
    const a = randomInt(minA, maxA);
    const b = randomInt(minB, Math.min(maxB, a));
    return [Math.max(a, b), Math.min(a, b)];
}
function randSubtractionWithBorrow(minA, maxA, minB, maxB) {
    for (let tries = 0; tries < 200; tries++) {
        const a = randomInt(minA, maxA);
        const maxLocalB = Math.min(maxB, a - 1);
        if (maxLocalB < minB) continue;
        const b = randomInt(minB, maxLocalB);
        if ((a % 10) < (b % 10) && a > b) return [a, b];
    }
    const a = randomInt(Math.max(minA, minB + 1), maxA);
    const b = randomInt(minB, Math.min(maxB, a - 1));
    return [a, b];
}
function randExactDivision(divMin, divMax, qMin, qMax) {
    const divisor = randomInt(divMin, divMax);
    const quotient = randomInt(qMin, qMax);
    return [divisor * quotient, divisor, quotient];
}
function randPerfectSquare(rootMin, rootMax) {
    const root = randomInt(rootMin, rootMax);
    return [root * root, root];
}
function makeStage(label, count, gen) {
    return { label, count, gen };
}
function qAddition(a, b, label) {
    return buildQuestionPayload('addition', a, b, a + b, `${a} + ${b}`, `${a} mais ${b}`, label);
}
function qAddition3(a, b, c, label) {
    return buildQuestionPayload('addition', a + b, c, a + b + c, `${a} + ${b} + ${c}`, `${a} mais ${b} mais ${c}`, label);
}
function qAdditionMissing(total, known, label, missingOnLeft = false) {
    const missing = total - known;
    return buildQuestionPayload(
        'addition',
        known,
        missing,
        missing,
        missingOnLeft ? `? + ${known} = ${total}` : `${known} + ? = ${total}`,
        `complete ${known} para chegar a ${total}`,
        label
    );
}
function qSubtraction(a, b, label) {
    return buildQuestionPayload('subtraction', a, b, a - b, `${a} - ${b}`, `${a} menos ${b}`, label);
}
function qUnknownMinuend(diff, subtrahend, label) {
    const answer = diff + subtrahend;
    return buildQuestionPayload('subtraction', answer, subtrahend, answer, `? - ${subtrahend} = ${diff}`, `qual número menos ${subtrahend} é igual a ${diff}`, label);
}
function qUnknownSubtrahend(minuend, diff, label) {
    const answer = minuend - diff;
    return buildQuestionPayload('subtraction', minuend, answer, answer, `${minuend} - ? = ${diff}`, `quanto falta tirar de ${minuend} para dar ${diff}`, label);
}
function qDivision(dividend, divisor, label) {
    const quotient = Math.floor(dividend / divisor);
    return buildQuestionPayload('division', dividend, divisor, quotient, `${dividend} ÷ ${divisor}`, `${dividend} dividido por ${divisor}`, label);
}
function qDivisionRemainder(dividend, divisor, label) {
    const remainder = dividend % divisor;
    return buildQuestionPayload('division', dividend, divisor, remainder, `${dividend} ÷ ${divisor} (resto)`, `qual é o resto de ${dividend} dividido por ${divisor}`, label);
}
function qDivisionFindDividend(divisor, quotient, label) {
    const answer = divisor * quotient;
    return buildQuestionPayload('division', answer, divisor, answer, `? ÷ ${divisor} = ${quotient}`, `qual dividendo dividido por ${divisor} dá ${quotient}`, label);
}
function qDivisionFindDivisor(dividend, quotient, label) {
    const answer = Math.floor(dividend / quotient);
    return buildQuestionPayload('division', dividend, answer, answer, `${dividend} ÷ ? = ${quotient}`, `qual divisor faz ${dividend} dividido por ele ser igual a ${quotient}`, label);
}
function qPower(base, exp, label) {
    return buildQuestionPayload('potenciacao', base, exp, base ** exp, `${base}${toSuperscript(exp)}`, `${base} elevado a ${exp}`, label);
}
function qPowerExpanded(base, exp, label) {
    const question = Array.from({ length: exp }, () => String(base)).join(' × ');
    return buildQuestionPayload('potenciacao', base, exp, base ** exp, question, `${base} multiplicado por ele mesmo ${exp} vezes`, label);
}
function qRoot(square, label) {
    const root = Math.round(Math.sqrt(square));
    return buildQuestionPayload('radiciacao', square, null, root, `√${square}`, `raiz quadrada de ${square}`, label);
}
function qRootEstimate(square, label) {
    const root = Math.round(Math.sqrt(square));
    return buildQuestionPayload('radiciacao', square, null, root, `√${square} (aproximada)`, `raiz quadrada aproximada de ${square}`, label);
}
function qCubeRoot(cube, label) {
    const root = Math.round(Math.cbrt(cube));
    return buildQuestionPayload('radiciacao', cube, 3, root, `∛${cube}`, `raiz cúbica de ${cube}`, label);
}
function qMultiplicationBasic(a, b, label) {
    return buildQuestionPayload('multiplication', a, b, a * b, `${a} x ${b}`, `${a} vezes ${b}`, label);
}
function qEqualGroups(groups, size, label) {
    const total = groups * size;
    return buildQuestionPayload('multiplication', groups, size, total, `${groups} grupos de ${size}`, `${groups} grupos com ${size} em cada grupo`, label);
}
function qRepeatedAddition(addend, times, label) {
    const total = addend * times;
    const parts = Array.from({ length: times }, () => String(addend));
    return buildQuestionPayload('multiplication', times, addend, total, parts.join(' + '), parts.join(' mais '), label);
}
function qDoubleTriple(base, factor, label) {
    const total = base * factor;
    const word = factor === 2 ? 'Dobro' : 'Triplo';
    return buildQuestionPayload('multiplication', factor, base, total, `${word} de ${base}`, `${word.toLowerCase()} de ${base}`, label);
}
function qSkipCounting(step, count, label) {
    const seq = Array.from({ length: count }, (_, i) => step * (i + 1));
    const answer = seq[seq.length - 1];
    const shown = seq.slice(0, -1).join(', ');
    return buildQuestionPayload('multiplication', step, count, answer, `${shown}, __`, `contagem em saltos de ${step} em ${step}`, label);
}

function getQuestionBankAuditRecentStore() {
    return window.__petQuestionAuditRecent || (window.__petQuestionAuditRecent = []);
}
function clearQuestionBankAuditTrail() {
    try { window.__petQuestionAuditRecent = []; } catch (_) {}
}
function normalizeQuestionAuditStageLabel(label) {
    return normalizeSkillStageLabel(label || '').toLowerCase();
}
function buildQuestionAuditInfo(q, ctx = {}) {
    const operation = String(ctx.operation || getQuestionSemanticOperation(q) || q?.operacao || gameState.currentOperation || '');
    const level = String(ctx.level || gameState.currentLevel || '');
    const stage = normalizeQuestionAuditStageLabel(ctx.stageLabel || q?.stageLabel || '');
    const raw = String(q?.question || '').replace(/\s*=\s*\?\s*$/, '').trim().toLowerCase();
    const exact = raw.replace(/\s+/g, ' ');
    const skeleton = exact.replace(/\d+/g, '#').replace(/\s+/g, ' ');
    return {
        operation,
        level,
        stage,
        exact,
        skeleton,
        bridgeFamily: String(q?.bridgeFamily || ''),
        strategyFamily: String(q?.strategyFamily || ''),
        auditStageVariant: String(q?.auditStageVariant || '')
    };
}
function isQuestionAuditInfoOverRepeated(info) {
    try {
        if (!info || !info.exact) return false;
        const recent = getQuestionBankAuditRecentStore();
        if (recent.some((it) => it && it.exact === info.exact && it.operation === info.operation)) return true;
        const sameSkeleton = recent.filter((it) => it && it.operation === info.operation && it.level === info.level && it.stage === info.stage && it.skeleton === info.skeleton).length;
        return sameSkeleton >= 2;
    } catch (_) {
        return false;
    }
}
function rememberQuestionAuditInfo(info) {
    try {
        if (!info || !info.exact) return;
        const recent = getQuestionBankAuditRecentStore();
        recent.push(info);
        while (recent.length > 12) recent.shift();
    } catch (_) {}
}
function finalizeAuditedQuestionSelection(q, ctx = {}) {
    const info = buildQuestionAuditInfo(q, ctx);
    rememberQuestionAuditInfo(info);
    q.questionAuditInfo = info;
    return q;
}
