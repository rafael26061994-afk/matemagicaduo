                <button type="button" id="diag-summary-redo" style="flex:1 1 160px; border:1px solid #d0d0d0; background:#fff; color:#111; border-radius:12px; padding:12px 14px; font-weight:700; cursor:pointer;">Refazer diagnóstico</button>
